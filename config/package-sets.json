{
  "version": 1,
  "packages": {
    "orchestrator": "packages/orchestrator",
    "claude-code-use": "packages/runtime/extensions/pi-claude-code-use",
    "state-compactor": "packages/runtime/extensions/state-compactor",
    "bash-timeout-guard": "packages/runtime/extensions/bash-timeout-guard",
    "scratch-updates": "packages/runtime/extensions/scratch-updates",
    "pi-cursor": "packages/runtime/extensions/pi-cursor",
    "remote": "apps/remote"
  },
  "roles": {
    "gmktec-user": [
      "orchestrator",
      "claude-code-use",
      "state-compactor",
      "bash-timeout-guard",
      "scratch-updates",
      "pi-cursor",
      "remote"
    ],
    "gmktec-fleet": [
      "orchestrator",
      "claude-code-use",
      "state-compactor",
      "bash-timeout-guard",
      "pi-cursor"
    ],
    "converge-user": [
      "orchestrator",
      "state-compactor",
      "bash-timeout-guard",
      "remote"
    ]
  },
  "contextObserver": "remote"
}
