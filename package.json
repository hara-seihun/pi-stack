{
  "name": "@hara-seihun/pi-stack",
  "version": "1.0.0",
  "private": true,
  "description": "The custom Pi runtime, orchestrator, remote clients, skills, and agent tools",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/remote",
    "apps/kenan",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=pi-orchestrator",
    "typecheck": "npm run typecheck --workspace=pi-orchestrator",
    "test": "node scripts/test.mjs",
    "build:kenan": "npm run build --workspace=kenan",
    "check": "node scripts/test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "file:vendor/pi/earendil-works-pi-ai-0.85.0-17de82d7bea1.tgz",
    "@earendil-works/pi-coding-agent": "file:vendor/pi/earendil-works-pi-coding-agent-0.85.0-17de82d7bea1.tgz",
    "@earendil-works/pi-server": "0.85.0"
  },
  "overrides": {
    "@earendil-works/pi-ai": "$@earendil-works/pi-ai",
    "@earendil-works/pi-coding-agent": "$@earendil-works/pi-coding-agent",
    "typebox": "1.3.16"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "agent-browser@0.34.0": true,
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true
  }
}
