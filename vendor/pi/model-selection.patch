diff --git a/packages/coding-agent/src/core/extension-providers.ts b/packages/coding-agent/src/core/extension-providers.ts
new file mode 100644
index 000000000..05dcabdf7
--- /dev/null
+++ b/packages/coding-agent/src/core/extension-providers.ts
@@ -0,0 +1,12 @@
+import type { ExtensionRuntime } from "./extensions/types.ts";
+import type { ModelRuntime } from "./model-runtime.ts";
+
+/** Model selection must see providers loaded by extensions, in CLI and SDK alike. */
+export async function applyExtensionProviders(runtime: ExtensionRuntime, models: ModelRuntime): Promise<void> {
+	if (!runtime.pendingProviderRegistrations.length && !runtime.pendingNativeProviderRegistrations.length) return;
+	for (const { name, config } of runtime.pendingProviderRegistrations) models.registerProvider(name, config);
+	for (const { provider } of runtime.pendingNativeProviderRegistrations) models.registerNativeProvider(provider);
+	runtime.pendingProviderRegistrations = [];
+	runtime.pendingNativeProviderRegistrations = [];
+	await models.refresh({ allowNetwork: false });
+}
