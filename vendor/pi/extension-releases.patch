diff --git a/packages/coding-agent/test/extensions-release.test.ts b/packages/coding-agent/test/extensions-release.test.ts
new file mode 100644
index 000000000..7a1a5d9ce
--- /dev/null
+++ b/packages/coding-agent/test/extensions-release.test.ts
@@ -0,0 +1,40 @@
+import assert from "node:assert/strict";
+import { mkdirSync, mkdtempSync, realpathSync, rmSync, symlinkSync, unlinkSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { it } from "vitest";
+import { clearExtensionCache, loadExtensionsCached } from "../src/core/extensions/loader.ts";
+
+it("loads the physical ESM release after a symlink switch and rollback", async () => {
+	const root = realpathSync(mkdtempSync(join(tmpdir(), "pi-extension-release-")));
+	const selected = join(root, "selected");
+	const entry = join(selected, "index.mjs");
+	try {
+		for (const version of ["first", "second"]) {
+			const release = join(root, version);
+			mkdirSync(release);
+			writeFileSync(join(release, "version.mjs"), `export default ${JSON.stringify(version)};`);
+			writeFileSync(
+				join(release, "index.mjs"),
+				'import version from "./version.mjs"; export default pi => pi.registerFlag("release", { type: "string", default: version });',
+			);
+		}
+		symlinkSync(join(root, "first"), selected, "junction");
+		const first = await loadExtensionsCached([entry], root);
+		assert.deepEqual(first.errors, []);
+		assert.equal(first.runtime.flagValues.get("release"), "first");
+		for (const version of ["second", "first"]) {
+			unlinkSync(selected);
+			symlinkSync(join(root, version), selected, "junction");
+			const result = await loadExtensionsCached([entry], root);
+			assert.deepEqual(result.errors, []);
+			assert.equal(result.runtime.flagValues.get("release"), version);
+			assert.equal(result.extensions[0]?.path, entry);
+			assert.equal(result.extensions[0]?.resolvedPath, join(root, version, "index.mjs"));
+			assert.equal(first.runtime.flagValues.get("release"), "first");
+		}
+	} finally {
+		clearExtensionCache();
+		rmSync(root, { recursive: true, force: true });
+	}
+});
