[Unit]
Description=Kenan preferred Opus quota fallback reconciliation
After=pi-stack-core.service
[Service]
User=kenan
Group=kenan
Environment=HOME=/home/kenan
EnvironmentFile=/etc/pi-stack/users/kenan/core.env
ExecStart=/usr/local/bin/bun /home/kenan/machine/ubuntu-apps/opus-capacity-fallback/reconcile.mjs
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
