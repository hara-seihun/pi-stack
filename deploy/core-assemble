#!/usr/bin/python3 -B
"""Assemble protected authority fragments and measured host bindings, never grant from a path."""
import copy
import hashlib
import json
import os
from pathlib import Path
import sys
sys.dont_write_bytecode = True
from core_namespace import absolute, publish


def read(path):
    path = absolute(str(path))
    metadata = path.lstat()
    if not path.is_file() or path.is_symlink() or metadata.st_uid != 0 or metadata.st_mode & 0o022:
        raise ValueError('protected root-owned assembly input required')
    return json.loads(path.read_text())


def unresolved(value, path='config'):
    found = []
    if isinstance(value, dict):
        if value.get('kind') == 'unresolved':
            found.append({'code': value.get('code', 'UNRESOLVED_FACT'), 'field': path})
        else:
            for key, child in value.items():
                found.extend(unresolved(child, path + '.' + key))
    elif isinstance(value, list):
        for index, child in enumerate(value):
            found.extend(unresolved(child, path + '[' + str(index) + ']'))
    return found


def merge_policy(base, extension):
    result = copy.deepcopy(base)
    for key in ('grants', 'consents'):
        indexed = {item['id']: item for item in result[key]}
        for item in extension[key]:
            if item['id'] in indexed and indexed[item['id']] != item:
                raise ValueError('authority fragment conflicts with an existing policy identity')
            indexed[item['id']] = item
        result[key] = list(indexed.values())
    result['revision'] = max(base['revision'], extension['revision'])
    return result


def related_callback(binding, scope, target):
    callback = binding['callbackGateway']
    evidence = binding.get('callbackEvidence')
    if callback['kind'] != 'shared-remote-callback' or evidence is None or evidence.get('kind') != 'original-related-thread-directory' or evidence.get('targetScopeId') != callback['targetScopeId'] or target['id'] != callback['targetScopeId']:
        raise ValueError('explicit original related-owner callback proof required')
    source = Path(evidence['sourcePath'])
    raw = source.read_bytes()
    if hashlib.sha256(raw).hexdigest() != evidence['sourceSha256'] or b'ThreadDirectory' not in raw:
        raise ValueError('original ThreadDirectory source proof changed')
    if scope['principalId'] != target['principalId'] or any(scope['resource'][key] != target['resource'][key] for key in ('owner','subjects','privacy')) or any(binding['custody'][key] != target['custody'][key] for key in ('uid','gid')) or callback['peerUid'] != target['custody']['uid']:
        raise ValueError('related callback crosses an original owner boundary')
    return copy.deepcopy(callback)


def gateway_overlay(original, overlay, scope_bindings, scopes):
    if overlay.get('version') != 1:
        raise ValueError('gateway overlay version required')
    result = overlay['gatewayBindings']
    indexed = {row['gatewayId']:row for row in result}
    if len(indexed) != len(result) or set(indexed) != {row['gatewayId'] for row in original}:
        raise ValueError('gateway overlay cannot create or remove adapters')
    for old in original:
        new = indexed[old['gatewayId']]
        if any(new.get(key) != value for key,value in old.items() if key not in ('scopeIds','routeCeiling')) or not set(old['scopeIds']).issubset(new['scopeIds']) or any(route not in new['routeCeiling'] for route in old['routeCeiling']):
            raise ValueError('gateway overlay cannot alter original ingress authority')
        related = [scope_id for scope_id in new['scopeIds'] if scope_id not in old['scopeIds']]
        for scope_id in related:
            binding = scope_bindings[scope_id]
            callback = related_callback(binding, scopes[scope_id], scopes[binding['callbackGateway']['targetScopeId']])
            if callback['targetScopeId'] not in old['scopeIds']:
                raise ValueError('related gateway target is not its original adapter')
        for route in new['routeCeiling']:
            if route in old['routeCeiling']:continue
            allowed = any(route['path'] in ('/v1/scopes/'+sid+'/projection','/v1/scopes/'+sid+'/events','/v1/scopes/'+sid+'/update') and route['kind']=='exact' or route['path']=='/v1/scopes/'+sid+'/thread-owner/' and route['kind']=='prefix' or route['path'].startswith('/v1/scopes/'+sid+'/thread-owner/') and route['kind']=='exact' for sid in related)
            if not allowed:raise ValueError('gateway overlay route escapes its proved related owner')
    return copy.deepcopy(result)


def memory_metadata(directory, resolved, output_path):
    fragments = directory / 'activation/final-schema'
    mapping = read(resolved / 'completed-mapping.json')
    folders = read(resolved / 'destination.resources.json')
    resources = {item['id']: item for item in folders}
    projected = read(directory / 'activation/core-config.projection.json')['config']['scopes']
    authority = {item['id']: item for item in read(fragments / 'scope-authority.json')['scopes']}
    root = read(fragments / 'root.fragment.json')
    memory = read(fragments / 'memory.fragment.json')
    policy = read(resolved / 'authority-projection.grants.json')
    owner_ids = {item['scopeId'] for item in root['consultationOwners']}
    eligible = sorted(item['id'] for item in projected if item['id'] in owner_ids and item['custody']['uid'] == memory['uid'] and item['availability']['kind'] == 'adopt' and authority[item['id']]['resource']['privacy'] == 'confidential')
    if not eligible:
        raise ValueError('no verified existing confidential memory custody scope with exact UID')
    custody_id = eligible[0]
    owners = []
    patch_by_id = {}
    for entry in mapping['entries']:
        plan = read(entry['planFile'])
        resource = plan['destination']['resource']
        if resource['id'] != entry['destinationResourceId'] or plan['destination']['path'] != entry['destination']:
            raise ValueError('completed memory mapping conflicts with its exact authorized plan')
        if resource['id'] in resources and resources[resource['id']] != resource:
            raise ValueError('completed memory destination descriptor changed')
        resources[resource['id']] = resource
        policy = merge_policy(policy, plan['policy'])
        # The exact original unavailable scope keeps its inert folder descriptor.
        scope_id = custody_id if entry['resourceOwner'] == resource['owner'] and entry['subject'].startswith('root:') else entry['custodyScopeId']
        owners.append({'subject': entry['subject'], 'custodyScopeId': scope_id, 'folder': entry['destination'], 'resource': resource})
        patch = patch_by_id.setdefault(scope_id, {'id': scope_id, 'resources': [], 'environment': {}})
        patch['resources'].append({'path': entry['destination'], 'kind': 'directory'})
        patch['environment']['PI_KENAN_MEMORY_FOLDER'] = entry['destination']
        if entry['subject'].startswith('root:'):
            for root_scope_id in owner_ids:
                root_patch = patch_by_id.setdefault(root_scope_id, {'id': root_scope_id, 'resources': [], 'environment': {}})
                root_patch['resources'].append({'path': entry['destination'], 'kind': 'directory'})
                root_patch['environment']['PI_KENAN_MEMORY_FOLDER'] = entry['destination']
    primary = patch_by_id.setdefault(custody_id, {'id': custody_id, 'resources': [], 'environment': {}})
    paths = [memory['databasePath'], memory['authFile']]
    if memory['roomAudience']['kind'] == 'registry':
        paths.append(memory['roomAudience']['databasePath'])
    for dataset in memory['datasets']:
        paths.append(dataset['databasePath'])
    for path in paths:
        primary['resources'].append({'path': path, 'kind': 'file'})
        primary['resources'].append({'path': str(Path(path).parent), 'kind': 'directory'})
    registry = {item['id']: item for item in memory['resources']}
    for resource in resources.values():
        if resource['id'] in registry and registry[resource['id']] != resource:
            raise ValueError('destination memory descriptor conflicts with original resource')
        registry[resource['id']] = resource
    principal = mapping['registeredMaintenancePrincipal']
    result = {'version': 1, 'principals': [principal], 'policy': policy, 'configPatch': {'custodyScopeId': custody_id, 'adoptionReceiptPath': str(directory / 'host-plans/receipts/memory-owner.json'), 'markdownOwners': owners, 'projectionMaintenancePrincipalId': principal['id'], 'resources': list(registry.values())}, 'scopePatches': list(patch_by_id.values()), 'evidence': {'sourcePhysicalOwner': mapping['sourcePhysicalOwner'], 'adoptionStage': 'preliminary-old-writer-attached', 'finalSnapshotRequired': True, 'adoptedCount': sum(bool(entry['adopted']) for entry in mapping['entries'])}}
    publish(output_path, result)
    return {'state': 'assembled-memory-metadata', 'ownerCount': len(owners), 'adoptedCount': result['evidence']['adoptedCount'], 'activationPermitted': False}


def assemble(directory, inputs_path, output_path):
    fragments = directory / 'activation/final-schema'
    inputs = read(inputs_path)
    if inputs.get('version') != 1:
        raise ValueError('explicit assembly input version required')
    initial = read(directory / 'activation/core-config.projection.json')['config']
    config = copy.deepcopy(initial)
    for key in ('host', 'port', 'statePath', 'releaseCommit'):
        config[key] = inputs[key]
    config['principals'] = read(fragments / 'principals.json')
    config['credentials'] = read(fragments / 'credentials.json')
    config['policy'] = read(fragments / 'policy.json')
    image_authority = fragments / 'images-duties-authority-e4b3609f'
    image_grants = read(image_authority / 'image-authority.grants.json')
    if image_grants.get('newAuthorityGranted') is not False or not isinstance(image_grants.get('grants'), list) or not isinstance(image_grants.get('consents'), list):
        raise ValueError('image authority must explicitly project original grants without new authority')
    config['policy'] = merge_policy(config['policy'], {'revision': config['policy']['revision'], 'grants': image_grants['grants'], 'consents': image_grants['consents']})
    declared_auxiliary = {row['id']: row for row in read(image_authority / 'per-scope.fragment.json')['scopes']}
    config.update(read(fragments / 'gateway.fragment.json'))
    config['callbacks'] = read(fragments / 'callbacks.fragment.json')
    config['broker'] = read(fragments / 'provider.fragment.json')
    config['broker']['freshListeners'] = []
    listeners = config['broker'].get('retainedListeners')
    if listeners and listeners.get('kind') == 'uid-bound':
        listeners['admissionDeltaPaths'] = []
    config['root'] = read(fragments / 'root.fragment.json')
    config['memory'] = read(fragments / 'memory.fragment.json')
    runtime = read(inputs['runtimePath'])
    bindings = read(inputs['scopeBindingsPath'])
    auxiliary = read(inputs['auxiliaryPath'])
    if bindings.get('version') != 1 or auxiliary.get('version') != 1:
        raise ValueError('measured scope and auxiliary metadata versions required')
    indexed = {entry['id']: entry for entry in bindings['scopes']}
    aux_scopes = {entry['id']: entry for entry in auxiliary['scopes']}
    authority = {entry['id']: entry for entry in read(fragments / 'scope-authority.json')['scopes']}
    callbacks = {entry['id']: entry['callbackGateway'] for entry in read(fragments / 'remote-bindings.json')['scopeCallbackPatches']}
    scopes = []
    for scope in config['scopes']:
        scope = copy.deepcopy(scope)
        policy_scope = authority.get(scope['id'])
        if policy_scope is not None:
            for key in ('principalId', 'resource', 'availability'):
                if key in policy_scope:
                    scope[key] = policy_scope[key]
        binding = indexed.get(scope['id'])
        if binding is None:
            raise ValueError('every adopted and unavailable scope needs an explicit host binding')
        for key in ('custody', 'storage', 'environment', 'resources'):
            scope[key] = copy.deepcopy(binding[key])
        declaration = declared_auxiliary.get(scope['id'])
        if declaration is None:
            raise ValueError('every scope requires its original auxiliary resource declaration')
        resources = {row['path']: row for row in scope['resources']}
        for row in declaration['resourceDeclarationsToMerge']:
            if row['path'] in resources and resources[row['path']] != row:
                raise ValueError('auxiliary resource conflicts with the registered path kind')
            resources[row['path']] = row
        scope['resources'] = list(resources.values())
        original_callback = callbacks.get(scope['id'], {'kind': 'none'})
        bound_callback = binding.get('callbackGateway')
        if bound_callback is not None:
            if original_callback['kind'] != 'none' and original_callback != bound_callback:
                raise ValueError('measured callback conflicts with original Remote callback owner')
            target = indexed.get(bound_callback.get('targetScopeId'))
            if bound_callback['kind'] == 'shared-remote-callback':
                if target is None:raise ValueError('related callback target lacks measured binding')
                target_scope = next(item for item in config['scopes'] if item['id'] == bound_callback['targetScopeId'])
                scope['callbackGateway'] = related_callback(binding, scope, {**target_scope, 'custody':target['custody']})
            elif bound_callback == original_callback:
                scope['callbackGateway'] = copy.deepcopy(bound_callback)
            else:raise ValueError('undeclared callback overlay')
        else:
            scope['callbackGateway'] = original_callback
        aux = aux_scopes.get(scope['id'])
        if aux is None:
            raise ValueError('every scope needs explicitly captured manager and notice ownership')
        scope['manager'] = aux['manager']
        scope['managerRouting'] = copy.deepcopy(aux['managerRouting'])
        if scope['managerRouting']['kind'] == 'configured':
            origin = scope['environment'].get('PI_REMOTE_SERVER_URL')
            if not isinstance(origin, str):raise ValueError('configured relay requires measured original Remote origin')
            scope['managerRouting']['relay']['callbackUrl'] = origin+'/v1/core/manager-relay'
        scopes.append(scope)
    config['scopes'] = scopes
    if 'gatewayBindingsPath' in inputs:
        config['gatewayBindings'] = gateway_overlay(config['gatewayBindings'], read(inputs['gatewayBindingsPath']), indexed, {scope['id']:scope for scope in scopes})
    config['images'] = auxiliary['images']
    config['duties'] = auxiliary['duties']
    if config['root']['kind'] == 'configured':
        owners = config['root']['consultationOwners']
        registered = {scope['id']: scope for scope in scopes}
        eligible = sorted({entry['scopeId'] for entry in owners if entry['scopeId'] in registered and registered[entry['scopeId']]['availability']['kind'] == 'adopt' and registered[entry['scopeId']]['resource']['privacy'] == 'confidential'})
        if not eligible:
            raise ValueError('no existing confidential registered root consultation owner')
        config['root']['consultationScopeId'] = eligible[0]
    if config['memory']['kind'] == 'configured':
        memory = read(inputs['memoryPath'])
        config['policy'] = merge_policy(config['policy'], memory['policy'])
        existing = {principal['id']: principal for principal in config['principals']}
        for principal in memory['principals']:
            if principal['id'] in existing and existing[principal['id']] != principal:
                raise ValueError('memory principal identity conflicts with authority')
            existing[principal['id']] = principal
        config['principals'] = list(existing.values())
        config['memory'].update(memory['configPatch'])
        extra = {scope['id']: scope for scope in memory['scopePatches']}
        for scope in scopes:
            if scope['id'] in extra:
                patch = extra[scope['id']]
                for key in ('resources', 'environment'):
                    if key in patch:
                        if key == 'resources':
                            unique = {json.dumps(item, sort_keys=True): item for item in scope[key] + patch[key]}
                            scope[key] = list(unique.values())
                        else:
                            scope[key].update(patch[key])
    if runtime.get('version') != 1 or runtime.get('uid') != 0 or runtime.get('gid') != 0:
        raise ValueError('prepared common runtime must retain exact root custodian')
    pending = unresolved(config)
    if pending:
        publish(output_path.with_suffix('.pending.json'), {'version': 1, 'state': 'incomplete', 'pending': pending})
        return {'state': 'incomplete', 'pendingCount': len(pending), 'writtenConfig': False}
    publish(output_path, config)
    return {'state': 'assembled', 'scopeCount': len(scopes), 'writtenConfig': True, 'activationPermitted': False}


if __name__ == '__main__':
    try:
        if os.geteuid() != 0:
            raise ValueError('root assembly owner required')
        if len(sys.argv) == 5 and sys.argv[1] == 'memory':
            value = memory_metadata(*(absolute(path) for path in sys.argv[2:]))
        elif len(sys.argv) == 4:
            value = assemble(*(absolute(path) for path in sys.argv[1:]))
        else:
            raise ValueError('usage: core-assemble [memory] MIGRATION_DIRECTORY INPUT_JSON_OR_RESOLVED_DIRECTORY OUTPUT_JSON')
        print(json.dumps({'ok': True, 'value': value}))
    except (OSError, KeyError, ValueError, TypeError) as error:
        print(json.dumps({'ok': False, 'error': {'code': 'core-assembly-unavailable', 'message': str(error)}}))
        sys.exit(75)
