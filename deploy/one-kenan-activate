#!/usr/bin/python3
"""Gracefully replace One Kenan executors; durable request intake stays open."""
import argparse
import fcntl
import http.client
import json
import os
import pathlib
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

UNITS = {'memory': 'pi-kenan-memory.service', 'root': 'pi-kenan-root.service', 'rooms': 'pi-rooms.service'}


class Deferred(Exception):
    pass


class Host:
    def __init__(self, config, expected):
        self.config, self.expected = config, expected
        self.deadline = time.monotonic() + 120

    def command(self, *args):
        return subprocess.check_output(args, text=True, timeout=min(5, max(.1, self.deadline-time.monotonic()))).strip()

    def health(self, role):
        return self.http(role, '/v1/health')[1]

    def http(self, role, path, method='GET', body=None):
        port = self.config.get(role+'Port', {'memory': 18820, 'root': 18821, 'rooms': 18822}[role])
        if not isinstance(port, int) or not 0 < port < 65536:
            raise RuntimeError('Invalid One Kenan listener port')
        headers = {}
        if path == '/v1/admin/release':
            token = pathlib.Path(self.config['rootAdminCapabilityFile']).read_text().strip()
            if not re.fullmatch('[0-9a-f]{64}', token):
                raise RuntimeError('Invalid root release capability')
            headers['x-pi-kenan-admin'] = token
        if body is not None:
            headers['content-type'] = 'application/json'
        request = urllib.request.Request(f'http://127.0.0.1:{port}{path}', method=method, headers=headers,
                                        data=None if body is None else json.dumps(body).encode())
        try:
            with urllib.request.urlopen(request, timeout=2) as response:
                return response.status, json.loads(response.read(16384))
        except urllib.error.HTTPError as error:
            try:
                return error.code, json.loads(error.read(16384))
            except (OSError, http.client.HTTPException, ValueError):
                return error.code, {}
        except (OSError, http.client.HTTPException, ValueError):
            return 0, {}

    def acquire_idle(self):
        deadline = min(self.deadline, time.monotonic() + 60)
        delay = .05
        while True:
            status, body = self.http('root', '/v1/admin/release', 'POST')
            if status != 409 or body != {'ok': False, 'error': 'busy'}:
                return status, body
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise Deferred('Protocol 1/2 Root did not reach natural idle during the bounded atomic acquisition window; intake and running work remain unchanged')
            time.sleep(min(delay, remaining))
            delay = min(.25, delay * 1.5)

    def wait_handoff(self, pid):
        while time.monotonic() < self.deadline:
            if self.command('systemctl', 'show', UNITS['root'], '-p', 'MainPID', '--value') != pid:
                raise Deferred('Root generation changed during dispatch drain; durable handoff needs reconciliation')
            health = self.health('root')
            if health.get('ok') is not True or health.get('releaseProtocol') != 3 or health.get('handoffTarget') != self.expected or health.get('dispatchPaused') is not True or type(health.get('handoffReady')) is not bool:
                raise Deferred('Root durable dispatch handoff is not positively owned by this release')
            if health.get('handoffReady') is True:
                return
            time.sleep(.1)
        raise Deferred('Root running executions are finishing naturally; dispatch remains durably paused and accepted requests stay queued for the next activation attempt')

    def ready(self, role, previous_pid=None):
        while time.monotonic() < self.deadline:
            health = self.health(role)
            replaced = previous_pid is None or self.command('systemctl', 'show', UNITS[role], '-p', 'MainPID', '--value') not in ('0', previous_pid)
            if replaced and health.get('ok') is True and health.get('releaseCommit') == self.expected:
                return health
            time.sleep(.1)
        raise Deferred(f'{UNITS[role]} has not activated {self.expected}; graceful replacement remains owned by systemd')

    def install_room_launcher(self):
        remote = self.config.get('remoteRoot', '/srv/pi/pi-remote')
        bun = self.config.get('bun', '/usr/local/bin/bun')
        if any(not os.path.isabs(p) or re.search(r'[\s%\\]', p) for p in [remote, bun]):
            raise RuntimeError('Invalid room launcher path')
        directory = pathlib.Path('/etc/systemd/system/pi-rooms.service.d')
        directory.mkdir(mode=0o755, exist_ok=True)
        dropin = directory/'release.conf'
        dropin.write_text(f'[Service]\nExecStart=\nExecStart={remote}/server/pi-remote-supervise {bun} {remote}/server/rooms-main.ts\nExecReload=\nExecReload=/bin/kill -HUP $MAINPID\n')
        dropin.chmod(0o644)
        migration = directory/'release-migration.conf'
        old_start = self.command('systemctl', 'show', UNITS['rooms'], '-p', 'ExecStart', '--value')
        previous_pid = None
        if 'pi-remote-supervise' not in old_start:
            previous_pid = self.command('systemctl', 'show', UNITS['rooms'], '-p', 'MainPID', '--value')
            migration.write_text('[Service]\nKillMode=process\n')
            migration.chmod(0o644)
        self.command('systemctl', 'daemon-reload')
        return migration, previous_pid

    def prepare(self, role):
        if role not in ('root', 'memory'):
            raise RuntimeError('Only Root and memory have executor drain declarations')
        selection = self.config.get('remoteRoot', '/srv/pi/pi-remote') if role == 'root' else self.config.get('runtimeRoot', '/srv/pi/runtime')
        if not os.path.isabs(selection) or (pathlib.Path(selection) / '.pi-stack-commit').read_text().strip() != self.expected:
            raise RuntimeError(f'{role} candidate source is not selected; accepting owner remains untouched')
        directory = pathlib.Path('/etc/systemd/system/' + UNITS[role] + '.d')
        directory.mkdir(mode=0o755, exist_ok=True)
        dropin = directory/'release.conf'
        dropin.write_text('[Service]\nTimeoutStopSec=infinity\n' + ('KillMode=mixed\n' if role == 'root' else ''))
        dropin.chmod(0o644)
        self.command('systemctl', 'daemon-reload')

    def finish_room_migration(self, migration):
        if migration.exists():
            migration.unlink()
            self.command('systemctl', 'daemon-reload')


def check(host):
    for role, unit in UNITS.items():
        if host.command('systemctl', 'show', unit, '-p', 'LoadState', '--value') != 'loaded':
            raise RuntimeError(f'Enabled One Kenan is missing {unit}')
    health = host.health('root')
    protocol = health.get('releaseProtocol')
    if health.get('ok') is not True or type(protocol) is not int or protocol not in (1, 2, 3):
        raise Deferred('The running Root executor has no recognized handoff protocol; it remains running')
    capabilities = health.get('releaseCapabilities')
    if protocol == 3 and (type(capabilities) is not list or 'durable-dispatch-handoff' not in capabilities):
        raise Deferred('Root protocol 3 has not declared the durable dispatch handoff capability')
    return protocol


def release_matches(host, role, running):
    if running == host.expected:
        return True
    source = pathlib.Path(__file__).resolve().parent.parent
    plan = pathlib.Path(os.environ.get('PI_STACK_HOST_PLAN', str(pathlib.Path(host.config.get('runtimeRoot', '/srv/pi/runtime')).parent / '.pi-stack-release-plan.json')))
    if not plan.is_file() or not (source / '.git').exists():
        return False
    value = json.loads(plan.read_text())
    if value.get('candidate') != host.expected:
        return False
    try:
        proof = host.command('node', str(source / 'deploy/host-plan.mjs'), 'verify-owner', str(source), str(plan), role, str(running))
    except subprocess.CalledProcessError as error:
        outcome = json.loads(error.output)
        if error.returncode == 66 and outcome.get('ok') is False and outcome.get('error', {}).get('code') == 'host-owner-source-stale':
            return False
        raise
    return json.loads(proof).get('ok') is True


def prove(host):
    result = {}
    for role, unit in UNITS.items():
        if host.command('systemctl', 'is-active', unit) != 'active':
            raise RuntimeError(f'{unit} is not active')
        health = host.health(role)
        if health.get('ok') is not True or not release_matches(host, role, health.get('releaseCommit')):
            raise RuntimeError(f'{unit} running source does not match {host.expected}')
        if role == 'root' and health.get('releaseProtocol') == 3 and (health.get('dispatchPaused') is not False or health.get('handoffTarget') is not None):
            raise RuntimeError('Root dispatch has not been explicitly resumed; selected source alone is not an activated executor')
        result[role] = {'unit': unit, 'releaseCommit': health['releaseCommit']}
    return {'enabled': True, 'consumers': result}


def activate_rooms(host):
    migration, previous_pid = host.install_room_launcher()
    if previous_pid is not None:
        host.command('systemctl', 'kill', '--kill-whom=main', '--signal=SIGUSR2', UNITS['rooms'])
        host.ready('rooms', previous_pid)
    elif not release_matches(host, 'rooms', host.health('rooms').get('releaseCommit')):
        host.command('systemctl', 'reload', '--no-block', UNITS['rooms'])
        host.ready('rooms')
    host.finish_room_migration(migration)
    health = host.health('rooms')
    if health.get('ok') is not True or not release_matches(host, 'rooms', health.get('releaseCommit')):
        raise RuntimeError('pi-rooms.service running source does not match the selected release')
    return {'enabled': True, 'consumers': {'rooms': {'unit': UNITS['rooms'], 'releaseCommit': health['releaseCommit']}}}


def release_request(host, protocol, method):
    if protocol == 3:
        return host.http('root', '/v1/admin/release', method, {'targetCommit': host.expected})
    return host.http('root', '/v1/admin/release', method)


def release_response(host, protocol, paused):
    result = {'ok': True, 'quiescing' if protocol == 1 else 'dispatchPaused': paused}
    if protocol == 3:
        result['targetCommit'] = host.expected
    return result


def pause(host, protocol):
    if protocol == 3:
        health = host.health('root')
        target = health.get('handoffTarget')
        request = {'targetCommit': host.expected}
        if target is not None and target != host.expected:
            if not isinstance(target, str) or not re.fullmatch('[0-9a-f]{40}', target) or health.get('dispatchPaused') is not True:
                raise Deferred('Root existing handoff ownership is invalid; dispatch remains unchanged')
            request['previousTarget'] = target
        status, body = host.http('root', '/v1/admin/release', 'POST', request)
    else:
        status, body = host.acquire_idle()
    if status != 200 or body != release_response(host, protocol, True):
        raise Deferred('Root handoff was not confirmed; no consumers restarted')


def resume_owned(host, protocol):
    for role in ('memory', 'root'):
        health = host.health(role)
        if host.command('systemctl', 'is-active', UNITS[role]) != 'active' or health.get('ok') is not True or not release_matches(host, role, health.get('releaseCommit')):
            raise Deferred('Root/memory replacement source ownership is not proven; dispatch resume remains pending')
    status, body = release_request(host, protocol, 'DELETE')
    if status != 200 or body != release_response(host, protocol, False):
        raise Deferred('Root dispatch resume was not confirmed')
    if protocol == 3:
        health = host.health('root')
        if health.get('dispatchPaused') is not False or health.get('handoffTarget') is not None or not release_matches(host, 'root', health.get('releaseCommit')):
            raise Deferred('Root accepting source and explicit dispatch resume have not been proven')


def activate(host):
    stale = [role for role in ('memory', 'root') if not release_matches(host, role, host.health(role).get('releaseCommit'))]
    if not stale:
        health = host.health('root')
        if health.get('releaseProtocol') == 3 and health.get('dispatchPaused') is True:
            protocol = check(host)
            pid = host.command('systemctl', 'show', UNITS['root'], '-p', 'MainPID', '--value')
            if health.get('handoffTarget') != host.expected:
                pause(host, protocol)
            host.wait_handoff(pid)
            resume_owned(host, protocol)
        activate_rooms(host)
        return prove(host)
    protocol = check(host)
    if protocol == 1 and 'root' not in stale:
        raise Deferred('Protocol 1 owner needs a prepared accepting Root replacement before memory activation')
    for role in stale:
        host.prepare(role)
    paused_pid = host.command('systemctl', 'show', UNITS['root'], '-p', 'MainPID', '--value')
    if not re.fullmatch(r'[1-9][0-9]*', paused_pid):
        raise Deferred('Root owner changed during preparation; intake remains unchanged')
    durable = protocol == 3
    try:
        pause(host, protocol)
        if host.command('systemctl', 'show', UNITS['root'], '-p', 'MainPID', '--value') != paused_pid:
            raise Deferred('Root generation changed after handoff; no consumers restarted')
        if protocol == 3:
            host.wait_handoff(paused_pid)
        if protocol == 1:
            host.command('systemctl', 'restart', '--no-block', UNITS['root'])
            host.ready('root', paused_pid)
            protocol = check(host)
            durable = durable or protocol == 3
            if protocol not in (2, 3):
                raise Deferred('Root replacement has not established accepting dispatch-only handoff')
            stale.remove('root')
            if 'memory' in stale:
                pause(host, protocol)
                if protocol == 3:
                    pid = host.command('systemctl', 'show', UNITS['root'], '-p', 'MainPID', '--value')
                    host.wait_handoff(pid)
        for role in stale:
            previous_pid = host.command('systemctl', 'show', UNITS[role], '-p', 'MainPID', '--value')
            host.command('systemctl', 'restart', '--no-block', UNITS[role])
            health = host.ready(role, previous_pid)
            if role == 'root':
                previous_protocol = protocol
                protocol = check(host)
                durable = durable or protocol == 3
                if previous_protocol == 3 and (protocol != 3 or health.get('dispatchPaused') is not True or health.get('handoffTarget') != host.expected):
                    raise Deferred('Root replacement lost its durable dispatch handoff; source ownership must be reconciled')
        resume_owned(host, protocol)
        activate_rooms(host)
        return prove(host)
    finally:
        # Protocol 3 retains its release-owned pause across deferred attempts and crashes.
        # Idle-only owners cannot persist it and must be explicitly reopened on failure.
        if not durable and protocol in (1, 2):
            status, body = release_request(host, protocol, 'DELETE')
            if status != 200 or body != release_response(host, protocol, False):
                raise Deferred('Root replacement is still settling; request receipts remain durable and dispatch resume must be reconciled')


def public_config(path):
    path = pathlib.Path(path)
    info = path.stat()
    if info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError('One Kenan configuration must be root-owned and not writable by other identities')
    return json.loads(path.read_text())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['check', 'activate', 'rooms', 'proof'])
    parser.add_argument('--host', required=True)
    parser.add_argument('--expected', required=True)
    parser.add_argument('--config', default='/etc/pi-stack/one-kenan.json')
    args = parser.parse_args()
    enabled = public_config(args.host).get('oneKenan')
    if enabled is False:
        print(json.dumps({'enabled': False}))
        return
    if enabled is not True:
        raise RuntimeError('Root product authority is not explicitly declared')
    if os.geteuid() != 0:
        raise RuntimeError('One Kenan activation/proof requires the host administrator')
    if os.stat('/proc/self/ns/mnt').st_ino != os.stat('/proc/1/ns/mnt').st_ino:
        raise RuntimeError('Run activation in PID 1 mount namespace with sudo nsenter -t 1 -m --')
    if not re.fullmatch('[0-9a-f]{40}', args.expected):
        raise RuntimeError('Expected release must be a full commit ID')
    with open('/run/pi-one-kenan-activation.lock', 'a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        host = Host(public_config(args.config), args.expected)
        if args.action == 'check':
            check(host)
        else:
            action = {'activate': activate, 'rooms': activate_rooms, 'proof': prove}[args.action]
            print(json.dumps(action(host)))


if __name__ == '__main__':
    try:
        main()
    except Deferred as error:
        print(str(error), file=sys.stderr)
        sys.exit(75)
    except (RuntimeError, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'One Kenan release failed: {error}', file=sys.stderr)
        sys.exit(1)
