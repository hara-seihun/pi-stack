#!/usr/bin/python3
"""Install read-only raw transport entrypoints, retaining explicit owner providers."""
import argparse
import json
import os
import pathlib
import shutil
import subprocess
import sys


class InstallationError(Exception):
    pass


def install(root, tools, run=subprocess.run):
    def path(value):
        return root / value.lstrip('/')

    guard = tools.rstrip('/') + '/raw-outbound-guard/main'
    if not path(guard).is_file():
        raise InstallationError('Selected tools release has no raw transport guard')
    config = path('/etc/pi-stack/raw-outbound-transports.json')
    providers = json.loads(config.read_text()) if config.exists() else {}
    if not isinstance(providers, dict) or any(name not in ('msmtp', 'signal-cli', 'sendmail') or not isinstance(value, str) or not pathlib.Path(value).is_absolute() for name, value in providers.items()):
        raise InstallationError('Invalid transport declaration')
    signal_original = None

    def link(target, source):
        source.parent.mkdir(parents=True, exist_ok=True)
        temporary = source.with_name(source.name + '.pi-action-new')
        temporary.unlink(missing_ok=True)
        temporary.symlink_to(target)
        temporary.replace(source)

    msmtp = path('/usr/bin/msmtp')
    retained_msmtp = '/usr/lib/pi-stack/providers/msmtp'
    if msmtp.exists() or path(retained_msmtp).exists():
        path(retained_msmtp).parent.mkdir(parents=True, exist_ok=True)
        registered = run(['dpkg-divert', '--listpackage', '/usr/bin/msmtp'], check=True,
                         capture_output=True, text=True).stdout.strip()
        if registered:
            diverted = run(['dpkg-divert', '--truename', '/usr/bin/msmtp'], check=True,
                           capture_output=True, text=True).stdout.strip()
            if registered != 'LOCAL' or diverted != retained_msmtp:
                raise InstallationError('msmtp diversion belongs to a different owner')
        else:
            run(['dpkg-divert', '--local', '--add', '--rename', '--divert', retained_msmtp,
                 '/usr/bin/msmtp'], check=True, capture_output=True, text=True)
        if not path(retained_msmtp).is_file():
            raise InstallationError('Diverted msmtp provider is missing')
        providers['msmtp'] = retained_msmtp

    signal = path('/usr/local/bin/signal-cli')
    if (signal.exists() or signal.is_symlink()) and not (signal.is_symlink() and os.readlink(signal) == guard):
        original = signal.resolve()
        if root != pathlib.Path('/'):
            # A staging-root fixture uses absolute host links without following them outside it.
            if signal.is_symlink():
                original = path(os.readlink(signal))
        if original.name != 'signal-cli' or original.parent.name != 'bin' or not original.is_file():
            raise InstallationError('Signal launcher is not the declared installed distribution')
        retained = original.with_name('signal-cli-provider')
        retained_name = '/' + str(retained.relative_to(root))
        if retained.exists():
            if providers.get('signal-cli') != retained_name:
                raise InstallationError('Unregistered retained Signal provider already exists')
        else:
            shutil.copy2(original, retained)
        providers['signal-cli'] = retained_name
        signal_original = original
    if 'signal-cli' in providers and not path(providers['signal-cli']).is_file():
        raise InstallationError('Declared Signal provider is missing')

    if path('/usr/sbin/sendmail').is_file():
        providers['sendmail'] = '/usr/sbin/sendmail'

    config.parent.mkdir(parents=True, exist_ok=True)
    temporary = config.with_suffix('.new')
    temporary.write_text(json.dumps(providers, sort_keys=True) + '\n')
    temporary.chmod(0o644)
    temporary.replace(config)
    if signal_original is not None:
        link(guard, signal_original)
    if 'msmtp' in providers:
        link(guard, msmtp)
    for name in providers:
        if name not in ('msmtp', 'signal-cli', 'sendmail'):
            raise InstallationError('Unknown declared transport')
        link(guard, path('/usr/local/bin/' + name))
    if 'sendmail' in providers:
        link(guard, path('/usr/local/sbin/sendmail'))
    return providers


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--tools', required=True, help='Selected immutable tools release path')
    args = parser.parse_args()
    if os.geteuid() != 0:
        print(json.dumps({'ok': False, 'error': 'administrator-required'}), file=sys.stderr)
        return 77
    try:
        providers = install(pathlib.Path('/'), args.tools)
    except (InstallationError, OSError, ValueError, subprocess.CalledProcessError) as error:
        print(json.dumps({'ok': False, 'error': 'transport-installation-failed',
                          'message': str(error)}), file=sys.stderr)
        return 1
    print(json.dumps({'ok': True, 'transports': sorted(providers)}))
    return 0


if __name__ == '__main__':
    sys.exit(main())
