#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
# Telephone credentials and the personal encrypted state are host-owned.
[[ $(systemctl show pi-stack-phone.service -p LoadState --value) == loaded ]] || exit 0
case ${1:---activate} in
  --check)
    pi_stack_as_root test -s /etc/pi-stack/phone.json
    pi_stack_as_root bun "$root/apps/remote/server/phone/config-check.ts" /etc/pi-stack/phone.json
    if systemctl is-active --quiet pi-stack-phone.service; then
      status=$(bun "$root/apps/remote/server/pi-call" status) || { echo 'Phone census unavailable' >&2; exit 75; }
      [[ $(jq -r '.activeCalls' <<<"$status") == 0 ]] || { echo 'Live telephone calls; defer deployment' >&2; exit 75; }
      [[ $(jq -r '[(.simGateways // [])[] | select(.callId != null)] | length' <<<"$status") == 0 ]] || { echo 'SIM modem hangup remains unconfirmed; defer deployment' >&2; exit 75; }
    fi
    ;;
  --activate)
    bindings=$(systemctl show pi-stack-phone.service -p BindsTo --value)
    supervisors=()
    for unit in $bindings; do
      [[ $unit == pi-remote@*.service ]] && supervisors+=("$unit")
    done
    [[ ${#supervisors[@]} == 1 ]] || { echo 'Phone unit must bind to exactly one personal supervisor' >&2; exit 66; }
    supervisor=${supervisors[0]}
    state=$(systemctl show "$supervisor" -p ActiveState --value)
    case $state in
      active)
        pi_stack_as_root systemctl reset-failed pi-stack-phone.service
        pi_stack_as_root systemctl restart pi-stack-phone.service
        systemctl is-active --quiet pi-stack-phone.service
        ;;
      inactive)
        pi_stack_as_root systemctl reset-failed pi-stack-phone.service
        pi_stack_as_root systemctl stop pi-stack-phone.service
        echo "Phone remains stopped with $supervisor"
        ;;
      failed)
        echo "Phone owner supervisor failed: $supervisor" >&2
        exit 66
        ;;
      activating|deactivating|reloading|refreshing)
        echo "Phone owner supervisor is transitioning: $supervisor ($state)" >&2
        exit 75
        ;;
      *) echo "Unknown phone owner supervisor state: $supervisor ($state)" >&2; exit 66 ;;
    esac
    ;;
  *) echo 'usage: deploy/phone [--check|--activate]' >&2; exit 64 ;;
esac
