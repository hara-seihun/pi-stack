#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
# Telephone credentials and the personal encrypted state are host-owned.
[[ $(systemctl show pi-stack-phone.service -p LoadState --value) == loaded ]] || exit 0
canonical=${PI_STACK_PHONE_CONFIG:-/etc/pi-stack/phone.json}
host_file=$(pi_stack_host_file)
revision=$(git -C "$root" rev-parse HEAD)
configuration() { pi_stack_as_root node "$root/deploy/phone-configuration.mjs" "$1" "$host_file" "$revision" "$canonical"; }
candidate=$(configuration inspect)
reset_phone_failure() {
  local phone_state
  phone_state=$(systemctl show pi-stack-phone.service -p ActiveState --value)
  case $phone_state in
    failed) pi_stack_as_root systemctl reset-failed pi-stack-phone.service ;;
    active|inactive) ;;
    activating|deactivating|reloading|refreshing)
      echo "Phone unit is transitioning: $phone_state" >&2
      return 75
      ;;
    *) echo "Unknown phone unit state: $phone_state" >&2; return 66 ;;
  esac
}
case ${1:---activate} in
  --check)
    pi_stack_as_root test -s "$candidate"
    pi_stack_as_root bun "$root/apps/remote/server/phone/config-check.ts" "$candidate"
    configuration prepare >/dev/null
    if systemctl is-active --quiet pi-stack-phone.service; then
      status=$(PI_STACK_PHONE_CONFIG="$canonical" bun "$root/apps/remote/server/pi-call" status) || { echo 'Phone census unavailable' >&2; exit 75; }
      [[ $(jq -r '.activeCalls' <<<"$status") == 0 ]] || { echo 'Live telephone calls; defer deployment' >&2; exit 75; }
    fi
    ;;
  --activate|--restore)
    bindings=$(systemctl show pi-stack-phone.service -p BindsTo --value)
    supervisors=()
    for unit in $bindings; do
      [[ $unit == pi-remote@*.service ]] && supervisors+=("$unit")
    done
    [[ ${#supervisors[@]} == 1 ]] || { echo 'Phone unit must bind to exactly one personal supervisor' >&2; exit 66; }
    supervisor=${supervisors[0]}
    state=$(systemctl show "$supervisor" -p ActiveState --value)
    case $state in
      active)
        reset_phone_failure
        if [[ ${1:---activate} == --restore ]]; then configuration restore >/dev/null;
        else configuration activate >/dev/null; fi
        if ! pi_stack_as_root systemctl restart pi-stack-phone.service || ! systemctl is-active --quiet pi-stack-phone.service; then
          configuration restore >/dev/null
          exit 1
        fi
        ;;
      inactive)
        [[ ${1:---activate} != --restore ]] || configuration restore >/dev/null
        reset_phone_failure
        pi_stack_as_root systemctl stop pi-stack-phone.service
        echo "Phone remains stopped with $supervisor"
        ;;
      failed)
        echo "Phone owner supervisor failed: $supervisor" >&2
        exit 66
        ;;
      activating|deactivating|reloading|refreshing)
        echo "Phone owner supervisor is transitioning: $supervisor ($state)" >&2
        exit 75
        ;;
      *) echo "Unknown phone owner supervisor state: $supervisor ($state)" >&2; exit 66 ;;
    esac
    ;;
  *) echo 'usage: deploy/phone [--check|--activate|--restore]' >&2; exit 64 ;;
esac
