#!/usr/bin/env python3
"""Resource-only kernel wait4 witness for a registered Remote supervisor's child."""
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
from core_namespace import absolute, publish, trusted


def plan_at(path):
    plan = trusted(absolute(str(path)))
    if plan.get('version') != 1 or not re.fullmatch(r'pi-remote@[a-z0-9_-]+\.service', plan.get('unit', '')) or not re.fullmatch(r'[a-f0-9]{32}', plan.get('invocationId', '')):
        raise ValueError('exact Remote unit invocation required')
    for key in ('wrapper', 'nativeChild'):
        value = plan[key]
        if type(value['pid']) is not int or value['pid'] < 1 or not re.fullmatch(r'[0-9]+', value['startTicks']):
            raise ValueError('exact wrapper and native child births required')
    if plan['wrapper']['pid'] == plan['nativeChild']['pid']:
        raise ValueError('distinct native child required')
    paths = [absolute(plan[key]) for key in ('readyPath', 'proofPath', 'tracePath')]
    if len(set(paths)) != 3 or len({p.parent for p in paths}) != 1:
        raise ValueError('distinct artifacts in one protected witness directory required')
    directory = paths[0].parent
    st = directory.lstat()
    if not directory.is_dir() or directory.is_symlink() or st.st_uid != 0 or st.st_mode & 0o077:
        raise ValueError('root-private witness directory required')
    source = absolute(plan['sourceProof']['path'])
    raw = source.read_bytes()
    if hashlib.sha256(raw).hexdigest() != plan['sourceProof']['sha256'] or b'kill -TERM "$child"' not in raw or b'((stopping)) && exit 0' not in raw:
        raise ValueError('exact original wrapper termination source required')
    digest = hashlib.sha256(json.dumps(plan, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    return plan, digest


def birth(identity):
    fields = Path(f"/proc/{identity['pid']}/stat").read_text().rsplit(')', 1)[1].split()
    if fields[19] != identity['startTicks']:
        raise ValueError('process birth changed')
    return fields


def tracer(pid):
    status = Path(f'/proc/{pid}/status').read_text()
    return int(next(line.split(':', 1)[1].strip() for line in status.splitlines() if line.startswith('TracerPid:')))


def verify_live(plan):
    birth(plan['wrapper'])
    if int(birth(plan['nativeChild'])[1]) != plan['wrapper']['pid']:
        raise ValueError('native child no longer belongs to this wrapper')
    if Path(os.readlink(f"/proc/{plan['nativeChild']['pid']}/exe")).name != 'bun':
        raise ValueError('registered native child must be Bun')
    result = subprocess.run(['systemctl', 'show', plan['unit'], '--property=MainPID,InvocationID,ActiveState'], capture_output=True, text=True, check=True, timeout=3)
    properties = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
    if properties != {'MainPID':str(plan['wrapper']['pid']), 'ActiveState':'active', 'InvocationID':plan['invocationId']}:
        raise ValueError('original unit invocation changed')


def wait4_exit(text, child_pid):
    records = []
    for line in text.splitlines():
        match = re.search(r'wait4\([^\n]*\{WIFEXITED\(s\) && WEXITSTATUS\(s\) == ([0-9]+)\}[^\n]*\)\s*=\s*([0-9]+)\s*$', line)
        if match and int(match[2]) == child_pid:
            records.append(int(match[1]))
        if re.search(r'wait4\([^\n]*WIFSIGNALED[^\n]*\)\s*=\s*' + str(child_pid) + r'\s*$', line):
            raise ValueError('native child exited by signal')
    if records != [0]:
        raise ValueError('one affirmative normal native child exit0 required')
    return {'kind':'normal', 'code':0}


def observer_unit(digest):
    return 'pi-core-witness-' + digest[:24] + '.service'


def status(path):
    plan, digest = plan_at(path)
    proof_path = absolute(plan['proofPath'])
    if proof_path.exists():
        proof = trusted(proof_path)
        if proof.get('planSha256') != digest:
            raise ValueError('another purpose owns this witness proof')
        if proof.get('state') != 'exited':
            return {'state':'unconfirmed', 'proofPath':str(proof_path)}
        raw = absolute(proof['trace']['path']).read_bytes()
        if hashlib.sha256(raw).hexdigest() != proof['trace']['sha256'] or wait4_exit(raw.decode(), plan['nativeChild']['pid']) != proof['exit']:
            raise ValueError('kernel native child witness changed')
        return {'state':'exited', 'proofPath':str(proof_path)}
    ready_path = absolute(plan['readyPath'])
    if not ready_path.exists():
        return {'state':'pending', 'observerUnit':observer_unit(digest)}
    ready = trusted(ready_path)
    if ready.get('planSha256') != digest:
        raise ValueError('another purpose owns witness readiness')
    verify_live(plan)
    if tracer(plan['wrapper']['pid']) != ready['tracerPid']:
        raise ValueError('kernel witness is not attached')
    return {'state':'attached', 'observerUnit':observer_unit(digest), 'tracerPid':ready['tracerPid']}


def observe(path):
    plan, digest = plan_at(path)
    verify_live(plan)
    if tracer(plan['wrapper']['pid']) != 0:
        raise ValueError('original wrapper already has another tracer')
    trace_path = absolute(plan['tracePath'])
    fd = os.open(trace_path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    os.close(fd)
    command = ['/usr/bin/strace', '-qq', '-e', 'trace=wait4', '-e', 'signal=none', '-o', str(trace_path), '-p', str(plan['wrapper']['pid'])]
    trace = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    try:
        deadline = time.monotonic() + 5
        while tracer(plan['wrapper']['pid']) != trace.pid:
            if trace.poll() is not None or time.monotonic() >= deadline:
                raise ValueError('kernel tracer did not affirmatively attach')
            time.sleep(0.01)
        verify_live(plan)
        publish(absolute(plan['readyPath']), {'version':1, 'protocol':'pi-core-native-child-witness-v1', 'state':'attached', 'planSha256':digest, 'tracerPid':trace.pid, 'unit':plan['unit'], 'invocationId':plan['invocationId'], 'wrapper':plan['wrapper'], 'nativeChild':plan['nativeChild']})
        _, stderr = trace.communicate()
        if trace.returncode != 0:
            raise ValueError('kernel observer exited without a completed trace')
        raw = trace_path.read_bytes()
        exit_state = wait4_exit(raw.decode(), plan['nativeChild']['pid'])
        publish(absolute(plan['proofPath']), {'version':1, 'protocol':'pi-core-native-child-exit-v1', 'state':'exited', 'unit':plan['unit'], 'invocationId':plan['invocationId'], 'wrapper':plan['wrapper'], 'nativeChild':plan['nativeChild'], 'exit':exit_state, 'planSha256':digest, 'sourceProof':plan['sourceProof'], 'trace':{'path':str(trace_path), 'sha256':hashlib.sha256(raw).hexdigest()}, 'observerUnit':observer_unit(digest)})
        return {'state':'exited', 'proofPath':plan['proofPath']}
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        publish(absolute(plan['proofPath']), {'version':1, 'protocol':'pi-core-native-child-exit-v1', 'state':'unconfirmed', 'planSha256':digest, 'error':str(error)})
        raise
    finally:
        if trace.poll() is None:
            trace.terminate()
            trace.wait(timeout=5)


def prepare(path):
    plan, digest = plan_at(path)
    if any(absolute(plan[key]).exists() for key in ('readyPath','proofPath','tracePath')):
        return status(path)
    verify_live(plan)
    command = ['/usr/bin/systemd-run', '--quiet', '--unit='+observer_unit(digest), '--property=Type=exec', '--property=TimeoutStopSec=infinity', '--property=Restart=no', '/usr/bin/python3', str(Path(__file__).resolve()), 'observe', str(path)]
    subprocess.run(command, check=True, capture_output=True, timeout=5)
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        result = status(path)
        if result['state'] != 'pending':
            return result
        time.sleep(0.02)
    return {'state':'pending', 'observerUnit':observer_unit(digest)}


if __name__ == '__main__':
    try:
        if os.geteuid() != 0 or len(sys.argv) != 3 or sys.argv[1] not in ('prepare','observe','status'):
            raise ValueError('usage: root core-remote-witness prepare|observe|status ROOT_PLAN')
        result = {'prepare':prepare,'observe':observe,'status':status}[sys.argv[1]](absolute(sys.argv[2]))
        print(json.dumps({'ok':True,'value':result}))
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(json.dumps({'ok':False,'error':{'code':'native-child-exit-unconfirmed','message':str(error)}}))
        sys.exit(75)
