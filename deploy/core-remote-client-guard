#!/usr/bin/python3 -B
"""Admit only the exact selected thin client while its original native owner is retained."""
import hashlib
import json
import os
from pathlib import Path
import stat
import sys
import urllib.request
sys.dont_write_bytecode = True


def protected(path, owner_uid):
    p = Path(path)
    s = p.lstat()
    if not isinstance(owner_uid, int) or isinstance(owner_uid, bool) or owner_uid < 0:
        raise ValueError('explicit source publisher UID required')
    if not p.is_absolute() or p.resolve() != p or not stat.S_ISREG(s.st_mode) or s.st_uid != owner_uid or s.st_mode & 0o022:
        raise ValueError('protected canonical root file required')
    return p


def admit(path):
    plan = json.loads(protected(path, 0).read_bytes())
    if plan.get('version') != 1 or plan.get('protocol') != 'pi-core-thin-client-admission-v1' or plan.get('state') != 'selected':
        raise ValueError('explicit selected thin-client admission required')
    release, remote_release = plan['releaseCommit'], plan['remoteReleaseCommit']
    for commit in (release, remote_release):
        if not isinstance(commit, str) or len(commit) != 40 or any(c not in '0123456789abcdef' for c in commit):
            raise ValueError('exact immutable core and client releases required')
    remote = Path('/srv/pi/.pi-stack-releases/remote') / remote_release
    if Path('/srv/pi/pi-remote').resolve() != remote or (remote / '.pi-stack-commit').read_text().strip() != remote_release:
        raise ValueError('selected Remote differs from admitted thin client')
    source_owner = plan['sourceOwnerUid']
    for name in ('main.ts', 'server.ts', 'core-client.ts'):
        source = protected(remote / 'server' / name, source_owner)
        if hashlib.sha256(source.read_bytes()).hexdigest() != plan['sourceSha256'][name]:
            raise ValueError('thin-client source identity changed')
    source = (remote / 'server/server.ts').read_text()
    if 'new CoreClient(' not in source or 'createThreadService(' in source:
        raise ValueError('selected Remote does not have the declared external core owner')
    config = json.loads(protected('/etc/pi-stack/core.json', 0).read_bytes())
    scope = next(s for s in config['scopes'] if s['id'] == plan['scopeId'])
    if config['releaseCommit'] != release or scope['custody']['uid'] != plan['uid'] or scope['custody']['dataDir'] != plan['dataDir'] or scope['availability']['kind'] != 'adopt':
        raise ValueError('client custody differs from the adopted scope')
    if config['host'] not in ('127.0.0.1', '::1'):
        raise ValueError('owning core must be loopback')
    host = '[::1]' if config['host'] == '::1' else config['host']
    with urllib.request.urlopen(f"http://{host}:{config['port']}/v1/health", timeout=3) as response:
        health = json.load(response)
    if health.get('ok') is not True or health.get('service') != 'pi-stack-core' or health.get('releaseCommit') != release or health.get('scopeCount') != len(config['scopes']):
        raise ValueError('selected core is not healthy')
    return {'protocol': plan['protocol'], 'scopeId': scope['id'], 'releaseCommit': release, 'remoteReleaseCommit': remote_release, 'nativeOwnerPreserved': True}


if __name__ == '__main__':
    try:
        if os.geteuid() != 0 or len(sys.argv) != 2:
            raise ValueError('usage: root core-remote-client-guard ROOT_ADMISSION_PLAN')
        print(json.dumps({'ok': True, 'value': admit(sys.argv[1])}))
    except (OSError, ValueError, KeyError, TypeError, StopIteration) as error:
        print(json.dumps({'ok': False, 'error': {'code': 'thin-client-admission-unavailable', 'message': str(error)}}))
        sys.exit(75)
