#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
mode=install
if [[ ${1:-} == --check || ${1:-} == --paths ]]; then mode=${1#--}; shift; fi
[[ $# == 1 ]] || { echo 'usage: deploy/write-rewrite-runtime [--check|--paths] STORE' >&2; exit 64; }
args=("$1" --mode "$mode")
# Seed artifacts live outside engine retention: an unrelated release may prune
# prepared-but-unselected component entries before this source is published.
args+=(--cache "${PI_STACK_WRITE_REWRITE_CACHE:-$(dirname "$1")/write-rewrite-cache}")
# Installation runs as root, leaving no private cache/home dependency for DynamicUser.
if [[ $mode == install ]]; then
  pi_stack_as_root python3 "$root/apps/write/rewrite-runtime/install.py" "${args[@]}"
else
  python3 "$root/apps/write/rewrite-runtime/install.py" "${args[@]}"
fi
