#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"

role=${1:-}
[[ $role == converge ]] || { echo "usage: deploy/host converge" >&2; exit 64; }

controller_systemctl() {
  XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)} systemctl --user "$@"
}

runner_contract_hash() {
  sha256sum "$1" "$2" | cut -d' ' -f1 | sha256sum | cut -d' ' -f1
}

pi_stack_prepare_dependencies "$root"
expected=$(git -C "$root" rev-parse HEAD)
orchestrator_dest=${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}
previous_orchestrator=""
previous_runner_contract_hash=""
if [[ -f $orchestrator_dest/.pi-stack-commit ]]; then
  previous_orchestrator=$(<"$orchestrator_dest/.pi-stack-commit")
fi
if [[ -f $orchestrator_dest/src/host/supervisor.ts && -f $orchestrator_dest/src/ledger/ledger.ts ]]; then
  previous_runner_contract_hash=$(runner_contract_hash \
    "$orchestrator_dest/src/host/supervisor.ts" "$orchestrator_dest/src/ledger/ledger.ts")
fi
remote_dest=${PI_STACK_REMOTE_DEST:-/srv/pi/pi-remote}
previous_remote=""
if [[ -f $remote_dest/.pi-stack-commit ]]; then
  previous_remote=$(<"$remote_dest/.pi-stack-commit")
fi
ledger=${PI_ORCHESTRATOR_LEDGER:-$HOME/.local/share/pi-orchestrator/ledger.sqlite3}
runner_service=${PI_ORCHESTRATOR_RUNNER_SERVICE:-pi-orchestrator-runner.service}
controller_service=${PI_ORCHESTRATOR_CONTROLLER_SERVICE:-pi-orchestrator.service}
voice_service=${PI_ORCHESTRATOR_VOICE_SERVICE:-pi-orchestrator-voice.service}
if [[ ! -v PI_ORCHESTRATOR_TASK_MANIFEST ]]; then
  controller_config=${PI_ORCHESTRATOR_CONFIG:-$HOME/.config/pi-orchestrator/config.json}
  if [[ -f $controller_config ]]; then
    PI_ORCHESTRATOR_TASK_MANIFEST=$(node - "$controller_config" <<'JS'
const { readFileSync } = require("node:fs");
const { dirname, isAbsolute, resolve } = require("node:path");

const configPath = process.argv[2];
const manifest = JSON.parse(readFileSync(configPath, "utf8")).taskManifest;
if (typeof manifest === "string" && manifest.length > 0) {
  process.stdout.write(isAbsolute(manifest) ? manifest : resolve(dirname(configPath), manifest));
}
JS
)
    export PI_ORCHESTRATOR_TASK_MANIFEST
  fi
fi
source_runner_contract_hash=$(runner_contract_hash \
  "$root/packages/orchestrator/src/host/supervisor.ts" \
  "$root/packages/orchestrator/src/ledger/ledger.ts")
runner_contract_changed=0
services_stopped=0
restore_services() {
  if (( services_stopped )); then
    set +e
    pi_stack_as_root systemctl start "$runner_service"
    controller_systemctl start "$controller_service"
  fi
}
# An artifact without a readable contract hash (predating content comparison,
# or after a layout change) must be treated as a contract change: on 2026-08-29
# the empty-hash case took the drain path across a ledger migration and left
# old workers writing to dropped columns.
if [[ -n $previous_orchestrator && $previous_orchestrator != "$expected" &&
      $previous_runner_contract_hash != "$source_runner_contract_hash" ]]; then
  runner_contract_changed=1
  services_stopped=1
  trap restore_services EXIT
  controller_systemctl stop "$controller_service"
  pi_stack_as_root systemctl stop "$runner_service"
fi
"$root/deploy/runtime"
"$root/deploy/orchestrator"
"$root/deploy/remote"
"$root/deploy/tools" converge
"$root/deploy/skills" converge-user
"$root/deploy/settings" converge-user

for artifact in \
  "${PI_STACK_RUNTIME_ROOT:-$HOME/.local/share/pi-runtime}" \
  "${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}" \
  "${PI_STACK_REMOTE_DEST:-/srv/pi/pi-remote}" \
  "${PI_STACK_SKILLS_DEST:-/srv/pi/skills}" \
  "${PI_STACK_TOOLS_DEST:-/srv/pi/tools}"; do
  [[ -f $artifact/.pi-stack-commit && $(<"$artifact/.pi-stack-commit") == "$expected" ]] || {
    echo "$artifact does not carry Pi stack $expected" >&2
    exit 1
  }
done

if (( runner_contract_changed )); then
  pi_stack_as_root systemctl start "$runner_service"
  controller_systemctl start "$controller_service"
  services_stopped=0
  trap - EXIT
  printf 'restarted %s and %s to activate changed runner storage or supervisor code\n' \
    "$runner_service" "$controller_service"
elif [[ -n $previous_orchestrator && $previous_orchestrator != "$expected" && -f $ledger ]]; then
  PI_ORCHESTRATOR_LEDGER="$ledger" node "$orchestrator_dest/dist/cli.js" drain-runners
fi
if [[ -n $previous_orchestrator && $previous_orchestrator != "$expected" ]] &&
   pi_stack_as_root systemctl is-active --quiet "$voice_service"; then
  pi_stack_as_root systemctl restart "$voice_service"
fi
remote_service=${PI_REMOTE_SERVICE:-pi-remote.service}
if [[ $previous_remote != "$expected" ]] && systemctl is-active --quiet "$remote_service"; then
  PI_REMOTE_SERVICE=$remote_service "$root/apps/remote/activate"
fi
printf 'deployed and activated Pi stack %s for Converge\n' "$expected"
