#!/usr/bin/env bash
# Deploy the checked-out Pi stack commit to this machine.
#
#   deploy/host [HOST_FILE]     defaults to /etc/pi-stack/host.json
#
# The host file names the account that runs the fleet daemon and any packages
# and skills this machine adds for every person. Persons come from Pi Remote's
# registry under /var/lib/pi-remote/persons. Everything else is the same on
# every host: one runtime under /srv/pi, one orchestrator, one Pi Remote, the
# tools, the skills, and each account's Pi settings and command links.
set -euo pipefail

control=$(cd "$(dirname "$0")/.." && pwd)
root=$control
source "$control/deploy/lib"
# Host phases below own independent deadlines; child deployment scripts inherit custody.
export PI_STACK_DEPLOY_DEADLINE_ACTIVE=1
pi_stack_enter_deployment "$0" "$root" "$@"
export PI_STACK_HOST_FILE=${1:-$(pi_stack_host_file)}
[[ -f $PI_STACK_HOST_FILE ]] || { echo "usage: deploy/host [HOST_FILE]; $PI_STACK_HOST_FILE does not exist" >&2; exit 64; }
jq -e '.version == 1' "$PI_STACK_HOST_FILE" >/dev/null || { echo "$PI_STACK_HOST_FILE must declare version 1" >&2; exit 64; }

# Rehearsals never touch host services or require their credentials.
services=1
if [[ -n ${PI_STACK_REMOTE_DEST:-}${PI_STACK_ORCHESTRATOR_DEST:-}${PI_STACK_RUNTIME_DEST:-} && ${PI_STACK_SERVICES:-0} != 1 ]]; then
  services=0
fi
if (( services )) && [[ -z ${PI_STACK_HOST_PHASE:-} ]]; then
  pi_stack_check_person_configs
  "$root/deploy/voice" --check
  "$root/deploy/phone" --check
fi
# Independent meeting runtimes keep rooms and media across supervisor activation.
# The initial upgrade still protects rooms owned by an earlier in-process supervisor.
# A candidate without the lifetime contract cannot remove it under a live meeting.
meeting_mode=--all
if [[ -f $root/apps/remote/meeting-runtime.json ]]; then
  jq -e '.protocol == "meet-runtime-v1" and .lifetime == "person-service"' "$root/apps/remote/meeting-runtime.json" >/dev/null || {
    echo 'invalid meeting runtime contract' >&2; exit 64;
  }
  meeting_mode=--restart-blockers
fi
if (( services )) && [[ ${PI_STACK_ALLOW_LIVE_MEETING_RESTART:-0} != 1 ]]; then
  if ! live_rooms=$(pi_stack_live_meeting_rooms "$meeting_mode"); then
    echo "meeting census unavailable on this host: see the census error above" >&2
    exit 75
  fi
  if [[ -n $live_rooms ]]; then
    echo "live meeting rooms on this host ($live_rooms); deploying now would end them" >&2
    exit 75
  fi
fi
# The host declares which native selected sources this Pi Stack commit depends on.
# Check after the meeting census and before any build or service change.
if (( services )); then
  candidate=$(git -C "$root" rev-parse HEAD)
  "$root/deploy/native-prerequisites" "$PI_STACK_HOST_FILE" "$root" "$candidate"
fi
recognition=0
if (( services )) && "$root/deploy/meet-recognition-service" --check 2>/dev/null; then recognition=1; fi

fleet=$(pi_stack_fleet_user)
mapfile -t users < <(pi_stack_users)
(( ${#users[@]} > 0 )) || { echo "no Pi accounts: set fleetUser in $PI_STACK_HOST_FILE or add a person with pi-remote person add" >&2; exit 64; }
if (( services )); then
  daemon_units=$(pi_stack_daemon_units "${users[@]}") || { echo 'could not discover Orchestrator daemon units' >&2; exit 1; }
  daemons=()
  if [[ -n $daemon_units ]]; then mapfile -t daemons <<< "$daemon_units"; fi
fi

recognition_base=${PI_STACK_MEET_RECOGNITION_DEST:-/srv/pi/meet-recognition}
previous_recognition=""
if (( recognition )) && [[ -e $recognition_base || -L $recognition_base ]]; then
  [[ -L $recognition_base ]] || { echo 'Meet recognition selection is not a managed symlink; adopt it before replacement' >&2; exit 66; }
  previous_recognition=$(readlink -e "$recognition_base") || { echo 'Meet recognition selection is dangling or recursive' >&2; exit 66; }
  [[ $previous_recognition != $(realpath -sm "$recognition_base") ]] || { echo 'Meet recognition selection points to itself' >&2; exit 66; }
fi
recognition_was_active=0
recognition_was_enabled=0
recognition_started=0
recognition_pid=""
old_write_loaded=not-found
old_write_active=inactive
old_write_enabled=disabled
recognition_transition=${PI_STACK_RECOGNITION_TRANSITION_FILE:-$(dirname "$recognition_base")/.pi-meet-recognition/host-transition.json}
recognition_journal_owner=0
if (( recognition )); then
  systemctl is-active --quiet pi-stack-meet-recognition.service && recognition_was_active=1
  systemctl is-enabled --quiet pi-stack-meet-recognition.service && recognition_was_enabled=1
  old_write_loaded=$(systemctl show pi-stack-write.service -p LoadState --value)
  case $old_write_loaded in
    not-found) ;;
    loaded)
      old_write_active=$(systemctl show pi-stack-write.service -p ActiveState --value)
      old_write_enabled=$(systemctl show pi-stack-write.service -p UnitFileState --value)
      case $old_write_active in active|inactive) ;; *) echo 'Previous speech unit has an unsettled lifecycle' >&2; exit 75;; esac
      case $old_write_enabled in enabled|disabled|static) ;; *) echo 'Previous speech unit has unknown enablement' >&2; exit 66;; esac
      ;;
    *) echo 'Previous speech unit declaration state is unknown' >&2; exit 66;;
  esac
fi
recognition_journal() {
  pi_stack_as_root python3 - "$recognition_transition" "$1" "$(git -C "$root" rev-parse HEAD)" "$previous_recognition" "$recognition_was_active" "$recognition_was_enabled" "$old_write_loaded" "$old_write_active" "$old_write_enabled" <<'PY'
import json, os, sys, tempfile
from pathlib import Path
path, phase, commit, previous, active, enabled, old_loaded, old_active, old_enabled = sys.argv[1:]
path = Path(path)
path.parent.mkdir(parents=True, exist_ok=True)
if phase == 'pending' and path.is_file():
    record = json.loads(path.read_text())
    if record['version'] != 1 or record['phase'] not in ('accepted', 'rolled_back'):
        raise SystemExit('Unresolved speech host transition; reconcile its saved assets/lifecycle before another release')
record = {'version': 1, 'phase': phase, 'commit': commit, 'previousRecognition': previous,
          'recognitionWasActive': active == '1', 'recognitionWasEnabled': enabled == '1',
          'oldWrite': {'loaded': old_loaded, 'active': old_active, 'enabled': old_enabled,
                       'selection': str(Path('/srv/pi/write-engine').resolve())}}
fd, temporary = tempfile.mkstemp(prefix='.speech-transition-', dir=path.parent)
with os.fdopen(fd, 'w') as stream:
    os.fchmod(stream.fileno(), 0o600)
    json.dump(record, stream)
    stream.flush()
    os.fsync(stream.fileno())
os.replace(temporary, path)
fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
os.fsync(fd)
os.close(fd)
PY
}
if (( recognition )) && [[ -z ${PI_STACK_HOST_PHASE:-} ]]; then
  recognition_journal pending
  recognition_journal_owner=1
fi
restore_recognition() {
  local status=$? candidate="$recognition_base.rollback.$$" restore_failed=0
  trap - EXIT TERM INT HUP
  if (( status != 0 && recognition_started )); then
    if [[ -n $recognition_pid ]]; then
      kill "$recognition_pid" 2>/dev/null || true
      wait "$recognition_pid" 2>/dev/null || true
    fi
    echo 'release failed; restoring previous Meet recognition selection and service state' >&2
    if [[ -n $previous_recognition && $previous_recognition != $(realpath -sm "$recognition_base") && -d $previous_recognition ]]; then
      pi_stack_as_root ln -s "$previous_recognition" "$candidate" &&
        pi_stack_as_root mv -Tf "$candidate" "$recognition_base" || { echo 'Meet recognition selection rollback failed' >&2; restore_failed=1; }
    else
      pi_stack_as_root rm -f "$recognition_base" || restore_failed=1
    fi
    if (( recognition_was_active )); then
      pi_stack_as_root systemctl reset-failed pi-stack-meet-recognition.service || true
      pi_stack_as_root systemctl restart pi-stack-meet-recognition.service || { echo 'Meet recognition rollback restart failed' >&2; restore_failed=1; }
    else
      # The old same-port listener cannot resume until candidate shutdown completes.
      pi_stack_as_root systemctl stop pi-stack-meet-recognition.service || { echo 'Meet recognition rollback stop failed' >&2; restore_failed=1; }
    fi
    (( recognition_was_enabled )) || pi_stack_as_root systemctl disable pi-stack-meet-recognition.service || restore_failed=1
    if [[ $old_write_loaded == loaded ]]; then
      case $old_write_enabled in
        enabled) pi_stack_as_root systemctl enable pi-stack-write.service || restore_failed=1 ;;
        disabled) pi_stack_as_root systemctl disable pi-stack-write.service || restore_failed=1 ;;
        static) ;;
      esac
      if [[ $old_write_active == active ]]; then
        if (( restore_failed == 0 )); then
          pi_stack_as_root systemctl start pi-stack-write.service || { echo 'Previous speech service rollback failed' >&2; restore_failed=1; }
        fi
      fi
    fi
    pi_stack_as_root rm -f "$candidate"
  fi
  if (( recognition_journal_owner )); then
    if (( status == 0 )); then recognition_journal accepted || status=1
    elif (( restore_failed )); then recognition_journal rollback_failed || status=1
    else recognition_journal rolled_back || status=1; fi
  fi
  # Join bounded proof jobs before releasing deployment custody.
  if [[ -n ${doctor_pid:-} ]]; then
    wait "$doctor_pid" || true
  fi
  exit "$status"
}
trap restore_recognition EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP

if [[ -z ${PI_STACK_HOST_PHASE:-} ]]; then
  # Nothing that compiles, downloads or tests belongs after old listeners close.
  "$root/deploy/prepare"
  export PI_STACK_RELEASES_ROOT=$(pi_stack_component_releases_root)
  if (( services )); then
    if jq -e '.oneKenan == true' "$PI_STACK_HOST_FILE" >/dev/null; then
      pi_stack_as_root python3 "$root/deploy/one-kenan-activate" check --host "$PI_STACK_HOST_FILE" --expected "$candidate" || exit $?
    fi
    "$root/deploy/native-history-boundary" "$PI_STACK_HOST_FILE" "$root" "$candidate"
  fi
  remote=${PI_STACK_REMOTE_DEST:-/srv/pi/pi-remote}
  export PI_STACK_PREVIOUS_REMOTE=$(cat "$remote/.pi-stack-commit" 2>/dev/null || true)
  export PI_STACK_PREVIOUS_REMOTE_RELEASE=$(readlink -f "$remote" || true)
  export PI_REMOTE_PERSONS_DIR=$(pi_stack_persons_dir)
  export PI_STACK_HOST_PLAN=${PI_STACK_HOST_PLAN:-$(dirname "${PI_STACK_RUNTIME_DEST:-/srv/pi/runtime}")/.pi-stack-release-plan.json}
  pi_stack_as_root node "$root/deploy/host-plan.mjs" create "$root" "$(git -C "$root" rev-parse HEAD)" "$PI_STACK_PREVIOUS_REMOTE" "$PI_STACK_HOST_PLAN" "$PI_STACK_HOST_FILE"
  phase() {
    local name=$1 seconds=$2; shift 2
    echo "release phase=$name started deadline=${seconds}s"
    local status=0
    timeout --signal=TERM --kill-after=5s "${seconds}s" "$@" || status=$?
    echo "release phase=$name completed status=$status"
    return "$status"
  }
  (( ! recognition )) || recognition_started=1
  phase publication 50 env PI_STACK_HOST_PHASE=publication "$0" "$@"
  if (( services )); then
    phase capacity-ready 10 bash -c 'source "$1/deploy/lib"; shift; pi_stack_run_as "$@"' -- "$control" "${fleet:-${users[0]}}" node "$control/deploy/capacity-ready.mjs" "${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}/dist/agent-capacity.js"
    (
      phase browser-doctor 120 "$control/deploy/runtime-doctors" browser "$root" "${fleet:-${users[0]}}" "$control" &
      browser_doctor_pid=$!
      phase model-doctor 30 "$control/deploy/runtime-doctors" model "$root" "${fleet:-${users[0]}}" "$control" &
      model_doctor_pid=$!
      failed=0
      wait "$browser_doctor_pid" || failed=1
      wait "$model_doctor_pid" || failed=1
      exit "$failed"
    ) &
    doctor_pid=$!
    activation_status=0; doctor_failed=0
    # Supervisors own a 90-second start and 10-second stop budget. Activation
    # overlaps the doctors; the shared generation wait must include both plus
    # the front door's 20-second readiness budget.
    phase activation 120 env PI_STACK_HOST_PHASE=activation "$0" "$@" || activation_status=$?
    wait "$doctor_pid" || doctor_failed=1
    if (( doctor_failed )); then
      echo 'runtime doctor failed' >&2
      if (( activation_status == 0 )); then
        phase rollback 120 env PI_STACK_HOST_PHASE=activation PI_STACK_FORCE_ROLLBACK=1 "$0" "$@" || true
      fi
      exit 1
    fi
    (( activation_status == 0 )) || exit "$activation_status"
  fi
  pi_stack_as_root node --input-type=module - "$PI_STACK_HOST_PLAN" <<'JS'
import { readFileSync, writeFileSync, renameSync, chmodSync } from 'node:fs';
const path = process.argv[2];
const plan = JSON.parse(readFileSync(path, 'utf8'));
const temporary = `${path}.${process.pid}.tmp`;
writeFileSync(temporary, JSON.stringify({ ...plan, state: 'accepted' }) + '\n', { mode: 0o644 });
chmodSync(temporary, 0o644);
renameSync(temporary, path);
JS
  echo "deployed Pi stack $(git -C "$root" rev-parse HEAD) for ${users[*]}"
  exit 0
fi
expected=$(git -C "$root" rev-parse HEAD)
runtime=${PI_STACK_RUNTIME_DEST:-/srv/pi/runtime}
orchestrator=${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}
remote=${PI_STACK_REMOTE_DEST:-/srv/pi/pi-remote}
skills=${PI_STACK_SKILLS_DEST:-/srv/pi/skills}
tools=${PI_STACK_TOOLS_DEST:-/srv/pi/tools}
previous_remote=${PI_STACK_PREVIOUS_REMOTE:-}
previous_remote_release=${PI_STACK_PREVIOUS_REMOTE_RELEASE:-}
if [[ $PI_STACK_HOST_PHASE == publication ]]; then
export PI_STACK_RELEASES_ROOT=$(pi_stack_component_releases_root)
pi_stack_as_root node "$root/deploy/prepared-components.mjs" "$PI_STACK_RELEASES_ROOT" "$expected" verify
"$root/deploy/runtime" --activate-prepared
for component in orchestrator remote tools; do
  case $component in
    orchestrator) destination=$orchestrator ;;
    remote) destination=$remote ;;
    tools) destination=$tools ;;
  esac
  pi_stack_select_release "$PI_STACK_RELEASES_ROOT/$component/$expected" "$destination" "$expected"
done
"$root/deploy/orchestrator" --links-only
if (( services )) && [[ ${PI_STACK_DEPLOY_NO_SUDO:-0} != 1 ]]; then
  [[ $remote =~ ^/[a-zA-Z0-9_./-]+$ ]] || { echo 'invalid selected Remote path for router web assets' >&2; exit 64; }
  pi_stack_as_root bash -s -- "$remote" <<'ROOT'
set -euo pipefail
path=/etc/systemd/system/pi-remote-router.service.d/40-web-release.conf
value=$(printf '[Service]\nEnvironment=PI_REMOTE_WEB_ROOT=%s/web/dist\n' "$1")
if [[ ! -f $path || $(<"$path") != "$value" ]]; then
  install -d -m755 "$(dirname "$path")"
  printf '%s\n' "$value" > "$path.tmp"
  chmod 644 "$path.tmp"
  mv -T "$path.tmp" "$path"
  systemctl daemon-reload
fi
ROOT
fi
if (( recognition )); then
  recognition_started=1
  "$root/deploy/meet-recognition" --select
else
  echo 'Meet recognition: no host service declaration; skipping local ASR' >&2
fi
if (( services )) && [[ ${PI_STACK_DEPLOY_NO_SUDO:-0} != 1 ]]; then
  timezone_users=()
  for user in "${users[@]}"; do timezone_users+=(--user "$user"); done
  pi_stack_as_root python3 "$root/apps/remote/server/pi-timezone-provision" --configure "${timezone_users[@]}"
  if jq -e '.oneKenan == true' "$PI_STACK_HOST_FILE" >/dev/null; then
    pi_stack_as_root install -m755 "$root/deploy/one-kenan-runtime" /usr/local/libexec/pi-kenan-runtime
  fi
fi
# Once Orchestrator is selected, Remote, the tools and the accounts touch
# disjoint state: separate release directories, ~/.local/bin, and ~/.pi/agent.
# The shared skills release is published once, serially; each account's
# settings and package install then proceed in parallel.
(
  for user in "${users[@]}"; do "$root/deploy/tools" --links-only "$user"; done
) &
tools_pid=$!
(
  set -euo pipefail
  "$root/deploy/skills" "${users[0]}"
  account_pids=()
  for user in "${users[@]}"; do
    if [[ $user != "${users[0]}" ]]; then
      "$root/deploy/skills" --links-only "$user" &
      account_pids+=($!)
    fi
    "$root/deploy/settings" "$user" &
    account_pids+=($!)
  done
  accounts_failed=0
  for pid in "${account_pids[@]}"; do wait "$pid" || accounts_failed=1; done
  exit "$accounts_failed"
) &
accounts_pid=$!
publish_failed=0
wait "$tools_pid" || publish_failed=1
wait "$accounts_pid" || publish_failed=1
(( publish_failed == 0 )) || exit 1

for artifact in "$runtime" "$orchestrator" "$remote" "$skills" "$tools"; do
  [[ -f $artifact/.pi-stack-commit && $(<"$artifact/.pi-stack-commit") == "$expected" ]] || {
    echo "$artifact does not carry Pi stack $expected" >&2
    exit 1
  }
done

  exit 0
fi
[[ $PI_STACK_HOST_PHASE == activation ]] || exit 64
owner_changed() {
  [[ -n ${PI_STACK_HOST_PLAN:-} ]] || return 0
  jq -e --arg owner "$1" --arg expected "$expected" '.protocol == "pi-host-plan-v1" and .candidate == $expected and (.owners[$owner].changed | type == "boolean")' "$PI_STACK_HOST_PLAN" >/dev/null || { echo 'host owner plan is invalid' >&2; exit 66; }
  jq -e --arg owner "$1" '.owners[$owner].changed' "$PI_STACK_HOST_PLAN" >/dev/null
}
owner_matches() {
  local owner=$1 running=$2
  [[ $running == "$expected" ]] && return 0
  [[ -n ${PI_STACK_HOST_PLAN:-} ]] || return 1
  node "$root/deploy/host-plan.mjs" verify-owner "$root" "$PI_STACK_HOST_PLAN" "$owner" "$running" >/dev/null
}
# Unchanged owners keep their recorded release. Source equality is proved against
# their actual running commit, not inferred from the selected symlink.
router_base=http://127.0.0.1:${PI_REMOTE_ROUTER_PORT:-8788}
# The front door starts every open person's supervisor before it listens, so
# right after a restart the port is closed for as long as those starts take.
# Nothing may judge the release through a closed port.
wait_for_router() {
  local deadline=$((SECONDS + 20))
  while (( SECONDS < deadline )); do
    curl -fsS --max-time 2 "$router_base/v1/router-health" >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  echo "pi-remote-router.service did not answer within 20 seconds" >&2
  return 1
}
supervisor_commit() {
  pi_stack_supervisor_health "$1" 2>/dev/null | jq -r '.releaseCommit // empty' 2>/dev/null
}
remote_matches_release() {
  local target_commit=$1 user
  local -a unlocked_users=()
  wait_for_router || return 1
  mapfile -t unlocked_users < <(curl -fsS --max-time 2 "$router_base/v1/router-health" 2>/dev/null | jq -r '.people[] | select(.unlocked) | .user' 2>/dev/null)
  for user in "${unlocked_users[@]}"; do
    if [[ $target_commit == "$expected" ]]; then
      owner_matches remote "$(supervisor_commit "$user")" || return 1
    else
      [[ $(supervisor_commit "$user") == "$target_commit" ]] || return 1
    fi
  done
}
activate_remote() {
  local target_commit=$1 user response deadline
  local -a unlocked_users=()
  if [[ $target_commit != "$expected" ]] || owner_changed router; then
    pi_stack_as_root systemctl restart pi-remote-router.service || return 1
  fi
  wait_for_router || return 1
  # A supervisor the front door has just started already runs the selected
  # release; only one that reports another commit is asked to hand over.
  mapfile -t unlocked_users < <(curl -fsS --max-time 2 "$router_base/v1/router-health" 2>/dev/null | jq -r '.people[] | select(.unlocked) | .user' 2>/dev/null)
  for user in "${unlocked_users[@]}"; do
    if [[ $target_commit == "$expected" ]] && ! owner_changed remote && owner_matches remote "$(supervisor_commit "$user")"; then continue; fi
    [[ $(supervisor_commit "$user") == "$target_commit" ]] && continue
    PI_REMOTE_SERVICE="pi-remote@$user.service" "$root/apps/remote/activate"
  done
  deadline=$((SECONDS + 100))
  local -a pending=()
  while (( SECONDS < deadline )); do
    pending=()
    for user in "${unlocked_users[@]}"; do
      if [[ $target_commit == "$expected" ]] && ! owner_changed remote; then
        owner_matches remote "$(supervisor_commit "$user")" || pending+=("$user")
      else
        [[ $(supervisor_commit "$user") == "$target_commit" ]] || pending+=("$user")
      fi
    done
    (( ${#pending[@]} == 0 )) && return 0
    sleep 0.1
  done
  printf 'supervisors did not activate Pi Remote %s within their start/stop budget: %s\n' "$target_commit" "${pending[*]}" >&2
  return 1
}
# Remote owns canonical settings and publishes its narrow timezone projection
# before fleet admissions start. Locked owners retain explicit unavailable state.
activate_daemons() {
  local failed=0 broker_units
  local -a brokers=()
  if owner_changed daemons && (( ${#daemons[@]} )); then
    pi_stack_as_root systemctl restart "${daemons[@]}" || failed=1
  fi
  if owner_changed brokers; then
    broker_units=$(pi_stack_as_root systemctl list-units --type=service --state=running --no-legend 'pi-model-broker.service' 'pi-stack-model-broker@*.service') || failed=1
    mapfile -t brokers < <(printf '%s\n' "$broker_units" | awk '$1 ~ /^(pi-model-broker\.service|pi-stack-model-broker@.*\.service)$/ {print $1}')
    if (( ${#brokers[@]} )); then
      pi_stack_as_root systemctl restart "${brokers[@]}" || failed=1
    fi
  fi
  return "$failed"
}
activation_failed=0
if [[ ${PI_STACK_FORCE_ROLLBACK:-0} != 1 ]]; then
  if (( recognition )); then
    recognition_started=1
    "$root/deploy/meet-recognition-service" --activate &
    recognition_pid=$!
  fi
if owner_changed remote || owner_changed router; then
  activate_remote "$expected" || activation_failed=1
elif ! remote_matches_release "$expected"; then
  # Publication can finish before a deployment is interrupted. Reconcile a
  # selected release whose supervisors never received the activation handoff.
  activate_remote "$expected" || activation_failed=1
fi

if (( activation_failed == 0 )); then
  for service in voice phone; do
    if owner_changed "$service" && ! "$root/deploy/$service" --activate; then activation_failed=1; fi
  done
fi
if (( activation_failed == 0 )) && [[ ${PI_STACK_DEPLOY_NO_SUDO:-0} != 1 ]]; then
  "$root/deploy/timezone-ready" "$router_base" || activation_failed=1
fi
if (( activation_failed == 0 )); then
  activate_daemons &
  daemon_activation_pid=$!
fi

# Refresh additive access and hand enabled consumers to their owning activator.
# Root replacement pauses dispatch only; durable intake remains accepting.
if ! "$root/deploy/one-kenan-access-release" "$PI_STACK_HOST_FILE"; then
  activation_failed=1
elif jq -e '.oneKenan == true' "$PI_STACK_HOST_FILE" >/dev/null && { owner_changed root || owner_changed memory || owner_changed rooms; }; then
  if [[ ${PI_STACK_DEPLOY_NO_SUDO:-0} != 1 ]]; then
    consumer_status=0
    pi_stack_as_root python3 "$root/deploy/one-kenan-activate" activate --host "$PI_STACK_HOST_FILE" --expected "$expected" || consumer_status=$?
    if (( consumer_status == 75 )); then
      if (( recognition )); then wait "$recognition_pid" || exit 1; fi
      if [[ -n ${daemon_activation_pid:-} ]]; then wait "$daemon_activation_pid" || exit 1; fi
      echo 'executor replacement waiting: accepting Root remains busy or its graceful handoff is settling' >&2
      exit 75
    fi
    (( consumer_status == 0 )) || activation_failed=1
  fi
fi
if (( recognition )); then
  wait "$recognition_pid" || activation_failed=1
fi
if [[ -n ${daemon_activation_pid:-} ]]; then wait "$daemon_activation_pid" || activation_failed=1; fi

fi
# Then walk the front door the way the clients do. A release that locks a
# person out of the app goes back to the previous Pi Remote release on the
# spot, and the deployment fails loudly instead of quietly.
smoke_failed=0
if [[ ${PI_STACK_FORCE_ROLLBACK:-0} == 1 ]] || (( activation_failed )) || ! "$root/deploy/smoke"; then smoke_failed=1; fi
if (( smoke_failed )); then
    if [[ -n $previous_remote_release && $previous_remote != "$expected" && -d $previous_remote_release ]] &&
       node "$root/deploy/remote-rollback-compatible.mjs" "$(readlink -f "$remote")" "$previous_remote_release"; then
      echo "activation, smoke or runtime doctor failed; returning Pi Remote to schema-compatible $previous_remote" >&2
      candidate="$(dirname "$remote")/.pi-stack-releases/.rollback.$$"
      pi_stack_as_root ln -s "$previous_remote_release" "$candidate"
      pi_stack_as_root mv -Tf "$candidate" "$remote"
      # A supervisor that crashed on the rejected release may have hit its
      # start limit; the previous release cannot come back through a unit
      # systemd refuses to start.
      pi_stack_as_root systemctl reset-failed 'pi-remote@*.service' 2>/dev/null || true
      for service in voice phone; do
        if [[ -f $previous_remote_release/server/$service/service.ts ]]; then
          service_action=--activate
          [[ $service != phone ]] || service_action=--restore
          "$root/deploy/$service" "$service_action" || echo "$service rollback failed" >&2
        elif [[ $(systemctl show "pi-stack-$service.service" -p LoadState --value) == loaded ]]; then
          pi_stack_as_root systemctl stop "pi-stack-$service.service"
        fi
      done
      activate_remote "$previous_remote" || true
      if [[ -x $previous_remote_release/deploy/smoke ]]; then
        "$previous_remote_release/deploy/smoke" || echo 'The restored release failed its own smoke check' >&2
      fi
    fi
    echo "Pi stack $expected is not accepted on this host" >&2
    exit 1
fi
if (( recognition )); then
  "$root/deploy/meet-recognition" --retain || echo 'Meet recognition retention failed; retained store needs collection' >&2
fi
printf 'deployed Pi stack %s for %s\n' "$expected" "${users[*]}"
