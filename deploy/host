#!/usr/bin/env bash
# Deploy the checked-out Pi stack commit to this machine.
#
#   deploy/host [HOST_FILE]     defaults to /etc/pi-stack/host.json
#
# The host file names the account that runs the fleet daemon and any packages
# and skills this machine adds for every person. Persons come from Pi Remote's
# registry under /var/lib/pi-remote/persons. Everything else is the same on
# every host: one runtime under /srv/pi, one orchestrator, one Pi Remote, the
# tools, the skills, and each account's Pi settings and command links.
set -euo pipefail

control=$(cd "$(dirname "$0")/.." && pwd)
root=$control
source "$control/deploy/lib"
# Host phases below own independent deadlines; child deployment scripts inherit custody.
export PI_STACK_DEPLOY_DEADLINE_ACTIVE=1
pi_stack_enter_deployment "$0" "$root" "$@"
export PI_STACK_HOST_FILE=${1:-$(pi_stack_host_file)}
[[ -f $PI_STACK_HOST_FILE ]] || { echo "usage: deploy/host [HOST_FILE]; $PI_STACK_HOST_FILE does not exist" >&2; exit 64; }
jq -e '.version == 1' "$PI_STACK_HOST_FILE" >/dev/null || { echo "$PI_STACK_HOST_FILE must declare version 1" >&2; exit 64; }

# Rehearsals never touch host services or require their credentials.
services=1
if [[ -n ${PI_STACK_REMOTE_DEST:-}${PI_STACK_ORCHESTRATOR_DEST:-}${PI_STACK_RUNTIME_DEST:-} && ${PI_STACK_SERVICES:-0} != 1 ]]; then
  services=0
fi
if (( services )) && [[ -z ${PI_STACK_HOST_PHASE:-} ]]; then
  pi_stack_check_person_configs
  "$root/deploy/voice" --check
  "$root/deploy/phone" --check
fi
# Activation restarts Pi Remote, which ends every live Meet room: the meeting bot stays
# in the call with no voice, canvas or agent (a release at 06:40Z on 2026-09-29 cut a
# live Meet test mid-brief). Defer instead; the publication owner probes this exit 75
# without consuming deployment attempts. A census that cannot answer is not an empty
# host, so it defers too. PI_STACK_ALLOW_LIVE_MEETING_RESTART=1 overrides.
if (( services )) && [[ ${PI_STACK_ALLOW_LIVE_MEETING_RESTART:-0} != 1 ]]; then
  if ! live_rooms=$(pi_stack_live_meeting_rooms); then
    echo "meeting census unavailable on this host: see the census error above" >&2
    exit 75
  fi
  if [[ -n $live_rooms ]]; then
    echo "live meeting rooms on this host ($live_rooms); deploying now would end them" >&2
    exit 75
  fi
fi
# The host declares which native selected sources this Pi Stack commit depends on.
# Check after the meeting census and before any build or service change.
if (( services )); then
  "$root/deploy/native-prerequisites" "$PI_STACK_HOST_FILE" "$root" "$(git -C "$root" rev-parse HEAD)"
fi
# Write needs its host-declared engine unit and a CPU able to stream Nemotron;
# a host without the unit keeps Remote working and reports Write unavailable.
write=0
if (( services )) && "$root/deploy/write-service" --check 2>/dev/null; then write=1; fi

fleet=$(pi_stack_fleet_user)
mapfile -t users < <(pi_stack_users)
(( ${#users[@]} > 0 )) || { echo "no Pi accounts: set fleetUser in $PI_STACK_HOST_FILE or add a person with pi-remote person add" >&2; exit 64; }
if (( services )); then
  daemon_units=$(pi_stack_daemon_units "${users[@]}") || { echo 'could not discover Orchestrator daemon units' >&2; exit 1; }
  daemons=()
  if [[ -n $daemon_units ]]; then mapfile -t daemons <<< "$daemon_units"; fi
fi

write_base=${PI_STACK_WRITE_ENGINE_DEST:-/srv/pi/write-engine}
previous_write=$(readlink -f "$write_base" 2>/dev/null || true)
write_was_active=0
write_was_enabled=0
write_started=0
write_pid=""
if (( write )); then
  systemctl is-active --quiet pi-stack-write.service && write_was_active=1
  systemctl is-enabled --quiet pi-stack-write.service && write_was_enabled=1
fi
restore_write() {
  local status=$? candidate="$write_base.rollback.$$"
  trap - EXIT TERM INT HUP
  if (( status != 0 && write_started )); then
    # Stop the readiness job before restoring: it must not restart the rejected
    # engine after the selection has gone back. Queue the old unit immediately;
    # cold rollback readiness cannot fit inside an already failed deadline.
    if [[ -n $write_pid ]]; then
      kill "$write_pid" 2>/dev/null || true
      wait "$write_pid" 2>/dev/null || true
    fi
    echo 'release failed; restoring previous Write selection and service state' >&2
    if [[ -n $previous_write && -d $previous_write ]]; then
      pi_stack_as_root ln -s "$previous_write" "$candidate" &&
        pi_stack_as_root mv -Tf "$candidate" "$write_base" || echo 'Write selection rollback failed' >&2
    else
      pi_stack_as_root rm -f "$write_base"
    fi
    if (( write_was_active )); then
      pi_stack_as_root systemctl reset-failed pi-stack-write.service || true
      pi_stack_as_root systemctl restart --no-block pi-stack-write.service || echo 'Write rollback restart failed' >&2
    else
      pi_stack_as_root systemctl stop --no-block pi-stack-write.service || echo 'Write rollback stop failed' >&2
    fi
    (( write_was_enabled )) || pi_stack_as_root systemctl disable pi-stack-write.service || true
    pi_stack_as_root rm -f "$candidate"
  fi
  # Join bounded proof jobs before releasing deployment custody.
  if [[ -n ${doctor_pid:-} ]]; then
    wait "$doctor_pid" || true
  fi
  exit "$status"
}
trap restore_write EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP

if [[ -z ${PI_STACK_HOST_PHASE:-} ]]; then
  remote=${PI_STACK_REMOTE_DEST:-/srv/pi/pi-remote}
  export PI_STACK_PREVIOUS_REMOTE=$(cat "$remote/.pi-stack-commit" 2>/dev/null || true)
  export PI_STACK_PREVIOUS_REMOTE_RELEASE=$(readlink -f "$remote" || true)
  phase() {
    local name=$1 seconds=$2; shift 2
    echo "release phase=$name started deadline=${seconds}s"
    local status=0
    timeout --signal=TERM --kill-after=5s "${seconds}s" "$@" || status=$?
    echo "release phase=$name completed status=$status"
    return "$status"
  }
  (( ! write )) || write_started=1
  phase publication 50 env PI_STACK_HOST_PHASE=publication "$0" "$@"
  if (( services )); then
    phase capacity-ready 10 pi_stack_run_as "${fleet:-${users[0]}}" node "$control/deploy/capacity-ready.mjs" "${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}/dist/agent-capacity.js"
    (
      phase browser-doctor 120 "$control/deploy/runtime-doctors" browser "$root" "${fleet:-${users[0]}}" "$control" &
      browser_doctor_pid=$!
      phase model-doctor 30 "$control/deploy/runtime-doctors" model "$root" "${fleet:-${users[0]}}" "$control" &
      model_doctor_pid=$!
      failed=0
      wait "$browser_doctor_pid" || failed=1
      wait "$model_doctor_pid" || failed=1
      exit "$failed"
    ) &
    doctor_pid=$!
    activation_failed=0; doctor_failed=0
    phase activation 50 env PI_STACK_HOST_PHASE=activation "$0" "$@" || activation_failed=1
    wait "$doctor_pid" || doctor_failed=1
    if (( doctor_failed )); then
      echo 'runtime doctor failed' >&2
      if (( ! activation_failed )); then
        phase rollback 50 env PI_STACK_HOST_PHASE=activation PI_STACK_FORCE_ROLLBACK=1 "$0" "$@" || true
      fi
    fi
    (( ! activation_failed && ! doctor_failed )) || exit 1
  fi
  echo "deployed Pi stack $(git -C "$root" rev-parse HEAD) for ${users[*]}"
  exit 0
fi
expected=$(git -C "$root" rev-parse HEAD)
runtime=${PI_STACK_RUNTIME_DEST:-/srv/pi/runtime}
orchestrator=${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}
remote=${PI_STACK_REMOTE_DEST:-/srv/pi/pi-remote}
skills=${PI_STACK_SKILLS_DEST:-/srv/pi/skills}
tools=${PI_STACK_TOOLS_DEST:-/srv/pi/tools}
previous_remote=${PI_STACK_PREVIOUS_REMOTE:-}
previous_remote_release=${PI_STACK_PREVIOUS_REMOTE_RELEASE:-}
if [[ $PI_STACK_HOST_PHASE == publication ]]; then
# Builds share checkout dependencies, not output directories. Prepare them
# together while selecting and warming Write on hosts that own it.
# The Write engine's 1.2 GB model is fetched by deploy/prepare, outside this
# deadline; here it is only selected, and a missing preparation fails loudly.
pi_stack_prepare_builds "$root" &
builds_pid=$!
"$root/deploy/runtime" &
runtime_pid=$!
if (( write )); then
  # Join selection in this shell: an orphan selector must not overwrite a
  # rollback after an independent build failure or signal.
  write_started=1
  "$root/deploy/write-engine" --select
else
  echo 'Pi Stack Write: no pi-stack-write.service on this host; skipping the engine' >&2
fi
preparation_failed=0
wait "$builds_pid" || preparation_failed=1
# prepare already selected this immutable runtime. Its repeated custody proof
# can overlap component staging; a cold deployment still needs it selected first.
if [[ ! -f $runtime/.pi-stack-commit || $(<"$runtime/.pi-stack-commit") != "$expected" ]]; then
  wait "$runtime_pid" || preparation_failed=1
fi
(( preparation_failed == 0 )) || exit 1
"$root/deploy/orchestrator"
# Once Orchestrator is selected, Remote, the tools and the accounts touch
# disjoint state: separate release directories, ~/.local/bin, and ~/.pi/agent.
# The shared skills release is published once, serially; each account's
# settings and package install then proceed in parallel.
"$root/deploy/remote" &
remote_pid=$!
"$root/deploy/tools" &
tools_pid=$!
(
  set -euo pipefail
  "$root/deploy/skills" "${users[0]}"
  account_pids=()
  for user in "${users[@]}"; do
    if [[ $user != "${users[0]}" ]]; then
      "$root/deploy/skills" --links-only "$user" &
      account_pids+=($!)
    fi
    "$root/deploy/settings" "$user" &
    account_pids+=($!)
  done
  accounts_failed=0
  for pid in "${account_pids[@]}"; do wait "$pid" || accounts_failed=1; done
  exit "$accounts_failed"
) &
accounts_pid=$!
publish_failed=0
wait "$runtime_pid" || publish_failed=1
wait "$remote_pid" || publish_failed=1
wait "$tools_pid" || publish_failed=1
wait "$accounts_pid" || publish_failed=1
(( publish_failed == 0 )) || exit 1

for artifact in "$runtime" "$orchestrator" "$remote" "$skills" "$tools"; do
  [[ -f $artifact/.pi-stack-commit && $(<"$artifact/.pi-stack-commit") == "$expected" ]] || {
    echo "$artifact does not carry Pi stack $expected" >&2
    exit 1
  }
done

  exit 0
fi
[[ $PI_STACK_HOST_PHASE == activation ]] || exit 64
# Every enabled or running person's daemon restarts on release; live workers keep the
# release they recorded. The front door restarts only when Pi Remote changed, and each
# running supervisor is then handed the new release without ending active turns.
router_base=http://127.0.0.1:${PI_REMOTE_ROUTER_PORT:-8788}
# The front door starts every open person's supervisor before it listens, so
# right after a restart the port is closed for as long as those starts take.
# Nothing may judge the release through a closed port.
wait_for_router() {
  local deadline=$((SECONDS + 20))
  while (( SECONDS < deadline )); do
    curl -fsS --max-time 2 "$router_base/v1/router-health" >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  echo "pi-remote-router.service did not answer within 20 seconds" >&2
  return 1
}
supervisor_commit() {
  pi_stack_supervisor_health "$1" 2>/dev/null | jq -r '.releaseCommit // empty' 2>/dev/null
}
remote_matches_release() {
  local target_commit=$1 user
  local -a unlocked_users=()
  wait_for_router || return 1
  mapfile -t unlocked_users < <(curl -fsS --max-time 2 "$router_base/v1/router-health" 2>/dev/null | jq -r '.people[] | select(.unlocked) | .user' 2>/dev/null)
  for user in "${unlocked_users[@]}"; do
    [[ $(supervisor_commit "$user") == "$target_commit" ]] || return 1
  done
}
activate_remote() {
  local target_commit=$1 user response deadline
  local -a unlocked_users=()
  pi_stack_as_root systemctl restart pi-remote-router.service || return 1
  wait_for_router || return 1
  # A supervisor the front door has just started already runs the selected
  # release; only one that reports another commit is asked to hand over.
  mapfile -t unlocked_users < <(curl -fsS --max-time 2 "$router_base/v1/router-health" 2>/dev/null | jq -r '.people[] | select(.unlocked) | .user' 2>/dev/null)
  for user in "${unlocked_users[@]}"; do
    [[ $(supervisor_commit "$user") == "$target_commit" ]] && continue
    PI_REMOTE_SERVICE="pi-remote@$user.service" "$root/apps/remote/activate"
  done
  for user in "${unlocked_users[@]}"; do
    deadline=$((SECONDS + 20))
    while (( SECONDS < deadline )); do
      [[ $(supervisor_commit "$user") == "$target_commit" ]] && continue 2
      sleep 0.1
    done
    echo "pi-remote@$user.service did not activate Pi Remote $target_commit" >&2
    return 1
  done
}
# A daemon's graceful stop can consume its full systemd stop budget. Remote
# handoff does not depend on it; join both jobs before smoke instead of spending
# that budget before the supervisors even receive their reload (PUB-bf877cd4).
(
  failed=0
  if (( ${#daemons[@]} )); then
    pi_stack_as_root systemctl restart "${daemons[@]}" || failed=1
  fi
  broker_units=$(pi_stack_as_root systemctl list-units --type=service --state=running --no-legend 'pi-model-broker.service' 'pi-stack-model-broker@*.service') || failed=1
  mapfile -t brokers < <(printf '%s\n' "$broker_units" | awk '$1 ~ /^(pi-model-broker\.service|pi-stack-model-broker@.*\.service)$/ {print $1}')
  if (( ${#brokers[@]} )); then
    pi_stack_as_root systemctl restart "${brokers[@]}" || failed=1
  fi
  exit "$failed"
) &
daemon_activation_pid=$!
activation_failed=0
if [[ ${PI_STACK_FORCE_ROLLBACK:-0} != 1 ]]; then
  if (( write )); then
    write_started=1
    "$root/deploy/write-service" --activate &
    write_pid=$!
  fi
if ! "$root/deploy/voice" --activate || ! "$root/deploy/phone" --activate; then
  activation_failed=1
elif [[ $previous_remote != "$expected" ]]; then
  activate_remote "$expected" || activation_failed=1
elif ! remote_matches_release "$expected"; then
  # Publication can finish before a deployment is interrupted. Reconcile a
  # selected release whose supervisors never received the activation handoff.
  activate_remote "$expected" || activation_failed=1
fi

# Refresh the additive gates before rolling the shared-room supervisor. Root,
# memory and encrypted custody remain untouched by the ordinary host release.
if ! "$root/deploy/one-kenan-access-release" "$PI_STACK_HOST_FILE"; then
  activation_failed=1
elif jq -e '.oneKenan == true' "$PI_STACK_HOST_FILE" >/dev/null; then
  pi_stack_as_root python3 "$root/deploy/one-kenan-activate" rooms --host "$PI_STACK_HOST_FILE" --expected "$expected" || activation_failed=1
fi
if (( write )); then
  wait "$write_pid" || activation_failed=1
fi
wait "$daemon_activation_pid" || activation_failed=1

fi
# Then walk the front door the way the clients do. A release that locks a
# person out of the app goes back to the previous Pi Remote release on the
# spot, and the deployment fails loudly instead of quietly.
smoke_failed=0
if [[ ${PI_STACK_FORCE_ROLLBACK:-0} == 1 ]] || (( activation_failed )) || ! "$root/deploy/smoke"; then smoke_failed=1; fi
if (( smoke_failed )); then
    if [[ -n $previous_remote_release && $previous_remote != "$expected" && -d $previous_remote_release ]]; then
      echo "activation, smoke or runtime doctor failed; returning Pi Remote to $previous_remote" >&2
      candidate="$(dirname "$remote")/.pi-stack-releases/.rollback.$$"
      pi_stack_as_root ln -s "$previous_remote_release" "$candidate"
      pi_stack_as_root mv -Tf "$candidate" "$remote"
      # A supervisor that crashed on the rejected release may have hit its
      # start limit; the previous release cannot come back through a unit
      # systemd refuses to start.
      pi_stack_as_root systemctl reset-failed 'pi-remote@*.service' 2>/dev/null || true
      for service in voice phone; do
        if [[ -f $previous_remote_release/server/$service/service.ts ]]; then
          "$root/deploy/$service" --activate || echo "$service rollback failed" >&2
        elif [[ $(systemctl show "pi-stack-$service.service" -p LoadState --value) == loaded ]]; then
          pi_stack_as_root systemctl stop "pi-stack-$service.service"
        fi
      done
      activate_remote "$previous_remote" || true
      if [[ -x $previous_remote_release/deploy/smoke ]]; then
        "$previous_remote_release/deploy/smoke" || echo 'The restored release failed its own smoke check' >&2
      fi
    fi
    echo "Pi stack $expected is not accepted on this host" >&2
    exit 1
fi
if (( write )); then
  "$root/deploy/write-engine" --retain || echo 'Write retention failed; retained store needs collection' >&2
fi
printf 'deployed Pi stack %s for %s\n' "$expected" "${users[*]}"
