#!/usr/bin/env node
import { createHash, randomUUID } from "node:crypto";
import {
  closeSync,
  readSync,
  fstatSync,
  copyFileSync,
  existsSync,
  fsyncSync,
  mkdirSync,
  openSync,
  readFileSync,
  readdirSync,
  renameSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import { dirname, join, resolve } from "node:path";
import { homedir } from "node:os";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";
import { policy, canResumeRebootedIntegration, stallReason, runnable, observeQueueProgress, queueStallReason, progressBudgetExhausted, repairId, repairUnit, repairPrompt } from "./publication-control.mjs";
import { loadPublicationConfig } from "./publication-config.mjs";
import { hostWaitKind, rollForwardHosts } from "./publication-hosts.mjs";
import { sourceOnlyQueued, freezeSourceBundle, sourceBundleMembers, resolveSourceBundle } from "./publication-bundle.mjs";
import { publicationJournalEnabled, beginPublication, finishPublication } from "./action-journal.mjs";

const config = loadPublicationConfig();
const { repositoryUrl, canonicalRepository, stateRoot, installedCommand, userUnitRoot, targets, alertInbox } = config;
const requestRoot = join(stateRoot, "requests");
const logRoot = join(stateRoot, "logs");
// Hara's explicit per-request authorization to restart through live meetings (ends them).
const meetingOverrideRoot = join(stateRoot, "live-meeting-overrides");
const meetingOverride = requestId => {
  const path = join(meetingOverrideRoot, `${requestId}.json`);
  return existsSync(path) ? JSON.parse(readFileSync(path, "utf8")) : null;
};
const proofRoot = join(stateRoot, "proofs");
const contractRoot = join(stateRoot, "contracts");
const checkout = join(stateRoot, "repository");

const issueAcknowledgementsPath = join(stateRoot, "issue-acknowledgements.json");
const issueAlertPath = join(alertInbox, "pi-stack-publication-issues.md");
const threadExecutionContract = "unified-threads-v1";
const threadExecutionActivationPath = join(contractRoot, `${threadExecutionContract}.json`);
const self = fileURLToPath(import.meta.url);
const repairRoot = join(stateRoot, "repairs");
const repairPolicyPath = join(stateRoot, "repair-policy.json");
const ownerSourceRef = "refs/pi-stack-publication/owner-source";
let activeRequest;
let activeLog;
let trackingCommand = false;
const workerBootId = readFileSync("/proc/sys/kernel/random/boot_id", "utf8").trim();

// A shared master may belong to a thread scope that exits during publication.
const publicationSshOptions = ["-o", "ControlPath=none", "-o", "ControlMaster=no", "-o", "ControlPersist=no"];
const publicationRsyncShell = ["ssh", ...publicationSshOptions, "-o", "BatchMode=yes"].join(" ");

function usage() {
  process.stderr.write(`usage:
  deploy/publication install [--code-only]
  deploy/publication submit SHA
  deploy/publication inspect REQUEST
  deploy/publication issues
  deploy/publication acknowledge-issues
  deploy/publication cancel REQUEST
  deploy/publication repair REQUEST
  deploy/publication repair-result REQUEST
  deploy/publication recover-native-history REQUEST HOST
  deploy/publication submit SHA --repair-of REQUEST
  deploy/publication report REQUEST [REMOTE_URL SESSION_ID]
  deploy/publication gate-status
  deploy/publication allow-live-meetings REQUEST REASON

The installed systemd user service also invokes the internal enqueue and drain commands.\n`);
}

export function commandResult(command, args, options = {}) {
  if (command === "ssh") args = [...publicationSshOptions, ...args];
  if (command === "rsync") args = ["-e", publicationRsyncShell, ...args];
  const timeoutSeconds = options.timeoutSeconds ?? 60;
  const tracked = activeRequest && !trackingCommand;
  if (tracked) {
    trackingCommand = true;
    const startedAt = new Date().toISOString();
    activeRequest.progress = { step: activeRequest.step, command, args, cwd: options.cwd,
      startedAt, deadlineAt: new Date(Date.now() + timeoutSeconds * 1000).toISOString(), log: activeLog };
    writeRequest(activeRequest);
    trackingCommand = false;
  }
  const invocation = spawnSync(
    "timeout",
    ["--kill-after=10s", `${timeoutSeconds}s`, command, ...args],
    {
      cwd: options.cwd,
      env: options.env,
      encoding: "utf8",
      input: options.input,
      maxBuffer: 4 * 1024 * 1024,
      stdio: options.stdio ?? [options.input === undefined ? "ignore" : "pipe", "pipe", "pipe"],
    },
  );
  if (tracked) {
    activeRequest.progress.completedAt = new Date().toISOString();
    activeRequest.progress.deadlineAt = new Date(Date.now() + policy.betweenStepsMs).toISOString();
    writeRequest(activeRequest);
  }
  return {
    ok: invocation.status === 0,
    status: invocation.status ?? 1,
    stdout: invocation.stdout ?? "",
    stderr: invocation.stderr ?? "",
    signal: invocation.signal,
  };
}

function checked(command, args, options = {}) {
  const result = commandResult(command, args, options);
  if (!result.ok) {
    const detail = result.stderr.trim() || result.stdout.trim() || result.signal || `exit ${result.status}`;
    throw new Error(`${command} failed: ${detail}`);
  }
  return result.stdout.trim();
}

function ensureState() {
  for (const path of [stateRoot, requestRoot, logRoot, proofRoot, contractRoot, repairRoot]) mkdirSync(path, { recursive: true, mode: 0o700 });
  rmSync(join(stateRoot, "issues.json"), { force: true });
}

function syncDirectory(path) {
  const descriptor = openSync(path, "r");
  try {
    fsyncSync(descriptor);
  } finally {
    closeSync(descriptor);
  }
}

function atomicWrite(path, content, mode = 0o600) {
  mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
  const temporary = `${path}.${process.pid}.${randomUUID()}.tmp`;
  const descriptor = openSync(temporary, "wx", mode);
  try {
    writeFileSync(descriptor, content);
    fsyncSync(descriptor);
  } finally {
    closeSync(descriptor);
  }
  renameSync(temporary, path);
  syncDirectory(dirname(path));
}

function requestPath(requestId) {
  return join(requestRoot, `${requestId}.json`);
}

function migrateRequestOnRead(request) {
  // Version 2 request states convert in memory so old receipts remain immutable until their next real transition.
  if (request.status === "blocked") request.status = "queued";
  if (request.status === "recovering") {
    request.status = "running";
    request.recoveryInProgress = true;
  }
  if (request.status === "finalizing") request.status = "running";
  if (request.blocker && !request.waiting) request.waiting = request.blocker;
  delete request.blocker;
  if (request.status === "cancelled") {
    request.status = "failed";
    const failure = request.failure ?? {
      at: request.updatedAt ?? new Date(0).toISOString(),
      attempt: request.attempt ?? 0,
      step: request.step,
      message: "Publication cancelled; any completed host release remains selected",
    };
    failure.reason ??= "cancelled";
    request.failure = failure;
    request.failures ??= [];
    const historical = request.failures.find(candidate => candidate === failure || candidate.at === failure.at && candidate.message === failure.message);
    if (historical) historical.reason ??= "cancelled";
    else request.failures.push(failure);
  }
  if (request.status === "failed" && request.failure) {
    request.failure.reason ??= request.failure.message;
    const historical = request.failures?.find(candidate => candidate.at === request.failure.at && candidate.message === request.failure.message);
    if (historical) historical.reason ??= request.failure.reason;
  }
  request.version = 3;
  return request;
}

function readRequest(requestId) {
  const path = requestPath(requestId);
  if (!existsSync(path)) throw new Error(`unknown publication request ${requestId}`);
  return migrateRequestOnRead(JSON.parse(readFileSync(path, "utf8")));
}

function writeRequest(request) {
  migrateRequestOnRead(request);
  if (!["queued", "running", "failed", "published"].includes(request.status)) throw new Error(`invalid publication status: ${request.status}`);
  request.updatedAt = new Date().toISOString();
  atomicWrite(requestPath(request.requestId), `${JSON.stringify(request, null, 2)}\n`);
}

function validateRequestId(value) {
  if (!/^PUB-[a-f0-9]{24}$/.test(value)) throw new Error(`invalid publication request id: ${value}`);
}

function validateSha(value) {
  if (!/^[a-f0-9]{40}$/.test(value)) throw new Error(`invalid source SHA: ${value}`);
}

export function checkOwnerSource(sourceRoot, sourceSha) {
  if (!existsSync(join(checkout, ".git"))) return;
  const retained = checked("git", ["-C", checkout, "for-each-ref", "--format=%(objectname)", ownerSourceRef]);
  if (!retained) return;
  if (resolve(sourceRoot) !== resolve(checkout)) {
    checked("git", ["-C", sourceRoot, "fetch", "--quiet", "--no-tags", "--no-write-fetch-head", checkout, ownerSourceRef]);
  }
  if (!commandResult("git", ["-C", sourceRoot, "merge-base", "--is-ancestor", retained, sourceSha]).ok) {
    throw new Error(`Publication source ${sourceSha} omits bootstrapped owner source ${retained}; merge the retained ${ownerSourceRef} from ${checkout} before publication or owner installation`);
  }
}

function retainOwnerSource(sourceRoot, sourceSha) {
  if (!existsSync(join(checkout, ".git"))) throw new Error("Code-only repair requires an initialized publication repository for source custody");
  if (checked("git", ["-C", sourceRoot, "status", "--porcelain", "--untracked-files=all", "--", "deploy"])) {
    throw new Error("Commit deployment source before installing a code-only owner repair");
  }
  checked("git", ["-C", checkout, "fetch", "--quiet", "--no-tags", "--no-write-fetch-head", sourceRoot, `${sourceSha}:${ownerSourceRef}`]);
}

function installFrom(sourceRoot, activate = true) {
  const commandSource = join(sourceRoot, "deploy/publication");
  const unitNames = ["pi-stack-publication.service", "pi-stack-publication.timer", "pi-stack-publication.path",
    "pi-stack-publication-watchdog.service", "pi-stack-publication-watchdog.timer", "pi-stack-publication-repair@.service", "pi-stack-publication-notices.service"];
  const modules = ["publication-control.mjs", "publication-config.mjs", "publication-hosts.mjs", "publication-bundle.mjs", "action-journal.mjs", "release-checkout", "meeting-census", "native-prerequisites"];
  for (const path of [commandSource, ...modules.map(name => join(sourceRoot, "deploy", name)), ...unitNames.map(name => join(sourceRoot, "deploy/systemd", name))]) {
    if (!existsSync(path)) throw new Error(`publication installation source is missing: ${path}`);
  }
  const sourceSha = checked("git", ["-C", sourceRoot, "rev-parse", "HEAD^{commit}"]);
  checkOwnerSource(sourceRoot, sourceSha);
  ensureState();
  if (!activate) retainOwnerSource(sourceRoot, sourceSha);
  mkdirSync(dirname(installedCommand), { recursive: true, mode: 0o750 });
  mkdirSync(userUnitRoot, { recursive: true, mode: 0o700 });
  for (const name of modules) atomicWrite(join(dirname(installedCommand), name), readFileSync(join(sourceRoot, "deploy", name)), 0o644);
  atomicWrite(installedCommand, readFileSync(commandSource), 0o750);
  if (!activate) return;
  const replacements = { "@PUBLICATION_COMMAND@": installedCommand, "@PUBLICATION_WAKE@": join(stateRoot, "wake"), "@PUBLICATION_PATH@": `${join(homedir(), ".local/bin")}:/usr/local/bin:/run/wrappers/bin:/run/current-system/sw/bin:/usr/bin:/bin` };
  for (const name of unitNames) {
    let unit = readFileSync(join(sourceRoot, "deploy/systemd", name), "utf8");
    for (const [token, value] of Object.entries(replacements)) unit = unit.replaceAll(token, value);
    atomicWrite(join(userUnitRoot, name), unit, 0o644);
  }
  if (!existsSync(repairPolicyPath)) atomicWrite(repairPolicyPath, JSON.stringify({ activatedAt: new Date().toISOString(), policy }));
  checked("systemctl", ["--user", "daemon-reload"]);
  checked("systemctl", ["--user", "enable", "--now", "pi-stack-publication.timer", "pi-stack-publication.path", "pi-stack-publication-watchdog.timer"]);
}

function install(activate = true) {
  const sourceRoot = resolve(dirname(self), "..");
  installFrom(sourceRoot, activate);
  process.stdout.write(`installed pi-stack publication owner${activate ? "" : " code only; services unchanged"}; state=${stateRoot}\n`);
}

export function adoptPublicationOwner(sourceRoot, integrationSha) {
  const ownerSource = checked("git", ["-C", sourceRoot, "rev-parse", "HEAD"]);
  if (ownerSource !== integrationSha) throw new Error(`Publication owner checkout ${ownerSource} differs from checked integration ${integrationSha}`);
  checkOwnerSource(sourceRoot, integrationSha);
  // The candidate owns its installation layout; the running worker already holds the lock.
  checked(process.execPath, [join(sourceRoot, "deploy/publication"), "install"], { timeoutSeconds: 90 });
}

function gitRoot() {
  return checked("git", ["rev-parse", "--show-toplevel"], { cwd: process.cwd() });
}

function assertSourceRootsOnMain(sourceRoot, sourceSha) {
  if (checked("git", ["rev-parse", "--is-shallow-repository"], { cwd: sourceRoot }) !== "false")
    throw new Error("Cannot prove source ancestry from a shallow checkout; fetch its complete history before publication");
  const grafts = checked("git", ["rev-parse", "--git-path", "info/grafts"], { cwd: sourceRoot });
  if (existsSync(resolve(sourceRoot, grafts))) throw new Error("Cannot prove source ancestry with Git grafts installed");
  checked("git", ["fetch", "--quiet", "--no-tags", "origin", "refs/heads/main"], { cwd: sourceRoot, timeoutSeconds: 60 });
  const mainSha = checked("git", ["rev-parse", "--verify", "FETCH_HEAD^{commit}"], { cwd: sourceRoot });
  const roots = sha => checked("git", ["--no-replace-objects", "rev-list", "--max-parents=0", sha], { cwd: sourceRoot }).split("\n");
  const mainRoots = new Set(roots(mainSha));
  const extraRoots = roots(sourceSha).filter(root => !mainRoots.has(root));
  if (extraRoots.length) throw new Error(`Source ${sourceSha} introduces Git root(s) absent from current main ${mainSha}: ${extraRoots.join(", ")}; replay the changes onto current main before publication`);
}

function submit(sourceArgument, repairedRequestId) {
  if (sourceArgument === undefined) throw new Error("submit requires an explicit source commit");
  const sourceRoot = gitRoot();
  const sourceSha = checked("git", ["rev-parse", "--verify", `${sourceArgument}^{commit}`], { cwd: sourceRoot });
  validateSha(sourceSha);
  const remote = checked("git", ["config", "--get", "remote.origin.url"], { cwd: sourceRoot });
  if (remote !== repositoryUrl) throw new Error(`origin is not configured repository ${repositoryUrl}: ${remote}`);
  if (!existsSync(installedCommand)) throw new Error(`publication owner is not installed at ${installedCommand}`);

  let repaired;
  if (repairedRequestId) {
    validateRequestId(repairedRequestId);
    repaired = readRequest(repairedRequestId);
    checkCancellation(repaired);
    const repair = readRepair(repairedRequestId);
    if (repair?.outcome?.status !== "source-fixed" || repair.outcome.sourceSha !== sourceSha)
      throw new Error("Repaired submission requires its dedicated owner's source-fixed outcome and matching commit");
    if (repaired.status !== "failed") throw new Error("Repaired submission requires a failed request");
    if (sourceSha === repaired.sourceSha) throw new Error("Source repair requires a new commit");
    checked("git", ["merge-base", "--is-ancestor", repaired.sourceSha, sourceSha], { cwd: sourceRoot });
  }
  ensureState();
  if (!repaired) {
    const existing = existingSource(sourceSha);
    if (existing) {
      if (existing.status === "failed") throw new Error(`${sourceSha} already failed in ${existing.requestId}; use repair ${existing.requestId}, not an unrepaired resubmission`);
      process.stdout.write(`${JSON.stringify({ requestId: existing.requestId, sourceSha, status: existing.status, receipt: requestPath(existing.requestId), owner: existing.owner })}\n`);
      return;
    }
  }
  assertSourceRootsOnMain(sourceRoot, sourceSha);
  checkOwnerSource(sourceRoot, sourceSha);
  const requester = repaired?.reporter ?? requesterFromEnvironment();
  const reporter = requester ? validateReporter(requester) : null;
  const requestId = `PUB-${repaired ? createHash("sha256").update(`repair:${repairedRequestId}`).digest("hex").slice(0, 24) : randomUUID().replaceAll("-", "").slice(0, 24)}`;
  if (existsSync(requestPath(requestId))) {
    const existing = readRequest(requestId);
    if (existing.sourceSha !== sourceSha) throw new Error("This repair already submitted another commit");
    process.stdout.write(`${JSON.stringify({ requestId, sourceSha, status: existing.status, receipt: requestPath(requestId) })}\n`);
    return;
  }
  const sourceRef = `refs/heads/pi-stack-publications/${requestId}`;
  const pushed = commandResult("git", ["push", "--quiet", "origin", `${sourceSha}:${sourceRef}`], {
    cwd: sourceRoot,
    timeoutSeconds: 60,
    stdio: "inherit",
  });
  if (!pushed.ok) throw new Error(`failed to publish immutable source ref ${sourceRef}`);

  const enqueued = commandResult(installedCommand, ["enqueue", requestId, sourceSha, sourceRef, JSON.stringify(reporter), ...(repaired ? [repairedRequestId] : [])], {
    timeoutSeconds: 30,
  });
  if (!enqueued.ok) {
    throw new Error(`${enqueued.stderr.trim() || `publication owner did not acknowledge ${requestId}`}; source remains at ${sourceRef}`);
  }
  process.stdout.write(enqueued.stdout);
}

function enqueue(requestId, sourceSha, sourceRef, reporterJson, repairedRequestId) {
  validateRequestId(requestId);
  validateSha(sourceSha);
  if (repairedRequestId) {
    validateRequestId(repairedRequestId);
    checkCancellation(readRequest(repairedRequestId));
  }
  if (sourceRef !== `refs/heads/pi-stack-publications/${requestId}`) throw new Error("source ref does not match request id");
  ensureState();
  const loadState = checked("systemctl", ["--user", "show", "pi-stack-publication.service", "-p", "LoadState", "--value"]);
  if (loadState !== "loaded") throw new Error("pi-stack-publication.service is not loaded");
  checked("systemctl", ["--user", "is-active", "--quiet", "pi-stack-publication-watchdog.timer"]);
  const remoteLine = checked("git", ["ls-remote", repositoryUrl, sourceRef], { timeoutSeconds: 60 });
  if (remoteLine.split(/\s+/)[0] !== sourceSha) throw new Error(`remote source ref does not own ${sourceSha}`);
  const duplicate = existingSource(sourceSha);
  if (duplicate) {
    if (duplicate.status === "failed") throw new Error(`Source already failed in ${duplicate.requestId}; a repair is required`);
    process.stdout.write(`${JSON.stringify({ requestId: duplicate.requestId, sourceSha, status: duplicate.status, owner: duplicate.owner, receipt: requestPath(duplicate.requestId) })}\n`);
    return;
  }
  const path = requestPath(requestId);
  if (existsSync(path)) throw new Error(`publication request already exists: ${requestId}`);
  const now = new Date().toISOString();
  const request = {
    version: 3,
    requestId,
    sourceSha,
    sourceRef,
    contract: null,
    status: "queued",
    step: "queued",
    owner: "pi-stack-publication.service",
    queuedAt: now,
    updatedAt: now,
    attempt: 0,
    failures: [],
    reporter: reporterJson && JSON.parse(reporterJson) ? validateReporter(JSON.parse(reporterJson)) : null,
    ...(publicationJournalEnabled() ? { actionPerson: process.env.PI_KENAN_PERSON ?? process.env.PI_REMOTE_SENDER_ID ?? process.env.USER ?? "kenan" } : {}),
    ...(repairedRequestId ? { repairOf: repairedRequestId, repairId: repairId(repairedRequestId),
      repairDepth: (readRequest(repairedRequestId).repairDepth ?? 0) + 1 } : {}),
  };
  atomicWrite(path, `${JSON.stringify(request, null, 2)}\n`);
  atomicWrite(join(stateRoot, "wake"), `${now}\n`);
  const wake = commandResult("systemctl", ["--user", "start", "--no-block", "pi-stack-publication.service"]);
  if (!wake.ok) atomicWrite(join(stateRoot, "wake-failure.json"), JSON.stringify({ requestId,
    at: new Date().toISOString(), error: wake.stderr.trim() || `exit ${wake.status}` }));
  process.stdout.write(`${JSON.stringify({
    requestId,
    sourceSha,
    status: "queued",
    owner: request.owner,
    receipt: path,
    wake: wake.ok ? "started" : "watchdog-owned",
    reporting: request.reporter ? { status: "pending", ...request.reporter } : { status: "receipt", issues: `${installedCommand} issues` },
  })}\n`);
}

function inspect(requestId) {
  validateRequestId(requestId);
  process.stdout.write(`${JSON.stringify(readRequest(requestId), null, 2)}\n`);
}

function retry(requestId) {
  validateRequestId(requestId);
  const request = readRequest(requestId);
  checkCancellation(request);
  const repair = readRepair(requestId);
  if (request.repairedRetry?.repairId === repair?.id) return;
  if (repair?.explicitStop || repair?.failure?.at !== request.failure?.at || repair?.failure?.attempt !== request.failure?.attempt) throw new Error("Repair evidence is not bound to the latest failed attempt or was explicitly stopped");
  if (request.status !== "failed" || repair?.outcome?.status !== "infrastructure-fixed")
    throw new Error("Retry requires the dedicated repair's infrastructure-fixed evidence and is allowed once");
  if (Object.values(request.nativeHistory?.hosts ?? {}).some(host => host.state === "repair-required")) {
    throw new Error("Native history custody remains repair-held; recover-native-history must establish safe restoration before unchanged-source retry");
  }
  if (request.repairedRetry) request.repairedRetries = [...(request.repairedRetries ?? []), request.repairedRetry];
  request.repairedRetry = { failureAt: request.failure.at, failedAttempt: request.failure.attempt, repairId: repair.id, at: new Date().toISOString(), evidence: repair.outcome.evidence };
  if (repair.outcome.ownerSourceSha) {
    request.ownerRepairSourceSha = repair.outcome.ownerSourceSha;
    request.integrationHistory = [...(request.integrationHistory ?? []), { attempt: request.attempt, integrationSha: request.integrationSha, checks: request.checks, android: request.android }];
    checked("git", ["-C", checkout, "update-ref", `refs/pi-stack-publication/${request.requestId}/before-owner-repair-attempt-${request.attempt}`, request.integrationSha]);
    delete request.integrationSha; delete request.checks; delete request.android;
  }
  request.hostProofHistory = [...(request.hostProofHistory ?? []), { attempt: request.attempt, hosts: request.hosts }];
  request.hosts = {}; // Both hosts must supply fresh proof for the repaired attempt.
  request.status = "queued";
  request.recoveryAttempts = 0;
  request.attemptLimit = request.attempt + 1;
  delete request.blockedSince;
  delete request.nextAttemptAt;
  request.step = "queued-after-repair";
  writeRequest(request);
  atomicWrite(join(stateRoot, "wake"), `${Date.now()}\n`);
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication.service"]);
}

function cancellationPath(requestId) {
  return join(requestRoot, `${requestId}.cancel`);
}

function cancel(requestId) {
  validateRequestId(requestId);
  const request = readRequest(requestId);
  if (["failed", "published"].includes(request.status)) throw new Error(`${requestId} is already ${request.status}`);
  atomicWrite(cancellationPath(requestId), `${new Date().toISOString()}\n`);
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication.service"]);
  process.stdout.write(`${JSON.stringify({ requestId, status: "cancellation-requested", receipt: cancellationPath(requestId) })}\n`);
}

function isCancelled(request) {
  return request.failure?.reason === "cancelled" || existsSync(cancellationPath(request.requestId));
}

function checkCancellation(request) {
  if (isCancelled(request)) throw new Error("Publication cancelled; any completed host release remains selected");
  const owner = request.sourceBundleOwner ? readRequest(request.sourceBundleOwner.requestId) : request;
  if (!owner.sourceBundle) return;
  const members = sourceBundleMembers(owner);
  if (!members.ok) throw new Error(`${members.error.kind}: ${members.error.detail}`);
  const cancelled = members.sources.find(source => isCancelled(readRequest(source.requestId)));
  if (cancelled) throw new Error(`Source bundle member ${cancelled.requestId} cancelled; any completed host release remains selected`);
}

function appendLog(path, text) {
  mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
  const descriptor = openSync(path, "a", 0o600);
  try {
    writeFileSync(descriptor, text);
    fsyncSync(descriptor);
  } finally {
    closeSync(descriptor);
  }
}

function runLogged(request, step, command, args, timeoutSeconds, logPath, options = {}) {
  checkCancellation(request);
  request.step = step;
  writeRequest(request);
  appendLog(logPath, `\n[${new Date().toISOString()}] ${step}\n`);
  const descriptor = openSync(logPath, "a", 0o600);
  let result;
  try {
    result = commandResult(command, args, {
      cwd: options.cwd,
      env: options.env,
      input: options.input,
      timeoutSeconds,
      stdio: [options.input === undefined ? "ignore" : "pipe", descriptor, descriptor],
    });
  } finally {
    closeSync(descriptor);
  }
  return result;
}

function runCapture(command, args, options = {}) {
  const result = commandResult(command, args, options);
  if (!result.ok) {
    const detail = result.stderr.trim() || result.stdout.trim() || result.signal || `exit ${result.status}`;
    throw new Error(`${command} failed: ${detail}`);
  }
  return result.stdout.trim();
}

function logTail(path, start = 0) {
  if (!existsSync(path)) return "";
  const fd = openSync(path, "r");
  try {
    const size = fstatSync(fd).size;
    const buffer = Buffer.alloc(Math.min(Math.max(0, size - start), 8000));
    readSync(fd, buffer, 0, buffer.length, Math.max(0, size - buffer.length));
    return buffer.toString("utf8");
  } finally { closeSync(fd); }
}

function updateFailure(request, message, logPath, notify = true, reason = message) {
  const cancelled = existsSync(cancellationPath(request.requestId));
  const failure = {
    at: new Date().toISOString(),
    attempt: request.attempt,
    step: request.step,
    reason: cancelled ? "cancelled" : reason,
    message,
    log: logPath,
    command: request.progress ? [request.progress.command, ...request.progress.args].join(" ") : request.checks?.command,
    progress: request.progress,
    hosts: Object.fromEntries(Object.entries(request.hosts ?? {}).filter(([, host]) => host.status === "failed").map(([id, host]) => [id, structuredClone(host.failure)])),
    excerpt: logTail(logPath),
  };
  if (request.checks?.status === "running") request.checks.status = "failed";
  (request.failures ??= []).push(failure);
  request.status = "failed";
  delete request.nextAttemptAt;
  request.failure = failure;
  writeRequest(request);
  ensureRepair(request);
  if (notify) deliverNotice(request);
}

function noticeBody(request) {
  const repair = readRepair(request.requestId);
  const compact = value => String(value ?? "").replace(/\s+/g, " ").slice(0, 400);
  return [
    `Request: ${request.requestId}`,
    `Source: ${request.sourceSha}`,
    request.integrationSha ? `Integration: ${request.integrationSha}` : undefined,
    request.resolvedBy ? `Resolved by: ${request.resolvedBy}` : undefined,
    `Step: ${request.step}`,
    `Status: ${request.status}`,
    request.hosts ? `Hosts: ${targets.map(target => {
      const host = request.hosts[target.id];
      return `${target.id} ${host?.status ?? "pending"}${host?.status === "waiting" ? ` (${host.waiting.kind})` : ""}`;
    }).join("; ")}` : undefined,
    request.repairOf ? `Repairs: ${request.repairOf} via ${request.repairId}` : undefined,
    repair ? `Repair: ${repair.status}; receipt: ${repair.path}` : undefined,
    repair?.successor ? `Successor: ${repair.successor.requestId}` : undefined,
    request.status === "failed" ? `Failure: ${compact(request.failure?.message)}` : request.status === "queued" && request.waiting ? `Waiting: ${compact(request.waiting.reason)}; next attempt: ${request.nextAttemptAt}` : undefined,
    request.status === "failed" && request.failure?.reason !== request.failure?.message ? `Reason: ${compact(request.failure?.reason)}` : undefined,
    `Receipt: ${requestPath(request.requestId)}`,
    `Log: ${request.status === "failed" ? request.failure?.log : request.status === "queued" ? request.waiting?.log : request.finalProof?.path}`,
    request.status === "failed" && request.failure?.command ? `Command: ${compact(request.failure.command)}` : undefined,
    request.status === "failed" && request.failure?.reason !== "cancelled" ? "The dedicated repair owner retains this failure. A source fix needs a new commit; an unchanged-source retry requires recorded infrastructure repair evidence." : undefined,
  ].filter(Boolean).join("\n");
}

function validateReporter(reporter) {
  const url = new URL(reporter.url);
  if (!["http:", "https:"].includes(url.protocol) || url.username || url.password || url.search || url.hash)
    throw new Error("Remote report URL must be an HTTP endpoint without credentials, query or fragment");
  if (!/^[0-9a-f-]{36}$/i.test(reporter.sessionId)) throw new Error("Remote report requires a session UUID");
  return { url: url.href.replace(/\/$/, ""), sessionId: reporter.sessionId };
}

function requesterFromEnvironment() {
  const url = process.env.PI_STACK_PUBLICATION_REPORT_URL ?? process.env.PI_REMOTE_SERVER_URL;
  const sessionId = process.env.PI_STACK_PUBLICATION_REPORT_SESSION
    ?? process.env.PI_SESSION_FILE?.match(/\/core-sessions\/([0-9a-f-]{36})\//i)?.[1]
    ?? process.env.PI_REMOTE_SESSION_ID;
  if (!url && !sessionId) return null;
  if (!url || !sessionId) throw new Error("Cannot identify publication requester; set PI_STACK_PUBLICATION_REPORT_URL and PI_STACK_PUBLICATION_REPORT_SESSION");
  return validateReporter({ url, sessionId });
}

function remoteJson(reporter, suffix, method, body) {
  const output = checked("curl", ["--silent", "--show-error", "--fail-with-body", "--max-time", "8",
    "--request", method, "--header", "content-type: application/json",
    ...(body === undefined ? [] : ["--data-binary", "@-"]),
    `${reporter.url}/v1/sessions/${reporter.sessionId}${suffix}`,
  ], { timeoutSeconds: 10, input: body === undefined ? undefined : JSON.stringify(body) });
  return JSON.parse(output);
}

function deliverReport(request, key, presentation = request) {
  if (!request.reporter) return;
  if (request.report?.key === key && request.report.status === "delivered") return;
  if (request.report?.key !== key) {
    const digest = createHash("sha256").update(`${request.requestId}:${key}`).digest("hex");
    request.report = { key, status: "pending", requestId: `${digest.slice(0, 8)}-${digest.slice(8, 12)}-4${digest.slice(13, 16)}-a${digest.slice(17, 20)}-${digest.slice(20, 32)}` };
    writeRequest(request);
  }
  const report = request.report;
  try {
    if (!report.workId) {
      const accepted = remoteJson(request.reporter, "/prompt", "POST", {
        requestId: report.requestId,
        delivery: "steer",
        text: `Publication owner report. Please tell the user this result; do not retry or submit a release without a repair.\n\n${noticeBody(presentation)}`,
      });
      if (!accepted.accepted || !accepted.workId) throw new Error("Remote did not acknowledge publication report custody");
      report.workId = accepted.workId;
      report.status = "accepted";
      report.acceptedAt = new Date().toISOString();
      writeRequest(request);
    }
    // Delivery is confirmed from the thread's own queue, which is durable: the
    // report's work leaves it once the agent has the message. The activity feed
    // this used to read is a bounded window in memory, so a supervisor restart
    // between acceptance and the check could never confirm anything again.
    const view = remoteJson(request.reporter, "", "GET");
    const waiting = (view.session?.queuedMessages ?? []).some(message => message.id === report.workId);
    if (waiting) {
      report.status = "accepted";
    } else {
      report.status = "delivered";
      report.deliveredAt = new Date().toISOString();
    }
    delete report.error;
  } catch (error) {
    report.status = "failed";
    report.error = error instanceof Error ? error.message : String(error);
  }
  report.checkedAt = new Date().toISOString();
  writeRequest(request);
}

function noticeKey(request) {
  const state = request.status === "failed" ? `failed:${request.failure.at}`
    : request.status === "queued" && request.waiting ? `waiting:${JSON.stringify(targets.map(target => {
      const host = request.hosts?.[target.id];
      return [target.id, host?.status ?? "pending", host?.integrationSha ?? null, host?.waiting?.kind ?? null, host?.failure?.message ?? null];
    }))}` : request.status;
  const existing = request.report?.key;
  return existing === state || existing?.startsWith(`${state}:`) ? existing : state;
}

function deriveIssues() {
  const requests = allRequests();
  const byId = new Map(requests.map(request => [request.requestId, request]));
  const repairs = new Map(requests.map(request => [request.requestId, readRepair(request.requestId)]));
  const publications = requests.filter(request => request.status === "published" && request.integrationSha)
    .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
  const deployedSources = new Map();
  for (const publication of publications) {
    if (!deployedSources.has(publication.integrationSha)) deployedSources.set(publication.integrationSha, publication);
  }
  if (publications.length) {
    const ancestry = checked("git", ["--no-replace-objects", "-C", checkout, "rev-list", "--topo-order", "--parents",
      ...deployedSources.keys()], { timeoutSeconds: 5 });
    for (const line of ancestry.split("\n")) {
      const [sha, ...parents] = line.split(" ");
      const publication = deployedSources.get(sha);
      for (const parent of parents) {
        const existing = deployedSources.get(parent);
        if (!existing || existing.publishedAt < publication.publishedAt) deployedSources.set(parent, publication);
      }
    }
  }
  function resolution(request, seen = new Set()) {
    if (!request || seen.has(request.requestId)) return null;
    seen.add(request.requestId);
    if (request.status === "published") return { requestId: request.requestId, integrationSha: request.integrationSha, proof: request.finalProof?.path };
    const published = deployedSources.get(request.sourceSha);
    if (published) return { requestId: published.requestId, integrationSha: published.integrationSha, proof: published.finalProof?.path };
    return resolution(byId.get(repairs.get(request.requestId)?.successor?.requestId), seen);
  }
  const resolved = [], issues = [], superseded = [];
  for (const request of requests) {
    const custody = outstandingHostCustody(request);
    const cancelled = request.failure?.reason === "cancelled";
    if ((request.status !== "failed" || cancelled) && !(custody && ["failed", "published"].includes(request.status))) continue;
    const proof = custody ? null : resolution(request);
    if (proof) { resolved.push({ requestId: request.requestId, resolution: proof }); continue; }
    const repair = repairs.get(request.requestId);
    const successor = byId.get(repair?.successor?.requestId);
    if (!custody && successor && successor.failure?.reason !== "cancelled") {
      superseded.push({ requestId: request.requestId, successorId: successor.requestId });
      continue;
    }
    const condition = createHash("sha256").update(JSON.stringify({ source: request.sourceSha,
      status: request.status, failureAt: request.failure?.at, failure: request.failure?.message, reason: request.failure?.reason,
      step: request.step, custody, repair: repair?.status, successor: repair?.successor?.requestId })).digest("hex");
    issues.push({ requestId: request.requestId, condition, sourceSha: request.sourceSha, step: custody ? "restore-host-custody" : request.step,
      failure: custody ? "Host restoration remains outstanding; inspect the receipt's restoration plans." : String(request.failure?.reason ?? request.failure?.message ?? "").replace(/\s+/g, " ").slice(0, 300),
      repair: repair?.status ?? "unassigned", receipt: requestPath(request.requestId), repairReceipt: repair?.path });
  }
  const acknowledgements = existsSync(issueAcknowledgementsPath) ? JSON.parse(readFileSync(issueAcknowledgementsPath, "utf8")) : {};
  const acknowledged = issues.filter(issue => acknowledgements[issue.requestId]?.condition === issue.condition);
  const visible = issues.filter(issue => acknowledgements[issue.requestId]?.condition !== issue.condition);
  return { issues, resolved, superseded, acknowledged: acknowledged.map(issue => issue.requestId), visible };
}

function reconcileIssueAlert() {
  const index = deriveIssues();
  if (index.visible.length === 0) { rmSync(issueAlertPath, { force: true }); return index; }
  const body = ["# Pi Stack publication needs repair", "", `Repository: ${repositoryUrl}`,
    `Deployment/proof targets: ${targets.map(target => target.id).join(", ")}`,
    `${index.visible.length} unacknowledged publication issue(s). Run ${installedCommand} issues for the complete derived list.`,
    "Read the named receipt before acting. Repair owners retain their work; do not replay requests.", "",
    ...index.visible.slice(0, 8).map(issue => `- ${issue.requestId}: ${issue.step}; repair ${issue.repair}. ${issue.failure}\n  Receipt: ${issue.receipt}`),
    ...(index.visible.length > 8 ? [`${index.visible.length - 8} further issues are in the derived list.`] : []), ""].join("\n");
  if (!existsSync(issueAlertPath) || readFileSync(issueAlertPath, "utf8") !== body) atomicWrite(issueAlertPath, body, 0o660);
  return index;
}

function acknowledgeIssues() {
  const { issues } = deriveIssues();
  const acknowledgements = existsSync(issueAcknowledgementsPath) ? JSON.parse(readFileSync(issueAcknowledgementsPath, "utf8")) : {};
  const at = new Date().toISOString();
  for (const issue of issues) acknowledgements[issue.requestId] = { condition: issue.condition, at, receipt: issue.receipt };
  atomicWrite(issueAcknowledgementsPath, `${JSON.stringify(acknowledgements, null, 2)}\n`);
  reconcileIssueAlert();
  process.stdout.write(`${issueAcknowledgementsPath}\n`);
}

function noticeProjection(request, index) {
  if (!["failed", "published"].includes(request.status) && !(request.status === "queued" && request.waiting)) return null;
  if (index.superseded.some(item => item.requestId === request.requestId)) return null;
  const resolution = index.resolved.find(item => item.requestId === request.requestId)?.resolution;
  if (resolution && resolution.requestId !== request.requestId) {
    const completion = readRequest(resolution.requestId);
    if (completion.reporter && JSON.stringify(completion.reporter) === JSON.stringify(request.reporter)) return null;
    return { key: `resolved:${resolution.requestId}:${resolution.integrationSha}`, presentation: {
      ...request, status: "published", step: "complete", integrationSha: resolution.integrationSha,
      finalProof: { path: resolution.proof }, resolvedBy: resolution.requestId,
    } };
  }
  return { key: noticeKey(request), presentation: request };
}

function reconcileNotices() {
  const index = reconcileIssueAlert();
  const candidates = allRequests().filter(request => {
    const projection = noticeProjection(request, index);
    return projection && request.reporter && (request.report?.key !== projection.key || request.report.status !== "delivered");
  });
  candidates.sort((a, b) => (a.noticeCheckedAt ?? "").localeCompare(b.noticeCheckedAt ?? ""));
  if (candidates[0]) deliverNotice(candidates[0], index);
}

function deliverNotice(request, index = reconcileIssueAlert()) {
  const projection = noticeProjection(request, index);
  if (!projection) return;
  request.noticeCheckedAt = new Date().toISOString();
  writeRequest(request);
  deliverReport(request, projection.key, projection.presentation);
}

function report(requestId, url, sessionId) {
  validateRequestId(requestId);
  const request = readRequest(requestId);
  if (url) {
    const reporter = validateReporter({ url, sessionId });
    if (request.reporter && JSON.stringify(request.reporter) !== JSON.stringify(reporter)) throw new Error("Publication already has another requester");
    request.reporter = reporter;
    writeRequest(request);
  }
  deliverNotice(request);
  inspect(requestId);
}

function prepareCheckout(request, logPath) {
  mkdirSync(checkout, { recursive: true, mode: 0o700 });
  if (!existsSync(join(checkout, ".git"))) {
    let result = runLogged(request, "initialize-publication-checkout", "git", ["init", "--quiet", checkout], 30, logPath);
    if (!result.ok) return result;
  }
  if (!commandResult("git", ["-C", checkout, "remote", "get-url", "origin"]).ok) {
    const result = runLogged(request, "configure-publication-origin", "git", ["-C", checkout, "remote", "add", "origin", repositoryUrl], 30, logPath);
    if (!result.ok) return result;
  }
  const remote = runCapture("git", ["-C", checkout, "remote", "get-url", "origin"]);
  if (remote !== repositoryUrl) return { ok: false, status: 1, stderr: `publication checkout has wrong origin: ${remote}` };
  let result = runLogged(request, "reset-publication-checkout", "git", ["-C", checkout, "reset", "--hard"], 30, logPath);
  if (!result.ok) return result;
  result = runLogged(request, "clean-publication-checkout", "git", ["-C", checkout, "clean", "-dffx", "-e", "/node_modules/", "-e", "**/node_modules/",
    "-e", "/packages/*/dist/", "-e", "/apps/remote/web/dist/", "-e", "/apps/remote/server/phone/dist/", "-e", "/apps/remote/server/meet/adapter-dist/",
    "-e", "/apps/kenan/dist/", "-e", "/apps/kenan/android/.gradle/", "-e", "/apps/kenan/android/app/build/"], 30, logPath);
  if (!result.ok) return result;
  return runLogged(request, "fetch-main", "git", ["-C", checkout, "fetch", "--quiet", "--no-tags", "origin", "+refs/heads/main:refs/remotes/origin/main"], 60, logPath);
}

export function integrateSourceBundle(request, logPath) {
  const members = sourceBundleMembers(request);
  if (!members.ok) return { ok: false, status: 1, stderr: `${members.error.kind}: ${members.error.detail}` };
  for (const source of members.sources) checkCancellation(readRequest(source.requestId));
  let result = runLogged(request, "fetch-submitted-sources", "git",
    ["-C", checkout, "fetch", "--quiet", "--no-tags", "origin", ...members.sources.map(source => `+${source.sourceRef}:refs/pi-stack-publication/${source.requestId}/source`)], 60, logPath);
  if (!result.ok) return result;
  for (const source of members.sources) {
    const fetchedSource = runCapture("git", ["-C", checkout, "rev-parse", `refs/pi-stack-publication/${source.requestId}/source^{commit}`]);
    if (fetchedSource !== source.sourceSha) return { ok: false, status: 1, stderr: `source ref moved from ${source.sourceSha} to ${fetchedSource}` };
  }
  const baseSha = runCapture("git", ["-C", checkout, "rev-parse", "refs/remotes/origin/main^{commit}"]);
  result = runLogged(request, "create-integration", "git", ["-C", checkout, "checkout", "--quiet", "-B", "pi-stack-publication", baseSha], 30, logPath);
  if (!result.ok) return result;
  for (const source of members.sources) {
    const contained = commandResult("git", ["--no-replace-objects", "-C", checkout, "merge-base", "--is-ancestor", source.sourceSha, "HEAD"]);
    if (contained.status === 0) continue;
    if (contained.status !== 1) return contained;
    result = runLogged(request, "merge-source", "git", [
      "-C", checkout, "-c", `user.name=${config.mergeAuthor.name}`, "-c", `user.email=${config.mergeAuthor.email}`,
      "merge", "--no-ff", "--no-edit", "-m", `Integrate Pi Stack publication ${source.requestId}\n\nPi-Stack-Source: ${source.sourceSha}`, source.sourceSha,
    ], 60, logPath);
    if (!result.ok) return result;
  }
  for (const source of members.sources) {
    const proof = commandResult("git", ["--no-replace-objects", "-C", checkout, "merge-base", "--is-ancestor", source.sourceSha, "HEAD"]);
    if (!proof.ok) return { ...proof, stderr: `combined integration omits ${source.requestId}: ${source.sourceSha}` };
  }
  return { ok: true, status: 0, stdout: "", stderr: "", baseSha };
}

function createIntegration(request, logPath) {
  let result = integrateSourceBundle(request, logPath);
  if (!result.ok) return result;
  const { baseSha } = result;
  if (request.ownerRepairSourceSha && !commandResult("git", ["-C", checkout, "merge-base", "--is-ancestor", request.ownerRepairSourceSha, "HEAD"]).ok) {
    const retained = checked("git", ["-C", checkout, "rev-parse", `${ownerSourceRef}^{commit}`]);
    if (retained !== request.ownerRepairSourceSha) throw new Error("Owner repair source changed; fresh bound evidence required");
    result = runLogged(request, "merge-bound-owner-repair", "git", ["-C", checkout, "-c", `user.name=${config.mergeAuthor.name}`, "-c", `user.email=${config.mergeAuthor.email}`, "merge", "--no-ff", "--no-edit", "-m", `Repair publication owner for ${request.requestId} within existing publication`, retained], 60, logPath);
    if (!result.ok) return result;
  }
  const integrationSha = runCapture("git", ["-C", checkout, "rev-parse", "HEAD^{commit}"]);
  checkOwnerSource(checkout, integrationSha);
  const localProperties = config.androidProperties;
  if (!existsSync(localProperties)) return { ok: false, status: 1, stderr: `missing host-owned Android configuration: ${localProperties}` };
  mkdirSync(join(checkout, "apps/kenan/android"), { recursive: true });
  copyFileSync(localProperties, join(checkout, "apps/kenan/android/local.properties"));
  request.baseSha = baseSha;
  request.integrationSha = integrationSha;
  const androidPlan = existsSync(join(checkout, "deploy/android-update"))
    ? JSON.parse(runCapture("bun", [join(checkout, "deploy/android-update"), "plan", requestRoot], { timeoutSeconds: 30, cwd: checkout }))
    : { kind: "native" };
  if (!["native", "web"].includes(androidPlan.kind) || androidPlan.identity && androidPlan.identity.revision !== integrationSha) throw new Error("Invalid Android artifact build plan");
  const androidChecks = androidPlan.kind === "native" ? "npm run android:test --workspace=kenan"
    : "node --test apps/kenan/release-info.test.mjs && bun test apps/kenan/connect-adb.test.ts";
  const checksCommand = `npm run check && ${androidChecks}`;
  request.checks = { status: "running", command: checksCommand, androidPlan, log: logPath };
  writeRequest(request);
  result = runLogged(
    request,
    "checks",
    "bash",
    ["-c", 'set -euo pipefail\nsource deploy/lib\npi_stack_prepare_dependencies "$PWD"\nnpm run check'],
    900,
    logPath,
    { cwd: checkout, env: { ...process.env, PI_STACK_CHECK_CACHE_DIR: join(stateRoot, 'check-cache') } },
  );
  if (!result.ok) return result;
  result = runLogged(request, 'android-checks', 'bash', ['-c', `set -euo pipefail\n${androidChecks}`], 180, logPath, { cwd: checkout });
  if (!result.ok) return result;
  if (androidPlan.kind === 'native') {
    request.nativeChecks = { status: 'passed', revision: integrationSha, identity: androidPlan.identity,
      command: 'npm run android:test --workspace=kenan', at: new Date().toISOString() };
    writeRequest(request);
  }
  request.baseSha = baseSha;
  request.integrationSha = integrationSha;
  request.checks = {
    status: "passed",
    command: checksCommand,
    androidPlan,
    at: new Date().toISOString(),
    log: logPath,
  };
  request.step = "checks-passed";
  writeRequest(request);
  return { ok: true, status: 0, stdout: "", stderr: "" };
}

function prepareAndroidArtifact(request, logPath) {
  const supported = commandResult("git", ["-C", checkout, "cat-file", "-e", `${request.integrationSha}:deploy/android-update`]);
  if (!supported.ok) { delete request.android; return; }
  const directory = request.bundleEvidence?.integrationSha === request.integrationSha && request.android
    ? request.android.directory : join(proofRoot, request.requestId, "android-artifact", request.integrationSha);
  if ((request.android?.web?.revision ?? request.android?.release?.revision) === request.integrationSha && existsSync(join(directory, request.android.release.fileName))
    && existsSync(join(directory, `${request.integrationSha}.web.zip`))) {
    if (sha256(join(directory, request.android.release.fileName)) !== request.android.release.sha256) throw new Error("Prepared Android artifact is corrupt");
    const web = JSON.parse(readFileSync(join(directory, "web-manifest.json"), "utf8"));
    if (sha256(join(directory, web.fileName)) !== web.sha256) throw new Error("Prepared web bundle is corrupt");
    return;
  }
  let result = runLogged(request, "select-android-source", "git", ["-C", checkout, "checkout", "--quiet", "--detach", request.integrationSha], 30, logPath);
  if (!result.ok) throw new Error("Could not select the checked Android source");
  const plan = request.checks.androidPlan;
  if (!plan || plan.kind === "native") {
    const apk = join(checkout, "apps/kenan/android/app/build/outputs/apk/debug/app-debug.apk");
    const identity = commandResult("unzip", ["-p", apk, "assets/app-release.json"]);
    let builtRevision;
    if (identity.ok) builtRevision = JSON.parse(identity.stdout).revision;
    if (builtRevision !== request.integrationSha) {
      copyFileSync(config.androidProperties, join(checkout, "apps/kenan/android/local.properties"));
      result = runLogged(request, "build-android-update", "bash", ["-c", 'set -euo pipefail\nsource deploy/lib\npi_stack_prepare_dependencies "$PWD"\nnpm run android:build --workspace=kenan'], 180, logPath, { cwd: checkout });
      if (!result.ok) throw new Error(`Android update build exited ${result.status}`);
    }
  } else if (plan.kind !== "web") throw new Error("Unknown checked Android build plan");
  if (existsSync(directory) && !existsSync(join(directory, `${request.integrationSha}.web.zip`))) rmSync(directory, { recursive: true, force: true });
  const args = plan?.kind === "web" ? ["prepare-web", directory, plan.nativeDirectory] : ["prepare", directory];
  result = runLogged(request, "prepare-android-update", join(checkout, "deploy/android-update"), args, 60, logPath);
  if (!result.ok) throw new Error(`Android artifact preparation exited ${result.status}`);
  const manifest = join(directory, "manifest.json");
  const release = JSON.parse(readFileSync(manifest, "utf8"));
  const web = JSON.parse(readFileSync(join(directory, "web-manifest.json"), "utf8"));
  if (web.revision !== request.integrationSha || web.shellId !== release.shellId || web.versionCode < release.versionCode) throw new Error("Prepared web revision or native compatibility does not match the checked integration");
  request.android = { release, web, directory, manifest, status: "prepared", hosts: {} };
  writeRequest(request);
}

function publishAndroidArtifact(request, logPath, selectedTargets = targets) {
  if (!request.android) return;
  const { directory, manifest } = request.android;
  // Ship the checked installer with the artifact: neither host needs to select the
  // new server before it can offer the matching client.
  const installer = join(directory, "android-update.js");
  if (request.android.installer) {
    if (!existsSync(installer) || sha256(installer) !== request.android.installer.sha256) throw new Error("Prepared Android installer is corrupt");
  } else {
    const build = runLogged(request, "prepare-android-installer", "bun", [join(checkout, "deploy/android-update"), "bundle", installer], 30, logPath);
    if (!build.ok) throw new Error(`Android installer build exited ${build.status}`);
    request.android.installer = { sha256: sha256(installer) };
    writeRequest(request);
  }
  const installerHash = request.android.installer.sha256;
  for (const target of selectedTargets) {
    const remoteDirectory = target.sshHost && join(target.androidTransferRoot, request.requestId);
    const tool = target.sshHost ? join(remoteDirectory, "android-update.js") : installer;
    if (target.sshHost) {
      let result = runLogged(request, `transfer-android-${target.id}`, "ssh", ["-o", "BatchMode=yes", target.sshHost, "mkdir", "-p", "-m", "700", remoteDirectory], 30, logPath);
      if (!result.ok) throw new Error(`${target.id} Android transfer directory exited ${result.status}`);
      result = runLogged(request, `transfer-android-${target.id}`, "rsync", ["-a", "--chmod=D700,F600", `${directory}/`, `${target.sshHost}:${remoteDirectory}/`], 90, logPath);
      if (!result.ok) throw new Error(`${target.id} Android transfer exited ${result.status}`);
      const remoteHash = runCapture("ssh", ["-o", "BatchMode=yes", target.sshHost, "sha256sum", tool], { timeoutSeconds: 30 }).split(/\s+/)[0];
      if (remoteHash !== installerHash) throw new Error(`${target.id} Android installer differs from the checked source bundle`);
    }
    const invocation = target.sshHost ? ["ssh", ["-o", "BatchMode=yes", target.sshHost, "sudo", "-n", "bun", tool, "install", remoteDirectory]] : ["sudo", ["-n", "bun", tool, "install", directory]];
    const result = runLogged(request, `publish-android-${target.id}`, ...invocation, 30, logPath);
    if (!result.ok) throw new Error(`${target.id} Android publication exited ${result.status}`);
    const verify = target.sshHost ? ["ssh", ["-o", "BatchMode=yes", target.sshHost, "bun", tool, "verify", `${remoteDirectory}/manifest.json`]] : ["bun", [tool, "verify", manifest]];
    request.android.hosts[target.id] = JSON.parse(runCapture(...verify, { timeoutSeconds: 30 }));
    writeRequest(request);
    if (remoteDirectory) {
      const cleanup = runLogged(request, `remove-android-transfer-${target.id}`, "ssh", ["-o", "BatchMode=yes", target.sshHost, "rm", "-rf", remoteDirectory], 30, logPath);
      if (!cleanup.ok) throw new Error(`${target.id} Android transfer cleanup exited ${cleanup.status}`);
    }
  }
  request.android.status = targets.every(target => request.android.hosts[target.id]) ? "published" : "partial";
  writeRequest(request);
}

export function publishIntegration(request, logPath) {
  const refresh = step => runLogged(request, step, "git", ["-C", checkout, "fetch", "--quiet", "--no-tags", "origin", "+refs/heads/main:refs/remotes/origin/main"], 60, logPath);
  const main = () => runCapture("git", ["-C", checkout, "rev-parse", "refs/remotes/origin/main^{commit}"]);
  const moved = remoteMain => ({ ok: false, kind: "main-moved", remoteMain });
  let fetch = refresh("refresh-integration-base");
  if (!fetch.ok) return fetch;
  let remoteMain = main();
  if (remoteMain !== request.integrationSha) {
    if (remoteMain !== request.baseSha) return moved(remoteMain);
    const result = runLogged(request, "integrate-main", "git", ["-C", checkout, "push", "--quiet", "origin", `${request.integrationSha}:refs/heads/main`], 60, logPath);
    const pushProgress = request.progress;
    fetch = refresh("confirm-integrated-main");
    if (!fetch.ok) return fetch;
    remoteMain = main();
    if (remoteMain !== request.integrationSha) {
      if (remoteMain !== request.baseSha) return moved(remoteMain);
      request.step = "integrate-main";
      request.progress = pushProgress;
      writeRequest(request);
      return result.ok ? { ok: false, status: 1, stderr: "main did not retain the pushed integration" } : result;
    }
  }
  request.integratedAt = new Date().toISOString();
  request.step = "integrated";
  writeRequest(request);
  return { ok: true, status: 0, stdout: "", stderr: "" };
}

export const publicationReservationScript = readFileSync(join(dirname(self), "release-checkout"), "utf8") + String.raw`
set -euo pipefail
pi_stack_acquire_host_lock
reservation="\${PI_STACK_HOST_LOCK_PATH:-/srv/pi/.pi-stack-deploy.lock}.publication"
operation=$1
request=$2
commit=$3
become=()
[[ $EUID == 0 ]] || become=(sudo -n)
if [[ -e $reservation ]]; then
  jq -e --arg request "$request" --arg commit "$commit" \
    '.requestId == $request and .integrationSha == $commit' "$reservation" >/dev/null || {
    echo "host reservation belongs to another publication: $(<"$reservation")" >&2; exit 75;
  }
fi
case "$operation" in
  reserve)
    jq -nc --arg request "$request" --arg commit "$commit" '{requestId:$request,integrationSha:$commit}' \
      | "\${become[@]}" tee "$reservation.next" >/dev/null
    "\${become[@]}" chmod 644 "$reservation.next"
    "\${become[@]}" mv -f "$reservation.next" "$reservation"
    ;;
  release) "\${become[@]}" rm -f "$reservation" "$reservation.next" ;;
  *) exit 64 ;;
esac
`.replaceAll("\\${", "${");

export function nativeHistoryCustodyOwners(request, target) {
  return allRequests().filter(owner => owner.requestId !== request.requestId).flatMap(owner => {
    const history = owner.nativeHistory?.hosts?.[target.id];
    if (!history || ["restored", "released"].includes(history.state)) return [];
    return [{ requestId: owner.requestId, integrationSha: history.integrationSha, state: history.state, receipt: requestPath(owner.requestId) }];
  });
}

export function reserveTarget(request, target, logPath) {
  ensureState();
  const owners = nativeHistoryCustodyOwners(request, target);
  if (owners.length) return { ok: false, status: 75, kind: "native-history-custody", owners };
  request.reservations ??= {};
  request.reservations[target.id] = { state: "restore-required", integrationSha: request.integrationSha };
  writeRequest(request);
  const args = ["reserve", request.requestId, request.integrationSha];
  return target.sshHost
    ? runLogged(request, `reserve-${target.id}`, "ssh", ["-o", "BatchMode=yes", target.sshHost, "bash", "-s", "--", ...args], 45, logPath, { input: publicationReservationScript })
    : runLogged(request, `reserve-${target.id}`, "bash", ["-s", "--", ...args], 45, logPath, { input: publicationReservationScript });
}

export function restoreReservation(request, target) {
  const reservation = request.reservations?.[target.id];
  if (!custodyNeedsRestore(reservation)) return;
  runHostScript(publicationReservationScript, target.sshHost,
    ["release", request.requestId, reservation.integrationSha], 45);
  reservation.state = "released";
  writeRequest(request);
}

export function deployTarget(request, target, logPath) {
  const fd = openSync(logPath, "a", 0o600);
  const start = fstatSync(fd).size;
  closeSync(fd);
  const env = [`PI_STACK_PUBLICATION_REQUEST=${request.requestId}`, ...(meetingOverride(request.requestId) ? ["PI_STACK_ALLOW_LIVE_MEETING_RESTART=1"] : [])];
  const result = target.sshHost
    ? runLogged(request, `deploy-${target.id}`, "ssh", ["-o", "BatchMode=yes", target.sshHost, "env", ...env, target.releaseCommand, request.integrationSha], 420, logPath)
    : runLogged(request, `deploy-${target.id}`, "env", [...env, target.releaseCommand, request.integrationSha], 420, logPath);
  const tail = result.status === 75 ? logTail(logPath, start) : "";
  if (/^another Pi stack deployment owns \/[^\r\n]+$/m.test(tail)) return { ...result, kind: "host-lock-busy" };
  if (/^(live meeting rooms on this host \([^\r\n]+\); deploying now would end them|meeting census unavailable on this host: .*)$/m.test(tail)) return { ...result, kind: "host-lock-busy", liveMeeting: true };
  if (/^native source prerequisite [^\r\n]+ requires [0-9a-f]{40} before Pi Stack [0-9a-f]{40}; selected [0-9a-f]{40}$/m.test(tail)) return { ...result, kind: "host-lock-busy", nativePrerequisite: true };
  if (/^native history boundary waiting: [^\r\n]+$/m.test(tail)) return { ...result, kind: "host-lock-busy", nativeHistory: true };
  return result;
}

export function requeueBusyHost(request, target, logPath, waitKind = "host-lock") {
  const progress = request.progress;
  for (const host of targets) {
    restoreCustody(request, host.id, host.sshHost);
    restoreMaintenance(request, host.id, host.sshHost);
    restoreReservation(request, host);
  }
  request.progress = progress;
  request.status = "queued";
  request.step = hostWaitKind({ kind: waitKind });
  if (waitKind !== "host-lock") delete request.blockedSince;
  else request.blockedSince ??= new Date().toISOString();
  request.nextAttemptAt = new Date(Date.now() + policy.blockedRetryMs).toISOString();
  request.waiting = {
    kind: waitKind, host: target.id, at: new Date().toISOString(), log: logPath,
    reason: waitKind === "live-meeting"
      ? `${target.id} has live meeting rooms that a Pi Remote restart would end. The publication owner will probe without deploying and resume this attempt once they close.`
      : waitKind === "native-source"
        ? `${target.id} requires a newer native selected source before this Pi Stack release. The publication owner will probe without deploying and resume this attempt once that source is serving.`
        : waitKind === "native-history"
          ? `${target.id} old native generation is still settling its history. The publication owner will probe without deploying and resume once maintenance is ready.`
          : `${target.id} has an active Pi Stack deployment. The publication owner will resume after the host lock is released, within its existing attempt and wait budgets.`,
  };
  (request.hostLockWaits ??= []).push({ ...request.waiting, attempt: request.attempt, progress });
  writeRequest(request);
  appendLog(logPath, `[${new Date().toISOString()}] ${request.waiting.reason}\n`);
  deliverNotice(request);
}

/** Live meetings on a target, as census words; empty when none. Throws when the census cannot answer. */
export function censusTarget(target, protocol = null) {
  const script = readFileSync(join(dirname(self), "meeting-census"), "utf8");
  const mode = protocol === "meet-runtime-v1" ? "--restart-blockers" : "--all";
  return target.sshHost
    ? runCapture("ssh", ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", target.sshHost, "bash", "-s", "--", mode], { input: script, timeoutSeconds: 45 })
    : runCapture("bash", ["-s", "--", mode], { input: script, timeoutSeconds: 45 });
}

function meetingRuntimeProtocol(sha) {
  const path = "apps/remote/meeting-runtime.json";
  const present = runCapture("git", ["-C", checkout, "ls-tree", "--name-only", sha, "--", path]);
  if (!present) return null;
  const manifest = JSON.parse(runCapture("git", ["-C", checkout, "show", `${sha}:${path}`]));
  if (manifest.protocol !== "meet-runtime-v1" || manifest.lifetime !== "person-service") throw new Error("Unsupported meeting runtime lifetime contract");
  return manifest.protocol;
}

/** Before the first host deploys, a live meeting on any target holds the whole release. */
export function liveMeetingTarget(request) {
  if (meetingOverride(request.requestId)) return null;
  if (targets.some(target => request.hosts?.[target.id]?.status === "passed")) return null;
  for (const target of targets) {
    let rooms;
    try { rooms = censusTarget(target, request.meetingRuntimeProtocol); } catch (error) { rooms = `census unavailable: ${error.message}`; }
    if (rooms) return { target, rooms };
  }
  return null;
}

export function refreshMeetingWait(request) {
  const target = targets.find(target => target.id === request.waiting.host);
  if (!target) throw new Error(`Unknown meeting-wait host: ${request.waiting.host}`);
  if (meetingOverride(request.requestId)) return true;
  const rooms = censusTarget(target, request.meetingRuntimeProtocol);
  request.waiting.probe = { at: new Date().toISOString(), rooms };
  delete request.waiting.probeFailingSince;
  if (rooms) request.nextAttemptAt = new Date(Date.now() + policy.blockedRetryMs).toISOString();
  writeRequest(request);
  return !rooms;
}

function nativeSourceProbe(request, target, ensureSource = false) {
  const script = (ensureSource ? 'set -euo pipefail\ngit -C "$2" fetch --quiet --no-tags origin "$3"\n' : "") + readFileSync(join(dirname(self), "native-prerequisites"), "utf8");
  const args = [target.hostConfig, target.releaseRepository, request.integrationSha];
  const command = target.sshHost ? "ssh" : "bash";
  const commandArgs = target.sshHost
    ? ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", target.sshHost, "bash", "-s", "--", ...args]
    : ["-s", "--", ...args];
  const result = commandResult(command, commandArgs, { input: script, timeoutSeconds: 45 });
  if (!result.ok && !(result.status === 75 && /^native source prerequisite [^\r\n]+ requires [0-9a-f]{40} before Pi Stack [0-9a-f]{40}; selected [0-9a-f]{40}$/m.test(result.stderr))) {
    throw Object.assign(new Error(result.stderr.trim() || `native prerequisite probe exited ${result.status}`), {
      probeFailure: { kind: "native-source", host: target.id, status: result.status, command: [command, ...commandArgs] },
    });
  }
  return result;
}

export function nativeMaintenanceSourceProof(repository, candidate, retained) {
  const files = ['deploy/native-history-boundary', 'deploy/native-history-coordinator.mjs', 'deploy/native-history-owner-recovery.mjs', 'deploy/native-history-bridge.mjs',
    'deploy/native-history-closed-owner.mjs', 'deploy/native-history-package-identity.mjs', 'deploy/native-history-root-boundary',
    'deploy/one-kenan-activate', 'scripts/migrate-native-history.mjs'];
  try {
    const tree = sha => new Map(checked('git', ['-C', repository, 'ls-tree', '-r', '--format=%(objectname) %(path)', sha, '--', ...files])
      .split('\n').filter(Boolean).map(line => [line.slice(41), line.slice(0, 40)]));
    const selected = tree(candidate), current = tree(retained);
    const changed = files.filter(path => selected.get(path) !== current.get(path));
    return changed.length === 0 ? { ok: true, value: { candidate, retained } }
      : { ok: false, error: { code: 'obsolete-native-maintenance-source', candidate, retained, changed } };
  } catch (error) { return { ok: false, error: { code: 'native-maintenance-source-unavailable', message: String(error) } }; }
}

export function nativeMaintenanceIntakeProof(repository, candidate) {
  try {
    const source = checked('git', ['-C', repository, 'show', `${candidate}:deploy/native-history-bridge.mjs`]);
    return /^export const MAINTENANCE_INTAKE = ['"]always-open-v1['"];$/m.test(source)
      ? { ok: true, value: { candidate, intake: 'always-open-v1' } }
      : { ok: false, error: { code: 'closed-intake-maintenance-forbidden', candidate } };
  } catch (error) { return { ok: false, error: { code: 'maintenance-intake-contract-unavailable', message: String(error) } }; }
}

export function nativeHistoryBoundaryTarget(request, target, mode, logPath) {
  if (!["advance", "probe", "restore"].includes(mode)) throw new Error(`Unknown native history boundary mode: ${mode}`);
  const path = "deploy/native-history-boundary";
  const present = runCapture("git", ["-C", checkout, "ls-tree", "--name-only", request.integrationSha, "--", path]);
  if (!present) return { ok: true, status: 0, needed: false };
  if (mode !== 'restore') {
    const retained = checked('git', ['-C', checkout, 'for-each-ref', '--format=%(objectname)', ownerSourceRef]);
    if (retained) {
      const proof = nativeMaintenanceSourceProof(checkout, request.integrationSha, retained);
      if (!proof.ok) throw Object.assign(new Error(`Native maintenance source requires the retained owner repair: ${JSON.stringify(proof.error)}`), {
        probeFailure: { kind: 'native-source', mode, host: target.id, status: 1, sourceProof: proof.error },
      });
    }
  }
  if (mode !== 'restore') {
    const intake = nativeMaintenanceIntakeProof(checkout, request.integrationSha);
    if (!intake.ok) throw Object.assign(new Error(`Deployment must keep agent intake open: ${JSON.stringify(intake.error)}`), {
      probeFailure: { kind: 'native-source', mode, host: target.id, status: 1, intakeProof: intake.error },
    });
  }
  const source = runCapture("git", ["-C", checkout, "show", `${request.integrationSha}:${path}`]);
  const script = (mode === "advance" ? 'set -euo pipefail\ngit -C "$2" fetch --quiet --no-tags origin "$3"\n' : "") + source;
  const args = [target.hostConfig, target.releaseRepository, request.integrationSha, ...(mode === "advance" ? [] : [`--${mode}`])];
  const command = target.sshHost ? "ssh" : "bash";
  const commandArgs = target.sshHost
    ? ["-o", "BatchMode=yes", "-o", "ConnectTimeout=5", target.sshHost, "bash", "-s", "--", ...args]
    : ["-s", "--", ...args];
  if (mode === "advance") {
    (request.nativeHistory ??= { hosts: {} }).hosts[target.id] = { state: "restore-required", integrationSha: request.integrationSha };
    writeRequest(request);
  }
  const start = logPath && existsSync(logPath) ? statLogSize(logPath) : 0;
  const result = mode === "advance"
    ? runLogged(request, `native-history-${target.id}`, command, commandArgs, 45, logPath, { input: script })
    : commandResult(command, commandArgs, { input: script, timeoutSeconds: 45 });
  const detail = mode === "advance" ? logTail(logPath, start) : result.stderr;
  if (!result.ok && !(mode !== "restore" && result.status === 75 && /^native history boundary waiting: [^\r\n]+$/m.test(detail))) {
    throw Object.assign(new Error(detail.trim() || `native history boundary ${mode} exited ${result.status}`), {
      probeFailure: { kind: "native-history", mode, host: target.id, status: result.status, command: [command, ...commandArgs] },
    });
  }
  return result;
}

function statLogSize(path) {
  const fd = openSync(path, "r");
  try { return fstatSync(fd).size; } finally { closeSync(fd); }
}

function restoreNativeHistory(request, target, explicit = false) {
  if (!explicit && nativeHistoryRepairHeld(request)) return;
  const host = request.nativeHistory?.hosts?.[target.id];
  if (!custodyNeedsRestore(host) && !(explicit && host?.state === "repair-required")) return;
  nativeHistoryBoundaryTarget({ ...request, integrationSha: host.integrationSha }, target, "restore");
  host.state = "restored";
  host.restoredAt = new Date().toISOString();
  writeRequest(request);
}

export function recoverNativeHistoryCustody(request, hostId) {
  if (request.status !== "failed") throw new Error("Only a failed request can explicitly recover native history custody");
  const target = targets.find(target => target.id === hostId);
  if (!target) throw new Error(`Unknown native history recovery host: ${hostId}`);
  if (!custodyNeedsRestore(request.nativeHistory?.hosts?.[target.id]) && request.nativeHistory?.hosts?.[target.id]?.state !== "repair-required") {
    throw new Error(`No repair-held native history custody remains on ${hostId}`);
  }
  const recovery = { at: new Date().toISOString(), hosts: [], status: "running" };
  (request.nativeHistoryRecoveries ??= []).push(recovery);
  writeRequest(request);
  try {
    restoreNativeHistory(request, target, true);
    recovery.hosts.push(target.id);
    recovery.status = "restored";
  } catch (error) {
    recovery.status = "failed";
    recovery.error = error instanceof Error ? error.message : String(error);
    throw error;
  } finally {
    recovery.finishedAt = new Date().toISOString();
    writeRequest(request);
  }
}

function releaseNativeHistory(request, target) {
  const host = request.nativeHistory?.hosts?.[target.id];
  if (!host || host.state === "released") return;
  host.state = "released";
  host.releasedAt = new Date().toISOString();
  writeRequest(request);
}

export function refreshNativeSourceWait(request) {
  const target = targets.find(target => target.id === request.waiting.host);
  if (!target) throw new Error(`Unknown native-source-wait host: ${request.waiting.host}`);
  const result = nativeSourceProbe(request, target);
  request.waiting.probe = { at: new Date().toISOString(), selected: result.status === 75 ? result.stderr.trim() : "ready" };
  delete request.waiting.probeFailingSince;
  if (result.status === 75) request.nextAttemptAt = new Date(Date.now() + policy.blockedRetryMs).toISOString();
  writeRequest(request);
  return result.ok;
}

export function requeueMovedIntegration(request, remoteMain, logPath) {
  const ref = `refs/pi-stack-publication/${request.requestId}/integrations/${request.integrationSha}`;
  const retained = runLogged(request, "retain-moved-integration", "git", ["-C", checkout, "update-ref", ref, request.integrationSha], 30, logPath);
  if (!retained.ok) throw new Error(`Could not retain checked integration ${request.integrationSha}`);
  for (const target of targets) {
    restoreCustody(request, target.id, target.sshHost);
    restoreMaintenance(request, target.id, target.sshHost);
    restoreReservation(request, target);
  }
  const fields = ["baseSha", "integrationSha", "checks", "android", "hosts", "integratedAt", "releaseAncestry", "contractGate"];
  const integration = Object.fromEntries(fields.filter(key => request[key] !== undefined).map(key => [key, request[key]]));
  (request.mainMovements ??= []).push({ ...integration, ref, remoteMain, attempt: request.attempt, log: logPath,
    at: new Date().toISOString(), bootstrap: structuredClone(request.bootstrap), maintenance: structuredClone(request.maintenance) });
  for (const key of fields) delete request[key];
  request.status = "queued";
  request.step = "main-moved-recheck-required";
  writeRequest(request);
  appendLog(logPath, `[${new Date().toISOString()}] main moved to ${remoteMain}; retained ${ref}; queued a fresh integration and full checks\n`);
}

export const hostProofScript = String.raw`
set -euo pipefail
expected=$1
host=$2
environment=$3
host_config=$4
voice_url=$5
service_check=$6
shift 6
remote=$(< /srv/pi/pi-remote/.pi-stack-commit)
orchestrator=$(< /srv/pi/pi-orchestrator/.pi-stack-commit)
source /srv/pi/pi-remote/deploy/lib
fleet_user=$(jq -er '.fleetUser | select(type == "string" and length > 0)' "$host_config")
services=$("$service_check" "$fleet_user" "$environment" --json)
voice=$(pi_stack_as_root curl -fsS --max-time 3 "$voice_url" | jq -r .releaseCommit)
[[ $remote == "$expected" && $orchestrator == "$expected" && $voice == "$expected" ]] || {
  printf '%s: deployed commit markers do not match integration: expected=%s remote=%s orchestrator=%s voice=%s\n' "$host" "$expected" "$remote" "$orchestrator" "$voice" >&2; exit 1;
}
for unit in "$@"; do
  systemctl is-active --quiet "$unit" || { echo "$unit is not active" >&2; exit 1; }
  services=$(jq -c --arg unit "$unit" '.units[$unit] = "active"' <<<"$services")
done
people='[]'
users=$(jq -r '.router.people[] | select(.unlocked) | .user' <<<"$services")
while IFS= read -r user; do
  [[ -n $user ]] || continue
  unit="pi-remote@$user.service"
  health=$(pi_stack_supervisor_health "$user")
  jq -e --arg expected "$expected" --arg environment "$environment" \
    '.ok == true and .releaseCommit == $expected and .environmentId == $environment' <<<"$health" >/dev/null || {
    echo "$unit health does not match integration and environment" >&2; exit 1;
  }
  properties=$(systemctl show "$unit" -p ExecStart -p ExecReload -p KillMode -p MemoryMax -p MemoryHigh -p PrivateMounts)
  people=$(jq -c --arg user "$user" --argjson health "$health" --arg properties "$properties" '. + [{user:$user,health:$health,effectiveUnit:$properties}]' <<<"$people")
done <<<"$users"
jq -n --arg host "$host" --arg expected "$expected" --arg remote "$remote" --arg orchestrator "$orchestrator" \
  --arg voice "$voice" --arg environment "$environment" --argjson services "$services" --argjson people "$people" \
  '{host:$host,verifiedAt:(now|todateiso8601),integrationSha:$expected,remoteCommit:$remote,orchestratorCommit:$orchestrator,
    voiceCommit:$voice,environmentId:$environment,router:$services.router,units:$services.units,
    otherFailedPiUnits:$services.otherFailedPiUnits,supervisors:$people}'
`;

export function verifyTarget(target, expected) {
  if (activeRequest) {
    activeRequest.step = `verify-${target.id}`;
    writeRequest(activeRequest);
  }
  return JSON.parse(runHostScript(hostProofScript, target.sshHost,
    [expected, target.id, target.environmentId, target.hostConfig, target.voiceStatusUrl,
      target.checkServicesCommand, ...target.requiredUnits], 60));
}

