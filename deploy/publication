function sha256(path) {
  return runCapture("sha256sum", [path]).split(/\s+/)[0];
}

function hasExecutionContract(commit) {
  const result = commandResult("git", ["-C", checkout, "grep", "-q", "-F", "export interface CoreExecutionSnapshot", commit, "--", "packages/orchestrator/src/cores/contracts.ts"]);
  if (result.status > 1) throw new Error(`cannot inspect execution contract in ${commit}: ${result.stderr.trim()}`);
  return result.ok;
}

function validateBootstrapTarget(request) {
  const required = [
    ["packages/orchestrator/src/cores/contracts.ts", "export interface CoreExecutionSnapshot"],
    ["apps/remote/server/server.ts", "Core execution contract is unavailable; its runtime must finish under its owning release"],
    ["apps/remote/server/server.ts", "PI_STACK_EXECUTION_BASELINE"],
  ];
  for (const [path, text] of required) {
    const result = commandResult("git", ["-C", checkout, "grep", "-q", "-F", text, request.integrationSha, "--", path]);
    if (!result.ok) throw new Error(`${request.integrationSha} does not implement ${coreExecutionContract}: missing ${text} in ${path}`);
  }
}

function activatedContract() {
  if (!existsSync(coreExecutionActivationPath)) return null;
  const activation = JSON.parse(readFileSync(coreExecutionActivationPath, "utf8"));
  if (activation.version !== 1 || activation.contract !== coreExecutionContract) throw new Error(`invalid contract activation receipt: ${coreExecutionActivationPath}`);
  validateSha(activation.integrationSha);
  return activation;
}

function selectedHasContract(selectedCommit, request) {
  if (!selectedCommit) return false;
  if (selectedCommit === request.integrationSha) return true;
  const activation = activatedContract();
  if (!activation) return false;
  const ancestry = commandResult("git", ["-C", checkout, "merge-base", "--is-ancestor", activation.integrationSha, selectedCommit]);
  if (ancestry.status > 1) throw new Error(`cannot compare deployed commit ${selectedCommit} with contract activation ${activation.integrationSha}`);
  return ancestry.ok;
}

function recordContractActivation(request) {
  if (existsSync(coreExecutionActivationPath)) return;
  atomicWrite(coreExecutionActivationPath, `${JSON.stringify({
    version: 1,
    contract: coreExecutionContract,
    integrationSha: request.integrationSha,
    activatedAt: new Date().toISOString(),
    requestId: request.requestId,
    hosts: {
      gmktec: request.hosts.gmktec,
      converge: request.hosts.converge,
    },
  }, null, 2)}\n`);
}

function recoverOutstandingCustody(request) {
  for (const [hostKey, remoteHost] of [["gmktec", undefined], ["converge", "converge-kenan"]]) {
    if (!custodyNeedsRestore(request.bootstrap?.hosts?.[hostKey])) continue;
    request.step = `restore-${hostKey}-intake`;
    writeRequest(request);
    try {
      restoreCustody(request, hostKey, remoteHost);
      delete request.recoveryFailure;
      writeRequest(request);
    } catch (error) {
      request.recoveryFailure = {
        at: new Date().toISOString(),
        host: hostKey,
        message: error instanceof Error ? error.message : String(error),
      };
      writeRequest(request);
      throw error;
    }
  }
}

function processRequest(request) {
  request.attempt += 1;
  request.status = "running";
  request.startedAt ??= new Date().toISOString();
  request.step = "starting";
  delete request.failure;
  writeRequest(request);
  const attemptRoot = join(logRoot, request.requestId);
  mkdirSync(attemptRoot, { recursive: true, mode: 0o700 });
  const logPath = join(attemptRoot, `attempt-${request.attempt}.log`);
  appendLog(logPath, `[${new Date().toISOString()}] request=${request.requestId} source=${request.sourceSha} attempt=${request.attempt}\n`);

  try {
    let result = prepareCheckout(request, logPath);
    if (!result.ok) throw new Error(result.stderr.trim() || `checkout preparation exited ${result.status}`);

    const remoteMain = runCapture("git", ["-C", checkout, "rev-parse", "refs/remotes/origin/main^{commit}"]);
    const reusableIntegration = request.integrationSha && request.checks?.status === "passed"
      && (remoteMain === request.integrationSha || remoteMain === request.baseSha)
      && commandResult("git", ["-C", checkout, "cat-file", "-e", `${request.integrationSha}^{commit}`]).ok;
    if (!reusableIntegration) {
      delete request.integrationSha;
      delete request.baseSha;
      delete request.checks;
      delete request.hosts;
      result = createIntegration(request, logPath);
      if (!result.ok) throw new Error(result.stderr.trim() || `integration checks exited ${result.status}`);
    }

    prepareAndroidArtifact(request, logPath);
    request.contract = hasExecutionContract(request.integrationSha) ? coreExecutionContract : null;
    if (!request.contract && activatedContract()) throw new Error("Refusing to remove the activated core execution contract");
    writeRequest(request);
    const requestProofRoot = join(proofRoot, request.requestId);
    const deploymentsPassed = request.hosts?.gmktec?.status === "passed" && request.hosts?.converge?.status === "passed";
    if (!deploymentsPassed) {
      const gmktecCensus = runtimeCensus(undefined);
      const convergeCensus = runtimeCensus("converge-kenan");
      if (!request.contract && [gmktecCensus, convergeCensus].some(host => host.selectedCommit && hasExecutionContract(host.selectedCommit))) {
        throw new Error("Refusing to replace a host's core execution contract with a target that lacks it");
      }
      const gmktecBootstrap = !!request.contract && !selectedHasContract(gmktecCensus.selectedCommit, request);
      const convergeBootstrap = !!request.contract && !selectedHasContract(convergeCensus.selectedCommit, request);
      gmktecCensus.contract = gmktecBootstrap ? "pre-contract" : request.contract;
      convergeCensus.contract = convergeBootstrap ? "pre-contract" : request.contract;
      if (request.contract) validateBootstrapTarget(request);
      const gateProofPath = join(requestProofRoot, "core-execution-gate.json");
      atomicWrite(gateProofPath, `${JSON.stringify({ checkedAt: new Date().toISOString(), contract: request.contract, hosts: [gmktecCensus, convergeCensus] }, null, 2)}\n`);
      request.contractGate = { proof: gateProofPath, sha256: sha256(gateProofPath) };
      if ((gmktecBootstrap && gmktecCensus.runtimes.length > 0) || (convergeBootstrap && convergeCensus.runtimes.length > 0)) {
        updateBlocked(request, [gmktecCensus, convergeCensus], logPath);
        return;
      }

      request.step = gmktecBootstrap || convergeBootstrap ? "seal-pre-contract-intake" : "live-handoff";
      writeRequest(request);
      if (gmktecBootstrap) {
        const outcome = sealHost(request, "gmktec", undefined);
        if (outcome.state !== "sealed") {
          updateBlocked(request, [gmktecCensus, convergeCensus, outcome], logPath);
          return;
        }
      }
      if (convergeBootstrap) {
        const outcome = sealHost(request, "converge", "converge-kenan");
        if (outcome.state !== "sealed") {
          restoreCustody(request, "gmktec", undefined);
          updateBlocked(request, [gmktecCensus, convergeCensus, outcome], logPath);
          return;
        }
      }
      if (gmktecBootstrap || convergeBootstrap) {
        request.contractGate.sealedAt = new Date().toISOString();
        writeRequest(request);
      }

      result = publishIntegration(request, logPath);
      if (!result.ok) throw new Error(result.stderr.trim() || `main integration exited ${result.status}`);

      if (request.hosts?.gmktec?.status !== "passed") {
        if (request.bootstrap?.hosts?.gmktec?.state === "sealed") {
          request.bootstrap.hosts.gmktec.state = "deploying";
          writeRequest(request);
        }
        result = runLogged(request, "deploy-gmktec", "/home/kenan/machine/pi-stack-release", [request.integrationSha], 180, logPath);
        if (!result.ok) throw new Error(`GMKtec release wrapper exited ${result.status}`);
        const gmktecProof = verifyGmktec(request.integrationSha);
        const gmktecProofPath = join(requestProofRoot, "gmktec.json");
        atomicWrite(gmktecProofPath, `${JSON.stringify(gmktecProof, null, 2)}\n`);
        request.hosts = {
          ...(request.hosts ?? {}),
          gmktec: { status: "passed", proof: gmktecProofPath, sha256: sha256(gmktecProofPath) },
        };
        writeRequest(request);
        releaseCustody(request, "gmktec");
      }

      if (request.hosts?.converge?.status !== "passed") {
        if (request.bootstrap?.hosts?.converge?.state === "sealed") {
          request.bootstrap.hosts.converge.state = "deploying";
          writeRequest(request);
        }
        result = runLogged(request, "deploy-converge", "ssh", ["-o", "BatchMode=yes", "converge-kenan", "/home/kenan/machine/pi-stack-release", request.integrationSha], 240, logPath);
        if (!result.ok) throw new Error(`Converge release wrapper exited ${result.status}`);
        const convergeProof = verifyConverge(request.integrationSha);
        const convergeProofPath = join(requestProofRoot, "converge-kenan.json");
        atomicWrite(convergeProofPath, `${JSON.stringify(convergeProof, null, 2)}\n`);
        request.hosts.converge = { status: "passed", proof: convergeProofPath, sha256: sha256(convergeProofPath) };
        writeRequest(request);
        releaseCustody(request, "converge");
      }
    } else {
      verifyGmktec(request.integrationSha);
      verifyConverge(request.integrationSha);
      releaseCustody(request, "gmktec");
      releaseCustody(request, "converge");
    }
    publishAndroidArtifact(request, logPath);
    const finalProofs = { gmktec: verifyGmktec(request.integrationSha), converge: verifyConverge(request.integrationSha) };
    const finalProofPath = join(requestProofRoot, "final-hosts.json");
    atomicWrite(finalProofPath, `${JSON.stringify(finalProofs, null, 2)}\n`);
    request.finalProof = { path: finalProofPath, sha256: sha256(finalProofPath) };
    writeRequest(request);
    if (request.contract) recordContractActivation(request);

    request.status = "finalizing";
    request.step = "adopt-publication-owner";
    writeRequest(request);
    installFrom(canonicalRepository);

    request.status = "published";
    request.step = "complete";
    request.publishedAt = new Date().toISOString();
    request.receipt = requestPath(request.requestId);
    delete request.failure;
    writeRequest(request);
    appendLog(logPath, `[${new Date().toISOString()}] published integration=${request.integrationSha}\n`);
    if (request.android) rmSync(join(request.android.directory, request.android.release.fileName), { force: true });
    deliverNotice(request);
  } catch (error) {
    const restorationFailures = [];
    for (const [hostKey, remoteHost] of [["gmktec", undefined], ["converge", "converge-kenan"]]) {
      try { restoreCustody(request, hostKey, remoteHost); }
      catch (restoreError) { restorationFailures.push(`${hostKey}: ${restoreError instanceof Error ? restoreError.message : String(restoreError)}`); }
    }
    let message = error instanceof Error ? error.message : String(error);
    if (restorationFailures.length) message += `; intake restoration failed: ${restorationFailures.join("; ")}`;
    appendLog(logPath, `[${new Date().toISOString()}] failed step=${request.step}: ${message}\n`);
    updateFailure(request, message, logPath);
  }
}

function gateStatus() {
  process.stdout.write(`${JSON.stringify({
    checkedAt: new Date().toISOString(),
    contract: activatedContract(),
    hosts: [runtimeCensus(undefined), runtimeCensus("converge-kenan")],
  }, null, 2)}\n`);
}

function drain() {
  ensureState();
  const allRequests = [];
  for (const name of checked("find", [requestRoot, "-maxdepth", "1", "-type", "f", "-name", "PUB-*.json", "-printf", "%p\\n"]).split("\n")) {
    if (name) allRequests.push(JSON.parse(readFileSync(name, "utf8")));
  }
  for (const request of allRequests) { recoverOutstandingCustody(request); deliverNotice(request); }
  const requests = allRequests.filter(request => ["queued", "running", "blocked", "finalizing"].includes(request.status));
  requests.sort((left, right) => left.queuedAt.localeCompare(right.queuedAt));
  if (requests.length > 0) processRequest(requests[0]);
}

function main() {
  const [operation, ...args] = process.argv.slice(2);
  if (operation === "install" && args.length === 0) return install();
  if (operation === "submit" && args.length === 1) return submit(args[0]);
  if (operation === "inspect" && args.length === 1) return inspect(args[0]);
  if (operation === "retry" && args.length === 1) return retry(args[0]);
  if (operation === "gate-status" && args.length === 0) return gateStatus();
  if (operation === "enqueue" && [3, 4].includes(args.length)) return enqueue(...args);
  if (operation === "report" && [1, 3].includes(args.length)) return report(...args);
  if (operation === "drain" && args.length === 0) return drain();
  usage();
  process.exitCode = 2;
}

try {
  main();
} catch (error) {
  process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
  process.exitCode = 1;
}
