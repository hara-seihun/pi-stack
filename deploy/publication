  if [[ -r /proc/$fleet_pid/stat && $(awk '{print $22}' "/proc/$fleet_pid/stat") == "$fleet_start" ]]; then sudo -n kill -CONT "$fleet_pid" || failed=1; fi
  sudo -n systemctl unmask --runtime "$(jq -r .unit <<<"$fleet")" >&2 || failed=1
  sudo -n systemctl start "$(jq -r .unit <<<"$fleet")" >&2 || failed=1
  while IFS= read -r supervisor; do
    pid=$(jq -r .serverPid <<<"$supervisor")
    start=$(jq -r .startTime <<<"$supervisor")
    if [[ -r /proc/$pid/stat && $(awk '{print $22}' "/proc/$pid/stat") == "$start" ]]; then sudo -n kill -CONT "$pid" || failed=1; fi
  done < <(jq -c '.supervisors[]' <<<"$plan")
