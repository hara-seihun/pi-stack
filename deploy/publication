function runHostScript(script, remoteHost, args, timeoutSeconds) {
  const command = remoteHost ? "ssh" : "bash";
  const remoteArgs = remoteHost
    ? ["-o", "BatchMode=yes", remoteHost, "bash", "-s", "--", ...args]
    : ["-s", "--", ...args];
  return runCapture(command, remoteArgs, { input: script, timeoutSeconds });
}

function runtimeCensus(remoteHost) {
  const target = targets.find(candidate => candidate.sshHost === (remoteHost ?? null));
  return JSON.parse(runHostScript(runtimeCensusScript, remoteHost, [target.id, target.releaseRepository], 60));
}

function sealPlan(remoteHost, fleet) {
  return JSON.parse(runHostScript(sealPlanScript, remoteHost, [targets.find(target => target.sshHost === (remoteHost ?? null)).id, planEncoding(fleet)], 60));
}

function planEncoding(plan) {
  return Buffer.from(JSON.stringify(plan), "utf8").toString("base64");
}

function sealHost(request, hostKey, remoteHost) {
  const plan = sealPlan(remoteHost, request.maintenance.hosts[hostKey].plan);
  request.bootstrap ??= { contract: threadExecutionContract, hosts: {} };
  request.bootstrap.hosts[hostKey] = { state: "restore-required", recordedAt: new Date().toISOString(), plan };
  writeRequest(request);
  const outcome = JSON.parse(runHostScript(sealScript, remoteHost, [hostKey, planEncoding(plan)], 90));
  request.bootstrap.hosts[hostKey].outcome = outcome;
  request.bootstrap.hosts[hostKey].state = outcome.state === "sealed" ? "sealed" : "restored";
  request.bootstrap.hosts[hostKey].updatedAt = new Date().toISOString();
  writeRequest(request);
  return outcome;
}

function custodyNeedsRestore(host) {
  return host && ["restore-required", "sealed", "deploying"].includes(host.state);
}

export function outstandingHostCustody(request) {
  return Object.values(request.bootstrap?.hosts ?? {}).some(custodyNeedsRestore)
    || Object.values(request.reservations ?? {}).some(custodyNeedsRestore)
    || Object.values(request.maintenance?.hosts ?? {}).some(host => !["restored", "released"].includes(host.state))
    || Object.values(request.nativeHistory?.hosts ?? {}).some(host => custodyNeedsRestore(host) || host.state === "repair-required");
}

export function nativeHistoryRepairHeld(request) {
  return Object.values(request.nativeHistory?.hosts ?? {}).some(host => host.state === "repair-required");
}

export function recoveryNeeded(request) {
  return Object.values(request.bootstrap?.hosts ?? {}).some(custodyNeedsRestore)
    || Object.values(request.reservations ?? {}).some(custodyNeedsRestore)
    || ["failed", "published"].includes(request.status) && (
      Object.values(request.maintenance?.hosts ?? {}).some(host => !["restored", "released"].includes(host.state))
      || !nativeHistoryRepairHeld(request) && Object.values(request.nativeHistory?.hosts ?? {}).some(custodyNeedsRestore));
}

function restoreCustody(request, hostKey, remoteHost) {
  const host = request.bootstrap?.hosts?.[hostKey];
  if (!custodyNeedsRestore(host)) return;
  runHostScript(restoreScript, remoteHost, [planEncoding(host.plan)], 90);
  host.state = "restored";
  host.restoredAt = new Date().toISOString();
  writeRequest(request);
}

function releaseCustody(request, hostKey) {
  const target = targets.find(candidate => candidate.id === hostKey);
  restoreMaintenance(request, hostKey, target.sshHost, "released");
  const host = request.bootstrap?.hosts?.[hostKey];
  if (!host || host.state === "released") return;
  host.state = "released";
  host.releasedAt = new Date().toISOString();
  writeRequest(request);
}

function sha256(path) {
  return runCapture("sha256sum", [path]).split(/\s+/)[0];
}

export function retainSelectedSource(census, remoteHost) {
  const commit = census.selectedCommit;
  if (!commit) return;
  validateSha(commit);
  const target = targets.find(candidate => candidate.sshHost === (remoteHost ?? null));
  const repository = remoteHost ? `${remoteHost}:${target.releaseRepository}` : target.releaseRepository;
  const ref = `refs/pi-stack-publication/selected/${commit}`;
  if (!commandResult("git", ["-C", checkout, "cat-file", "-e", `${commit}^{commit}`]).ok) {
    checked("git", ["-C", checkout, "fetch", "--quiet", "--no-tags", repository, `${commit}:${ref}`], { timeoutSeconds: 45 });
  }
  checked("git", ["-C", checkout, "cat-file", "-e", `${commit}^{commit}`]);
  checked("git", ["-C", checkout, "update-ref", ref, commit]);
  census.selectedSource = { repository, ref, commit };
}

export function inspectReleaseAncestry(census, target, remoteHost) {
  validateSha(target);
  const baselines = [];
  for (const [kind, commit] of [["live", census.selectedCommit], ["checkout", census.checkoutCommit]]) {
    if (!commit) continue;
    const source = { selectedCommit: commit };
    retainSelectedSource(source, remoteHost);
    if (kind === "live") census.selectedSource = source.selectedSource;
    const result = commandResult("git", ["-C", checkout, "merge-base", "--is-ancestor", commit, target]);
    if (result.status !== 0 && result.status !== 1) {
      throw new Error(`cannot inspect release ancestry for ${commit}: ${result.stderr.trim()}`);
    }
    baselines.push({ kind, ...source.selectedSource, included: result.ok });
  }
  return { host: census.host, target, baselines, ok: baselines.every(baseline => baseline.included) };
}

export function hasExecutionContract(commit) {
  const result = commandResult("git", ["-C", checkout, "grep", "-q", "-F", "THREAD_EXECUTION_CONTRACT = \"unified-threads-v1\"", commit, "--", "packages/orchestrator/src/threads/contracts.ts"]);
  if (result.status > 1) throw new Error(`cannot inspect execution contract in ${commit}: ${result.stderr.trim()}`);
  return result.ok;
}

function validateBootstrapTarget(request) {
  const required = [
    ["packages/orchestrator/src/threads/contracts.ts", "THREAD_EXECUTION_CONTRACT = \"unified-threads-v1\""],
    ["packages/orchestrator/src/threads/import.ts", "export function importRemoteThreads"],
    ["apps/remote/server/server.ts", "importRemoteThreads"],
  ];
  for (const [path, text] of required) {
    const result = commandResult("git", ["-C", checkout, "grep", "-q", "-F", text, request.integrationSha, "--", path]);
    if (!result.ok) throw new Error(`${request.integrationSha} does not implement ${threadExecutionContract}: missing ${text} in ${path}`);
  }
}

function activatedContract() {
  if (!existsSync(threadExecutionActivationPath)) return null;
  const activation = JSON.parse(readFileSync(threadExecutionActivationPath, "utf8"));
  if (activation.version !== 1 || activation.contract !== threadExecutionContract) throw new Error(`invalid contract activation receipt: ${threadExecutionActivationPath}`);
  validateSha(activation.integrationSha);
  return activation;
}

function selectedHasContract(selectedCommit, request) {
  if (!selectedCommit) return false;
  if (selectedCommit === request.integrationSha) return true;
  return hasExecutionContract(selectedCommit);
}

function recordContractActivation(request) {
  if (existsSync(threadExecutionActivationPath)) return;
  atomicWrite(threadExecutionActivationPath, `${JSON.stringify({
    version: 1,
    contract: threadExecutionContract,
    integrationSha: request.integrationSha,
    activatedAt: new Date().toISOString(),
    requestId: request.requestId,
    hosts: Object.fromEntries(targets.map(target => [target.id, request.hosts[target.id]])),
  }, null, 2)}\n`);
}

export function recoverOutstandingCustody(request, status = request.status) {
  for (const { id: hostKey, sshHost: remoteHost } of targets) {
    const restoringSeal = custodyNeedsRestore(request.bootstrap?.hosts?.[hostKey]);
    const terminal = ["failed", "published"].includes(status) || existsSync(cancellationPath(request.requestId));
    const maintenance = request.maintenance?.hosts?.[hostKey];
    const restoringMaintenance = terminal && maintenance && !["restored", "released"].includes(maintenance.state);
    const target = targets.find(target => target.id === hostKey);
    const restoringReservation = custodyNeedsRestore(request.reservations?.[hostKey]);
    const restoringHistory = terminal && custodyNeedsRestore(request.nativeHistory?.hosts?.[hostKey]);
    if (!restoringSeal && !restoringMaintenance && !restoringReservation && !restoringHistory) continue;
    try {
      restoreCustody(request, hostKey, remoteHost);
      if (terminal) {
        restoreMaintenance(request, hostKey, remoteHost);
        restoreNativeHistory(request, target);
      }
      restoreReservation(request, target);
      delete request.recoveryFailure;
      writeRequest(request);
    } catch (error) {
      request.recoveryFailure = {
        at: new Date().toISOString(),
        host: hostKey,
        message: error instanceof Error ? error.message : String(error),
      };
      writeRequest(request);
      throw error;
    }
  }
}

function hostWait(request, target, kind, logPath, reason, previous) {
  const at = previous?.status === "waiting" && previous.waiting.kind === kind ? previous.waiting.at : new Date().toISOString();
  return { status: "waiting", waiting: { kind, host: target.id, at, log: logPath, reason }, nextAttemptAt: new Date(Date.now() + policy.blockedRetryMs).toISOString() };
}

const currentAndroidProofScript = String.raw`
set -euo pipefail
selected=$1
root=/var/lib/pi-remote/app-updates/current
app=$(< "$root/manifest.json")
web=$(< "$root/web-manifest.json")
served=$(curl -fsS --max-time 5 http://127.0.0.1:8788/v1/app-update)
jq -e --arg selected "$selected" --argjson app "$app" --argjson web "$web" \
  '.release == $app and .web == $web and .web.revision == $selected and .release.shellId == .web.shellId and .release.applicationId == .web.applicationId and .release.versionCode <= .web.versionCode and (.release.versionCode != .web.versionCode or .release.revision == .web.revision)' <<<"$served" >/dev/null
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
for artifact in "$app" "$web"; do
  name=$(jq -er '.fileName | select(test("^[a-zA-Z0-9._-]+$"))' <<<"$artifact")
  hash=$(jq -er '.sha256 | select(test("^[0-9a-f]{64}$"))' <<<"$artifact")
  size=$(jq -er '.size | select(type == "number" and . > 0)' <<<"$artifact")
  curl -fsS --max-time 15 "http://127.0.0.1:8788/v1/app-update/$name" -o "$work/$name"
  [[ $(stat -c %s "$work/$name") == "$size" ]]
  [[ $(sha256sum "$work/$name" | cut -d ' ' -f 1) == "$hash" ]]
done
jq --arg at "$(date -u +%FT%TZ)" '.release + {web:.web,verifiedAt:$at}' <<<"$served"
`;

function currentAndroidProof(target, selected) {
  return JSON.parse(runHostScript(currentAndroidProofScript, target.sshHost, [selected], 45));
}

function deliverHost(request, target, logPath, previous) {
  checkCancellation(request);
  if (previous?.status === "waiting" && previous.ready === false) return previous;
  if (previous?.status === "waiting" && ["host-lock", "thread-contract"].includes(previous.waiting.kind) && Date.now() - Date.parse(previous.waiting.at) > policy.blockedLimitMs) throw new Error(`${target.id} ${previous.waiting.kind} wait budget exhausted`);
  const result = reserveTarget(request, target, logPath);
  if (!result.ok) {
    if (result.kind === "native-history-custody") {
      const outcome = hostWait(request, target, "native-history-custody", logPath,
        `${target.id} native history custody belongs to ${result.owners.map(owner => owner.requestId).join(", ")}; only their positive restoration or release permits another host admission.`, previous);
      outcome.waiting.owners = result.owners;
      return outcome;
    }
    if (result.status === 75) {
      request.reservations[target.id].state = "released";
      writeRequest(request);
      return hostWait(request, target, "host-lock", logPath, `${target.id} deployment lock is busy; other hosts continue.`, previous);
    }
    throw new Error(`${target.id} reservation exited ${result.status}`);
  }
  try {
    const census = runtimeCensus(target.sshHost);
    retainSelectedSource(census, target.sshHost);
    if (census.selectedCommit && commandResult("git", ["-C", checkout, "merge-base", "--is-ancestor", request.integrationSha, census.selectedCommit]).ok) {
      if (census.selectedCommit !== request.integrationSha && !allRequests().some(candidate => candidate.integrationSha === census.selectedCommit && candidate.checks?.status === "passed")) throw new Error(`${target.id} selected descendant has no passing publication checks`);
      if (census.selectedCommit === request.integrationSha) publishAndroidArtifact(request, logPath, [target]);
      const proof = verifyTarget(target, census.selectedCommit);
      const android = currentAndroidProof(target, census.selectedCommit);
      const path = join(proofRoot, request.requestId, `${target.id}.json`);
      atomicWrite(path, `${JSON.stringify({ ...proof, requestedIntegrationSha: request.integrationSha, android }, null, 2)}\n`);
      releaseNativeHistory(request, target);
      return { status: "passed", integrationSha: census.selectedCommit, proof: path, sha256: sha256(path), android, superseded: census.selectedCommit !== request.integrationSha };
    }
    const ancestry = inspectReleaseAncestry(census, request.integrationSha, target.sshHost);
    const ancestryPath = join(proofRoot, request.requestId, `${target.id}-release-ancestry.json`);
    atomicWrite(ancestryPath, `${JSON.stringify(ancestry, null, 2)}\n`);
    if (!ancestry.ok) throw new Error(`${target.id} integration omits selected or checkout source; repair the source ancestry`);
    if (!meetingOverride(request.requestId)) {
      const rooms = censusTarget(target, request.meetingRuntimeProtocol);
      if (rooms) return hostWait(request, target, "live-meeting", logPath, `${target.id} has live meetings; other hosts roll forward while this host waits.`, previous);
    }
    const native = nativeSourceProbe(request, target, true);
    if (!native.ok) return hostWait(request, target, "native-source", logPath, `${target.id} needs a newer native source; other hosts continue.`, previous);
    const history = nativeHistoryBoundaryTarget(request, target, "advance", logPath);
    if (!history.ok) return hostWait(request, target, "native-history", logPath, `${target.id} old native generation must settle its history before any source artifacts change; other hosts continue.`, previous);
    const bootstrap = !!request.contract && !selectedHasContract(census.selectedCommit, request);
    if (!request.contract && census.selectedCommit && hasExecutionContract(census.selectedCommit)) throw new Error(`${target.id} release would remove its thread execution contract`);
    if (bootstrap) {
      validateBootstrapTarget(request);
      ensureMaintenance(request, target.id, target.sshHost);
      const active = runtimeCensus(target.sshHost);
      if (active.runtimes.length || active.fleet.activeRuns.length) return hostWait(request, target, "thread-contract", logPath, `${target.id} pre-contract workers must settle; other hosts continue.`, previous);
      const seal = sealHost(request, target.id, target.sshHost);
      if (seal.state !== "sealed") return hostWait(request, target, "thread-contract", logPath, `${target.id} pre-contract intake is not sealed; other hosts continue.`, previous);
      request.bootstrap.hosts[target.id].state = "deploying";
      writeRequest(request);
    }
    publishAndroidArtifact(request, logPath, [target]);
    const deployed = deployTarget(request, target, logPath);
    if (deployed.kind === "host-lock-busy") return hostWait(request, target, deployed.liveMeeting ? "live-meeting" : deployed.nativePrerequisite ? "native-source" : deployed.nativeHistory ? "native-history" : "host-lock", logPath, `${target.id} is not ready to activate; other hosts continue.`, previous);
    if (!deployed.ok) throw new Error(`${target.id} release wrapper exited ${deployed.status}`);
    const proof = verifyTarget(target, request.integrationSha);
    const android = currentAndroidProof(target, request.integrationSha);
    const path = join(proofRoot, request.requestId, `${target.id}.json`);
    atomicWrite(path, `${JSON.stringify({ ...proof, android }, null, 2)}\n`);
    releaseCustody(request, target.id);
    releaseNativeHistory(request, target);
    return { status: "passed", integrationSha: request.integrationSha, proof: path, sha256: sha256(path), android };
  } finally {
    restoreCustody(request, target.id, target.sshHost);
    restoreMaintenance(request, target.id, target.sshHost);
    restoreReservation(request, target);
  }
}

export function processRequest(request) {
  const resumeAfterReboot = canResumeRebootedIntegration(request, workerBootId);
  if (resumeAfterReboot) {
    request.workerRestarts = [...(request.workerRestarts ?? []), {
      at: new Date().toISOString(), fromBootId: request.workerBootId, toBootId: workerBootId,
      attempt: request.attempt, step: request.step, progress: request.progress,
    }];
  } else if (["live-meeting", "native-source", "native-history", "hosts"].includes(request.waiting?.kind)) {
    request[request.waiting.kind === "live-meeting" ? "meetingWait" : request.waiting.kind === "native-source" ? "nativeWait" : "hostWait"] = { ...request.waiting, resumedAt: new Date().toISOString() };
    delete request.waiting;
    delete request.nextAttemptAt;
  } else request.attempt = (request.attempt ?? 0) + 1;
  activeRequest = request;
  request.workerBootId = workerBootId;
  request.status = "running";
  request.startedAt ??= new Date().toISOString();
  request.step = "starting";
  delete request.failure;
  writeRequest(request);
  const attemptRoot = join(logRoot, request.requestId);
  mkdirSync(attemptRoot, { recursive: true, mode: 0o700 });
  const logPath = join(attemptRoot, `attempt-${request.attempt}.log`);
  activeLog = logPath;
  appendLog(logPath, `[${new Date().toISOString()}] request=${request.requestId} source=${request.sourceSha} attempt=${request.attempt}\n`);

  try {
    checkCancellation(request);
    if (!request.actionJournal) {
      const ticket = beginPublication(request, targets);
      if (ticket) { request.actionJournal = ticket; writeRequest(request); }
    }
    let result = prepareCheckout(request, logPath);
    if (!result.ok) throw new Error(result.stderr.trim() || `checkout preparation exited ${result.status}`);

    const remoteMain = runCapture("git", ["-C", checkout, "rev-parse", "refs/remotes/origin/main^{commit}"]);
    if (resumeAfterReboot && remoteMain !== request.integrationSha && remoteMain !== request.baseSha) {
      requeueMovedIntegration(request, remoteMain, logPath);
      return;
    }
    const reusableIntegration = request.integrationSha && request.checks?.status === "passed"
      && (request.integratedAt || remoteMain === request.integrationSha || remoteMain === request.baseSha)
      && commandResult("git", ["-C", checkout, "cat-file", "-e", `${request.integrationSha}^{commit}`]).ok;
    if (!reusableIntegration) {
      delete request.integrationSha;
      delete request.baseSha;
      delete request.checks;
      delete request.hosts;
      delete request.integratedAt;
      result = createIntegration(request, logPath);
      if (!result.ok) throw new Error(result.stderr.trim() || `${request.step} exited ${result.status}`);
    }

    if (!request.integratedAt) checkOwnerSource(checkout, request.integrationSha);
    request.meetingRuntimeProtocol = meetingRuntimeProtocol(request.integrationSha);
    writeRequest(request);
    prepareAndroidArtifact(request, logPath);
    request.step = "inspect-thread-execution-contract";
    writeRequest(request);
    request.contract = hasExecutionContract(request.integrationSha) ? threadExecutionContract : null;
    if (!request.contract && activatedContract()) throw new Error("Refusing to remove the activated thread execution contract");
    writeRequest(request);
    const requestProofRoot = join(proofRoot, request.requestId);
    if (!request.integratedAt) {
      result = publishIntegration(request, logPath);
      if (result.kind === "main-moved") {
        requeueMovedIntegration(request, result.remoteMain, logPath);
        return;
      }
      if (!result.ok) throw new Error(result.stderr.trim() || `main integration exited ${result.status}`);
    }
    request.step = "roll-forward-hosts";
    writeRequest(request);
    const outcome = rollForwardHosts(request, targets, {
      deliver: (target, previous) => deliverHost(request, target, logPath, previous),
      save: writeRequest,
    });
    checkCancellation(request);
    if (outcome.status === "failed") throw new Error(outcome.hosts.map(id => `${id}: ${request.hosts[id].failure.message}`).join("; "));
    if (outcome.status === "waiting") {
      request.status = "queued";
      request.step = "waiting-for-hosts";
      request.waiting = { kind: "hosts", at: new Date().toISOString(), log: logPath, hosts: outcome.hosts,
        reason: `${outcome.hosts.join(", ")} waiting; ready hosts retain their successful releases and are free to roll forward.` };
      request.nextAttemptAt = new Date(Date.now() + policy.blockedRetryMs).toISOString();
      writeRequest(request);
      deliverNotice(request);
      return;
    }
    const finalProofs = Object.fromEntries(targets.map(target => {
      const receipt = request.hosts[target.id];
      if (sha256(receipt.proof) !== receipt.sha256) throw new Error(`${target.id} host proof was modified`);
      const proof = JSON.parse(readFileSync(receipt.proof, "utf8"));
      const android = receipt.android ?? request.android?.hosts?.[target.id];
      if (request.android && !android) throw new Error(`${target.id} lacks durable matching app/web proof`);
      return [target.id, { ...proof, ...(android ? { android } : {}) }];
    }));
    const finalProofPath = join(requestProofRoot, "final-hosts.json");
    atomicWrite(finalProofPath, `${JSON.stringify(finalProofs, null, 2)}\n`);
    request.finalProof = { path: finalProofPath, sha256: sha256(finalProofPath) };
    writeRequest(request);
    if (request.contract) recordContractActivation(request);

    checkCancellation(request);
    request.status = "running";
    request.step = "adopt-publication-owner";
    writeRequest(request);
    const ownerPresent = commandResult("git", ["-C", checkout, "show-ref", "--verify", "--quiet", ownerSourceRef]);
    if (![0, 1].includes(ownerPresent.status)) throw new Error("Cannot inspect retained publication owner source");
    const retainedOwner = ownerPresent.ok ? checked("git", ["-C", checkout, "rev-parse", `${ownerSourceRef}^{commit}`]) : null;
    if (retainedOwner === null || commandResult("git", ["-C", checkout, "merge-base", "--is-ancestor", retainedOwner, request.integrationSha]).ok) adoptPublicationOwner(checkout, request.integrationSha);
    for (const target of targets) restoreReservation(request, target);

    request.status = "published";
    request.step = "complete";
    request.publishedAt = new Date().toISOString();
    request.receipt = requestPath(request.requestId);
    delete request.failure;
    writeRequest(request);
    finishPublication(request);
    if (request.actionJournal) writeRequest(request);
    appendLog(logPath, `[${new Date().toISOString()}] published integration=${request.integrationSha}\n`);
    deliverNotice(request);
  } catch (error) {
    const failedProgress = request.progress;
    const failedStep = request.step;
    const restorationFailures = [];
    for (const { id: hostKey, sshHost: remoteHost } of targets) {
      try {
        restoreCustody(request, hostKey, remoteHost);
        restoreMaintenance(request, hostKey, remoteHost);
        const target = targets.find(target => target.id === hostKey);
        restoreNativeHistory(request, target);
        restoreReservation(request, target);
      }
      catch (restoreError) { restorationFailures.push(`${hostKey}: ${restoreError instanceof Error ? restoreError.message : String(restoreError)}`); }
    }
    request.progress = failedProgress;
    request.step = failedStep;
    let message = error instanceof Error ? error.message : String(error);
    if (restorationFailures.length) message += `; intake restoration failed: ${restorationFailures.join("; ")}`;
    appendLog(logPath, `[${new Date().toISOString()}] failed step=${request.step}: ${message}\n`);
    const probeFailure = Object.values(request.hosts ?? {}).some(host => host.status === "failed" && host.failure.reason === "readiness-probe-failed");
    updateFailure(request, message, logPath, true, probeFailure ? "readiness-probe-failed" : message);
  } finally {
    activeRequest = undefined;
    activeLog = undefined;
  }
}

function gateStatus() {
  process.stdout.write(`${JSON.stringify({
    checkedAt: new Date().toISOString(),
    contract: activatedContract(),
    hosts: targets.map(target => runtimeCensus(target.sshHost)),
  }, null, 2)}\n`);
}

function allRequests() {
  return readdirSync(requestRoot).filter(name => /^PUB-[a-f0-9]{24}\.json$/.test(name))
    .map(name => migrateRequestOnRead(JSON.parse(readFileSync(join(requestRoot, name), "utf8"))))
    .sort((a, b) => (a.queuedAt ?? "").localeCompare(b.queuedAt ?? ""));
}

function existingSource(sourceSha) {
  const matches = allRequests().filter(request => request.sourceSha === sourceSha);
  return matches.find(request => request.status === "published") ?? matches.at(-1);
}

function repairPath(requestId) { return join(repairRoot, requestId, "receipt.json"); }
function readRepair(requestId) {
  return existsSync(repairPath(requestId)) ? JSON.parse(readFileSync(repairPath(requestId), "utf8")) : null;
}
function writeRepair(repair) {
  repair.updatedAt = new Date().toISOString();
  atomicWrite(repair.path, `${JSON.stringify(repair, null, 2)}\n`);
}

function ensureRepair(request) {
  if (isCancelled(request)) return;
  const previous = readRepair(request.requestId);
  if (previous && (previous.failure?.at === request.failure?.at || previous.explicitStop)) return;
  if (previous) {
    if (serviceBusy(previous.unit)) throw new Error("Previous repair still owns the service");
    const archive = join(repairRoot, request.requestId, "retained", `attempt-${previous.failure?.attempt ?? 1}`);
    mkdirSync(archive, { recursive: true });
    for (const key of ["path", "result", "outcome"]) {
      const file = key === "outcome" ? previous.outcome?.evidence : previous[key];
      if (file && existsSync(file)) copyFileSync(file, join(archive, key === "path" ? "receipt.json" : key === "result" ? "result.json" : "evidence"));
    }
  }
  const directory = join(repairRoot, request.requestId);
  const exhausted = !!previous || (request.repairDepth ?? 0) >= policy.maxRepairDepth;
  writeRepair({ id: previous ? `${repairId(request.requestId)}-attempt-${request.failure.attempt}` : repairId(request.requestId), priorRepairs: previous ? [...(previous.priorRepairs ?? []), { id: previous.id, failure: previous.failure, status: previous.status, explicitStop: previous.explicitStop }] : [], requestId: request.requestId, sourceSha: request.sourceSha,
    integrationSha: request.integrationSha, failure: request.failure, status: exhausted ? "blocked" : "pending",
    ...(exhausted ? { summary: "Automatic repair chain exhausted; Hara must assign the remaining blocker" } : {}),
    createdAt: new Date().toISOString(), path: repairPath(request.requestId), requestPath: requestPath(request.requestId),
    session: join(directory, previous ? `attempt-${request.failure.attempt}.session.jsonl` : "session.jsonl"), log: join(directory, previous ? `attempt-${request.failure.attempt}.agent.log` : "agent.log"), result: join(directory, previous ? `attempt-${request.failure.attempt}.result.json` : "result.json"),
    prompt: join(directory, "prompt.md"), unit: repairUnit(request.requestId), launchAttempts: 0 });
}

function requestRepair(requestId) {
  validateRequestId(requestId);
  const request = readRequest(requestId);
  if (request.status !== "failed" || isCancelled(request)) throw new Error("Only repairable failed requests need repair adoption");
  ensureRepair(request);
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication-watchdog.service"]);
  process.stdout.write(`${JSON.stringify(readRepair(requestId))}\n`);
}

function serviceState(unit) {
  return checked("systemctl", ["--user", "show", unit, "-p", "ActiveState", "--value"], { timeoutSeconds: 5 });
}
function serviceBusy(unit) { return ["active", "activating", "deactivating", "reloading"].includes(serviceState(unit)); }

function failStalled(requestId, reason) {
  const request = readRequest(requestId);
  if (!["queued", "running"].includes(request.status)) return;
  const log = request.progress?.log ?? join(logRoot, requestId, `attempt-${request.attempt}.log`);
  appendLog(log, `\n[${new Date().toISOString()}] watchdog: ${reason}\n`);
  updateFailure(request, reason, log, false);
}

function failUnclaimed(requestId, observationJson) {
  const queue = allRequests();
  if (queue.some(request => recoveryNeeded(request) || request.status === "running")) return;
  const request = queue.find(request => runnable(request));
  if (request?.requestId !== requestId) return;
  const reason = queueStallReason(request, JSON.parse(observationJson));
  if (reason) failStalled(requestId, reason);
}

function watchdog() {
  ensureState();
  const activatedAt = existsSync(repairPolicyPath) ? JSON.parse(readFileSync(repairPolicyPath, "utf8")).activatedAt : new Date().toISOString();
  for (const request of allRequests()) {
    const reason = canResumeRebootedIntegration(request, workerBootId) ? null : stallReason(request);
    if (reason) {
      checked("systemctl", ["--user", "stop", "pi-stack-publication.service"], { timeoutSeconds: 20 });
      locked("worker", "fail-stalled", [request.requestId, reason]);
    }
    if (request.status === "failed" && request.failure?.at >= activatedAt) ensureRepair(request);
  }
  const queue = allRequests();
  const idlePath = join(stateRoot, "worker-watch.json");
  const idle = existsSync(idlePath) ? JSON.parse(readFileSync(idlePath, "utf8")) : {};
  const waiting = queue.find(request => runnable(request));
  const custodyOwners = queue.filter(recoveryNeeded);
  idle.blockedBy = custodyOwners.map(request => request.requestId);
  delete idle.since;
  if (waiting && custodyOwners.length === 0 && !queue.some(request => request.status === "running")) {
    idle.queue = observeQueueProgress(waiting, idle.queue);
    if (queueStallReason(waiting, idle.queue)) {
      // A queued census can own the worker lock without entering running. Never stop it
      // from an unlocked snapshot; recheck progress only after acquiring that lock.
      if (locked("worker", "fail-unclaimed", [waiting.requestId, JSON.stringify(idle.queue)], true)) delete idle.queue;
    }
  } else { delete idle.queue; idle.wakeFailures = 0; }
  atomicWrite(idlePath, JSON.stringify(idle));
  const repairs = allRequests().map(request => readRepair(request.requestId)).filter(Boolean);
  let busy = false;
  for (const repair of repairs) {
    if (isCancelled(readRequest(repair.requestId)) && ["pending", "launching", "running", "submitting", "ready-to-retry"].includes(repair.status)) {
      if (serviceBusy(repair.unit)) { busy = true; continue; }
      repair.status = "blocked";
      repair.summary = "Publication cancelled; retained repair work cannot authorize a successor or retry";
      repair.finishedAt = new Date().toISOString();
      writeRepair(repair);
      continue;
    }
    if (repair.status === "submitted" && repair.successor) {
      const successor = readRequest(repair.successor.requestId);
      if (repair.successor.status !== successor.status) {
        repair.successor = { ...repair.successor, status: successor.status, integrationSha: successor.integrationSha,
          failure: successor.failure, publishedAt: successor.publishedAt };
        writeRepair(repair);
      }
    }
    if (repair.status === "ready-to-retry") {
      if (locked("worker", "retry", [repair.requestId], true)) {
        repair.status = "retry-submitted";
        writeRepair(repair);
      }
    }
    if (["launching", "running", "submitting"].includes(repair.status)) {
      if (serviceBusy(repair.unit)) { busy = true; continue; }
      const successorId = `PUB-${createHash("sha256").update(`repair:${repair.requestId}`).digest("hex").slice(0, 24)}`;
      if (existsSync(requestPath(successorId))) {
        const successor = readRequest(successorId);
        repair.successor = { requestId: successorId, sourceSha: successor.sourceSha, receipt: requestPath(successorId) };
        repair.status = "submitted";
      } else if (readRequest(repair.requestId).repairedRetry?.repairId === repair.id) {
        repair.status = "retry-submitted";
      } else {
        repair.status = "blocked";
        repair.summary = "Repair service exited or was interrupted without a terminal receipt; inspect its saved session, agent log and unit result. No automatic replay.";
        repair.unitResult = commandResult("systemctl", ["--user", "show", repair.unit, "-p", "Result", "-p", "ExecMainStatus"], { timeoutSeconds: 5 }).stdout;
      }
      writeRepair(repair);
    }
  }
  const agentLock = commandResult("flock", ["--nonblock", "--conflict-exit-code", "75", join(stateRoot, "repair-agent.lock"), "true"], { timeoutSeconds: 2 });
  if (!agentLock.ok && agentLock.status !== 75) throw new Error(`Cannot inspect repair-agent ownership: ${agentLock.stderr}`);
  if (!busy && agentLock.ok) {
    const repair = repairs.find(candidate => candidate.status === "pending");
    if (repair) {
      repair.launchAttempts += 1;
      repair.status = "launching";
      repair.launchedAt = new Date().toISOString();
      writeRepair(repair);
      const launch = commandResult("systemctl", ["--user", "start", "--no-block", repair.unit], { timeoutSeconds: 5 });
      if (!launch.ok) {
        repair.status = repair.launchAttempts >= policy.maxLaunchAttempts ? "blocked" : "pending";
        repair.summary = `Could not start dedicated repair service: ${launch.stderr || launch.status}`;
        writeRepair(repair);
      }
    }
  }
  // This wake is independent of the worker and also closes enqueue's start/exit race.
  const current = allRequests();
  const recoveryBlocked = current.some(request => (request.recoveryAttempts ?? 0) >= policy.maxAttempts
    && recoveryNeeded(request));
  if (!recoveryBlocked && current.some(request => runnable(request) || request.status === "running"
    || recoveryNeeded(request))) {
    const wake = commandResult("systemctl", ["--user", "start", "--no-block", "pi-stack-publication.service"], { timeoutSeconds: 5 });
    idle.wakeFailures = wake.ok ? 0 : (idle.wakeFailures ?? 0) + 1;
    idle.wakeError = wake.ok ? undefined : wake.stderr;
    atomicWrite(idlePath, JSON.stringify(idle));
    if (!wake.ok && idle.wakeFailures >= policy.maxLaunchAttempts && waiting) {
      locked("worker", "fail-stalled", [waiting.requestId, `Worker could not start after ${idle.wakeFailures} attempts: ${wake.stderr}`]);
    }
  } else {
    checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication-notices.service"], { timeoutSeconds: 5 });
  }
}

function repairRun(requestId) {
  validateRequestId(requestId);
  const repair = readRepair(requestId);
  if (!repair || repair.status !== "launching") return;
  const attemptPath = join(dirname(repair.path), "attempt.json");
  if (existsSync(attemptPath)) return;
  atomicWrite(attemptPath, JSON.stringify({ repairId: repair.id, startedAt: new Date().toISOString(), session: repair.session }));
  const request = readRequest(requestId);
  repair.status = "running";
  repair.startedAt = new Date().toISOString();
  writeRepair(repair);
  try {
    checkCancellation(request);
    try {
      const workspace = JSON.parse(checked("agent-workspace", ["create", "--root", config.repairWorkspaceRoot,
        "--name", `publication-repair-${requestId}`, "--repo", checkout, "--ref", request.sourceSha,
        "--owner", repair.id, "--mode", "writer", "--intent", "source-only", "--headroom-gib", "2",
        "--growth-mib", "512", "--creation-timeout-seconds", "40", "--json"], { timeoutSeconds: 45 }));
      repair.workspace = workspace.path;
      writeRepair(repair);
      if (!commandResult("git", ["cat-file", "-e", `${request.sourceSha}^{commit}`], { cwd: repair.workspace }).ok) {
        checked("git", ["fetch", "--quiet", "origin", request.sourceRef], { cwd: repair.workspace });
      }
      checked("git", ["checkout", "--detach", request.sourceSha], { cwd: repair.workspace });
    } catch (error) {
      repair.workspaceError = error instanceof Error ? error.message : String(error);
      writeRepair(repair);
    }
    atomicWrite(repair.prompt, repairPrompt(request, repair, installedCommand));
    const fd = openSync(repair.log, "a", 0o600);
    let result;
    try {
      result = commandResult(config.piCommand,
        ["--print", "--mode", "json", "--model", "openai-codex/gpt-6.1-sol", "--thinking", "high",
          "--session", repair.session, `@${repair.prompt}`],
        { cwd: repair.workspace && existsSync(repair.workspace) ? repair.workspace : dirname(repair.path),
          timeoutSeconds: policy.repairMs / 1000, stdio: ["ignore", fd, fd] });
    } finally { closeSync(fd); }
    if (!result.ok) throw new Error(`Repair agent exited ${result.status}; see ${repair.log}`);
    acceptRepairResult(repair);
  } catch (error) {
    repair.status = "blocked";
    repair.summary = error instanceof Error ? error.message : String(error);
    repair.finishedAt = new Date().toISOString();
    writeRepair(repair);
  }
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication-watchdog.service"], { timeoutSeconds: 5 });
}

function acceptRepairResult(repair) {
  const request = readRequest(repair.requestId);
  if (repair.explicitStop || repair.failure?.at !== request.failure?.at || repair.failure?.attempt !== request.failure?.attempt) throw new Error("Stale or explicitly stopped repair result");
  if (!existsSync(repair.result)) throw new Error(`Repair agent returned without ${repair.result}`);
  const outcome = JSON.parse(readFileSync(repair.result, "utf8"));
  if (!["source-fixed", "infrastructure-fixed", "blocked"].includes(outcome.status) || !outcome.summary?.trim()) throw new Error("Repair result needs a status and cause/repair summary");
  if (outcome.status !== "blocked") checkCancellation(readRequest(repair.requestId));
  if (outcome.status !== "blocked" && (!outcome.evidence || !existsSync(outcome.evidence))) throw new Error("Repair result needs an existing focused proof receipt");
  if (outcome.status === "source-fixed") {
    validateSha(outcome.sourceSha);
    if (!(outcome.workspace ?? repair.workspace)) throw new Error("Source repair must identify its registered workspace");
  }
  if (outcome.ownerSourceSha) {
    if (outcome.status !== "infrastructure-fixed") throw new Error("Owner control source belongs to an existing-publication infrastructure repair");
    validateSha(outcome.ownerSourceSha);
    if (checked("git", ["-C", checkout, "rev-parse", `${ownerSourceRef}^{commit}`]) !== outcome.ownerSourceSha) throw new Error("Owner repair source must be installed and retained first");
  }
  if (outcome.status !== "blocked") {
    const evidenceSource = resolve(outcome.evidence);
    const evidence = join(dirname(repair.path), `evidence-attempt-${repair.failure?.attempt ?? 1}`);
    atomicWrite(evidence, readFileSync(evidenceSource));
    outcome.evidence = evidence;
    outcome.evidenceSource = evidenceSource;
    outcome.evidenceSha256 = sha256(evidence);
  }
  repair.outcome = outcome;
  if (outcome.workspace) repair.workspace = resolve(outcome.workspace);
  repair.status = outcome.status === "blocked" ? "blocked" : "submitting";
  writeRepair(repair);
  if (outcome.status === "source-fixed") {
    repair.successor = JSON.parse(checked(installedCommand, ["submit", outcome.sourceSha, "--repair-of", repair.requestId],
      { cwd: repair.workspace, timeoutSeconds: 45 }));
    repair.status = "submitted";
    writeRepair(repair);
    checked("agent-workspace", ["release", "--path", repair.workspace], { timeoutSeconds: 10 });
  } else if (outcome.status === "infrastructure-fixed") {
    repair.status = "ready-to-retry";
  }
  repair.finishedAt = new Date().toISOString();
  writeRepair(repair);
}

function completeRepair(requestId) {
  validateRequestId(requestId);
  ensureRepair(readRequest(requestId));
  const repair = readRepair(requestId);
  if (!repair) throw new Error("No dedicated repair receipt exists for this request");
  if (["submitted", "retry-submitted", "ready-to-retry"].includes(repair.status)) {
    process.stdout.write(`${JSON.stringify(repair)}\n`);
    return;
  }
  if (readRequest(requestId).status !== "failed") throw new Error("Only a failed publication can accept a repair result");
  if (serviceBusy(repair.unit)) throw new Error("Repair service is still active; its owner will accept the result");
  if (!["blocked", "submitting"].includes(repair.status)) throw new Error("Only an interrupted or blocked repair can be completed explicitly");
  const recovery = { at: new Date().toISOString(), status: repair.status, summary: repair.summary, unitResult: repair.unitResult };
  try {
    acceptRepairResult(repair);
    repair.resultRecovery = [...(repair.resultRecovery ?? []), recovery];
    delete repair.summary;
    writeRepair(repair);
  } catch (error) {
    repair.status = "blocked";
    repair.summary = error instanceof Error ? error.message : String(error);
    writeRepair(repair);
    throw error;
  }
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication-watchdog.service"], { timeoutSeconds: 5 });
  process.stdout.write(`${JSON.stringify(repair)}\n`);
}

export function refreshHostWaits(request) {
  if (["failed", "published"].includes(request.status)) return false;
  request.hosts ??= {};
  if (["live-meeting", "native-source", "native-history", "host-lock"].includes(request.waiting?.kind)) {
    const id = request.waiting.host;
    if (!request.hosts[id] || request.hosts[id].status !== "passed") request.hosts[id] = { status: "waiting", waiting: request.waiting, nextAttemptAt: request.nextAttemptAt };
    request.waiting = { kind: "hosts", hosts: [id], reason: `${id} waiting; other hosts roll forward independently.`, log: request.waiting.log };
  }
  let ready = false;
  for (const target of targets) {
    const host = request.hosts[target.id];
    if (!host) { ready = true; continue; }
    if (host.status === "passed") continue;
    if (host.status === "failed") continue;
    if (host.status !== "waiting") throw new Error(`Unknown delivery state for ${target.id}: ${host.status}`);
    try {
      let available;
      switch (host.waiting.kind) {
        case "live-meeting": {
          const rooms = meetingOverride(request.requestId) ? "" : censusTarget(target, request.meetingRuntimeProtocol);
          host.waiting.probe = { at: new Date().toISOString(), rooms };
          available = !rooms;
          break;
        }
        case "native-source": {
          const result = nativeSourceProbe(request, target);
          host.waiting.probe = { at: new Date().toISOString(), selected: result.ok ? "ready" : result.stderr.trim() };
          available = result.ok;
          break;
        }
        case "native-history-custody": {
          const owners = nativeHistoryCustodyOwners(request, target);
          host.waiting.owners = owners;
          host.waiting.probe = { at: new Date().toISOString(), owners };
          available = owners.length === 0;
          break;
        }
        case "native-history": {
          const result = nativeHistoryBoundaryTarget(request, target, "probe");
          host.waiting.probe = { at: new Date().toISOString(), boundary: result.ok ? "ready" : result.stderr.trim() };
          available = result.ok;
          break;
        }
        case "host-lock":
        case "thread-contract": available = true; break;
        default: throw new Error(`Unknown wait kind for ${target.id}: ${host.waiting.kind}`);
      }
      delete host.waiting.probeFailingSince;
      delete host.waiting.probeFailure;
      host.ready = available;
      if (available) ready = true;
      else host.nextAttemptAt = new Date(Date.now() + policy.blockedRetryMs).toISOString();
    } catch (error) {
      host.ready = false;
      const since = host.waiting.probeFailingSince ?? new Date().toISOString();
      host.waiting.probeFailingSince = since;
      host.waiting.probe = { at: new Date().toISOString(), error: error.message, ...(error.probeFailure ? { failure: error.probeFailure } : {}) };
      if (host.waiting.kind !== "live-meeting" || Date.now() - Date.parse(since) > policy.meetingProbeFailureLimitMs) {
        request.hosts[target.id] = { status: "failed", failure: { at: new Date().toISOString(), reason: "readiness-probe-failed",
          message: `${target.id} readiness probe failed: ${error.message}`, waiting: structuredClone(host.waiting) } };
        const history = request.nativeHistory?.hosts?.[target.id];
        if (host.waiting.kind === "native-history" && custodyNeedsRestore(history)) {
          history.state = "repair-required";
          history.probeFailure = structuredClone(host.waiting.probe);
        }
        const log = host.waiting.log ?? request.waiting?.log ?? join(logRoot, request.requestId, `attempt-${request.attempt}.log`);
        appendLog(log, `[${new Date().toISOString()}] ${request.hosts[target.id].failure.message}\n${JSON.stringify(host.waiting.probe)}\n`);
      }
    }
  }
  const failures = targets.filter(target => request.hosts[target.id]?.status === "failed");
  if (failures.length && !ready) {
    request.step = "host-readiness-probe";
    const log = request.waiting?.log ?? join(logRoot, request.requestId, `attempt-${request.attempt}.log`);
    updateFailure(request, failures.map(target => request.hosts[target.id].failure.message).join("; "), log, true, "readiness-probe-failed");
    return false;
  }
  if (!ready) request.nextAttemptAt = new Date(Date.now() + policy.blockedRetryMs).toISOString();
  writeRequest(request);
  return ready;
}

function bindBundleFollowers(owner) {
  const members = sourceBundleMembers(owner);
  if (!members.ok) throw new Error(`${members.error.kind}: ${members.error.detail}`);
  for (const source of members.sources.slice(1)) {
    const follower = readRequest(source.requestId);
    if (follower.sourceSha !== source.sourceSha || follower.sourceRef !== source.sourceRef) throw new Error(`Frozen bundle source changed: ${source.requestId}`);
    if (follower.sourceBundleOwner?.requestId === owner.requestId && follower.sourceBundleOwner.bundleId === owner.sourceBundle.id) continue;
    if (isCancelled(follower)) continue;
    if (!sourceOnlyQueued(follower)) throw new Error(`Frozen bundle member acquired separate work: ${source.requestId}`);
    follower.sourceBundleOwner = { requestId: owner.requestId, bundleId: owner.sourceBundle.id };
    follower.step = "awaiting-source-bundle";
    writeRequest(follower);
  }
}

export function freezeQueuedSources(request) {
  if (!sourceOnlyQueued(request) || meetingOverride(request.requestId)) return;
  const frozen = freezeSourceBundle(request, allRequests(), candidate => runnable(candidate) && !isCancelled(candidate) && !meetingOverride(candidate.requestId));
  if (!frozen.ok) throw new Error(`${frozen.error.kind}: ${frozen.error.detail}`);
  request.sourceBundle = frozen.bundle;
  writeRequest(request);
  bindBundleFollowers(request);
}

export function reconcileSourceBundles() {
  for (const owner of allRequests().filter(candidate => candidate.sourceBundle)) bindBundleFollowers(owner);
  for (const request of allRequests().filter(candidate => candidate.status === "queued" && candidate.sourceBundleOwner && !candidate.bundleEvidence && !isCancelled(candidate))) {
    const owner = readRequest(request.sourceBundleOwner.requestId);
    const resolved = resolveSourceBundle(request, owner);
    const log = owner.failure?.log ?? owner.checks?.log ?? join(logRoot, owner.requestId, `attempt-${owner.attempt}.log`);
    if (!resolved.ok) {
      updateFailure(request, `${resolved.error.kind}: ${resolved.error.detail}`, log, true, "source-bundle-invalid");
      continue;
    }
    if (resolved.state === "pending") continue;
    if (resolved.state === "failed") {
      updateFailure(request, `Source bundle ${owner.requestId} failed: ${resolved.failure?.message}`, log, true, "source-bundle-failed");
      continue;
    }
    const proof = commandResult("git", ["--no-replace-objects", "-C", checkout, "merge-base", "--is-ancestor", request.sourceSha, resolved.evidence.integrationSha]);
    if (!proof.ok) {
      updateFailure(request, `Checked bundle ${owner.requestId} omits requested source ${request.sourceSha}`, log, true, "source-bundle-ancestry-failed");
      continue;
    }
    Object.assign(request, resolved.evidence);
    request.step = "source-bundle-ready";
    writeRequest(request);
  }
}

export function drain() {
  ensureState();
  // Re-read after each request. A submission while this service is active needs no timer turn.
  for (;;) {
    const requests = allRequests();
    let restorationBlocked = false;
    for (const request of requests) {
      if (!recoveryNeeded(request)) continue;
      if ((request.recoveryAttempts ?? 0) >= policy.maxAttempts) { restorationBlocked = true; continue; }
      request.recoveryAttempts = (request.recoveryAttempts ?? 0) + 1;
      const previousStatus = request.status;
      const causalFailure = request.failure;
      const interruptedRecovery = request.recoveryInProgress === true;
      request.status = "running";
      request.recoveryInProgress = true;
      activeRequest = request;
      activeLog = request.failure?.log ?? join(logRoot, request.requestId, `attempt-${request.attempt}.log`);
      writeRequest(request);
      try {
        recoverOutstandingCustody(request, previousStatus);
        delete request.recoveryInProgress;
        if (interruptedRecovery && !causalFailure) updateFailure(request, "Interrupted host recovery completed; repair owns the next publication attempt", activeLog);
        else { request.status = causalFailure ? "failed" : previousStatus; writeRequest(request); }
      } catch (error) {
        delete request.recoveryInProgress;
        if (causalFailure) {
          request.status = "failed";
          request.failure = causalFailure;
          appendLog(activeLog, `[${new Date().toISOString()}] Host custody recovery failed: ${error.message}\n`);
          writeRequest(request);
          ensureRepair(request);
          deliverNotice(request);
        } else updateFailure(request, `Host custody recovery failed: ${error.message}`, activeLog);
        restorationBlocked = true;
      } finally { activeRequest = undefined; activeLog = undefined; }
    }
    // Recovery remains scoped by host reservations; an unavailable host cannot stop its peers.
    const cancelled = allRequests().find(candidate => !["failed", "published"].includes(candidate.status) && existsSync(cancellationPath(candidate.requestId)));
    if (cancelled) { processRequest(cancelled); continue; }
    reconcileSourceBundles();
    const request = allRequests().find(candidate => (runnable(candidate) && (!candidate.sourceBundleOwner || candidate.bundleEvidence)) || candidate.status === "running");
    if (!request) return;
    if (request.status === "running") {
      if (canResumeRebootedIntegration(request, workerBootId)) processRequest(request);
      else failStalled(request.requestId, "Publication worker interrupted; retained host custody has been recovered. Repair required before retry.");
      continue;
    }
    if (["live-meeting", "native-source", "native-history", "host-lock", "hosts"].includes(request.waiting?.kind) && !refreshHostWaits(request)) continue;
    if (progressBudgetExhausted(request)) {
      updateFailure(request, "Publication progress budget exhausted", request.waiting?.log ?? join(logRoot, request.requestId, `attempt-${request.attempt}.log`), true,
        request.waiting?.reason ?? "Publication progress budget exhausted");
      continue;
    }
    freezeQueuedSources(request);
    processRequest(request);
  }
}

function locked(name, operation, args = [], optional = false) {
  ensureState();
  const result = spawnSync("flock", ["--nonblock", "--conflict-exit-code", "75", "--close", join(stateRoot, `${name}.lock`),
    process.execPath, self, `_${operation}`, ...args], { stdio: "inherit" });
  if (result.status !== 0 && !(optional && result.status === 75)) throw new Error(`${operation}: ${result.status === 75 ? "publication owner is busy" : `exit ${result.status}`}`);
  return result.status === 0;
}

function main() {
  const [operation, ...args] = process.argv.slice(2);
  if (operation === "watchdog" && args.length === 0) return locked("watchdog", "watchdog", [], true);
  if (operation === "_watchdog" && args.length === 0) return watchdog();
  if (operation === "_drain" && args.length === 0) return drain();
  if (operation === "recover-native-history" && args.length === 2) return locked("worker", "recover-native-history", args);
  if (operation === "_recover-native-history" && args.length === 2) {
    validateRequestId(args[0]);
    const request = readRequest(args[0]);
    recoverNativeHistoryCustody(request, args[1]);
    process.stdout.write(`${JSON.stringify(request)}\n`);
    return;
  }
  if (operation === "_fail-stalled" && args.length === 2) return failStalled(...args);
  if (operation === "_fail-unclaimed" && args.length === 2) return failUnclaimed(...args);
  if (operation === "acknowledge-issues" && args.length === 0) return locked("worker", "acknowledge-issues");
  if (operation === "_acknowledge-issues" && args.length === 0) return acknowledgeIssues();
  if (operation === "issues" && args.length === 0) {
    const { visible, ...index } = deriveIssues();
    process.stdout.write(`${JSON.stringify(index, null, 2)}\n`);
    return;
  }
  if (operation === "notices" && args.length === 0) return locked("worker", "notices", [], true);
  if (operation === "_notices" && args.length === 0) return reconcileNotices();
  if (operation === "repair-run" && args.length === 1) return locked("repair-agent", "repair-run", args);
  if (operation === "_repair-run" && args.length === 1) return repairRun(args[0]);
  if (operation === "repair-result" && args.length === 1) return locked("watchdog", "repair-result", args);
  if (operation === "_repair-result" && args.length === 1) { validateRequestId(args[0]); return locked(`repair-result-${args[0]}`, "complete-repair", args); }
  if (operation === "_complete-repair" && args.length === 1) return completeRepair(args[0]);
  if (operation === "repair" && args.length === 1) return locked("worker", "repair", args);
  if (operation === "_repair" && args.length === 1) return requestRepair(args[0]);
  if (operation === "_retry" && args.length === 1) return retry(args[0]);
  if (operation === "_report" && [1, 3].includes(args.length)) return report(...args);
  if (operation === "install" && args.length === 0) return install();
  if (operation === "install" && args.length === 1 && args[0] === "--code-only") return locked("worker", "install-code");
  if (operation === "_install-code" && args.length === 0) return install(false);
  if (operation === "submit" && args.length === 1) return submit(args[0]);
  if (operation === "submit" && args.length === 3 && args[1] === "--repair-of") return submit(args[0], args[2]);
  if (operation === "inspect" && args.length === 1) return inspect(args[0]);
  if (operation === "retry") throw new Error("Blind retries are disabled; use repair REQUEST to assign its dedicated repair owner");
  if (operation === "cancel" && args.length === 1) return cancel(args[0]);
  if (operation === "gate-status" && args.length === 0) return gateStatus();
  if (operation === "allow-live-meetings" && args.length === 2) {
    validateRequestId(args[0]); readRequest(args[0]);
    if (!args[1].trim()) throw new Error("allow-live-meetings needs the authorization reason");
    mkdirSync(meetingOverrideRoot, { recursive: true });
    atomicWrite(join(meetingOverrideRoot, `${args[0]}.json`), `${JSON.stringify({ requestId: args[0], reason: args[1].trim(), at: new Date().toISOString() }, null, 2)}\n`);
    process.stdout.write(`${args[0]} may restart through live meetings\n`);
    return;
  }
  if (operation === "enqueue" && [3, 4, 5].includes(args.length)) return locked("intake", "enqueue", args);
  if (operation === "_enqueue" && [3, 4, 5].includes(args.length)) return enqueue(...args);
  if (operation === "report" && [1, 3].includes(args.length)) return locked("worker", "report", args);
  if (operation === "drain" && args.length === 0) return locked("worker", "drain", [], true);
  usage();
  process.exitCode = 2;
}

if (process.argv[1] && resolve(process.argv[1]) === self) {
  try {
    main();
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
    process.exitCode = 1;
  }
}
