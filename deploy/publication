function runHostScript(script, remoteHost, args, timeoutSeconds) {
  const command = remoteHost ? "ssh" : "bash";
  const remoteArgs = remoteHost
    ? ["-o", "BatchMode=yes", remoteHost, "bash", "-s", "--", ...args]
    : ["-s", "--", ...args];
  return runCapture(command, remoteArgs, { input: script, timeoutSeconds });
}

function runtimeCensus(remoteHost) {
  const target = targets.find(candidate => candidate.sshHost === (remoteHost ?? null));
  return JSON.parse(runHostScript(runtimeCensusScript, remoteHost, [target.id, target.releaseRepository], 60));
}

function sealPlan(remoteHost, fleet) {
  return JSON.parse(runHostScript(sealPlanScript, remoteHost, [targets.find(target => target.sshHost === (remoteHost ?? null)).id, planEncoding(fleet)], 60));
}

function planEncoding(plan) {
  return Buffer.from(JSON.stringify(plan), "utf8").toString("base64");
}

function sealHost(request, hostKey, remoteHost) {
  const plan = sealPlan(remoteHost, request.maintenance.hosts[hostKey].plan);
  request.bootstrap ??= { contract: threadExecutionContract, hosts: {} };
  request.bootstrap.hosts[hostKey] = { state: "restore-required", recordedAt: new Date().toISOString(), plan };
  writeRequest(request);
  const outcome = JSON.parse(runHostScript(sealScript, remoteHost, [hostKey, planEncoding(plan)], 90));
  request.bootstrap.hosts[hostKey].outcome = outcome;
  request.bootstrap.hosts[hostKey].state = outcome.state === "sealed" ? "sealed" : "restored";
  request.bootstrap.hosts[hostKey].updatedAt = new Date().toISOString();
  writeRequest(request);
  return outcome;
}

function custodyNeedsRestore(host) {
  return host && ["restore-required", "sealed", "deploying"].includes(host.state);
}

function restoreCustody(request, hostKey, remoteHost) {
  const host = request.bootstrap?.hosts?.[hostKey];
  if (!custodyNeedsRestore(host)) return;
  runHostScript(restoreScript, remoteHost, [planEncoding(host.plan)], 90);
  host.state = "restored";
  host.restoredAt = new Date().toISOString();
  writeRequest(request);
}

function releaseCustody(request, hostKey) {
  const target = targets.find(candidate => candidate.id === hostKey);
  restoreMaintenance(request, hostKey, target.sshHost, "released");
  const host = request.bootstrap?.hosts?.[hostKey];
  if (!host || host.state === "released") return;
  host.state = "released";
  host.releasedAt = new Date().toISOString();
  writeRequest(request);
}

function sha256(path) {
  return runCapture("sha256sum", [path]).split(/\s+/)[0];
}

export function retainSelectedSource(census, remoteHost) {
  const commit = census.selectedCommit;
  if (!commit) return;
  validateSha(commit);
  const target = targets.find(candidate => candidate.sshHost === (remoteHost ?? null));
  const repository = remoteHost ? `${remoteHost}:${target.releaseRepository}` : target.releaseRepository;
  const ref = `refs/pi-stack-publication/selected/${commit}`;
  if (!commandResult("git", ["-C", checkout, "cat-file", "-e", `${commit}^{commit}`]).ok) {
    checked("git", ["-C", checkout, "fetch", "--quiet", "--no-tags", repository, `${commit}:${ref}`], { timeoutSeconds: 45 });
  }
  checked("git", ["-C", checkout, "cat-file", "-e", `${commit}^{commit}`]);
  checked("git", ["-C", checkout, "update-ref", ref, commit]);
  census.selectedSource = { repository, ref, commit };
}

export function inspectReleaseAncestry(census, target, remoteHost) {
  validateSha(target);
  const baselines = [];
  for (const [kind, commit] of [["live", census.selectedCommit], ["checkout", census.checkoutCommit]]) {
    if (!commit) continue;
    const source = { selectedCommit: commit };
    retainSelectedSource(source, remoteHost);
    if (kind === "live") census.selectedSource = source.selectedSource;
    const result = commandResult("git", ["-C", checkout, "merge-base", "--is-ancestor", commit, target]);
    if (result.status !== 0 && result.status !== 1) {
      throw new Error(`cannot inspect release ancestry for ${commit}: ${result.stderr.trim()}`);
    }
    baselines.push({ kind, ...source.selectedSource, included: result.ok });
  }
  return { host: census.host, target, baselines, ok: baselines.every(baseline => baseline.included) };
}

export function hasExecutionContract(commit) {
  const result = commandResult("git", ["-C", checkout, "grep", "-q", "-F", "THREAD_EXECUTION_CONTRACT = \"unified-threads-v1\"", commit, "--", "packages/orchestrator/src/threads/contracts.ts"]);
  if (result.status > 1) throw new Error(`cannot inspect execution contract in ${commit}: ${result.stderr.trim()}`);
  return result.ok;
}

function validateBootstrapTarget(request) {
  const required = [
    ["packages/orchestrator/src/threads/contracts.ts", "THREAD_EXECUTION_CONTRACT = \"unified-threads-v1\""],
    ["packages/orchestrator/src/threads/import.ts", "export function importRemoteThreads"],
    ["apps/remote/server/server.ts", "importRemoteThreads"],
  ];
  for (const [path, text] of required) {
    const result = commandResult("git", ["-C", checkout, "grep", "-q", "-F", text, request.integrationSha, "--", path]);
    if (!result.ok) throw new Error(`${request.integrationSha} does not implement ${threadExecutionContract}: missing ${text} in ${path}`);
  }
}

function activatedContract() {
  if (!existsSync(threadExecutionActivationPath)) return null;
  const activation = JSON.parse(readFileSync(threadExecutionActivationPath, "utf8"));
  if (activation.version !== 1 || activation.contract !== threadExecutionContract) throw new Error(`invalid contract activation receipt: ${threadExecutionActivationPath}`);
  validateSha(activation.integrationSha);
  return activation;
}

function selectedHasContract(selectedCommit, request) {
  if (!selectedCommit) return false;
  if (selectedCommit === request.integrationSha) return true;
  return hasExecutionContract(selectedCommit);
}

function recordContractActivation(request) {
  if (existsSync(threadExecutionActivationPath)) return;
  atomicWrite(threadExecutionActivationPath, `${JSON.stringify({
    version: 1,
    contract: threadExecutionContract,
    integrationSha: request.integrationSha,
    activatedAt: new Date().toISOString(),
    requestId: request.requestId,
    hosts: Object.fromEntries(targets.map(target => [target.id, request.hosts[target.id]])),
  }, null, 2)}\n`);
}

function recoverOutstandingCustody(request, status = request.status) {
  for (const { id: hostKey, sshHost: remoteHost } of targets) {
    const restoringSeal = custodyNeedsRestore(request.bootstrap?.hosts?.[hostKey]);
    const terminal = ["failed", "published"].includes(status) || existsSync(cancellationPath(request.requestId));
    const maintenance = request.maintenance?.hosts?.[hostKey];
    const restoringMaintenance = terminal && maintenance && !["restored", "released"].includes(maintenance.state);
    if (!restoringSeal && !restoringMaintenance) continue;
    try {
      restoreCustody(request, hostKey, remoteHost);
      if (terminal) restoreMaintenance(request, hostKey, remoteHost);
      delete request.recoveryFailure;
      writeRequest(request);
    } catch (error) {
      request.recoveryFailure = {
        at: new Date().toISOString(),
        host: hostKey,
        message: error instanceof Error ? error.message : String(error),
      };
      writeRequest(request);
      throw error;
    }
  }
}

export function processRequest(request) {
  request.attempt = (request.attempt ?? 0) + 1;
  activeRequest = request;
  request.status = "running";
  request.startedAt ??= new Date().toISOString();
  request.step = "starting";
  delete request.failure;
  writeRequest(request);
  const attemptRoot = join(logRoot, request.requestId);
  mkdirSync(attemptRoot, { recursive: true, mode: 0o700 });
  const logPath = join(attemptRoot, `attempt-${request.attempt}.log`);
  activeLog = logPath;
  appendLog(logPath, `[${new Date().toISOString()}] request=${request.requestId} source=${request.sourceSha} attempt=${request.attempt}\n`);

  try {
    checkCancellation(request);
    let result = prepareCheckout(request, logPath);
    if (!result.ok) throw new Error(result.stderr.trim() || `checkout preparation exited ${result.status}`);

    const remoteMain = runCapture("git", ["-C", checkout, "rev-parse", "refs/remotes/origin/main^{commit}"]);
    const reusableIntegration = request.integrationSha && request.checks?.status === "passed"
      && (remoteMain === request.integrationSha || remoteMain === request.baseSha)
      && commandResult("git", ["-C", checkout, "cat-file", "-e", `${request.integrationSha}^{commit}`]).ok;
    if (!reusableIntegration) {
      delete request.integrationSha;
      delete request.baseSha;
      delete request.checks;
      delete request.hosts;
      result = createIntegration(request, logPath);
      if (!result.ok) throw new Error(result.stderr.trim() || `${request.step} exited ${result.status}`);
    }

    prepareAndroidArtifact(request, logPath);
    request.step = "inspect-thread-execution-contract";
    writeRequest(request);
    request.contract = hasExecutionContract(request.integrationSha) ? threadExecutionContract : null;
    if (!request.contract && activatedContract()) throw new Error("Refusing to remove the activated thread execution contract");
    writeRequest(request);
    const requestProofRoot = join(proofRoot, request.requestId);
    const deploymentsPassed = targets.every(target => request.hosts?.[target.id]?.status === "passed");
    if (!deploymentsPassed) {
      request.step = "inspect-release-ancestry";
      writeRequest(request);
      const censuses = targets.map(target => runtimeCensus(target.sshHost));
      const ancestry = targets.map((target, index) => inspectReleaseAncestry(censuses[index], request.integrationSha, target.sshHost));
      const ancestryProofPath = join(requestProofRoot, "release-ancestry.json");
      atomicWrite(ancestryProofPath, `${JSON.stringify({ checkedAt: new Date().toISOString(), hosts: ancestry }, null, 2)}\n`);
      request.releaseAncestry = { proof: ancestryProofPath, sha256: sha256(ancestryProofPath) };
      writeRequest(request);
      const missing = ancestry.flatMap(host => host.baselines.filter(baseline => !baseline.included)
        .map(baseline => `${host.host} ${baseline.kind} ${baseline.commit}`));
      if (missing.length) throw new Error(`Integration ${request.integrationSha} omits host source: ${missing.join(", ")}; merge the retained commits into the repair source before publication`);
      request.step = "inspect-thread-execution-contract";
      writeRequest(request);
      if (!request.contract && censuses.some(host => host.selectedCommit && hasExecutionContract(host.selectedCommit))) {
        throw new Error("Refusing to replace a host's thread execution contract with a target that lacks it");
      }
      const bootstrap = targets.map((target, index) => !!request.contract && !selectedHasContract(censuses[index].selectedCommit, request));
      for (const [index, census] of censuses.entries()) census.contract = bootstrap[index] ? "pre-contract" : request.contract;
      if (request.contract) validateBootstrapTarget(request);
      checkCancellation(request);
      for (const [index, target] of targets.entries()) {
        if (!bootstrap[index]) continue;
        censuses[index].fleet = ensureMaintenance(request, target.id, target.sshHost);
        Object.assign(censuses[index], runtimeCensus(target.sshHost));
      }
      const gateProofPath = join(requestProofRoot, "thread-execution-gate.json");
      atomicWrite(gateProofPath, `${JSON.stringify({ checkedAt: new Date().toISOString(), contract: request.contract, hosts: censuses }, null, 2)}\n`);
      request.contractGate = { proof: gateProofPath, sha256: sha256(gateProofPath) };
      if (censuses.some((census, index) => bootstrap[index] && (census.runtimes.length > 0 || census.fleet.activeRuns.length > 0))) {
        updateBlocked(request, censuses, logPath);
        return;
      }

      request.step = bootstrap.some(Boolean) ? "seal-pre-contract-intake" : "live-handoff";
      writeRequest(request);
      const sealed = [];
      for (const [index, target] of targets.entries()) {
        if (!bootstrap[index]) continue;
        const outcome = sealHost(request, target.id, target.sshHost);
        if (outcome.state !== "sealed") {
          for (const previous of sealed) restoreCustody(request, previous.id, previous.sshHost);
          updateBlocked(request, [...censuses, outcome], logPath);
          return;
        }
        sealed.push(target);
      }
      if (request.waiting) {
        request.gateWait = { ...request.waiting, blockedSince: request.blockedSince, resumedAt: new Date().toISOString() };
        delete request.waiting;
        delete request.blockedSince;
        delete request.nextAttemptAt;
      }
      if (bootstrap.some(Boolean)) {
        request.contractGate.sealedAt = new Date().toISOString();
        writeRequest(request);
      }

      result = publishIntegration(request, logPath);
      if (result.kind === "main-moved") {
        requeueMovedIntegration(request, result.remoteMain, logPath);
        return;
      }
      if (!result.ok) throw new Error(result.stderr.trim() || `main integration exited ${result.status}`);

      for (const target of targets) {
        if (request.hosts?.[target.id]?.status === "passed") continue;
        if (request.bootstrap?.hosts?.[target.id]?.state === "sealed") {
          request.bootstrap.hosts[target.id].state = "deploying";
          writeRequest(request);
        }
        result = target.sshHost
          ? runLogged(request, `deploy-${target.id}`, "ssh", ["-o", "BatchMode=yes", target.sshHost, target.releaseCommand, request.integrationSha], 240, logPath)
          : runLogged(request, `deploy-${target.id}`, target.releaseCommand, [request.integrationSha], 180, logPath);
        if (!result.ok) throw new Error(`${target.id} release wrapper exited ${result.status}`);
        const proof = verifyTarget(target, request.integrationSha);
        const proofPath = join(requestProofRoot, `${target.id}.json`);
        atomicWrite(proofPath, `${JSON.stringify(proof, null, 2)}\n`);
        request.hosts ??= {};
        request.hosts[target.id] = { status: "passed", proof: proofPath, sha256: sha256(proofPath) };
        writeRequest(request);
        releaseCustody(request, target.id);
      }
    } else {
      for (const target of targets) {
        verifyTarget(target, request.integrationSha);
        releaseCustody(request, target.id);
      }
    }
    publishAndroidArtifact(request, logPath);
    const finalProofs = Object.fromEntries(targets.map(target => [target.id, verifyTarget(target, request.integrationSha)]));
    const finalProofPath = join(requestProofRoot, "final-hosts.json");
    atomicWrite(finalProofPath, `${JSON.stringify(finalProofs, null, 2)}\n`);
    request.finalProof = { path: finalProofPath, sha256: sha256(finalProofPath) };
    writeRequest(request);
    if (request.contract) recordContractActivation(request);

    checkCancellation(request);
    request.status = "running";
    request.step = "adopt-publication-owner";
    writeRequest(request);
    const ownerSource = checked("git", ["-C", checkout, "rev-parse", "HEAD"]);
    if (ownerSource !== request.integrationSha) throw new Error(`Publication owner checkout ${ownerSource} differs from checked integration ${request.integrationSha}`);
    installFrom(checkout);

    request.status = "published";
    request.step = "complete";
    request.publishedAt = new Date().toISOString();
    request.receipt = requestPath(request.requestId);
    delete request.failure;
    writeRequest(request);
    appendLog(logPath, `[${new Date().toISOString()}] published integration=${request.integrationSha}\n`);
    if (request.android) {
      rmSync(join(request.android.directory, request.android.release.fileName), { force: true });
      rmSync(join(request.android.directory, `${request.android.release.revision}.web.zip`), { force: true });
    }
    deliverNotice(request);
  } catch (error) {
    const failedProgress = request.progress;
    const failedStep = request.step;
    const restorationFailures = [];
    for (const { id: hostKey, sshHost: remoteHost } of targets) {
      try {
        restoreCustody(request, hostKey, remoteHost);
        restoreMaintenance(request, hostKey, remoteHost);
      }
      catch (restoreError) { restorationFailures.push(`${hostKey}: ${restoreError instanceof Error ? restoreError.message : String(restoreError)}`); }
    }
    request.progress = failedProgress;
    request.step = failedStep;
    let message = error instanceof Error ? error.message : String(error);
    if (restorationFailures.length) message += `; intake restoration failed: ${restorationFailures.join("; ")}`;
    appendLog(logPath, `[${new Date().toISOString()}] failed step=${request.step}: ${message}\n`);
    updateFailure(request, message, logPath);
  } finally {
    activeRequest = undefined;
    activeLog = undefined;
  }
}

function gateStatus() {
  process.stdout.write(`${JSON.stringify({
    checkedAt: new Date().toISOString(),
    contract: activatedContract(),
    hosts: targets.map(target => runtimeCensus(target.sshHost)),
  }, null, 2)}\n`);
}

function allRequests() {
  return readdirSync(requestRoot).filter(name => /^PUB-[a-f0-9]{24}\.json$/.test(name))
    .map(name => migrateRequestOnRead(JSON.parse(readFileSync(join(requestRoot, name), "utf8"))))
    .sort((a, b) => (a.queuedAt ?? "").localeCompare(b.queuedAt ?? ""));
}

function existingSource(sourceSha) {
  const matches = allRequests().filter(request => request.sourceSha === sourceSha);
  return matches.find(request => request.status === "published") ?? matches.at(-1);
}

function repairPath(requestId) { return join(repairRoot, requestId, "receipt.json"); }
function readRepair(requestId) {
  return existsSync(repairPath(requestId)) ? JSON.parse(readFileSync(repairPath(requestId), "utf8")) : null;
}
function writeRepair(repair) {
  repair.updatedAt = new Date().toISOString();
  atomicWrite(repair.path, `${JSON.stringify(repair, null, 2)}\n`);
}

function ensureRepair(request) {
  if (readRepair(request.requestId)) return;
  const directory = join(repairRoot, request.requestId);
  const exhausted = (request.repairDepth ?? 0) >= policy.maxRepairDepth;
  writeRepair({ id: repairId(request.requestId), requestId: request.requestId, sourceSha: request.sourceSha,
    integrationSha: request.integrationSha, failure: request.failure, status: exhausted ? "blocked" : "pending",
    ...(exhausted ? { summary: "Automatic repair chain exhausted; Hara must assign the remaining blocker" } : {}),
    createdAt: new Date().toISOString(), path: repairPath(request.requestId), requestPath: requestPath(request.requestId),
    session: join(directory, "session.jsonl"), log: join(directory, "agent.log"), result: join(directory, "result.json"),
    prompt: join(directory, "prompt.md"), unit: repairUnit(request.requestId), launchAttempts: 0 });
}

function requestRepair(requestId) {
  validateRequestId(requestId);
  const request = readRequest(requestId);
  if (request.status !== "failed" || request.failure?.reason === "cancelled") throw new Error("Only repairable failed requests need repair adoption");
  ensureRepair(request);
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication-watchdog.service"]);
  process.stdout.write(`${JSON.stringify(readRepair(requestId))}\n`);
}

function serviceState(unit) {
  return checked("systemctl", ["--user", "show", unit, "-p", "ActiveState", "--value"], { timeoutSeconds: 5 });
}
function serviceBusy(unit) { return ["active", "activating", "deactivating", "reloading"].includes(serviceState(unit)); }

function failStalled(requestId, reason) {
  const request = readRequest(requestId);
  if (!["queued", "running"].includes(request.status)) return;
  const log = request.progress?.log ?? join(logRoot, requestId, `attempt-${request.attempt}.log`);
  appendLog(log, `\n[${new Date().toISOString()}] watchdog: ${reason}\n`);
  updateFailure(request, reason, log, false);
}

function watchdog() {
  ensureState();
  const activatedAt = existsSync(repairPolicyPath) ? JSON.parse(readFileSync(repairPolicyPath, "utf8")).activatedAt : new Date().toISOString();
  for (const request of allRequests()) {
    const reason = stallReason(request);
    if (reason) {
      checked("systemctl", ["--user", "stop", "pi-stack-publication.service"], { timeoutSeconds: 20 });
      locked("worker", "fail-stalled", [request.requestId, reason]);
    }
    if (request.status === "failed" && request.failure?.at >= activatedAt) ensureRepair(request);
  }
  const queue = allRequests();
  const idlePath = join(stateRoot, "worker-watch.json");
  const idle = existsSync(idlePath) ? JSON.parse(readFileSync(idlePath, "utf8")) : {};
  const waiting = queue.find(request => runnable(request));
  const custodyOwners = queue.filter(request => Object.values(request.bootstrap?.hosts ?? {}).some(custodyNeedsRestore));
  idle.blockedBy = custodyOwners.map(request => request.requestId);
  if (waiting && custodyOwners.length === 0 && !queue.some(request => request.status === "running")) {
    idle.since ??= new Date().toISOString();
    if (Date.now() - Date.parse(idle.since) > policy.betweenStepsMs) {
      checked("systemctl", ["--user", "stop", "pi-stack-publication.service"], { timeoutSeconds: 20 });
      locked("worker", "fail-stalled", [waiting.requestId, "Queue made no progress for 90s; worker never claimed a request"]);
      delete idle.since;
    }
  } else { delete idle.since; idle.wakeFailures = 0; }
  atomicWrite(idlePath, JSON.stringify(idle));
  const repairs = allRequests().map(request => readRepair(request.requestId)).filter(Boolean);
  let busy = false;
  for (const repair of repairs) {
    if (repair.status === "submitted" && repair.successor) {
      const successor = readRequest(repair.successor.requestId);
      if (repair.successor.status !== successor.status) {
        repair.successor = { ...repair.successor, status: successor.status, integrationSha: successor.integrationSha,
          failure: successor.failure, publishedAt: successor.publishedAt };
        writeRepair(repair);
      }
    }
    if (repair.status === "ready-to-retry") {
      if (locked("worker", "retry", [repair.requestId], true)) {
        repair.status = "retry-submitted";
        writeRepair(repair);
      }
    }
    if (["launching", "running", "submitting"].includes(repair.status)) {
      if (serviceBusy(repair.unit)) { busy = true; continue; }
      const successorId = `PUB-${createHash("sha256").update(`repair:${repair.requestId}`).digest("hex").slice(0, 24)}`;
      if (existsSync(requestPath(successorId))) {
        const successor = readRequest(successorId);
        repair.successor = { requestId: successorId, sourceSha: successor.sourceSha, receipt: requestPath(successorId) };
        repair.status = "submitted";
      } else if (readRequest(repair.requestId).repairedRetry?.repairId === repair.id) {
        repair.status = "retry-submitted";
      } else {
        repair.status = "blocked";
        repair.summary = "Repair service exited or was interrupted without a terminal receipt; inspect its saved session, agent log and unit result. No automatic replay.";
        repair.unitResult = commandResult("systemctl", ["--user", "show", repair.unit, "-p", "Result", "-p", "ExecMainStatus"], { timeoutSeconds: 5 }).stdout;
      }
      writeRepair(repair);
    }
  }
  const agentLock = commandResult("flock", ["--nonblock", "--conflict-exit-code", "75", join(stateRoot, "repair-agent.lock"), "true"], { timeoutSeconds: 2 });
  if (!agentLock.ok && agentLock.status !== 75) throw new Error(`Cannot inspect repair-agent ownership: ${agentLock.stderr}`);
  if (!busy && agentLock.ok) {
    const repair = repairs.find(candidate => candidate.status === "pending");
    if (repair) {
      repair.launchAttempts += 1;
      repair.status = "launching";
      repair.launchedAt = new Date().toISOString();
      writeRepair(repair);
      const launch = commandResult("systemctl", ["--user", "start", "--no-block", repair.unit], { timeoutSeconds: 5 });
      if (!launch.ok) {
        repair.status = repair.launchAttempts >= policy.maxLaunchAttempts ? "blocked" : "pending";
        repair.summary = `Could not start dedicated repair service: ${launch.stderr || launch.status}`;
        writeRepair(repair);
      }
    }
  }
  // This wake is independent of the worker and also closes enqueue's start/exit race.
  const current = allRequests();
  const recoveryBlocked = current.some(request => (request.recoveryAttempts ?? 0) >= policy.maxAttempts
    && Object.values(request.bootstrap?.hosts ?? {}).some(custodyNeedsRestore));
  if (!recoveryBlocked && current.some(request => runnable(request) || request.status === "running"
    || Object.values(request.bootstrap?.hosts ?? {}).some(custodyNeedsRestore))) {
    const wake = commandResult("systemctl", ["--user", "start", "--no-block", "pi-stack-publication.service"], { timeoutSeconds: 5 });
    idle.wakeFailures = wake.ok ? 0 : (idle.wakeFailures ?? 0) + 1;
    idle.wakeError = wake.ok ? undefined : wake.stderr;
    atomicWrite(idlePath, JSON.stringify(idle));
    if (!wake.ok && idle.wakeFailures >= policy.maxLaunchAttempts && waiting) {
      locked("worker", "fail-stalled", [waiting.requestId, `Worker could not start after ${idle.wakeFailures} attempts: ${wake.stderr}`]);
    }
  } else {
    checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication-notices.service"], { timeoutSeconds: 5 });
  }
}

function repairRun(requestId) {
  validateRequestId(requestId);
  const repair = readRepair(requestId);
  if (!repair || repair.status !== "launching") return;
  const attemptPath = join(dirname(repair.path), "attempt.json");
  if (existsSync(attemptPath)) return;
  atomicWrite(attemptPath, JSON.stringify({ repairId: repair.id, startedAt: new Date().toISOString(), session: repair.session }));
  const request = readRequest(requestId);
  repair.status = "running";
  repair.startedAt = new Date().toISOString();
  writeRepair(repair);
  try {
    try {
      const workspace = JSON.parse(checked("agent-workspace", ["create", "--root", config.repairWorkspaceRoot,
        "--name", `publication-repair-${requestId}`, "--repo", checkout, "--owner", repair.id, "--mode", "writer", "--json"], { timeoutSeconds: 45 }));
      repair.workspace = workspace.path;
      writeRepair(repair);
      if (!commandResult("git", ["cat-file", "-e", `${request.sourceSha}^{commit}`], { cwd: repair.workspace }).ok) {
        checked("git", ["fetch", "--quiet", "origin", request.sourceRef], { cwd: repair.workspace });
      }
      checked("git", ["checkout", "--detach", request.sourceSha], { cwd: repair.workspace });
    } catch (error) {
      repair.workspaceError = error instanceof Error ? error.message : String(error);
      writeRepair(repair);
    }
    atomicWrite(repair.prompt, repairPrompt(request, repair, installedCommand));
    const fd = openSync(repair.log, "a", 0o600);
    let result;
    try {
      result = commandResult(config.piCommand,
        ["--print", "--mode", "json", "--model", "openai-codex/gpt-6-astra", "--thinking", "high",
          "--session", repair.session, `@${repair.prompt}`],
        { cwd: repair.workspace && existsSync(repair.workspace) ? repair.workspace : dirname(repair.path),
          timeoutSeconds: policy.repairMs / 1000, stdio: ["ignore", fd, fd] });
    } finally { closeSync(fd); }
    if (!result.ok) throw new Error(`Repair agent exited ${result.status}; see ${repair.log}`);
    acceptRepairResult(repair);
  } catch (error) {
    repair.status = "blocked";
    repair.summary = error instanceof Error ? error.message : String(error);
    repair.finishedAt = new Date().toISOString();
    writeRepair(repair);
  }
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication-watchdog.service"], { timeoutSeconds: 5 });
}

function acceptRepairResult(repair) {
  if (!existsSync(repair.result)) throw new Error(`Repair agent returned without ${repair.result}`);
  const outcome = JSON.parse(readFileSync(repair.result, "utf8"));
  if (!["source-fixed", "infrastructure-fixed", "blocked"].includes(outcome.status) || !outcome.summary?.trim()) throw new Error("Repair result needs a status and cause/repair summary");
  if (outcome.status !== "blocked" && (!outcome.evidence || !existsSync(outcome.evidence))) throw new Error("Repair result needs an existing focused proof receipt");
  if (outcome.status === "source-fixed") {
    validateSha(outcome.sourceSha);
    if (!(outcome.workspace ?? repair.workspace)) throw new Error("Source repair must identify its registered workspace");
  }
  if (outcome.status !== "blocked") {
    const evidenceSource = resolve(outcome.evidence);
    const evidence = join(dirname(repair.path), "evidence");
    atomicWrite(evidence, readFileSync(evidenceSource));
    outcome.evidence = evidence;
    outcome.evidenceSource = evidenceSource;
    outcome.evidenceSha256 = sha256(evidence);
  }
  repair.outcome = outcome;
  if (outcome.workspace) repair.workspace = resolve(outcome.workspace);
  repair.status = outcome.status === "blocked" ? "blocked" : "submitting";
  writeRepair(repair);
  if (outcome.status === "source-fixed") {
    repair.successor = JSON.parse(checked(installedCommand, ["submit", outcome.sourceSha, "--repair-of", repair.requestId],
      { cwd: repair.workspace, timeoutSeconds: 45 }));
    repair.status = "submitted";
    writeRepair(repair);
    checked("agent-workspace", ["release", "--path", repair.workspace], { timeoutSeconds: 10 });
  } else if (outcome.status === "infrastructure-fixed") {
    repair.status = "ready-to-retry";
  }
  repair.finishedAt = new Date().toISOString();
  writeRepair(repair);
}

function completeRepair(requestId) {
  validateRequestId(requestId);
  const repair = readRepair(requestId);
  if (!repair) throw new Error("No dedicated repair receipt exists for this request");
  if (["submitted", "retry-submitted", "ready-to-retry"].includes(repair.status)) {
    process.stdout.write(`${JSON.stringify(repair)}\n`);
    return;
  }
  if (readRequest(requestId).status !== "failed") throw new Error("Only a failed publication can accept a repair result");
  if (serviceBusy(repair.unit)) throw new Error("Repair service is still active; its owner will accept the result");
  if (!["blocked", "submitting"].includes(repair.status)) throw new Error("Only an interrupted or blocked repair can be completed explicitly");
  const recovery = { at: new Date().toISOString(), status: repair.status, summary: repair.summary, unitResult: repair.unitResult };
  try {
    acceptRepairResult(repair);
    repair.resultRecovery = [...(repair.resultRecovery ?? []), recovery];
    delete repair.summary;
    writeRepair(repair);
  } catch (error) {
    repair.status = "blocked";
    repair.summary = error instanceof Error ? error.message : String(error);
    writeRepair(repair);
    throw error;
  }
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication-watchdog.service"], { timeoutSeconds: 5 });
  process.stdout.write(`${JSON.stringify(repair)}\n`);
}

function drain() {
  ensureState();
  // Re-read after each request. A submission while this service is active needs no timer turn.
  for (;;) {
    const requests = allRequests();
    let restorationBlocked = false;
    for (const request of requests) {
      if (!Object.values(request.bootstrap?.hosts ?? {}).some(custodyNeedsRestore) && !(["failed", "published"].includes(request.status) && Object.values(request.maintenance?.hosts ?? {}).some(host => !["restored", "released"].includes(host.state)))) continue;
      if ((request.recoveryAttempts ?? 0) >= policy.maxAttempts) { restorationBlocked = true; continue; }
      request.recoveryAttempts = (request.recoveryAttempts ?? 0) + 1;
      const previousStatus = request.status;
      const interruptedRecovery = request.recoveryInProgress === true;
      request.status = "running";
      request.recoveryInProgress = true;
      activeRequest = request;
      activeLog = request.failure?.log ?? join(logRoot, request.requestId, `attempt-${request.attempt}.log`);
      writeRequest(request);
      try {
        recoverOutstandingCustody(request, previousStatus);
        delete request.recoveryInProgress;
        if (interruptedRecovery) updateFailure(request, "Interrupted host recovery completed; repair owns the next publication attempt", activeLog);
        else { request.status = previousStatus; writeRequest(request); }
      } catch (error) {
        delete request.recoveryInProgress;
        updateFailure(request, `Host custody recovery failed: ${error.message}`, activeLog);
        restorationBlocked = true;
      } finally { activeRequest = undefined; activeLog = undefined; }
    }
    if (restorationBlocked) return;
    const cancelled = allRequests().find(candidate => !["failed", "published"].includes(candidate.status) && existsSync(cancellationPath(candidate.requestId)));
    if (cancelled) { processRequest(cancelled); continue; }
    const request = allRequests().find(candidate => runnable(candidate) || candidate.status === "running");
    if (!request) return;
    if (request.status === "running") {
      failStalled(request.requestId, "Publication worker interrupted; retained host custody has been recovered. Repair required before retry.");
      continue;
    }
    if ((request.attempt ?? 0) >= (request.attemptLimit ?? policy.maxAttempts)
      || request.blockedSince && Date.now() - Date.parse(request.blockedSince) > policy.blockedLimitMs) {
      updateFailure(request, "Publication progress budget exhausted", request.waiting?.log ?? join(logRoot, request.requestId, `attempt-${request.attempt}.log`), true,
        request.waiting?.reason ?? "Publication progress budget exhausted");
      continue;
    }
    processRequest(request);
  }
}

function locked(name, operation, args = [], optional = false) {
  ensureState();
  const result = spawnSync("flock", ["--nonblock", "--conflict-exit-code", "75", "--close", join(stateRoot, `${name}.lock`),
    process.execPath, self, `_${operation}`, ...args], { stdio: "inherit" });
  if (result.status !== 0 && !(optional && result.status === 75)) throw new Error(`${operation}: ${result.status === 75 ? "publication owner is busy" : `exit ${result.status}`}`);
  return result.status === 0;
}

function main() {
  const [operation, ...args] = process.argv.slice(2);
  if (operation === "watchdog" && args.length === 0) return locked("watchdog", "watchdog", [], true);
  if (operation === "_watchdog" && args.length === 0) return watchdog();
  if (operation === "_drain" && args.length === 0) return drain();
  if (operation === "_fail-stalled" && args.length === 2) return failStalled(...args);
  if (operation === "acknowledge-issues" && args.length === 0) return locked("worker", "acknowledge-issues");
  if (operation === "_acknowledge-issues" && args.length === 0) return acknowledgeIssues();
  if (operation === "issues" && args.length === 0) return locked("worker", "issues");
  if (operation === "_issues" && args.length === 0) {
    const { visible, ...index } = reconcileIssueAlert();
    process.stdout.write(`${JSON.stringify(index, null, 2)}\n`);
    return;
  }
  if (operation === "notices" && args.length === 0) return locked("worker", "notices", [], true);
  if (operation === "_notices" && args.length === 0) return reconcileNotices();
  if (operation === "repair-run" && args.length === 1) return locked("repair-agent", "repair-run", args);
  if (operation === "_repair-run" && args.length === 1) return repairRun(args[0]);
  if (operation === "repair-result" && args.length === 1) return locked("watchdog", "repair-result", args);
  if (operation === "_repair-result" && args.length === 1) return locked("repair-agent", "complete-repair", args);
  if (operation === "_complete-repair" && args.length === 1) return completeRepair(args[0]);
  if (operation === "repair" && args.length === 1) return locked("worker", "repair", args);
  if (operation === "_repair" && args.length === 1) return requestRepair(args[0]);
  if (operation === "_retry" && args.length === 1) return retry(args[0]);
  if (operation === "_report" && [1, 3].includes(args.length)) return report(...args);
  if (operation === "install" && args.length === 0) return install();
  if (operation === "submit" && args.length === 1) return submit(args[0]);
  if (operation === "submit" && args.length === 3 && args[1] === "--repair-of") return submit(args[0], args[2]);
  if (operation === "inspect" && args.length === 1) return inspect(args[0]);
  if (operation === "retry") throw new Error("Blind retries are disabled; use repair REQUEST to assign its dedicated repair owner");
  if (operation === "cancel" && args.length === 1) return cancel(args[0]);
  if (operation === "gate-status" && args.length === 0) return gateStatus();
  if (operation === "enqueue" && [3, 4, 5].includes(args.length)) return locked("intake", "enqueue", args);
  if (operation === "_enqueue" && [3, 4, 5].includes(args.length)) return enqueue(...args);
  if (operation === "report" && [1, 3].includes(args.length)) return locked("worker", "report", args);
  if (operation === "drain" && args.length === 0) return locked("worker", "drain", [], true);
  usage();
  process.exitCode = 2;
}

if (process.argv[1] && resolve(process.argv[1]) === self) {
  try {
    main();
  } catch (error) {
    process.stderr.write(`${error instanceof Error ? error.message : String(error)}\n`);
    process.exitCode = 1;
  }
}
