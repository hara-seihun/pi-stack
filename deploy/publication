#!/usr/bin/env node
import { createHash, randomUUID } from "node:crypto";
import {
  closeSync,
  readSync,
  fstatSync,
  copyFileSync,
  existsSync,
  fsyncSync,
  mkdirSync,
  openSync,
  readFileSync,
  readdirSync,
  renameSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import { dirname, join, resolve } from "node:path";
import { homedir } from "node:os";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";
import { policy, stallReason, runnable, repairId, repairUnit, repairPrompt } from "./publication-control.mjs";
import { loadPublicationConfig } from "./publication-config.mjs";

const config = loadPublicationConfig();
const { repositoryUrl, canonicalRepository, stateRoot, installedCommand, userUnitRoot, targets, alertInbox } = config;
const requestRoot = join(stateRoot, "requests");
const logRoot = join(stateRoot, "logs");
const proofRoot = join(stateRoot, "proofs");
const contractRoot = join(stateRoot, "contracts");
const checkout = join(stateRoot, "repository");

const issueAcknowledgementsPath = join(stateRoot, "issue-acknowledgements.json");
const issueAlertPath = join(alertInbox, "pi-stack-publication-issues.md");
const threadExecutionContract = "unified-threads-v1";
const threadExecutionActivationPath = join(contractRoot, `${threadExecutionContract}.json`);
const self = fileURLToPath(import.meta.url);
const repairRoot = join(stateRoot, "repairs");
const repairPolicyPath = join(stateRoot, "repair-policy.json");
let activeRequest;
let activeLog;
let trackingCommand = false;

function usage() {
  process.stderr.write(`usage:
  deploy/publication install
  deploy/publication submit SHA
  deploy/publication inspect REQUEST
  deploy/publication issues
  deploy/publication acknowledge-issues
  deploy/publication cancel REQUEST
  deploy/publication repair REQUEST
  deploy/publication repair-result REQUEST
  deploy/publication submit SHA --repair-of REQUEST
  deploy/publication report REQUEST [REMOTE_URL SESSION_ID]
  deploy/publication gate-status

The installed systemd user service also invokes the internal enqueue and drain commands.\n`);
}

function commandResult(command, args, options = {}) {
  const timeoutSeconds = options.timeoutSeconds ?? 60;
  const tracked = activeRequest && !trackingCommand;
  if (tracked) {
    trackingCommand = true;
    const startedAt = new Date().toISOString();
    activeRequest.progress = { step: activeRequest.step, command, args, cwd: options.cwd,
      startedAt, deadlineAt: new Date(Date.now() + timeoutSeconds * 1000).toISOString(), log: activeLog };
    writeRequest(activeRequest);
    trackingCommand = false;
  }
  const invocation = spawnSync(
    "timeout",
    ["--kill-after=10s", `${timeoutSeconds}s`, command, ...args],
    {
      cwd: options.cwd,
      encoding: "utf8",
      input: options.input,
      maxBuffer: 4 * 1024 * 1024,
      stdio: options.stdio ?? [options.input === undefined ? "ignore" : "pipe", "pipe", "pipe"],
    },
  );
  if (tracked) {
    activeRequest.progress.completedAt = new Date().toISOString();
    activeRequest.progress.deadlineAt = new Date(Date.now() + policy.betweenStepsMs).toISOString();
    writeRequest(activeRequest);
  }
  return {
    ok: invocation.status === 0,
    status: invocation.status ?? 1,
    stdout: invocation.stdout ?? "",
    stderr: invocation.stderr ?? "",
    signal: invocation.signal,
  };
}

function checked(command, args, options = {}) {
  const result = commandResult(command, args, options);
  if (!result.ok) {
    const detail = result.stderr.trim() || result.stdout.trim() || result.signal || `exit ${result.status}`;
    throw new Error(`${command} failed: ${detail}`);
  }
  return result.stdout.trim();
}

function ensureState() {
  for (const path of [stateRoot, requestRoot, logRoot, proofRoot, contractRoot, repairRoot]) mkdirSync(path, { recursive: true, mode: 0o700 });
  rmSync(join(stateRoot, "issues.json"), { force: true });
}

function syncDirectory(path) {
  const descriptor = openSync(path, "r");
  try {
    fsyncSync(descriptor);
  } finally {
    closeSync(descriptor);
  }
}

function atomicWrite(path, content, mode = 0o600) {
  mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
  const temporary = `${path}.${process.pid}.${randomUUID()}.tmp`;
  const descriptor = openSync(temporary, "wx", mode);
  try {
    writeFileSync(descriptor, content);
    fsyncSync(descriptor);
  } finally {
    closeSync(descriptor);
  }
  renameSync(temporary, path);
  syncDirectory(dirname(path));
}

function requestPath(requestId) {
  return join(requestRoot, `${requestId}.json`);
}

function migrateRequestOnRead(request) {
  // Version 2 request states convert in memory so old receipts remain immutable until their next real transition.
  if (request.status === "blocked") request.status = "queued";
  if (request.status === "recovering") {
    request.status = "running";
    request.recoveryInProgress = true;
  }
  if (request.status === "finalizing") request.status = "running";
  if (request.blocker && !request.waiting) request.waiting = request.blocker;
  delete request.blocker;
  if (request.status === "cancelled") {
    request.status = "failed";
    const failure = request.failure ?? {
      at: request.updatedAt ?? new Date(0).toISOString(),
      attempt: request.attempt ?? 0,
      step: request.step,
      message: "Publication cancelled; any completed host release remains selected",
    };
    failure.reason ??= "cancelled";
    request.failure = failure;
    request.failures ??= [];
    const historical = request.failures.find(candidate => candidate === failure || candidate.at === failure.at && candidate.message === failure.message);
    if (historical) historical.reason ??= "cancelled";
    else request.failures.push(failure);
  }
  if (request.status === "failed" && request.failure) {
    request.failure.reason ??= request.failure.message;
    const historical = request.failures?.find(candidate => candidate.at === request.failure.at && candidate.message === request.failure.message);
    if (historical) historical.reason ??= request.failure.reason;
  }
  request.version = 3;
  return request;
}

function readRequest(requestId) {
  const path = requestPath(requestId);
  if (!existsSync(path)) throw new Error(`unknown publication request ${requestId}`);
  return migrateRequestOnRead(JSON.parse(readFileSync(path, "utf8")));
}

function writeRequest(request) {
  migrateRequestOnRead(request);
  if (!["queued", "running", "failed", "published"].includes(request.status)) throw new Error(`invalid publication status: ${request.status}`);
  request.updatedAt = new Date().toISOString();
  atomicWrite(requestPath(request.requestId), `${JSON.stringify(request, null, 2)}\n`);
}

function validateRequestId(value) {
  if (!/^PUB-[a-f0-9]{24}$/.test(value)) throw new Error(`invalid publication request id: ${value}`);
}

function validateSha(value) {
  if (!/^[a-f0-9]{40}$/.test(value)) throw new Error(`invalid source SHA: ${value}`);
}

function installFrom(sourceRoot) {
  const commandSource = join(sourceRoot, "deploy/publication");
  const unitNames = ["pi-stack-publication.service", "pi-stack-publication.timer", "pi-stack-publication.path",
    "pi-stack-publication-watchdog.service", "pi-stack-publication-watchdog.timer", "pi-stack-publication-repair@.service", "pi-stack-publication-notices.service"];
  const modules = ["publication-control.mjs", "publication-config.mjs"];
  for (const path of [commandSource, ...modules.map(name => join(sourceRoot, "deploy", name)), ...unitNames.map(name => join(sourceRoot, "deploy/systemd", name))]) {
    if (!existsSync(path)) throw new Error(`publication installation source is missing: ${path}`);
  }
  ensureState();
  mkdirSync(dirname(installedCommand), { recursive: true, mode: 0o750 });
  mkdirSync(userUnitRoot, { recursive: true, mode: 0o700 });
  for (const name of modules) atomicWrite(join(dirname(installedCommand), name), readFileSync(join(sourceRoot, "deploy", name)), 0o644);
  atomicWrite(installedCommand, readFileSync(commandSource), 0o750);
  const replacements = { "@PUBLICATION_COMMAND@": installedCommand, "@PUBLICATION_WAKE@": join(stateRoot, "wake"), "@PUBLICATION_PATH@": `${join(homedir(), ".local/bin")}:/run/wrappers/bin:/run/current-system/sw/bin:/usr/bin:/bin` };
  for (const name of unitNames) {
    let unit = readFileSync(join(sourceRoot, "deploy/systemd", name), "utf8");
    for (const [token, value] of Object.entries(replacements)) unit = unit.replaceAll(token, value);
    atomicWrite(join(userUnitRoot, name), unit, 0o644);
  }
  if (!existsSync(repairPolicyPath)) atomicWrite(repairPolicyPath, JSON.stringify({ activatedAt: new Date().toISOString(), policy }));
  checked("systemctl", ["--user", "daemon-reload"]);
  checked("systemctl", ["--user", "enable", "--now", "pi-stack-publication.timer", "pi-stack-publication.path", "pi-stack-publication-watchdog.timer"]);
}

function install() {
  const sourceRoot = resolve(dirname(self), "..");
  installFrom(sourceRoot);
  process.stdout.write(`installed pi-stack publication owner; state=${stateRoot}\n`);
}

function gitRoot() {
  return checked("git", ["rev-parse", "--show-toplevel"], { cwd: process.cwd() });
}

function assertSourceRootsOnMain(sourceRoot, sourceSha) {
  if (checked("git", ["rev-parse", "--is-shallow-repository"], { cwd: sourceRoot }) !== "false")
    throw new Error("Cannot prove source ancestry from a shallow checkout; fetch its complete history before publication");
  const grafts = checked("git", ["rev-parse", "--git-path", "info/grafts"], { cwd: sourceRoot });
  if (existsSync(resolve(sourceRoot, grafts))) throw new Error("Cannot prove source ancestry with Git grafts installed");
  checked("git", ["fetch", "--quiet", "--no-tags", "origin", "refs/heads/main"], { cwd: sourceRoot, timeoutSeconds: 60 });
  const mainSha = checked("git", ["rev-parse", "--verify", "FETCH_HEAD^{commit}"], { cwd: sourceRoot });
  const roots = sha => checked("git", ["--no-replace-objects", "rev-list", "--max-parents=0", sha], { cwd: sourceRoot }).split("\n");
  const mainRoots = new Set(roots(mainSha));
  const extraRoots = roots(sourceSha).filter(root => !mainRoots.has(root));
  if (extraRoots.length) throw new Error(`Source ${sourceSha} introduces Git root(s) absent from current main ${mainSha}: ${extraRoots.join(", ")}; replay the changes onto current main before publication`);
}

function submit(sourceArgument, repairedRequestId) {
  if (sourceArgument === undefined) throw new Error("submit requires an explicit source commit");
  const sourceRoot = gitRoot();
  const sourceSha = checked("git", ["rev-parse", "--verify", `${sourceArgument}^{commit}`], { cwd: sourceRoot });
  validateSha(sourceSha);
  const remote = checked("git", ["config", "--get", "remote.origin.url"], { cwd: sourceRoot });
  if (remote !== repositoryUrl) throw new Error(`origin is not configured repository ${repositoryUrl}: ${remote}`);
  if (!existsSync(installedCommand)) throw new Error(`publication owner is not installed at ${installedCommand}`);

  let repaired;
  if (repairedRequestId) {
    validateRequestId(repairedRequestId);
    repaired = readRequest(repairedRequestId);
    const repair = readRepair(repairedRequestId);
    if (repair?.outcome?.status !== "source-fixed" || repair.outcome.sourceSha !== sourceSha)
      throw new Error("Repaired submission requires its dedicated owner's source-fixed outcome and matching commit");
    if (repaired.status !== "failed") throw new Error("Repaired submission requires a failed request");
    if (sourceSha === repaired.sourceSha) throw new Error("Source repair requires a new commit");
    checked("git", ["merge-base", "--is-ancestor", repaired.sourceSha, sourceSha], { cwd: sourceRoot });
  }
  ensureState();
  if (!repaired) {
    const existing = existingSource(sourceSha);
    if (existing) {
      if (existing.status === "failed") throw new Error(`${sourceSha} already failed in ${existing.requestId}; use repair ${existing.requestId}, not an unrepaired resubmission`);
      process.stdout.write(`${JSON.stringify({ requestId: existing.requestId, sourceSha, status: existing.status, receipt: requestPath(existing.requestId), owner: existing.owner })}\n`);
      return;
    }
  }
  assertSourceRootsOnMain(sourceRoot, sourceSha);
  const reporter = repaired?.reporter ?? requesterFromEnvironment();
  if (reporter) remoteJson(reporter, "", "GET");
  const requestId = `PUB-${repaired ? createHash("sha256").update(`repair:${repairedRequestId}`).digest("hex").slice(0, 24) : randomUUID().replaceAll("-", "").slice(0, 24)}`;
  if (existsSync(requestPath(requestId))) {
    const existing = readRequest(requestId);
    if (existing.sourceSha !== sourceSha) throw new Error("This repair already submitted another commit");
    process.stdout.write(`${JSON.stringify({ requestId, sourceSha, status: existing.status, receipt: requestPath(requestId) })}\n`);
    return;
  }
  const sourceRef = `refs/heads/pi-stack-publications/${requestId}`;
  const pushed = commandResult("git", ["push", "--quiet", "origin", `${sourceSha}:${sourceRef}`], {
    cwd: sourceRoot,
    timeoutSeconds: 60,
    stdio: "inherit",
  });
  if (!pushed.ok) throw new Error(`failed to publish immutable source ref ${sourceRef}`);

  const enqueued = commandResult(installedCommand, ["enqueue", requestId, sourceSha, sourceRef, JSON.stringify(reporter), ...(repaired ? [repairedRequestId] : [])], {
    timeoutSeconds: 30,
  });
  if (!enqueued.ok) {
    throw new Error(`${enqueued.stderr.trim() || `publication owner did not acknowledge ${requestId}`}; source remains at ${sourceRef}`);
  }
  process.stdout.write(enqueued.stdout);
}

function enqueue(requestId, sourceSha, sourceRef, reporterJson, repairedRequestId) {
  validateRequestId(requestId);
  validateSha(sourceSha);
  if (sourceRef !== `refs/heads/pi-stack-publications/${requestId}`) throw new Error("source ref does not match request id");
  ensureState();
  const loadState = checked("systemctl", ["--user", "show", "pi-stack-publication.service", "-p", "LoadState", "--value"]);
  if (loadState !== "loaded") throw new Error("pi-stack-publication.service is not loaded");
  checked("systemctl", ["--user", "is-active", "--quiet", "pi-stack-publication-watchdog.timer"]);
  const remoteLine = checked("git", ["ls-remote", repositoryUrl, sourceRef], { timeoutSeconds: 60 });
  if (remoteLine.split(/\s+/)[0] !== sourceSha) throw new Error(`remote source ref does not own ${sourceSha}`);
  const duplicate = existingSource(sourceSha);
  if (duplicate) {
    if (duplicate.status === "failed") throw new Error(`Source already failed in ${duplicate.requestId}; a repair is required`);
    process.stdout.write(`${JSON.stringify({ requestId: duplicate.requestId, sourceSha, status: duplicate.status, owner: duplicate.owner, receipt: requestPath(duplicate.requestId) })}\n`);
    return;
  }
  const path = requestPath(requestId);
  if (existsSync(path)) throw new Error(`publication request already exists: ${requestId}`);
  const now = new Date().toISOString();
  const request = {
    version: 3,
    requestId,
    sourceSha,
    sourceRef,
    contract: null,
    status: "queued",
    step: "queued",
    owner: "pi-stack-publication.service",
    queuedAt: now,
    updatedAt: now,
    attempt: 0,
    failures: [],
    reporter: reporterJson && JSON.parse(reporterJson) ? validateReporter(JSON.parse(reporterJson)) : null,
    ...(repairedRequestId ? { repairOf: repairedRequestId, repairId: repairId(repairedRequestId),
      repairDepth: (readRequest(repairedRequestId).repairDepth ?? 0) + 1 } : {}),
  };
  atomicWrite(path, `${JSON.stringify(request, null, 2)}\n`);
  atomicWrite(join(stateRoot, "wake"), `${now}\n`);
  const wake = commandResult("systemctl", ["--user", "start", "--no-block", "pi-stack-publication.service"]);
  if (!wake.ok) atomicWrite(join(stateRoot, "wake-failure.json"), JSON.stringify({ requestId,
    at: new Date().toISOString(), error: wake.stderr.trim() || `exit ${wake.status}` }));
  process.stdout.write(`${JSON.stringify({
    requestId,
    sourceSha,
    status: "queued",
    owner: request.owner,
    receipt: path,
    wake: wake.ok ? "started" : "watchdog-owned",
    reporting: request.reporter ? { status: "pending", ...request.reporter } : { status: "receipt", issues: `${installedCommand} issues` },
  })}\n`);
}

function inspect(requestId) {
  validateRequestId(requestId);
  process.stdout.write(`${JSON.stringify(readRequest(requestId), null, 2)}\n`);
}

function retry(requestId) {
  validateRequestId(requestId);
  const request = readRequest(requestId);
  const repair = readRepair(requestId);
  if (request.repairedRetry?.repairId === repair?.id) return;
  if (request.status !== "failed" || request.repairedRetry || repair?.outcome?.status !== "infrastructure-fixed")
    throw new Error("Retry requires the dedicated repair's infrastructure-fixed evidence and is allowed once");
  request.repairedRetry = { repairId: repair.id, at: new Date().toISOString(), evidence: repair.outcome.evidence };
  request.status = "queued";
  request.recoveryAttempts = 0;
  request.attemptLimit = request.attempt + 1;
  delete request.blockedSince;
  delete request.nextAttemptAt;
  request.step = "queued-after-repair";
  writeRequest(request);
  atomicWrite(join(stateRoot, "wake"), `${Date.now()}\n`);
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication.service"]);
}

function cancellationPath(requestId) {
  return join(requestRoot, `${requestId}.cancel`);
}

function cancel(requestId) {
  validateRequestId(requestId);
  const request = readRequest(requestId);
  if (["failed", "published"].includes(request.status)) throw new Error(`${requestId} is already ${request.status}`);
  atomicWrite(cancellationPath(requestId), `${new Date().toISOString()}\n`);
  checked("systemctl", ["--user", "start", "--no-block", "pi-stack-publication.service"]);
  process.stdout.write(`${JSON.stringify({ requestId, status: "cancellation-requested", receipt: cancellationPath(requestId) })}\n`);
}

function checkCancellation(request) {
  if (existsSync(cancellationPath(request.requestId))) throw new Error("Publication cancelled; any completed host release remains selected");
}

function appendLog(path, text) {
  mkdirSync(dirname(path), { recursive: true, mode: 0o700 });
  const descriptor = openSync(path, "a", 0o600);
  try {
    writeFileSync(descriptor, text);
    fsyncSync(descriptor);
  } finally {
    closeSync(descriptor);
  }
}

function runLogged(request, step, command, args, timeoutSeconds, logPath, options = {}) {
  checkCancellation(request);
  request.step = step;
  writeRequest(request);
  appendLog(logPath, `\n[${new Date().toISOString()}] ${step}\n`);
  const descriptor = openSync(logPath, "a", 0o600);
  let result;
  try {
    result = commandResult(command, args, {
      cwd: options.cwd,
      input: options.input,
      timeoutSeconds,
      stdio: [options.input === undefined ? "ignore" : "pipe", descriptor, descriptor],
    });
  } finally {
    closeSync(descriptor);
  }
  return result;
}

function runCapture(command, args, options = {}) {
  const result = commandResult(command, args, options);
  if (!result.ok) {
    const detail = result.stderr.trim() || result.stdout.trim() || result.signal || `exit ${result.status}`;
    throw new Error(`${command} failed: ${detail}`);
  }
  return result.stdout.trim();
}

function updateBlocked(request, censuses, logPath) {
  request.status = "queued";
  request.step = "waiting-for-pre-contract-runtime-gate";
  request.blockedSince ??= new Date().toISOString();
  request.nextAttemptAt = new Date(Date.now() + policy.blockedRetryMs).toISOString();
  request.waiting = {
    at: new Date().toISOString(),
    reason: "Fleet launches are held at their recorded maintenance pause. Existing Remote and fleet owners retain active work. Publication retries the census and final intake seal after they drain; queued input and saved history transfer without replay.",
    hosts: censuses,
    log: logPath,
  };
  writeRequest(request);
  deliverNotice(request);
}

function logTail(path) {
  if (!existsSync(path)) return "";
  const fd = openSync(path, "r");
  try {
    const size = fstatSync(fd).size;
    const buffer = Buffer.alloc(Math.min(size, 8000));
    readSync(fd, buffer, 0, buffer.length, Math.max(0, size - buffer.length));
    return buffer.toString("utf8");
  } finally { closeSync(fd); }
}

function updateFailure(request, message, logPath, notify = true, reason = message) {
  const cancelled = existsSync(cancellationPath(request.requestId));
  const failure = {
    at: new Date().toISOString(),
    attempt: request.attempt,
    step: request.step,
    reason: cancelled ? "cancelled" : reason,
    message,
    log: logPath,
    command: request.progress ? [request.progress.command, ...request.progress.args].join(" ") : request.checks?.command,
    progress: request.progress,
    excerpt: logTail(logPath),
  };
  if (request.checks?.status === "running") request.checks.status = "failed";
  (request.failures ??= []).push(failure);
  request.status = "failed";
  delete request.nextAttemptAt;
  request.failure = failure;
  writeRequest(request);
  ensureRepair(request);
  if (notify) deliverNotice(request);
}

function noticeBody(request) {
  const repair = readRepair(request.requestId);
  const compact = value => String(value ?? "").replace(/\s+/g, " ").slice(0, 400);
  return [
    `Request: ${request.requestId}`,
    `Source: ${request.sourceSha}`,
    request.integrationSha ? `Integration: ${request.integrationSha}` : undefined,
    `Step: ${request.step}`,
    `Status: ${request.status}`,
    request.repairOf ? `Repairs: ${request.repairOf} via ${request.repairId}` : undefined,
    repair ? `Repair: ${repair.status}; receipt: ${repair.path}` : undefined,
    repair?.successor ? `Successor: ${repair.successor.requestId}` : undefined,
    request.status === "failed" ? `Failure: ${compact(request.failure?.message)}` : request.status === "queued" && request.waiting ? `Waiting: ${compact(request.waiting.reason)}; next attempt: ${request.nextAttemptAt}` : undefined,
    request.status === "failed" && request.failure?.reason !== request.failure?.message ? `Reason: ${compact(request.failure?.reason)}` : undefined,
    `Receipt: ${requestPath(request.requestId)}`,
    `Log: ${request.status === "failed" ? request.failure?.log : request.status === "queued" ? request.waiting?.log : request.finalProof?.path}`,
    request.failure?.command ? `Command: ${compact(request.failure.command)}` : undefined,
    request.status === "failed" && request.failure?.reason !== "cancelled" ? "The dedicated repair owner retains this failure. A source fix needs a new commit; an unchanged-source retry requires recorded infrastructure repair evidence." : undefined,
  ].filter(Boolean).join("\n");
}

function validateReporter(reporter) {
  const url = new URL(reporter.url);
  if (!["http:", "https:"].includes(url.protocol) || url.username || url.password || url.search || url.hash)
    throw new Error("Remote report URL must be an HTTP endpoint without credentials, query or fragment");
  if (!/^[0-9a-f-]{36}$/i.test(reporter.sessionId)) throw new Error("Remote report requires a session UUID");
  return { url: url.href.replace(/\/$/, ""), sessionId: reporter.sessionId };
}

function requesterFromEnvironment() {
  const url = process.env.PI_STACK_PUBLICATION_REPORT_URL ?? process.env.PI_REMOTE_SERVER_URL;
  const sessionId = process.env.PI_STACK_PUBLICATION_REPORT_SESSION
    ?? process.env.PI_SESSION_FILE?.match(/\/core-sessions\/([0-9a-f-]{36})\//i)?.[1]
    ?? process.env.PI_REMOTE_SESSION_ID;
  if (!url && !sessionId) return null;
  if (!url || !sessionId) throw new Error("Cannot identify publication requester; set PI_STACK_PUBLICATION_REPORT_URL and PI_STACK_PUBLICATION_REPORT_SESSION");
  return validateReporter({ url, sessionId });
}

function remoteJson(reporter, suffix, method, body) {
  const output = checked("curl", ["--silent", "--show-error", "--fail-with-body", "--max-time", "8",
    "--request", method, "--header", "content-type: application/json",
    ...(body === undefined ? [] : ["--data-binary", "@-"]),
    `${reporter.url}/v1/sessions/${reporter.sessionId}${suffix}`,
  ], { timeoutSeconds: 10, input: body === undefined ? undefined : JSON.stringify(body) });
  return JSON.parse(output);
}

function deliverReport(request, key) {
  if (!request.reporter) return;
  if (request.report?.key === key && request.report.status === "delivered") return;
  if (request.report?.key !== key) {
    const digest = createHash("sha256").update(`${request.requestId}:${key}`).digest("hex");
    request.report = { key, status: "pending", requestId: `${digest.slice(0, 8)}-${digest.slice(8, 12)}-4${digest.slice(13, 16)}-a${digest.slice(17, 20)}-${digest.slice(20, 32)}` };
    writeRequest(request);
  }
  const report = request.report;
  try {
    if (!report.workId) {
      const accepted = remoteJson(request.reporter, "/prompt", "POST", {
        requestId: report.requestId,
        delivery: "steer",
        text: `Publication owner report. Please tell the user this result; do not retry or submit a release without a repair.\n\n${noticeBody(request)}`,
      });
      if (!accepted.accepted || !accepted.workId) throw new Error("Remote did not acknowledge publication report custody");
      report.workId = accepted.workId;
      report.status = "accepted";
      report.acceptedAt = new Date().toISOString();
      writeRequest(request);
    }
    // Delivery is confirmed from the thread's own queue, which is durable: the
    // report's work leaves it once the agent has the message. The activity feed
    // this used to read is a bounded window in memory, so a supervisor restart
    // between acceptance and the check could never confirm anything again.
    const view = remoteJson(request.reporter, "", "GET");
    const waiting = (view.session?.queuedMessages ?? []).some(message => message.id === report.workId);
    if (waiting) {
      report.status = "accepted";
    } else {
      report.status = "delivered";
      report.deliveredAt = new Date().toISOString();
    }
    delete report.error;
  } catch (error) {
    report.status = "failed";
    report.error = error instanceof Error ? error.message : String(error);
  }
  report.checkedAt = new Date().toISOString();
  writeRequest(request);
}

function noticeKey(request) {
  const repair = readRepair(request.requestId);
  const state = request.status === "failed" ? `failed:${request.failure.at}`
    : request.status === "queued" && request.waiting ? `waiting:${request.blockedSince}` : request.status;
  return state + (repair ? `:${repair.status}:${repair.successor?.requestId ?? ""}:${repair.successor?.status ?? ""}` : "");
}

function deriveIssues() {
  const requests = allRequests();
  const byId = new Map(requests.map(request => [request.requestId, request]));
  const repairs = new Map(requests.map(request => [request.requestId, readRepair(request.requestId)]));
  const published = requests.filter(request => request.status === "published" && request.integrationSha)
    .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))[0];
  const deployedSources = new Set(published ? checked("git", ["-C", checkout, "rev-list", published.integrationSha], { timeoutSeconds: 5 }).split("\n") : []);
  function resolution(request, seen = new Set()) {
    if (!request || seen.has(request.requestId)) return null;
    seen.add(request.requestId);
    if (request.status === "published") return { requestId: request.requestId, integrationSha: request.integrationSha, proof: request.finalProof?.path };
    if (deployedSources.has(request.sourceSha)) return { requestId: published.requestId, integrationSha: published.integrationSha, proof: published.finalProof?.path };
    return resolution(byId.get(repairs.get(request.requestId)?.successor?.requestId), seen);
  }
  const resolved = [], issues = [];
  for (const request of requests) {
    const custody = Object.values(request.bootstrap?.hosts ?? {}).some(custodyNeedsRestore)
      || Object.values(request.maintenance?.hosts ?? {}).some(host => !["restored", "released"].includes(host.state));
    const cancelled = request.failure?.reason === "cancelled";
    if ((request.status !== "failed" || cancelled) && !(custody && ["failed", "published"].includes(request.status))) continue;
    const proof = custody ? null : resolution(request);
    if (proof) { resolved.push({ requestId: request.requestId, resolution: proof }); continue; }
    const repair = repairs.get(request.requestId);
    const successor = byId.get(repair?.successor?.requestId);
    if (!custody && successor && successor.failure?.reason !== "cancelled") continue;
    const condition = createHash("sha256").update(JSON.stringify({ source: request.sourceSha,
      status: request.status, failureAt: request.failure?.at, failure: request.failure?.message, reason: request.failure?.reason,
      step: request.step, custody, repair: repair?.status, successor: repair?.successor?.requestId })).digest("hex");
    issues.push({ requestId: request.requestId, condition, sourceSha: request.sourceSha, step: custody ? "restore-host-custody" : request.step,
      failure: custody ? "Host restoration remains outstanding; inspect the receipt's restoration plans." : String(request.failure?.reason ?? request.failure?.message ?? "").replace(/\s+/g, " ").slice(0, 300),
      repair: repair?.status ?? "unassigned", receipt: requestPath(request.requestId), repairReceipt: repair?.path });
  }
  const acknowledgements = existsSync(issueAcknowledgementsPath) ? JSON.parse(readFileSync(issueAcknowledgementsPath, "utf8")) : {};
  const acknowledged = issues.filter(issue => acknowledgements[issue.requestId]?.condition === issue.condition);
  const visible = issues.filter(issue => acknowledgements[issue.requestId]?.condition !== issue.condition);
  return { issues, resolved, acknowledged: acknowledged.map(issue => issue.requestId), visible };
}

function reconcileIssueAlert() {
  const index = deriveIssues();
  if (index.visible.length === 0) { rmSync(issueAlertPath, { force: true }); return index; }
  const body = ["# Pi Stack publication needs repair", "", `Repository: ${repositoryUrl}`,
    `Deployment/proof targets: ${targets.map(target => target.id).join(", ")}`,
    `${index.visible.length} unacknowledged publication issue(s). Run ${installedCommand} issues for the complete derived list.`,
    "Read the named receipt before acting. Repair owners retain their work; do not replay requests.", "",
    ...index.visible.slice(0, 8).map(issue => `- ${issue.requestId}: ${issue.step}; repair ${issue.repair}. ${issue.failure}\n  Receipt: ${issue.receipt}`),
    ...(index.visible.length > 8 ? [`${index.visible.length - 8} further issues are in the derived list.`] : []), ""].join("\n");
  if (!existsSync(issueAlertPath) || readFileSync(issueAlertPath, "utf8") !== body) atomicWrite(issueAlertPath, body, 0o660);
  return index;
}

function acknowledgeIssues() {
  const { issues } = deriveIssues();
  const acknowledgements = existsSync(issueAcknowledgementsPath) ? JSON.parse(readFileSync(issueAcknowledgementsPath, "utf8")) : {};
  const at = new Date().toISOString();
  for (const issue of issues) acknowledgements[issue.requestId] = { condition: issue.condition, at, receipt: issue.receipt };
  atomicWrite(issueAcknowledgementsPath, `${JSON.stringify(acknowledgements, null, 2)}\n`);
  reconcileIssueAlert();
  process.stdout.write(`${issueAcknowledgementsPath}\n`);
}

function reconcileNotices() {
  reconcileIssueAlert();
  const candidates = allRequests().filter(request => {
    if (!["failed", "published"].includes(request.status) && !(request.status === "queued" && request.waiting)) return false;
    const key = noticeKey(request);
    return request.reporter && (request.report?.key !== key || request.report.status !== "delivered");
  });
  candidates.sort((a, b) => (a.noticeCheckedAt ?? "").localeCompare(b.noticeCheckedAt ?? ""));
  if (candidates[0]) deliverNotice(candidates[0]);
}

function deliverNotice(request) {
  if (!["failed", "published"].includes(request.status) && !(request.status === "queued" && request.waiting)) return;
  const key = noticeKey(request);
  request.noticeCheckedAt = new Date().toISOString();
  writeRequest(request);
  reconcileIssueAlert();
  deliverReport(request, key);
}

function report(requestId, url, sessionId) {
  validateRequestId(requestId);
  const request = readRequest(requestId);
  if (url) {
    const reporter = validateReporter({ url, sessionId });
    if (request.reporter && JSON.stringify(request.reporter) !== JSON.stringify(reporter)) throw new Error("Publication already has another requester");
    request.reporter = reporter;
    writeRequest(request);
  }
  deliverNotice(request);
  inspect(requestId);
}

function prepareCheckout(request, logPath) {
  mkdirSync(checkout, { recursive: true, mode: 0o700 });
  if (!existsSync(join(checkout, ".git"))) {
    let result = runLogged(request, "initialize-publication-checkout", "git", ["init", "--quiet", checkout], 30, logPath);
    if (!result.ok) return result;
  }
  if (!commandResult("git", ["-C", checkout, "remote", "get-url", "origin"]).ok) {
    const result = runLogged(request, "configure-publication-origin", "git", ["-C", checkout, "remote", "add", "origin", repositoryUrl], 30, logPath);
    if (!result.ok) return result;
  }
  const remote = runCapture("git", ["-C", checkout, "remote", "get-url", "origin"]);
  if (remote !== repositoryUrl) return { ok: false, status: 1, stderr: `publication checkout has wrong origin: ${remote}` };
  let result = runLogged(request, "reset-publication-checkout", "git", ["-C", checkout, "reset", "--hard"], 30, logPath);
  if (!result.ok) return result;
  result = runLogged(request, "clean-publication-checkout", "git", ["-C", checkout, "clean", "-dffx", "-e", "/node_modules/", "-e", "**/node_modules/"], 30, logPath);
  if (!result.ok) return result;
  return runLogged(request, "fetch-main", "git", ["-C", checkout, "fetch", "--quiet", "--no-tags", "origin", "+refs/heads/main:refs/remotes/origin/main"], 60, logPath);
}

function createIntegration(request, logPath) {
  let result = runLogged(
    request,
    "fetch-submitted-source",
    "git",
    ["-C", checkout, "fetch", "--quiet", "--no-tags", "origin", `+${request.sourceRef}:refs/pi-stack-publication/${request.requestId}/source`],
    60,
    logPath,
  );
  if (!result.ok) return result;
  const fetchedSource = runCapture("git", ["-C", checkout, "rev-parse", `refs/pi-stack-publication/${request.requestId}/source^{commit}`]);
  if (fetchedSource !== request.sourceSha) return { ok: false, status: 1, stderr: `source ref moved from ${request.sourceSha} to ${fetchedSource}` };
  const baseSha = runCapture("git", ["-C", checkout, "rev-parse", "refs/remotes/origin/main^{commit}"]);
  result = runLogged(request, "create-integration", "git", ["-C", checkout, "checkout", "--quiet", "-B", "pi-stack-publication", baseSha], 30, logPath);
  if (!result.ok) return result;
  const sourceInBase = commandResult("git", ["-C", checkout, "merge-base", "--is-ancestor", request.sourceSha, baseSha]).ok;
  if (!sourceInBase) {
    result = runLogged(
      request,
      "merge-source",
      "git",
      [
        "-C", checkout,
        "-c", `user.name=${config.mergeAuthor.name}`,
        "-c", `user.email=${config.mergeAuthor.email}`,
        "merge", "--no-ff", "--no-edit",
        "-m", `Integrate Pi Stack publication ${request.requestId}\n\nPi-Stack-Source: ${request.sourceSha}`,
        request.sourceSha,
      ],
      60,
      logPath,
    );
    if (!result.ok) return result;
  }
  const integrationSha = runCapture("git", ["-C", checkout, "rev-parse", "HEAD^{commit}"]);
  const localProperties = config.androidProperties;
  if (!existsSync(localProperties)) return { ok: false, status: 1, stderr: `missing host-owned Android configuration: ${localProperties}` };
  mkdirSync(join(checkout, "apps/kenan/android"), { recursive: true });
  copyFileSync(localProperties, join(checkout, "apps/kenan/android/local.properties"));
  request.baseSha = baseSha;
  request.integrationSha = integrationSha;
  request.checks = { status: "running", command: "npm run check && npm run android:test --workspace=kenan", log: logPath };
  writeRequest(request);
  result = runLogged(
    request,
    "checks",
    "bash",
    ["-c", "set -euo pipefail\nsource deploy/lib\npi_stack_prepare_dependencies \"$PWD\"\nnpm run check\nnpm run android:test --workspace=kenan"],
    900,
    logPath,
    { cwd: checkout },
  );
  if (!result.ok) return result;
  request.baseSha = baseSha;
  request.integrationSha = integrationSha;
  request.checks = {
    status: "passed",
    command: "npm run check && npm run android:test --workspace=kenan",
    at: new Date().toISOString(),
    log: logPath,
  };
  request.step = "checks-passed";
  writeRequest(request);
  return { ok: true, status: 0, stdout: "", stderr: "" };
}

function prepareAndroidArtifact(request, logPath) {
  const supported = commandResult("git", ["-C", checkout, "cat-file", "-e", `${request.integrationSha}:deploy/android-update`]);
  if (!supported.ok) { delete request.android; return; }
  if (request.android && request.android.release.revision !== request.integrationSha) {
    rmSync(join(request.android.directory, request.android.release.fileName), { force: true });
    rmSync(join(request.android.directory, `${request.android.release.revision}.web.zip`), { force: true });
  }
  const directory = join(proofRoot, request.requestId, "android-artifact", request.integrationSha);
  if (request.android?.release?.revision === request.integrationSha && existsSync(join(directory, request.android.release.fileName))
    && existsSync(join(directory, `${request.integrationSha}.web.zip`))) {
    if (sha256(join(directory, request.android.release.fileName)) !== request.android.release.sha256) throw new Error("Prepared Android artifact is corrupt");
    const web = JSON.parse(readFileSync(join(directory, "web-manifest.json"), "utf8"));
    if (sha256(join(directory, web.fileName)) !== web.sha256) throw new Error("Prepared web bundle is corrupt");
    return;
  }
  let result = runLogged(request, "select-android-source", "git", ["-C", checkout, "checkout", "--quiet", "--detach", request.integrationSha], 30, logPath);
  if (!result.ok) throw new Error("Could not select the checked Android source");
  const apk = join(checkout, "apps/kenan/android/app/build/outputs/apk/debug/app-debug.apk");
  const identity = commandResult("unzip", ["-p", apk, "assets/app-release.json"]);
  let builtRevision;
  if (identity.ok) builtRevision = JSON.parse(identity.stdout).revision;
  if (builtRevision !== request.integrationSha) {
    copyFileSync(config.androidProperties, join(checkout, "apps/kenan/android/local.properties"));
    result = runLogged(request, "build-android-update", "bash", ["-c", 'set -euo pipefail\nsource deploy/lib\npi_stack_prepare_dependencies "$PWD"\nnpm run android:build --workspace=kenan'], 180, logPath, { cwd: checkout });
    if (!result.ok) throw new Error(`Android update build exited ${result.status}`);
  }
  if (existsSync(directory) && !existsSync(join(directory, `${request.integrationSha}.web.zip`))) rmSync(directory, { recursive: true, force: true });
  result = runLogged(request, "prepare-android-update", join(checkout, "deploy/android-update"), ["prepare", directory], 60, logPath);
  if (!result.ok) throw new Error(`Android artifact preparation exited ${result.status}`);
  const manifest = join(directory, "manifest.json");
  const release = JSON.parse(readFileSync(manifest, "utf8"));
  if (release.revision !== request.integrationSha) throw new Error("Prepared Android revision does not match the checked integration");
  request.android = { release, directory, manifest, status: "prepared", hosts: {} };
  writeRequest(request);
}

function publishAndroidArtifact(request, logPath) {
  if (!request.android) return;
  const { directory, manifest } = request.android;
  for (const target of targets) {
    const remoteDirectory = target.sshHost && join(target.androidTransferRoot, request.requestId);
    const tool = target.sshHost ? join(target.releaseRepository, "deploy/android-update") : join(checkout, "deploy/android-update");
    if (target.sshHost) {
      let result = runLogged(request, `transfer-android-${target.id}`, "ssh", ["-o", "BatchMode=yes", target.sshHost, "mkdir", "-p", "-m", "700", remoteDirectory], 30, logPath);
      if (!result.ok) throw new Error(`${target.id} Android transfer directory exited ${result.status}`);
      result = runLogged(request, `transfer-android-${target.id}`, "rsync", ["-a", "--chmod=D700,F600", "-e", "ssh -o BatchMode=yes", `${directory}/`, `${target.sshHost}:${remoteDirectory}/`], 90, logPath);
      if (!result.ok) throw new Error(`${target.id} Android transfer exited ${result.status}`);
      const remoteSource = runCapture("ssh", ["-o", "BatchMode=yes", target.sshHost, "git", "-C", target.releaseRepository, "rev-parse", "HEAD^{commit}"], { timeoutSeconds: 30 });
      if (remoteSource !== request.integrationSha) throw new Error(`${target.id} release checkout ${remoteSource} differs from checked integration ${request.integrationSha}`);
    }
    const invocation = target.sshHost ? ["ssh", ["-o", "BatchMode=yes", target.sshHost, "sudo", "-n", tool, "install", remoteDirectory]] : ["sudo", ["-n", tool, "install", directory]];
    const result = runLogged(request, `publish-android-${target.id}`, ...invocation, 30, logPath);
    if (!result.ok) throw new Error(`${target.id} Android publication exited ${result.status}`);
    const verify = target.sshHost ? ["ssh", ["-o", "BatchMode=yes", target.sshHost, tool, "verify", `${remoteDirectory}/manifest.json`]] : [tool, ["verify", manifest]];
    request.android.hosts[target.id] = JSON.parse(runCapture(...verify, { timeoutSeconds: 30 }));
    writeRequest(request);
    if (remoteDirectory) {
      const cleanup = runLogged(request, `remove-android-transfer-${target.id}`, "ssh", ["-o", "BatchMode=yes", target.sshHost, "rm", "-rf", remoteDirectory], 30, logPath);
      if (!cleanup.ok) throw new Error(`${target.id} Android transfer cleanup exited ${cleanup.status}`);
    }
  }
  request.android.status = "published";
  writeRequest(request);
}

export function publishIntegration(request, logPath) {
  const refresh = step => runLogged(request, step, "git", ["-C", checkout, "fetch", "--quiet", "--no-tags", "origin", "+refs/heads/main:refs/remotes/origin/main"], 60, logPath);
  const main = () => runCapture("git", ["-C", checkout, "rev-parse", "refs/remotes/origin/main^{commit}"]);
  const moved = remoteMain => ({ ok: false, kind: "main-moved", remoteMain });
  let fetch = refresh("refresh-integration-base");
  if (!fetch.ok) return fetch;
  let remoteMain = main();
  if (remoteMain !== request.integrationSha) {
    if (remoteMain !== request.baseSha) return moved(remoteMain);
    const result = runLogged(request, "integrate-main", "git", ["-C", checkout, "push", "--quiet", "origin", `${request.integrationSha}:refs/heads/main`], 60, logPath);
    const pushProgress = request.progress;
    fetch = refresh("confirm-integrated-main");
    if (!fetch.ok) return fetch;
    remoteMain = main();
    if (remoteMain !== request.integrationSha) {
      if (remoteMain !== request.baseSha) return moved(remoteMain);
      request.step = "integrate-main";
      request.progress = pushProgress;
      writeRequest(request);
      return result.ok ? { ok: false, status: 1, stderr: "main did not retain the pushed integration" } : result;
    }
  }
  request.integratedAt = new Date().toISOString();
  request.step = "integrated";
  writeRequest(request);
  return { ok: true, status: 0, stdout: "", stderr: "" };
}

export function requeueMovedIntegration(request, remoteMain, logPath) {
  const ref = `refs/pi-stack-publication/${request.requestId}/integrations/${request.integrationSha}`;
  const retained = runLogged(request, "retain-moved-integration", "git", ["-C", checkout, "update-ref", ref, request.integrationSha], 30, logPath);
  if (!retained.ok) throw new Error(`Could not retain checked integration ${request.integrationSha}`);
  for (const target of targets) {
    restoreCustody(request, target.id, target.sshHost);
    restoreMaintenance(request, target.id, target.sshHost);
  }
  const fields = ["baseSha", "integrationSha", "checks", "android", "hosts", "integratedAt", "releaseAncestry", "contractGate"];
  const integration = Object.fromEntries(fields.filter(key => request[key] !== undefined).map(key => [key, request[key]]));
  (request.mainMovements ??= []).push({ ...integration, ref, remoteMain, attempt: request.attempt, log: logPath,
    at: new Date().toISOString(), bootstrap: structuredClone(request.bootstrap), maintenance: structuredClone(request.maintenance) });
  for (const key of fields) delete request[key];
  request.status = "queued";
  request.step = "main-moved-recheck-required";
  writeRequest(request);
  appendLog(logPath, `[${new Date().toISOString()}] main moved to ${remoteMain}; retained ${ref}; queued a fresh integration and full checks\n`);
}

export const hostProofScript = String.raw`
set -euo pipefail
expected=$1
host=$2
environment=$3
host_config=$4
voice_url=$5
service_check=$6
shift 6
remote=$(< /srv/pi/pi-remote/.pi-stack-commit)
orchestrator=$(< /srv/pi/pi-orchestrator/.pi-stack-commit)
source /srv/pi/pi-remote/deploy/lib
fleet_user=$(jq -er '.fleetUser | select(type == "string" and length > 0)' "$host_config")
services=$("$service_check" "$fleet_user" "$environment" --json)
voice=$(pi_stack_as_root curl -fsS --max-time 3 "$voice_url" | jq -r .releaseCommit)
[[ $remote == "$expected" && $orchestrator == "$expected" && $voice == "$expected" ]] || {
  echo 'deployed commit markers do not match integration' >&2; exit 1;
}
for unit in "$@"; do
  systemctl is-active --quiet "$unit" || { echo "$unit is not active" >&2; exit 1; }
  services=$(jq -c --arg unit "$unit" '.units[$unit] = "active"' <<<"$services")
done
people='[]'
users=$(jq -r '.router.people[] | select(.unlocked) | .user' <<<"$services")
while IFS= read -r user; do
  [[ -n $user ]] || continue
  unit="pi-remote@$user.service"
  health=$(pi_stack_supervisor_health "$user")
  jq -e --arg expected "$expected" --arg environment "$environment" \
    '.ok == true and .releaseCommit == $expected and .environmentId == $environment' <<<"$health" >/dev/null || {
    echo "$unit health does not match integration and environment" >&2; exit 1;
  }
  properties=$(systemctl show "$unit" -p ExecStart -p ExecReload -p KillMode -p MemoryMax -p MemoryHigh -p PrivateMounts)
  people=$(jq -c --arg user "$user" --argjson health "$health" --arg properties "$properties" '. + [{user:$user,health:$health,effectiveUnit:$properties}]' <<<"$people")
done <<<"$users"
jq -n --arg host "$host" --arg expected "$expected" --arg remote "$remote" --arg orchestrator "$orchestrator" \
  --arg voice "$voice" --arg environment "$environment" --argjson services "$services" --argjson people "$people" \
  '{host:$host,verifiedAt:(now|todateiso8601),integrationSha:$expected,remoteCommit:$remote,orchestratorCommit:$orchestrator,
    voiceCommit:$voice,environmentId:$environment,router:$services.router,units:$services.units,supervisors:$people}'
`;

export function verifyTarget(target, expected) {
  return JSON.parse(runHostScript(hostProofScript, target.sshHost,
    [expected, target.id, target.environmentId, target.hostConfig, target.voiceStatusUrl,
      target.checkServicesCommand, ...target.requiredUnits], 60));
}

