    sudo -n systemctl start "\${units[@]}" >&2 || failed=1
  fi
  if [[ $(jq -r .routerWasActive <<<"$plan") == true ]]; then sudo -n systemctl start pi-remote-router.service >&2 || failed=1; fi
  return "$failed"
}
trap 'restore >&2' ERR
trap 'restore >&2; exit 143' TERM INT
if [[ $(jq -r .preContract <<<"$fleet") == true ]]; then
fleet_status=$(fleet_cli status)
[[ $(jq -r .launches <<<"$fleet_status") == paused ]]
fleet_pid=$(jq -r .pid <<<"$fleet")
