const fleetControlScript = String.raw`
set -euo pipefail
fleet=$(base64 --decode <<<"$1")
action=$2
` + fleetHelpers + String.raw`
case "$action" in
  pause) fleet_cli pause >/dev/null; expected=paused ;;
  restore)
    expected=$(jq -r .launches <<<"$fleet")
    if [[ $expected == paused ]]; then fleet_cli pause >/dev/null; else fleet_cli resume >/dev/null; fi
    ;;
  census)
    status=$(fleet_cli status)
    jq '{launches,activeRuns:[.runs[] | select(.state == "starting" or .state == "running" or .state == "waiting") | {id,state,workerUnit,sessionFile}]}' <<<"$status"
    exit 0
    ;;
  *) exit 64 ;;
esac
status=$(fleet_cli status)
[[ $(jq -r .launches <<<"$status") == "$expected" ]]
`;

function ensureMaintenance(request, hostKey, remoteHost) {
  request.maintenance ??= { hosts: {} };
  let host = request.maintenance.hosts[hostKey];
  const hostConfig = targets.find(target => target.id === hostKey).hostConfig;
  if (!host || ["restored", "released"].includes(host.state)) {
    const plan = JSON.parse(runHostScript(fleetPlanScript, remoteHost, [hostConfig], 30));
    host = { state: "restore-required", recordedAt: new Date().toISOString(), plan };
    request.maintenance.hosts[hostKey] = host;
    writeRequest(request);
  }
  runHostScript(fleetControlScript, remoteHost, [planEncoding(host.plan), "pause"], 30);
  const currentPlan = JSON.parse(runHostScript(fleetPlanScript, remoteHost, [hostConfig], 30));
  if (currentPlan.unit !== host.plan.unit) throw new Error(`${hostKey}: fleet owner changed during maintenance`);
  host.plan = { ...currentPlan, launches: host.plan.launches };
  host.state = "paused";
  writeRequest(request);
  return host.plan.preContract
    ? JSON.parse(runHostScript(fleetControlScript, remoteHost, [planEncoding(host.plan), "census"], 30))
    : { activeRuns: [], contract: threadExecutionContract };
}

function restoreMaintenance(request, hostKey, remoteHost, state = "restored") {
  const host = request.maintenance?.hosts?.[hostKey];
  if (!host || ["restored", "released"].includes(host.state)) return;
  runHostScript(fleetControlScript, remoteHost, [planEncoding(host.plan), "restore"], 30);
  host.state = state;
  host.restoredAt = new Date().toISOString();
  writeRequest(request);
}

