const restoreScript = String.raw`
set -euo pipefail
plan=$(base64 --decode <<<"$1")
if [[ $(jq -r '.fleet // empty' <<<"$plan") != '' ]]; then
  pid=$(jq -r .fleet.pid <<<"$plan")
