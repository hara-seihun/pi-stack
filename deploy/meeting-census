#!/usr/bin/env bash
# Read-only meeting census and restart admission.
set -euo pipefail
mode=${1:---all}
case "$mode" in --all|--restart-blockers) ;; *) echo 'usage: meeting-census [--all|--restart-blockers]' >&2; exit 64 ;; esac
become=()
[[ $EUID == 0 || ${PI_STACK_DEPLOY_NO_SUDO:-0} == 1 ]] || become=(sudo -n)
dir=${PI_REMOTE_PERSONS_DIR:-/var/lib/pi-remote/persons}
[[ -d $dir ]] || exit 0
# A supervisor retired by native-history maintenance runs only its maintenance
# bridge: it has closed its owners and serves no HTTP and no rooms until the
# candidate activates. Its own receipt, read as that person inside the unit's
# mount namespace (encrypted homes are mounted there only), proves it. Any
# missing or unreadable proof stays unknown live state.
retired_supervisor() {
  local user=$1 file=$2 data pid uid gid phase
  data=$("${become[@]}" jq -r '.environment.PI_REMOTE_DATA // empty' "$file") || return 1
  [[ $data == /* ]] || return 1
  pid=$("${become[@]}" systemctl show "pi-remote@$user.service" -p MainPID --value) || return 1
  [[ $pid =~ ^[1-9][0-9]*$ ]] || return 1
  uid=$(id -u "$user") && gid=$(id -g "$user") || return 1
  phase=$("${become[@]}" nsenter -t "$pid" -m -S "$uid" -G "$gid" jq -er '.phase | strings' "$data/native-history-maintenance.json" 2>/dev/null) || return 1
  [[ $phase == migrated || $phase == owners-closed || $phase == migration-pending ]]
}
live=()
all_preserved=1
preserved_count=0
for file in "$dir"/*.json; do
  [[ -f $file ]] || continue
  user=$("${become[@]}" jq -er '.user | select(type == "string")' "$file")
  [[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ && $file == "$dir/$user.json" ]] || { echo "invalid person identity in $file" >&2; exit 1; }
  port=$("${become[@]}" jq -er '.port | select(type == "number" and . > 0 and . < 65536)' "$file")
  probe=meet
  [[ $mode != --restart-blockers ]] || probe=health
  if response=$("${become[@]}" curl -fsS --max-time 2 "http://127.0.0.1:$port/v1/$probe" 2>&1); then
    :
  else
    status=$?
    [[ $status == 7 ]] || { echo "cannot census $user (curl $status): $response" >&2; exit 1; }
    for unit in "pi-remote@$user.service" "pi-remote-dev-supervisor@$user.service"; do
      state=$("${become[@]}" systemctl show "$unit" -p ActiveState --value)
      [[ -n $state ]] || { echo "cannot determine supervisor state for $user" >&2; exit 1; }
      case "$state" in
        inactive|failed) ;;
        active) [[ $unit == pi-remote@* ]] && retired_supervisor "$user" "$file" || { echo "cannot census $user ($state): $response" >&2; exit 1; } ;;
        *) echo "cannot census $user ($state): $response" >&2; exit 1 ;;
      esac
    done
    continue
  fi
  if [[ $mode == --restart-blockers ]]; then
    jq -e 'type == "object" and .ok == true' <<< "$response" >/dev/null || {
      echo "invalid supervisor health for $user" >&2; exit 1;
    }
    if jq -e '.meetingRuntime.protocol == "meet-runtime-v1" and .meetingRuntime.lifetime == "person-service"' <<< "$response" >/dev/null; then
      preserved_count=$((preserved_count + 1))
      continue
    fi
    all_preserved=0
    response=$("${become[@]}" curl -fsS --max-time 2 "http://127.0.0.1:$port/v1/meet" 2>&1) || {
      echo "cannot census rooms for $user: $response" >&2; exit 1;
    }
  fi
  count=$(jq -er '.rooms | arrays | length' <<< "$response")
  if (( count > 0 )); then live+=("$user:$count"); fi
done
# Meetings a host service owns outside Pi Remote (a Recall bot waiting in a lobby, a
# scheduler about to join) have no room here yet, but a restart still cuts them. The
# host file's optional meetingCensus command prints one live meeting per line; a
# failing census is unknown state, never an empty host.
host_file=${PI_STACK_HOST_FILE:-/etc/pi-stack/host.json}
if [[ -f $host_file && ( $mode == --all || $all_preserved == 0 || $preserved_count == 0 ) ]]; then
  commands=$(jq -r '.meetingCensus // [] | if type == "array" and all(type == "string") then .[] else error("meetingCensus must be a list of strings") end' "$host_file")
  census=()
  [[ -z $commands ]] || mapfile -t census <<< "$commands"
  if (( ${#census[@]} )); then
    errors=$(mktemp)
    trap 'rm -f "$errors"' EXIT
    if ! output=$(timeout 20 "${become[@]}" "${census[@]}" 2>"$errors"); then
      echo "cannot census host meetings (${census[0]}): $(<"$errors") $output" >&2; exit 1
    fi
    while IFS= read -r line; do
      line=${line//[[:space:]]/_}
      [[ -n $line ]] && live+=("$line")
    done <<< "$output"
  fi
fi
printf '%s\n' "${live[*]}"
