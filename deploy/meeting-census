#!/usr/bin/env bash
# Read-only meeting census and restart admission.
set -euo pipefail
mode=${1:---all}
case "$mode" in --all|--restart-blockers) ;; *) echo 'usage: meeting-census [--all|--restart-blockers]' >&2; exit 64 ;; esac
become=()
[[ $EUID == 0 || ${PI_STACK_DEPLOY_NO_SUDO:-0} == 1 ]] || become=(sudo -n)
dir=${PI_REMOTE_PERSONS_DIR:-/var/lib/pi-remote/persons}
[[ -d $dir ]] || exit 0
live=()
all_preserved=1
preserved_count=0
for file in "$dir"/*.json; do
  [[ -f $file ]] || continue
  user=$("${become[@]}" jq -er '.user | select(type == "string")' "$file")
  [[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ && $file == "$dir/$user.json" ]] || { echo "invalid person identity in $file" >&2; exit 1; }
  port=$("${become[@]}" jq -er '.port | select(type == "number" and . > 0 and . < 65536)' "$file")
  if response=$("${become[@]}" curl -fsS --max-time 2 "http://127.0.0.1:$port/v1/meet" 2>&1); then
    count=$(jq -er '.rooms | arrays | length' <<< "$response")
  else
    status=$?
    [[ $status == 7 ]] || { echo "cannot census $user (curl $status): $response" >&2; exit 1; }
    states=$("${become[@]}" systemctl show "pi-remote@$user.service" "pi-remote-dev-supervisor@$user.service" -p ActiveState --value)
    [[ -n $states ]] || { echo "cannot determine supervisor state for $user" >&2; exit 1; }
    for state in $states; do
      case "$state" in
        inactive|failed) ;;
        *) echo "cannot census $user ($state): $response" >&2; exit 1 ;;
      esac
    done
    continue
  fi
  preserved=0
  if [[ $mode == --restart-blockers ]]; then
    health=$("${become[@]}" curl -fsS --max-time 2 "http://127.0.0.1:$port/v1/health") || {
      echo "cannot inspect meeting runtime for $user" >&2; exit 1;
    }
    jq -e 'type == "object" and .ok == true' <<< "$health" >/dev/null || {
      echo "invalid supervisor health for $user" >&2; exit 1;
    }
    if jq -e '.meetingRuntime.protocol == "meet-runtime-v1" and .meetingRuntime.lifetime == "person-service"' <<< "$health" >/dev/null; then
      preserved=1
      preserved_count=$((preserved_count + 1))
    fi
    (( preserved )) || all_preserved=0
  fi
  if (( count > 0 && !preserved )); then live+=("$user:$count"); fi
done
# Meetings a host service owns outside Pi Remote (a Recall bot waiting in a lobby, a
# scheduler about to join) have no room here yet, but a restart still cuts them. The
# host file's optional meetingCensus command prints one live meeting per line; a
# failing census is unknown state, never an empty host.
host_file=${PI_STACK_HOST_FILE:-/etc/pi-stack/host.json}
if [[ -f $host_file && ( $mode == --all || $all_preserved == 0 || $preserved_count == 0 ) ]]; then
  commands=$(jq -r '.meetingCensus // [] | if type == "array" and all(type == "string") then .[] else error("meetingCensus must be a list of strings") end' "$host_file")
  census=()
  [[ -z $commands ]] || mapfile -t census <<< "$commands"
  if (( ${#census[@]} )); then
    errors=$(mktemp)
    trap 'rm -f "$errors"' EXIT
    if ! output=$(timeout 20 "${become[@]}" "${census[@]}" 2>"$errors"); then
      echo "cannot census host meetings (${census[0]}): $(<"$errors") $output" >&2; exit 1
    fi
    while IFS= read -r line; do
      line=${line//[[:space:]]/_}
      [[ -n $line ]] && live+=("$line")
    done <<< "$output"
  fi
fi
printf '%s\n' "${live[*]}"
