#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
role=${1:-}
manifest="$root/config/skill-sets.json"
jq -e --arg role "$role" '.roles[$role] | type == "array"' "$manifest" >/dev/null || {
  echo "usage: deploy/skills {gmktec-user|gmktec-fleet|converge-user}" >&2
  exit 64
}
dest=${PI_STACK_SKILLS_DEST:-/srv/pi/skills}
agent_dir=${PI_AGENT_DIR:-${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}}
stage=$(mktemp -d "${TMPDIR:-/tmp}/pi-skills.XXXXXXXX")
trap 'rm -rf "$stage"' EXIT

cd "$root"
commit=$(git rev-parse HEAD)
mkdir -p "$stage/release"
while IFS= read -r skill; do
  rsync -a --chmod=D755,F644 "skills/$skill/" "$stage/release/$skill/"
done < <(jq -r '.skills[]' "$manifest")
printf '%s\n' "$commit" > "$stage/release/.pi-stack-commit"
pi_stack_publish_release "$root" "$stage/release" "$dest" skills

agent_home=$(dirname "$(dirname "$agent_dir")")
agent_owner=$(stat -c %U "$agent_home")
agent_group=$(stat -c %G "$agent_home")
pi_stack_as_root install -d -m 755 -o "$agent_owner" -g "$agent_group" "$agent_dir" "$agent_dir/skills"
while IFS= read -r skill; do
  target="$agent_dir/skills/$skill"
  if jq -e --arg role "$role" --arg skill "$skill" '.roles[$role] | index($skill) != null' "$manifest" >/dev/null; then
    if [[ ! -L $target || $(readlink "$target") != "$dest/$skill" ]]; then
      pi_stack_as_root rm -rf -- "$target"
      pi_stack_as_root ln -s "$dest/$skill" "$target"
    fi
  elif [[ -L $target && $(readlink "$target") == "$dest/$skill" ]]; then
    pi_stack_as_root rm "$target"
  fi
done < <(jq -r '.skills[]' "$manifest")
printf 'deployed %s Pi skills from %s to %s\n' "$role" "$commit" "$dest"
