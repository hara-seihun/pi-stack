#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enforce_deploy_deadline "$0" "$@"
pi_stack_acquire_deploy_lock "$root"
if [[ ${PI_STACK_ALLOW_DIRTY:-0} != 1 && -n $(git -C "$root" status --porcelain) ]]; then
  echo "refusing to deploy an uncommitted Pi stack; set PI_STACK_ALLOW_DIRTY=1 only for a temporary test" >&2
  exit 65
fi
dest=${PI_STACK_REMOTE_DEST:-/srv/pi/pi-remote}
orchestrator=${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}
commit=$(git -C "$root" rev-parse HEAD)
if [[ -f $dest/.pi-stack-commit && $(<"$dest/.pi-stack-commit") == "$commit" && -x $dest/server/pi-remote-launch ]]; then
  printf 'Pi Remote from %s is already deployed\n' "$commit"
  exit 0
fi
stage=$(mktemp -d "${TMPDIR:-/tmp}/pi-remote.XXXXXXXX")
trap 'rm -rf "$stage"' EXIT

cd "$root"
[[ -f $orchestrator/.pi-stack-commit && $(<"$orchestrator/.pi-stack-commit") == "$commit" ]] || {
  echo "deploy Pi Orchestrator $commit before Pi Remote" >&2
  exit 66
}
orchestrator_release=$(readlink -f "$orchestrator")
[[ -f $orchestrator_release/src/boost.ts && -f $orchestrator_release/src/voice/index.ts ]] || {
  echo "Pi Orchestrator release is incomplete at $orchestrator_release" >&2
  exit 66
}

mkdir -p "$stage/release/node_modules"
rsync -a --chmod=D755,Fu=rwX,Fgo=rX apps/remote/package.json apps/remote/server apps/remote/web "$stage/release/"
test -x "$stage/release/server/pi-remote-launch" || {
  printf 'staged Pi Remote launch wrapper is not executable\n' >&2
  exit 1
}
ln -s "$orchestrator_release" "$stage/release/node_modules/pi-orchestrator"
printf '%s\n' "$commit" > "$stage/release/.pi-stack-commit"
pi_stack_publish_release "$root" "$stage/release" "$dest" remote
printf 'deployed Pi Remote from %s to %s\n' "$commit" "$dest"
