#!/usr/bin/env bash
# Refresh the additive One Kenan gate owner; no unit or private state changes.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
host=${1:-$(pi_stack_host_file)}
if ! jq -e '.oneKenan == true' "$host" >/dev/null; then
  echo 'One Kenan disabled; listener gates left alone'
  exit 0
fi
config=${PI_KENAN_ACCESS_CONFIG:-/etc/pi-stack/one-kenan-access.json}
command=${PI_KENAN_ACCESS_COMMAND:-/usr/local/sbin/pi-kenan-access}
[[ -f $config ]] || { echo "Enabled One Kenan is missing $config" >&2; exit 1; }
pi_stack_as_root install -m 755 "$root/deploy/one-kenan-access" "$command"
pi_stack_as_root "$command" apply --config "$config"
echo 'refreshed One Kenan listener gates; no service restarted'
