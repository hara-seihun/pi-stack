#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_acquire_deploy_lock "$root"
if [[ ${PI_STACK_ALLOW_DIRTY:-0} != 1 && -n $(git -C "$root" status --porcelain) ]]; then
  echo "refusing to deploy an uncommitted Pi stack; set PI_STACK_ALLOW_DIRTY=1 only for a temporary test" >&2
  exit 65
fi
runtime_source="$root/packages/runtime"
runtime_root=${PI_STACK_RUNTIME_ROOT:-$HOME/.local/share/pi-runtime}
bin_dir=${PI_STACK_USER_BIN:-$HOME/.local/bin}
dependencies_root="$runtime_root/dependencies"
releases_root="$runtime_root/releases"
stage=""
cleanup() { [[ -z $stage ]] || rm -rf "$stage"; }
trap cleanup EXIT
install -d -m 700 "$runtime_root" "$dependencies_root" "$releases_root"
exec 9>"$runtime_root/deploy.lock"
flock 9

cd "$root"
pi_stack_prepare_dependencies "$root"
npm run check --workspace=@rahularya01/pi-cursor
npm run build --workspace=@rahularya01/pi-cursor
npm test --workspace=@hara-seihun/pi-runtime
dependency_hash=$({
  sha256sum package.json package-lock.json
  printf '%s\n' workspace-production-closure-v1-atomic-settings-writes-v1
} | sha256sum | cut -d' ' -f1)
dependency_release="$dependencies_root/$dependency_hash"
if [[ ! -x $dependency_release/node_modules/.bin/pi ]]; then
  stage=$(mktemp -d "$dependencies_root/.stage.XXXXXXXX")
  install -m 644 package.json package-lock.json "$stage/"
  while IFS= read -r manifest; do
    install -d "$stage/$(dirname "$manifest")"
    install -m 644 "$manifest" "$stage/$manifest"
  done < <(find apps packages tools -name node_modules -prune -o -name package.json -print)
  (cd "$stage" && npm ci --omit=dev --ignore-scripts)
  settings_manager="$stage/node_modules/@earendil-works/pi-coding-agent/dist/core/settings-manager.js"
  SETTINGS_MANAGER="$settings_manager" node --input-type=module <<'NODE'
import { readFileSync, writeFileSync } from "node:fs";
const path = process.env.SETTINGS_MANAGER;
const source = readFileSync(path, "utf8");
const patched = source
  .replace(
    'import { existsSync, mkdirSync, readFileSync, writeFileSync } from "fs";',
    'import { existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "fs";',
  )
  .replace(
    '                writeFileSync(path, next, "utf-8");',
    '                const temporary = `${path}.${process.pid}.${randomUUID()}.tmp`;\n                try {\n                    writeFileSync(temporary, next, { encoding: "utf-8", mode: 0o600 });\n                    renameSync(temporary, path);\n                }\n                finally {\n                    rmSync(temporary, { force: true });\n                }',
  );
if (patched === source || !patched.includes("renameSync(temporary, path)")) {
  throw new Error("Pi settings atomic-write patch no longer matches the pinned dependency");
}
writeFileSync(path, patched);
NODE
  node --check "$settings_manager"
  rm -f "$stage/node_modules/pi-orchestrator" "$stage/node_modules/pi-remote"
  rm -rf "$stage/node_modules/@hara-seihun"
  mv "$stage" "$dependency_release"
  stage=""
fi
settings_manager="$dependency_release/node_modules/@earendil-works/pi-coding-agent/dist/core/settings-manager.js"
grep -q 'renameSync(temporary, path)' "$settings_manager"
node --check "$settings_manager"

extensions=(pi-claude-code-use state-compactor bash-timeout-guard publication-custody chatgpt-pro pi-cursor)
release_hash=$(cd "$runtime_source" && {
  printf '%s\n' "$dependency_hash"
  for extension in "${extensions[@]}"; do
    find "extensions/$extension" -type f -print0 | sort -z | xargs -0 sha256sum
  done
  find prompt-eval -type f -print0 | sort -z | xargs -0 sha256sum
  sha256sum models.json
} | sha256sum | cut -d' ' -f1)
runtime_release="$releases_root/$release_hash"
if [[ ! -d $runtime_release ]]; then
  stage=$(mktemp -d "$releases_root/.stage.XXXXXXXX")
  install -d -m 700 "$stage/extensions"
  for extension in "${extensions[@]}"; do rsync -a "$runtime_source/extensions/$extension" "$stage/extensions/"; done
  rsync -a "$runtime_source/prompt-eval" "$stage/"
  install -m 600 "$runtime_source/models.json" "$stage/models.json"
  ln -s "$dependency_release/node_modules" "$stage/node_modules"
  printf '%s\n' "$(git rev-parse HEAD)" > "$stage/.pi-stack-commit"
  mv "$stage" "$runtime_release"
  stage=""
fi

current="$runtime_root/current"
link_stage="$current.stage.$$"
ln -s "$runtime_release" "$link_stage"
mv -Tf "$link_stage" "$current"
printf '%s\n' "$(git rev-parse HEAD)" > "$runtime_root/.pi-stack-commit"
install -d -m 700 "$bin_dir"
ln -sfn "$current/node_modules/.bin/pi" "$bin_dir/pi"
ln -sfn "$current/prompt-eval/prompt-eval.mjs" "$bin_dir/prompt-eval"
ln -sfn "$current/extensions/chatgpt-pro/pro" "$bin_dir/pro"
version=$("$bin_dir/pi" --version)
[[ $version == 0.84.2 ]] || { echo "unexpected Pi version: $version" >&2; exit 1; }
"$bin_dir/prompt-eval" --help | grep -q '^prompt-eval'
printf 'deployed Pi %s from %s to %s\n' "$version" "$(git rev-parse HEAD)" "$runtime_release"
