#!/usr/bin/env bash
# Prepare an immutable runtime and its durable proof while the selected runtime
# keeps serving; activate that exact prepared candidate at the handoff.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
link_user=""
mode=deploy
if [[ ${1:-} == --links-only && $# == 2 && -n $2 ]]; then
  mode=links
  link_user=$2
elif [[ ${1:-} == --prepare && $# == 1 ]]; then
  mode=prepare
elif [[ ${1:-} == --activate-prepared && $# == 1 ]]; then
  mode=activate
elif (( $# )); then
  echo 'usage: deploy/runtime [--prepare | --activate-prepared | --links-only USER]' >&2; exit 64
fi
runtime_source="$root/packages/runtime"
dest=${PI_STACK_RUNTIME_DEST:-/srv/pi/runtime}
dependencies_root=${PI_STACK_DEPENDENCIES_ROOT:-/srv/pi/dependencies}
PI_VERSION=0.87.1
BROWSER_VERSION="agent-browser $(node -p 'require(process.argv[1]).packages["node_modules/agent-browser"].version' "$root/package-lock.json")"
stage=""
dependency_stage=""
artifact_stage=""
cleanup() {
  [[ -z $stage ]] || rm -rf "$stage"
  [[ -z $dependency_stage ]] || pi_stack_as_root rm -rf "$dependency_stage"
  [[ -z $artifact_stage ]] || pi_stack_as_root rm -rf "$artifact_stage"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
commit=$(git -C "$root" rev-parse HEAD)
releases=${PI_STACK_RELEASES_ROOT:-$(dirname "$dest")/.pi-stack-releases}/runtime
candidate="$releases/$commit"

runtime_preparation_proof() {
  pi_stack_as_root node --input-type=module - "$1" "$2" "$candidate" "$commit" "$dependencies_root" "$PI_VERSION" "$BROWSER_VERSION" <<'JS'
import fs from 'node:fs';
import path from 'node:path';
const [operation, artifact, candidate, commit, dependenciesRoot, piVersion, browserVersion] = process.argv.slice(2);
const proofPath = path.join(artifact, '.pi-stack-runtime-prepared.json');
function fail(reason) {
  console.error(`runtime preparation proof invalid: ${reason}`);
  process.exit(66);
}
function syncDirectory(directory) {
  const fd = fs.openSync(directory, 'r');
  try { fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
}
try {
  const artifactStat = fs.lstatSync(artifact);
  if (!artifactStat.isDirectory()) fail('candidate is not an immutable directory');
  if (operation === 'verify' && (artifactStat.mode & 0o222) !== 0) fail('candidate is writable');
  if (fs.readFileSync(path.join(artifact, '.pi-stack-commit'), 'utf8').trim() !== commit) fail('commit mismatch');
  const modules = fs.readlinkSync(path.join(artifact, 'node_modules'));
  const dependencyRelease = path.dirname(modules);
  if (!/^[a-f0-9]{64}$/.test(path.basename(dependencyRelease)) ||
      dependencyRelease !== path.join(dependenciesRoot, path.basename(dependencyRelease)) ||
      modules !== path.join(dependencyRelease, 'node_modules')) fail('dependency identity mismatch');
  for (const name of ['stack-pi.mjs', 'native-host.mjs', 'native-recovery.mjs', 'native-guardian.mjs', 'managed-agent.mjs', 'capacity']) {
    if (fs.readlinkSync(path.join(artifact, name)) !== path.join(dependencyRelease, name)) fail(`${name} identity mismatch`);
    fs.accessSync(path.join(artifact, name));
  }
  fs.accessSync(path.join(artifact, 'stack-pi.mjs'), fs.constants.X_OK);
  fs.accessSync(path.join(artifact, 'capacity', 'native-session.js'));
  for (const name of ['pi', 'agent-browser', 'pi-agent-browser-doctor', 'pi-model-selection-doctor']) {
    fs.accessSync(path.join(modules, '.bin', name), fs.constants.X_OK);
  }
  const expected = { schema: 1, state: 'prepared', commit, candidate, dependencyRelease, piVersion, browserVersion };
  if (operation === 'write') {
    const fd = fs.openSync(proofPath, 'wx', 0o444);
    try {
      fs.writeFileSync(fd, `${JSON.stringify({ ...expected, preparedAt: new Date().toISOString() })}\n`);
      fs.fsyncSync(fd);
    } finally { fs.closeSync(fd); }
    syncDirectory(artifact);
  } else if (operation === 'verify') {
    const proof = JSON.parse(fs.readFileSync(proofPath, 'utf8'));
    for (const [key, value] of Object.entries(expected)) {
      if (proof[key] !== value) fail(`${key} mismatch`);
    }
    if (typeof proof.preparedAt !== 'string' || !Number.isFinite(Date.parse(proof.preparedAt))) fail('preparation timestamp missing');
    if ((fs.statSync(proofPath).mode & 0o222) !== 0) fail('proof is writable');
  } else fail('unknown proof operation');
} catch (error) {
  fail(error.message);
}
JS
}

activate_prepared() {
  runtime_preparation_proof verify "$candidate"
  pi_stack_publish_release "$root" "$candidate" "$dest" runtime
  reconcile_links
}

clean_live_spills() {
  local spill_count
  spill_count=$(pi_stack_as_root node "$root/deploy/clean-shell-spills.mjs" /tmp)
  printf 'shell output custody proof passed; removed %s preexisting /tmp/pi-bash-*.log files\n' "$spill_count"
}

runtime_required_pattern() {
  local label=$1 file=$2 pattern=$3
  if ! grep -Fq "$pattern" "$file"; then
    printf 'runtime contract missing: %s (%s)\n' "$label" "$file" >&2
    return 66
  fi
}

check_release() {
  local release=$1 version browser_version
  version=$("$release/node_modules/.bin/pi" --version)
  browser_version=$("$release/node_modules/.bin/agent-browser" --version)
  [[ $version == "$PI_VERSION" ]] || { echo "unexpected Pi version: $version" >&2; exit 1; }
  [[ $browser_version == "$BROWSER_VERSION" ]] || { echo "unexpected agent-browser version: $browser_version" >&2; exit 1; }
  local claude_version
  claude_version=$(node -p 'require(process.argv[1]).claudeCodeVersion' "$runtime_source/extensions/claude-oauth/client.json")
  runtime_required_pattern 'Claude client identity' "$release/node_modules/@pi-plugins/claude-oauth/dist/index.mjs" "const CLAUDE_CODE_VERSION = \"$claude_version\";"
  node --check "$release/node_modules/@earendil-works/pi-coding-agent/dist/modes/rpc/shared-rpc-mode.js"
  runtime_required_pattern 'durable SDK session rewrite' "$release/node_modules/@earendil-works/pi-coding-agent/dist/core/session-manager.js" 'replaceSessionFileDurably(this.sessionFile'
  for writer in session-manager settings-manager auth-storage; do
    runtime_required_pattern "shared SDK $writer custody" "$release/node_modules/@earendil-works/pi-coding-agent/dist/core/$writer.js" 'PiStack shared filesystem custody'
    node --check "$release/node_modules/@earendil-works/pi-coding-agent/dist/core/$writer.js"
  done
  runtime_required_pattern 'browser sensitive output redaction' "$release/node_modules/pi-agent-browser-native/dist/extensions/agent-browser/index.js" 'Sensitive form values are redacted'
  runtime_required_pattern 'browser sensitive output contract' "$release/node_modules/pi-agent-browser-native/docs/TOOL_CONTRACT.md" 'Pi Stack sensitive form outputs'
  runtime_required_pattern 'browser recovery ownership' "$release/node_modules/pi-agent-browser-native/dist/extensions/agent-browser/lib/orchestration/browser-run/managed-session-daemon-policy.js" 'Closing is recovery, not reuse'
  node --input-type=module - "$release/node_modules/pi-agent-browser-native" <<'JS'
import assert from 'node:assert/strict';
import { pathToFileURL } from 'node:url';
const { compileAgentBrowserSemanticAction: compile } = await import(pathToFileURL(`${process.argv[2]}/dist/extensions/agent-browser/lib/input-modes/semantic-action.js`));
for (const target of [{selector:'#input'}, {locator:'label',value:'Input'}]) {
  assert.equal(compile({action:'fill', ...target, text:''}).compiled.args.at(-1), '');
  assert.equal(compile({action:'fill', ...target}).error, 'semanticAction.text is required for fill.');
}
JS
  runtime_required_pattern 'Anthropic error content' "$release/node_modules/@earendil-works/pi-ai/dist/api/anthropic-messages.js" 'Anthropic error tool results require text'
  local shell_source
  for shell_source in core/bash-executor.js core/tools/output-accumulator.js core/tools/bash.js; do
    runtime_required_pattern "bounded SDK $shell_source output" "$release/node_modules/@earendil-works/pi-coding-agent/dist/$shell_source" 'PiStack shell output stays in memory'
    node --check "$release/node_modules/@earendil-works/pi-coding-agent/dist/$shell_source"
  done
  PI_TEST_RUNTIME_ENTRY="file://$release/node_modules/@earendil-works/pi-coding-agent/dist/index.js" \
    node --test "$runtime_source/bash-spill.test.mjs"
  PI_TEST_RUNTIME_ENTRY="file://$release/node_modules/@earendil-works/pi-coding-agent/dist/index.js" \
    PI_TEST_BASH_CANCELLATION_PATCH=0 node --test "$runtime_source/bash-cancellation.test.mjs"
  cmp -s "$runtime_source/stack-pi.mjs" "$release/stack-pi.mjs" || { echo 'mandatory Pi launcher does not match this release' >&2; exit 1; }
  node --check "$release/stack-pi.mjs"
  cmp -s "$runtime_source/native-host.mjs" "$release/native-host.mjs" || { echo 'native session host does not match this release' >&2; exit 1; }
  node --check "$release/native-host.mjs"
  cmp -s "$runtime_source/native-recovery.mjs" "$release/native-recovery.mjs" || { echo 'native recovery owner does not match this release' >&2; exit 1; }
  node --check "$release/native-recovery.mjs"
  cmp -s "$runtime_source/native-guardian.mjs" "$release/native-guardian.mjs" || { echo 'native namespace watcher does not match this release' >&2; exit 1; }
  node --check "$release/native-guardian.mjs"
  cmp -s "$runtime_source/managed-agent.mjs" "$release/managed-agent.mjs" || { echo 'native ThreadService adapter does not match this release' >&2; exit 1; }
  runtime_required_pattern 'mandatory native ThreadService owner' "$release/node_modules/@earendil-works/pi-coding-agent/dist/main.js" 'PiStack native ThreadService owner'
  node --check "$release/node_modules/@earendil-works/pi-coding-agent/dist/main.js"
  [[ -f $release/capacity/native-session.js ]] || { echo 'native ThreadService owner is missing' >&2; exit 1; }
  timeout 8s node --input-type=module - "$release" <<'NODE' || { echo 'managed SDK/CLI owner import closure cannot load' >&2; return 66; }
import { pathToFileURL } from 'node:url';
import { join } from 'node:path';
const root = process.argv[2];
const sdk = await import(pathToFileURL(join(root, 'node_modules/@earendil-works/pi-coding-agent/dist/index.js')).href);
const owner = await import(pathToFileURL(join(root, 'managed-agent.mjs')).href);
if (typeof sdk.main !== 'function' || typeof owner.createManagedAgentSession !== 'function' || typeof owner.recoverNativeSessionOwners !== 'function') throw Error('Managed SDK/CLI exports are incomplete');
NODE
  local doctor command
  for doctor in browser model-selection; do
    command=pi-agent-browser-doctor
    [[ $doctor != model-selection ]] || command=pi-model-selection-doctor
    cmp -s "$runtime_source/$doctor-doctor.mjs" "$release/node_modules/.bin/$command" || {
      echo "the $doctor doctor does not match this release" >&2; exit 1;
    }
  done
}

# Every Pi account reaches the release through ~/.local/bin, so the links are
# reconciled on every run, including the already-deployed fast path: a person
# added since the last release must not wait for the next one.
reconcile_links() {
  local user home bin owner group
  while IFS= read -r user; do
    home=$(pi_stack_home "$user")
    [[ -n $home && -d $home ]] || continue
    bin="$home/.local/bin"
    owner=$(stat -c %U "$home"); group=$(stat -c %G "$home")
    pi_stack_as_root install -d -m 755 -o "$owner" -g "$group" "$home/.local" "$bin"
    pi_stack_as_root ln -sfn "$dest/stack-pi.mjs" "$bin/pi"
    pi_stack_as_root chown -h "$owner:$group" "$bin/pi"
    for name in agent-browser pi-agent-browser-doctor pi-model-selection-doctor; do
      pi_stack_as_root ln -sfn "$dest/node_modules/.bin/$name" "$bin/$name"
      pi_stack_as_root chown -h "$owner:$group" "$bin/$name"
    done
    pi_stack_as_root rm -f "$bin/codex" "$bin/pro" "$bin/prompt-eval"
  done < <(if [[ -n $link_user ]]; then printf '%s\n' "$link_user"; else pi_stack_users; fi)
}

if [[ -n $link_user ]]; then
  pi_stack_require_release "$dest" "$commit"
  for name in pi agent-browser pi-agent-browser-doctor pi-model-selection-doctor; do
    [[ -x $dest/node_modules/.bin/$name ]] || { echo "runtime command is missing: $name" >&2; exit 66; }
  done
  [[ -x $dest/stack-pi.mjs ]] || { echo "mandatory Pi launcher is missing: $dest/stack-pi.mjs" >&2; exit 66; }
  reconcile_links
  exit 0
fi

if [[ $mode == activate ]]; then
  activate_prepared
  printf 'activated prepared Pi %s from %s at %s\n' "$PI_VERSION" "$commit" "$dest"
  exit 0
fi

if [[ $mode == deploy && -f $dest/.pi-stack-commit && $(<"$dest/.pi-stack-commit") == "$commit" && -x $dest/node_modules/.bin/pi ]]; then
  check_release "$dest"
  clean_live_spills
  reconcile_links
  printf 'Pi %s from %s is already deployed\n' "$PI_VERSION" "$commit"
  exit 0
fi

if [[ -d $candidate ]]; then
  if [[ ! -f $candidate/.pi-stack-runtime-prepared.json ]]; then
    check_release "$candidate"
    runtime_preparation_proof write "$candidate"
    pi_stack_as_root chmod -R a-w "$candidate"
  fi
  runtime_preparation_proof verify "$candidate"
  if [[ $mode == deploy ]]; then
    activate_prepared
    clean_live_spills
  fi
  printf 'prepared Pi %s from %s at %s\n' "$PI_VERSION" "$commit" "$candidate"
  exit 0
fi

cd "$root"
pi_stack_as_root install -d -m 755 "$dependencies_root"
dependency_hash=$({
  sha256sum package.json package-lock.json packages/runtime/browser-doctor.mjs packages/runtime/browser-probe.mjs packages/runtime/browser-tab-restore-probe.mjs packages/runtime/model-selection-doctor.mjs packages/runtime/patch-browser-qa.mjs packages/runtime/patch-browser-sensitive-policy.mjs packages/runtime/patch-browser-managed-close.mjs packages/runtime/patch-browser-semantic-fill.mjs packages/runtime/patch-browser-batch-timeout.mjs packages/runtime/patch-codex-sse.mjs packages/runtime/patch-codex-service-recovery.mjs packages/runtime/codex-service-recovery.js packages/runtime/patch-compaction-errors.mjs packages/runtime/patch-bash-spill.mjs packages/runtime/patch-session-durability.mjs packages/runtime/patch-shared-custody.mjs packages/orchestrator/src/shared-custody.ts packages/runtime/patch-shared-rpc.mjs
  sha256sum packages/runtime/patch-bash-cancellation.mjs packages/runtime/pi-shell-owner.mjs packages/runtime/pi-shell-owner.py
  sha256sum packages/runtime/stack-pi.mjs packages/runtime/native-host.mjs packages/runtime/native-recovery.mjs packages/runtime/native-guardian.mjs packages/runtime/managed-agent.mjs packages/runtime/patch-managed-cli.mjs
  find packages/orchestrator/src -type f -print0 | sort -z | xargs -0 sha256sum
  sha256sum packages/runtime/patch-claude-oauth.mjs packages/runtime/extensions/claude-oauth/client.json packages/runtime/patch-anthropic-error-content.mjs packages/runtime/patch-summary-recovery.mjs packages/runtime/bounded-summary.js packages/runtime/extensions/codex-compaction/retry.mjs
  find packages/kenan-memory/src packages/kenan-root/src -type f -print0 | sort -z | xargs -0 sha256sum
  sha256sum packages/kenan-memory/package.json packages/kenan-memory/tsconfig.json packages/kenan-memory/discretion.md packages/kenan-memory/person.md
  sha256sum packages/kenan-root/package.json packages/kenan-root/tsconfig.json packages/kenan-root/instructions.md
  printf '%s\n' workspace-production-closure-v3-kenan-root-atomic-settings-writes-v1-durable-sessions-v1
} | sha256sum | cut -d' ' -f1)
dependency_release="$dependencies_root/$dependency_hash"
if [[ ! -x $dependency_release/node_modules/.bin/pi ]]; then
  stage=$(mktemp -d "${TMPDIR:-/tmp}/pi-runtime-dependencies.XXXXXXXX")
  install -m 644 package.json package-lock.json "$stage/"
  install -d "$stage/vendor/pi"
  install -m 644 vendor/pi/*.tgz "$stage/vendor/pi/"
  while IFS= read -r manifest; do
    install -d "$stage/$(dirname "$manifest")"
    install -m 644 "$manifest" "$stage/$manifest"
  done < <(find apps packages tools -name node_modules -prune -o -name package.json -print)
  pi_stack_prepare_dependencies "$root"
  node "$root/scripts/build-workspace.mjs" orchestrator
  npm run build --workspace=kenan-memory
  node "$root/scripts/build-workspace.mjs" kenan-root
  rsync -a packages/kenan-memory/src packages/kenan-memory/dist packages/kenan-memory/discretion.md packages/kenan-memory/person.md "$stage/packages/kenan-memory/"
  rsync -a packages/kenan-root/src packages/kenan-root/dist packages/kenan-root/instructions.md "$stage/packages/kenan-root/"
  (cd "$stage" && npm ci --omit=dev --ignore-scripts --prefer-offline --no-audit --no-fund)
  install -d "$stage/capacity"
  node "$root/node_modules/esbuild/bin/esbuild" "$root/packages/orchestrator/src/threads/native-session.ts" --bundle --platform=node --format=esm --packages=external --alias:pi-orchestrator/history="$root/packages/orchestrator/src/threads/history.mjs" --outfile="$stage/capacity/native-session.js"
  install -m 644 packages/runtime/managed-agent.mjs "$stage/managed-agent.mjs"
  install -m 644 packages/runtime/native-host.mjs packages/runtime/native-recovery.mjs packages/runtime/native-guardian.mjs "$stage/"
  install -m 755 packages/runtime/stack-pi.mjs "$stage/stack-pi.mjs"
  install -m 755 packages/runtime/browser-doctor.mjs "$stage/browser-doctor.mjs"
  install -m 644 packages/runtime/browser-probe.mjs "$stage/browser-probe.mjs"
  install -m 644 packages/runtime/browser-tab-restore-probe.mjs "$stage/browser-tab-restore-probe.mjs"
  ln -sfn ../../browser-doctor.mjs "$stage/node_modules/.bin/pi-agent-browser-doctor"
  install -m 755 packages/runtime/model-selection-doctor.mjs "$stage/model-selection-doctor.mjs"
  ln -sfn ../../model-selection-doctor.mjs "$stage/node_modules/.bin/pi-model-selection-doctor"
  node "$runtime_source/patch-claude-oauth.mjs" "$stage/node_modules"
  node "$runtime_source/patch-codex-sse.mjs" "$stage/node_modules"
  node "$runtime_source/patch-anthropic-error-content.mjs" "$stage/node_modules"
  node "$runtime_source/patch-codex-service-recovery.mjs" "$stage/node_modules"
  browser_job="$stage/node_modules/pi-agent-browser-native/dist/extensions/agent-browser/lib/input-modes/job.js"
  node "$runtime_source/patch-browser-qa.mjs" "$browser_job"
  node --check "$browser_job"
  node "$runtime_source/patch-browser-sensitive-policy.mjs" "$stage/node_modules/pi-agent-browser-native"
  node "$runtime_source/patch-browser-managed-close.mjs" "$stage/node_modules/pi-agent-browser-native"
  node "$runtime_source/patch-browser-semantic-fill.mjs" "$stage/node_modules/pi-agent-browser-native"
  node "$runtime_source/patch-browser-batch-timeout.mjs" "$stage/node_modules/pi-agent-browser-native"
  node --check "$stage/node_modules/pi-agent-browser-native/dist/extensions/agent-browser/index.js"
  node "$runtime_source/patch-compaction-errors.mjs" "$stage/node_modules"
  node "$runtime_source/patch-summary-recovery.mjs" "$stage/node_modules"
  node "$runtime_source/patch-bash-spill.mjs" "$stage/node_modules"
  node "$runtime_source/patch-bash-cancellation.mjs" "$stage/node_modules"
  node "$runtime_source/patch-session-durability.mjs" "$stage/node_modules"
  node "$runtime_source/patch-shared-custody.mjs" "$stage/node_modules"
  node "$runtime_source/patch-shared-rpc.mjs" "$stage/node_modules"
  node "$runtime_source/patch-managed-cli.mjs" "$stage/node_modules"
  rm -f "$stage/node_modules/pi-orchestrator" "$stage/node_modules/pi-remote"
  rm -rf "$stage/node_modules/@hara-seihun"
  dependency_stage="$dependencies_root/.stage.$$.${RANDOM}"
  pi_stack_as_root install -d -m 755 "$dependency_stage"
  pi_stack_as_root rsync -a --delete --chmod=D755,Fu=rwX,Fgo=rX "$stage/" "$dependency_stage/"
  pi_stack_as_root chmod -R a-w "$dependency_stage"
  pi_stack_as_root mv -T "$dependency_stage" "$dependency_release"
  dependency_stage=""
  rm -rf "$stage"
  stage=""
fi
settings_manager="$dependency_release/node_modules/@earendil-works/pi-coding-agent/dist/core/settings-manager.js"
runtime_required_pattern 'atomic SDK settings replacement' "$settings_manager" 'renameSync(temporary, path)'
node --check "$settings_manager"

stage=$(mktemp -d "${TMPDIR:-/tmp}/pi-runtime.XXXXXXXX")
install -d -m 755 "$stage/release/extensions"
while IFS= read -r extension; do
  rsync -a --chmod=D755,Fu=rwX,Fgo=rX "$root/$extension" "$stage/release/extensions/"
done < <(jq -r '.packages[].source | select(startswith("packages/runtime/extensions/"))' "$root/config/packages.json")
ln -s "$dependency_release/node_modules" "$stage/release/node_modules"
ln -s "$dependency_release/native-host.mjs" "$stage/release/native-host.mjs"
ln -s "$dependency_release/native-recovery.mjs" "$stage/release/native-recovery.mjs"
ln -s "$dependency_release/native-guardian.mjs" "$stage/release/native-guardian.mjs"
ln -s "$dependency_release/stack-pi.mjs" "$stage/release/stack-pi.mjs"
ln -s "$dependency_release/managed-agent.mjs" "$stage/release/managed-agent.mjs"
ln -s "$dependency_release/capacity" "$stage/release/capacity"
printf '%s\n' "$commit" > "$stage/release/.pi-stack-commit"
pi_stack_as_root install -d -m 755 "$releases"
artifact_stage="$releases/.stage.$$.${RANDOM}"
pi_stack_as_root install -d -m 755 "$artifact_stage"
pi_stack_as_root rsync -a --delete --chmod=D755,Fu=rwX,Fgo=rX "$stage/release/" "$artifact_stage/"
check_release "$artifact_stage"
runtime_preparation_proof write "$artifact_stage"
pi_stack_as_root chmod -R a-w "$artifact_stage"
pi_stack_as_root mv -T "$artifact_stage" "$candidate"
artifact_stage=""
pi_stack_as_root sync -f "$releases"
if [[ $mode == prepare ]]; then
  printf 'prepared Pi %s and %s from %s at %s\n' "$PI_VERSION" "$BROWSER_VERSION" "$commit" "$candidate"
else
  activate_prepared
  clean_live_spills
  printf 'deployed Pi %s and %s from %s to %s\n' "$PI_VERSION" "$BROWSER_VERSION" "$commit" "$dest"
fi
