#!/usr/bin/env bash
# Build and prove immutable candidates while the selected controllers keep serving.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_acquire_deploy_lock "$root"
export PI_STACK_DEPLOY_DEADLINE_ACTIVE=1
if [[ ${PI_STACK_ALLOW_DIRTY:-0} != 1 && -n $(git -C "$root" status --porcelain) ]]; then
  echo 'refusing to prepare an uncommitted Pi stack' >&2
  exit 65
fi
commit=$(git -C "$root" rev-parse HEAD)
export PI_STACK_RELEASES_ROOT=$(pi_stack_component_releases_root)
prepared_root="$(dirname "$PI_STACK_RELEASES_ROOT")/.pi-stack-prepared"
prepared="$prepared_root/$commit"
pi_stack_as_root install -d -m755 "$prepared_root" "$prepared"
if pi_stack_as_root test -f "$PI_STACK_RELEASES_ROOT/.prepared/$commit.json"; then
  pi_stack_as_root node "$root/deploy/prepared-components.mjs" "$PI_STACK_RELEASES_ROOT" "$commit" verify
  "$root/deploy/meet-recognition"
  printf 'Pi stack %s is already prepared; selected owners are unchanged\n' "$commit"
  exit 0
fi
started=$SECONDS
"$root/deploy/retain" || echo 'Pi stack release retention failed; existing assets retained' >&2
cache=$(pi_stack_as_root node "$root/deploy/component-cache.mjs" "$root" "$PI_STACK_RELEASES_ROOT" "$commit" reuse)
printf '%s\n' "$cache"
(
  if jq -e '.value.components | all(. == "present" or . == "reused")' <<<"$cache" >/dev/null; then
    echo 'all component inputs unchanged; reusing prepared build artifacts'
  else
    pi_stack_prepare_builds "$root"
  fi
) &
builds_pid=$!
"$root/deploy/meet-recognition" &
recognition_pid=$!
failed=0
if wait "$builds_pid"; then
  if "$root/deploy/runtime" --prepare; then :; else
    status=$?; printf 'Pi stack preparation runtime exited %s\n' "$status" >&2; failed=1
  fi
else
  status=$?; printf 'Pi stack preparation builds exited %s\n' "$status" >&2; failed=1
fi
if wait "$recognition_pid"; then :; else
  status=$?; printf 'Pi stack preparation meet-recognition exited %s\n' "$status" >&2; failed=1
fi
(( failed == 0 )) || exit 1
# Scratch selectors are never referenced by a service or an account command.
export PI_STACK_PREPARE_ONLY=1 PI_STACK_SKIP_TOOL_LINKS=1
export PI_STACK_RUNTIME_DEST="$PI_STACK_RELEASES_ROOT/runtime/$commit"
export PI_STACK_ORCHESTRATOR_DEST="$prepared/orchestrator" PI_STACK_REMOTE_DEST="$prepared/remote" PI_STACK_TOOLS_DEST="$prepared/tools"
prepare_component() {
  local name=$1 destination=$2
  if [[ $(jq -r --arg name "$name" '.value.components[$name]' <<<"$cache") == reused ]]; then
    pi_stack_select_release "$PI_STACK_RELEASES_ROOT/$name/$commit" "$destination" "$commit"
  else
    "$root/deploy/$name"
  fi
}
prepare_component orchestrator "$PI_STACK_ORCHESTRATOR_DEST"
prepare_component remote "$PI_STACK_REMOTE_DEST" &
remote_pid=$!
prepare_component tools "$PI_STACK_TOOLS_DEST" &
tools_pid=$!
failed=0
wait "$remote_pid" || failed=1
wait "$tools_pid" || failed=1
(( failed == 0 )) || exit 1
pi_stack_as_root node "$root/deploy/prepared-components.mjs" "$PI_STACK_RELEASES_ROOT" "$commit" record
pi_stack_as_root node "$root/deploy/component-cache.mjs" "$root" "$PI_STACK_RELEASES_ROOT" "$commit" record
printf 'prepared Pi stack %s in %ss without changing selected owners\n' "$commit" "$((SECONDS - started))"
