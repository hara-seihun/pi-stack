#!/usr/bin/python3
"""Read the shared core's exact scoped adoption proof; never change admission."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('host')
    parser.add_argument('candidate')
    parser.add_argument('--probe', action='store_true')
    args = parser.parse_args()
    if os.geteuid() != 0 or not re.fullmatch(r'[a-f0-9]{40}', args.candidate):
        raise ValueError('administrator and exact candidate required')
    artifact = Path('/srv/pi/pi-orchestrator')
    result = subprocess.run([str(artifact / 'host/core-runtime'), 'proof', str(artifact), '/etc/pi-stack/core.json'],
                            check=False, capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        print(json.dumps({'ready': False, 'state': 'core-adoption-unavailable', 'admissionGated': False}))
        print('native history observation waiting: core adoption proof unavailable; original evidence remains owned', file=sys.stderr)
        return 75
    proof = json.loads(result.stdout)
    if proof.get('ok') is not True or proof['value'].get('protocol') != 'pi-core-adoption-proof-v1' or proof['value'].get('admissionGated') is not False:
        raise ValueError('invalid scoped core adoption proof')
    print(json.dumps({'ready': True, 'state': 'core-adopted', 'admissionGated': False, 'proof': proof['value']}))
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print('Core native history observation failed: ' + str(error), file=sys.stderr)
        sys.exit(1)
