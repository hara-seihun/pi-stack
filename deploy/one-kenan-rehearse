#!/usr/bin/python3
"""Finite privileged deployment rehearsal in a private mount namespace, fixture paths only."""
import os
import pathlib
import subprocess
import sys

if os.geteuid()!=0: raise SystemExit('Run sudo deploy/one-kenan-rehearse; only temporary fixture state is changed')
repo=pathlib.Path(__file__).resolve().parent.parent
subprocess.run(['unshare','--mount','--propagation','private',sys.executable,str(repo/'scripts/one-kenan-deploy.test.py')],
    check=True,timeout=45,env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1'})
