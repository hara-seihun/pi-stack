#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enforce_deploy_deadline "$0" "$@"
pi_stack_acquire_deploy_lock "$root"
if [[ ${PI_STACK_ALLOW_DIRTY:-0} != 1 && -n $(git -C "$root" status --porcelain) ]]; then
  echo "refusing to deploy an uncommitted Pi stack; set PI_STACK_ALLOW_DIRTY=1 only for a temporary test" >&2
  exit 65
fi
role=${1:-}
[[ $role == local || $role == converge ]] || { echo "usage: deploy/tools {local|converge}" >&2; exit 64; }
dest=${PI_STACK_TOOLS_DEST:-/srv/pi/tools}
runtime_root=${PI_STACK_RUNTIME_ROOT:-$HOME/.local/share/pi-runtime}
user_home=${PI_STACK_USER_HOME:-/home/kenan}
fleet_home=${PI_STACK_FLEET_HOME:-/home/orchestrator}
skip_links=${PI_STACK_SKIP_TOOL_LINKS:-0}
stage=$(mktemp -d "${TMPDIR:-/tmp}/pi-tools.XXXXXXXX")
trap 'rm -rf "$stage"' EXIT

cd "$root"
commit=$(git rev-parse HEAD)
[[ -f $runtime_root/.pi-stack-commit && $(<"$runtime_root/.pi-stack-commit") == "$commit" ]] || {
  echo "deploy Pi Runtime $commit before Pi tools" >&2
  exit 66
}
dependencies=$(readlink -f "$runtime_root/current/node_modules")
[[ -d $dependencies ]] || { echo "Pi Runtime dependencies are missing at $dependencies" >&2; exit 66; }

mkdir -p "$stage/release"
mapfile -t selected < <(jq -r --arg role "$role" '.tools[] | select(.hosts | index($role)) | .id' config/tools.json)
for tool in "${selected[@]}"; do
  rsync -a --chmod=D755,F644 --exclude=deploy "tools/$tool/" "$stage/release/$tool/"
  while IFS=$'\t' read -r name entry; do
    chmod 755 "$stage/release/$tool/$entry"
  done < <(jq -r --arg tool "$tool" '.tools[] | select(.id == $tool) | .commands[] | [.name,.entry] | @tsv' config/tools.json)
done

ln -s "$dependencies" "$stage/release/node_modules"
printf '%s\n' "$commit" > "$stage/release/.pi-stack-commit"
pi_stack_publish_release "$root" "$stage/release" "$dest" "tools-$role"

if [[ $skip_links != 1 ]]; then
  reconcile_links() {
    local home=$1
    local fleet=$2
    local bin="$home/.local/bin"
    declare -A expected=()
    while IFS=$'\t' read -r tool name entry; do
      expected["$name"]="$dest/$tool/$entry"
    done < <(jq -r --arg role "$role" --argjson fleet "$fleet" \
      '.tools[] | select(.hosts | index($role)) | select(($fleet | not) or .fleet) | .id as $tool | .commands[] | [$tool,.name,.entry] | @tsv' \
      config/tools.json)

    while IFS= read -r -d '' link; do
      target=$(pi_stack_as_root readlink "$link")
      name=$(basename "$link")
      if [[ $target == "$dest/"* && ${expected[$name]:-} != "$target" ]]; then
        pi_stack_as_root rm -- "$link"
      fi
    done < <(pi_stack_as_root find "$bin" -maxdepth 1 -type l -print0)

    for name in "${!expected[@]}"; do
      pi_stack_as_root ln -sfn "${expected[$name]}" "$bin/$name"
      pi_stack_as_root chown -h "$(stat -c %U "$home"):$(stat -c %G "$home")" "$bin/$name"
    done
  }

  pi_stack_as_root install -d -m 755 -o "$(stat -c %U "$user_home")" -g "$(stat -c %G "$user_home")" "$user_home/.local/bin"
  reconcile_links "$user_home" false

  if [[ -d $fleet_home ]]; then
    pi_stack_as_root install -d -m 755 -o "$(stat -c %U "$fleet_home")" -g "$(stat -c %G "$fleet_home")" "$fleet_home/.local/bin"
    reconcile_links "$fleet_home" true
  fi
fi

printf 'deployed %s Pi tools from %s to %s\n' "$role" "$commit" "$dest"
