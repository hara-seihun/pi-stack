#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
[[ $# == 0 || ( $# == 1 && $1 == --select ) ]] || { echo 'usage: deploy/write-engine [--select]' >&2; exit 64; }
mode=${1:-prepare}
# Only a host that declares the engine unit fetches its 1.2 GB model.
if [[ $mode == prepare && ${PI_STACK_WRITE_ENGINE_FORCE:-0} != 1 ]] && [[ $(systemctl show pi-stack-write.service -p LoadState --value 2>/dev/null) != loaded ]]; then
  echo 'Pi Stack Write: no pi-stack-write.service on this host; nothing to prepare'
  exit 0
fi
source_dir="$root/apps/write/engine"
# The venv is keyed by the lock and the 1.2 GB of weights by the model pins and
# their converter, so neither a source change nor a dependency change refetches
# the weights. A download also reuses any already verified copy of a pinned file.
mapfile -t sources < <(cd "$source_dir" && find . -name '*.py' ! -name 'test_*' | LC_ALL=C sort)
gpu_enabled=${PI_STACK_WRITE_GPU_ENABLED:-auto}
if [[ $gpu_enabled == auto ]]; then
  gpu_enabled=0
  [[ -f /etc/pi-stack/write-gpu ]] && gpu_enabled=1
fi
[[ $gpu_enabled == 0 || $gpu_enabled == 1 ]] || { echo 'invalid PI_STACK_WRITE_GPU_ENABLED' >&2; exit 64; }
# Public service runtimes must not share inodes with an installer's private uv cache.
# The format key rebuilds previously hardlinked environments without refetching weights.
venv_key=$( { printf 'public-copy-v1\n'; cat "$source_dir/requirements.lock"; } | sha256sum | cut -d' ' -f1)
gpu_key=$( { printf 'public-copy-v1\n'; cat "$source_dir/requirements-gpu.lock" "$source_dir/gpu-model.json"; } | sha256sum | cut -d' ' -f1)
weights_key=$(cat "$source_dir/model.json" "$source_dir/convert_fp32.py" | sha256sum | cut -d' ' -f1)
environment_key=$(printf '%s\n%s\n%s\n' "$venv_key" "$weights_key" "$gpu_enabled:$gpu_key" | sha256sum | cut -d' ' -f1)
cleanup_manifest="$source_dir/cleanup/model.json"
cleanup_key=$(sha256sum "$cleanup_manifest" | cut -d' ' -f1)
punctuation_manifest="$source_dir/punctuation-model.json"
punctuation_key=$(sha256sum "$punctuation_manifest" | cut -d' ' -f1)
key=$( { echo "$environment_key"; echo "$cleanup_key"; echo "$punctuation_key"; for file in "${sources[@]}"; do echo "$file"; cat "$source_dir/$file"; done; } | sha256sum | cut -d' ' -f1)
base=${PI_STACK_WRITE_ENGINE_DEST:-/srv/pi/write-engine}
store="$(dirname "$base")/.pi-write"
environment="$store/venv-$venv_key"
gpu_environment="$store/gpu-venv-$gpu_key"
gpu_weights="$store/gpu-weights-$(sha256sum "$source_dir/gpu-model.json" | cut -d' ' -f1)"
weights="$store/weights-$weights_key"
cleanup_model="$store/cleanup-$cleanup_key"
punctuation_model="$store/punctuation-$punctuation_key"
tree="$store/$key"
if [[ ! -f "$tree/ready" && $mode == --select ]]; then
  echo "PiStack Write engine is not prepared at $tree; run deploy/prepare first" >&2
  exit 66
fi
fetch() { # URL DIGEST DESTINATION
  local url=$1 digest=$2 destination=$3 existing
  [[ -f "$destination" && $(sha256sum "$destination" | cut -d' ' -f1) == "$digest" ]] && return
  install -d "$(dirname "$destination")"
  for existing in "$store"/*/model/"${destination#"$weights"/}" "$store"/weights-*/"${destination#"$weights"/}"; do
    [[ -f "$existing" && "$existing" != "$destination" ]] || continue
    if [[ $(sha256sum "$existing" | cut -d' ' -f1) == "$digest" ]]; then cp --reflink=auto "$existing" "$destination.part" && mv "$destination.part" "$destination" && return; fi
  done
  pi_stack_download_artifact "$url" "$destination" "$digest"
}
if [[ ! -f "$environment/ready" ]]; then
  command -v uv >/dev/null || { echo 'PiStack Write requires uv' >&2; exit 1; }
  pi_stack_as_root install -d -m 0755 "$store" "$environment"
  pi_stack_as_root chown "$(id -u):$(id -g)" "$environment"
  # uv's managed interpreter normally lives in the installing user's home, which
  # the service's dynamic user cannot read; keep it inside the shared tree.
  export UV_PYTHON_INSTALL_DIR="$environment/python"
  [[ -x "$environment/venv/bin/python" ]] || uv venv --managed-python --python 3.12 "$environment/venv"
  uv pip sync --link-mode copy --python "$environment/venv/bin/python" --require-hashes "$source_dir/requirements.lock"
  chmod -R a+rX "$environment"
  touch "$environment/ready"
fi
if [[ ! -f "$weights/ready" ]]; then
  command -v curl >/dev/null || { echo 'PiStack Write requires curl' >&2; exit 1; }
  pi_stack_as_root install -d -m 0755 "$store" "$weights"
  pi_stack_as_root chown "$(id -u):$(id -g)" "$weights"
  "$environment/venv/bin/python" - "$source_dir/model.json" > "$weights/files.tsv" <<'PY'
import json,sys
m=json.load(open(sys.argv[1]))
for path,digest in m['files'].items():
    print(path, path, m['repository'], m['revision'], digest, sep='\t')
print('shared/'+m['tokenizer_file'],m['tokenizer_file'],m['tokenizer_repository'],m['tokenizer_revision'],m['tokenizer_sha256'],sep='\t')
PY
  while IFS=$'\t' read -r file source_file repository revision digest; do
    fetch "https://huggingface.co/$repository/resolve/$revision/$source_file" "$digest" "$weights/$file"
  done < "$weights/files.tsv"
  "$environment/venv/bin/python" "$source_dir/convert_fp32.py" "$weights"
  chmod -R a+rX "$weights"
  touch "$weights/ready"
fi
if [[ ! -f "$cleanup_model/ready" ]]; then
  command -v curl >/dev/null || { echo 'PiStack Write cleanup requires curl' >&2; exit 1; }
  pi_stack_as_root install -d -m 0755 "$cleanup_model"
  pi_stack_as_root chown "$(id -u):$(id -g)" "$cleanup_model"
  "$environment/venv/bin/python" - "$cleanup_manifest" > "$cleanup_model/files.tsv" <<'PY'
import json,sys
m=json.load(open(sys.argv[1]))
for name,digest in m['files'].items():
    print(name,m['release'].rstrip('/')+'/'+name,digest,sep='\t')
PY
  while IFS=$'\t' read -r file url digest; do
    destination="$cleanup_model/$file"
    pi_stack_download_artifact "$url" "$destination" "$digest"
  done < "$cleanup_model/files.tsv"
  chmod -R a+rX "$cleanup_model"
  touch "$cleanup_model/ready"
fi
if [[ ! -f "$punctuation_model/ready" ]]; then
  command -v curl >/dev/null || { echo 'PiStack Write punctuation requires curl' >&2; exit 1; }
  pi_stack_as_root install -d -m 0755 "$punctuation_model"
  pi_stack_as_root chown "$(id -u):$(id -g)" "$punctuation_model"
  "$environment/venv/bin/python" - "$punctuation_manifest" > "$punctuation_model/files.tsv" <<'PY'
import json,sys
m=json.load(open(sys.argv[1]))
for name,digest in m['files'].items():
    print(name,'https://huggingface.co/'+m['repository']+'/resolve/'+m['revision']+'/'+name,digest,sep='\t')
PY
  while IFS=$'\t' read -r file url digest; do
    pi_stack_download_artifact "$url" "$punctuation_model/$file" "$digest"
  done < "$punctuation_model/files.tsv"
  chmod -R a+rX "$punctuation_model"
  touch "$punctuation_model/ready"
fi
# A readiness stamp is not proof that the mandatory assets still match their pins.
"$environment/venv/bin/python" - "$punctuation_manifest" "$punctuation_model" <<'PY'
import hashlib,json,sys
from pathlib import Path
manifest=json.load(open(sys.argv[1]))
for name,digest in manifest['files'].items():
    path=Path(sys.argv[2])/name
    with path.open('rb') as asset:
        actual=hashlib.file_digest(asset,'sha256').hexdigest()
    if actual != digest:
        raise SystemExit('PiStack Write punctuation checksum mismatch: '+str(path))
PY
if [[ $gpu_enabled == 1 && ! -f "$gpu_environment/ready" ]]; then
  command -v uv >/dev/null || { echo 'PiStack Write GPU requires uv' >&2; exit 1; }
  pi_stack_as_root install -d -m 0755 "$gpu_environment"
  pi_stack_as_root chown "$(id -u):$(id -g)" "$gpu_environment"
  export UV_PYTHON_INSTALL_DIR="$gpu_environment/python"
  [[ -x "$gpu_environment/venv/bin/python" ]] || uv venv --managed-python --python 3.12 "$gpu_environment/venv"
  uv pip sync --link-mode copy --python "$gpu_environment/venv/bin/python" --require-hashes \
    --index https://download.pytorch.org/whl/rocm7.2 \
    --default-index https://pypi.org/simple --index-strategy unsafe-best-match \
    "$source_dir/requirements-gpu.lock"
  chmod -R a+rX "$gpu_environment"
  touch "$gpu_environment/ready"
fi
if [[ $gpu_enabled == 1 && ! -f "$gpu_weights/ready" ]]; then
  pi_stack_as_root install -d -m 0755 "$gpu_weights"
  pi_stack_as_root chown "$(id -u):$(id -g)" "$gpu_weights"
  "$environment/venv/bin/python" - "$source_dir/gpu-model.json" > "$gpu_weights/files.tsv" <<'PY'
import json,sys
m=json.load(open(sys.argv[1]))
for path,digest in m['files'].items():
    print(path,m['repository'],m['revision'],digest,sep='\t')
PY
  while IFS=$'\t' read -r file repository revision digest; do
    fetch "https://huggingface.co/$repository/resolve/$revision/$file" "$digest" "$gpu_weights/$file"
  done < "$gpu_weights/files.tsv"
  chmod -R a+rX "$gpu_weights"
  touch "$gpu_weights/ready"
fi
if [[ ! -f "$tree/ready" ]]; then
  pi_stack_as_root install -d -m 0755 "$tree"
  pi_stack_as_root chown "$(id -u):$(id -g)" "$tree"
  if [[ $gpu_enabled == 1 ]]; then
    ln -sfn "$gpu_environment/venv" "$tree/venv"
    ln -sfn "$gpu_weights" "$tree/gpu-model"
  else
    ln -sfn "$environment/venv" "$tree/venv"
  fi
  ln -sfn "$weights" "$tree/model"
  ln -sfn "$cleanup_model" "$tree/cleanup-model"
  ln -sfn "$punctuation_model" "$tree/punctuation-model"
  for file in "${sources[@]}"; do install -D -m 0644 "$source_dir/$file" "$tree/$file"; done
  chmod -R a+rX "$tree"
  touch "$tree/ready"
fi
[[ -x "$tree/venv/bin/python" && -f "$tree/server.py" && -d "$tree/model" && -f "$tree/cleanup-model/joint-f32.onnx" && $(readlink -f "$tree/punctuation-model") == "$punctuation_model" && -f "$tree/punctuation-model/punct_cap_seg_en.onnx" && -f "$tree/punctuation-model/spe_32k_lc_en.model" ]] || { echo "Incomplete Write engine: $tree" >&2; exit 66; }
next="$base.next.$$"
trap 'pi_stack_as_root rm -f "$next"' EXIT
previous=$(readlink -f "$base" 2>/dev/null || true)
pi_stack_as_root ln -s "$tree" "$next"
pi_stack_as_root mv -Tf "$next" "$base"
echo "PiStack Write engine ready: $key"
# Keep the selected tree and the one it replaced (which the running unit may
# still use, and which rollback selects), with everything they link to. Remove
# every other store entry, so model and dependency changes do not accumulate.
keep=()
# The GPU tree links the superset ROCm venv, but preparation also uses this
# small CPU environment for model conversion and manifest parsing. Retain it
# so each source-only release does not re-fetch its managed Python runtime.
[[ $gpu_enabled == 0 ]] || keep+=("$environment")
for selected in "$tree" "$previous"; do
  [[ -n $selected && -d $selected ]] || continue
  keep+=("$(readlink -f "$selected")")
  for link in "$selected"/venv "$selected"/model "$selected"/gpu-model "$selected"/cleanup-model "$selected"/punctuation-model; do
    [[ -L $link ]] || continue
    target=$(readlink -f "$link")
    while [[ $(dirname "$target") != "$store" && $target != / ]]; do target=$(dirname "$target"); done
    keep+=("$target")
  done
done
# A running engine (or anything else) that maps files from an entry keeps it.
while read -r used; do keep+=("$used"); done < <(pi_stack_as_root sh -c 'cat /proc/[0-9]*/maps 2>/dev/null' | grep -o "$store/[^/ ]*" | sort -u)
for entry in "$store"/*; do
  [[ -e $entry ]] || continue
  printf '%s\n' "${keep[@]}" | grep -qxF "$(readlink -f "$entry")" && continue
  pi_stack_as_root rm -rf -- "$entry"
done
