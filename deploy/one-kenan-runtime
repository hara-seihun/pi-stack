#!/usr/bin/python3
"""Join fixed core data custody and drain accepted action receipts as their owner."""
import fcntl
import json
import os
from pathlib import Path
import pwd
import stat
import sys

sys.path.insert(0, '/srv/pi/pi-orchestrator/host')
from core_namespace import namespace_path, trusted


def publisher_credential(uid, gid, environment):
    directory = environment.get('CREDENTIALS_DIRECTORY')
    if not directory:
        raise ValueError('systemd action-journal publisher credential required')
    source = os.open(os.path.join(directory, 'kenan-memory-publisher'), os.O_RDONLY | os.O_NOFOLLOW)
    try:
        info = os.fstat(source)
        if not stat.S_ISREG(info.st_mode) or info.st_size > 1024 * 1024:
            raise ValueError('invalid publisher credential custody')
        data = os.read(source, 1024 * 1024 + 1)
    finally:
        os.close(source)
    fd = os.memfd_create('kenan-memory-publisher', os.MFD_ALLOW_SEALING)
    os.write(fd, data); os.lseek(fd, 0, os.SEEK_SET); os.fchown(fd, uid, gid); os.fchmod(fd, 0o400)
    fcntl.fcntl(fd, fcntl.F_ADD_SEALS, fcntl.F_SEAL_WRITE | fcntl.F_SEAL_GROW | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_SEAL)
    os.set_inheritable(fd, True)
    environment['PI_KENAN_MEMORY_PUBLISHER_TOKEN_FILE'] = f'/proc/self/fd/{fd}'
    environment.pop('CREDENTIALS_DIRECTORY', None)


def main():
    if os.geteuid() != 0 or sys.argv[1:] != ['journal']:
        raise ValueError('fixed privileged journal-only launcher required')
    config = trusted(Path('/etc/pi-stack/one-kenan.json'))
    if not isinstance(config.get('executionUser'), str):
        raise ValueError('explicit journal receipt owner required')
    user = pwd.getpwnam(config['executionUser'])
    if user.pw_uid == 0:
        raise ValueError('journal consumer must retain its unprivileged identity')
    runtime = trusted(Path('/etc/pi-stack/core-runtime.json'))
    core = trusted(Path('/etc/pi-stack/core.json'))
    if runtime.get('version') != 1 or core.get('version') != 1 or core.get('host') not in ('127.0.0.1', '::1') or type(core.get('port')) is not int:
        raise ValueError('explicit common data namespace and loopback memory origin required')
    source = os.path.realpath('/srv/pi/runtime/node_modules/kenan-memory/src/journal-cli.ts')
    if not Path(source).is_file():
        raise ValueError('immutable action-journal runtime unavailable')
    environment = dict(os.environ)
    publisher_credential(user.pw_uid, user.pw_gid, environment)
    namespace = os.open(namespace_path(runtime['namespace']), os.O_RDONLY)
    try:
        os.setns(namespace, 0)
    finally:
        os.close(namespace)
    host = '[::1]' if core['host'] == '::1' else core['host']
    environment['PI_KENAN_MEMORY_URL'] = f"http://{host}:{core['port']}"
    environment.update(USER=user.pw_name, LOGNAME=user.pw_name)
    os.initgroups(user.pw_name, user.pw_gid); os.setgid(user.pw_gid); os.setuid(user.pw_uid)
    if os.getuid() == 0 or os.geteuid() == 0:
        raise ValueError('journal owner privilege drop failed')
    os.execve('/usr/local/bin/bun', ['/usr/local/bin/bun', source, 'drain', '--all'], environment)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(json.dumps({'ok': False, 'error': {'code': 'journal-custody-unavailable', 'message': str(error)}}), file=sys.stderr)
        sys.exit(75)
