#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
[[ $# == 1 || $# == 2 ]] || { echo 'usage: deploy/direct-agent-ingress EXPECTED_COMMIT [HOST_FILE]' >&2; exit 64; }
expected=$1
[[ $expected =~ ^[0-9a-f]{40}$ ]] || exit 64
[[ $# == 1 ]] || export PI_STACK_HOST_FILE=$2
runtime=${PI_STACK_RUNTIME_DEST:-/srv/pi/runtime}
[[ -f $runtime/.pi-stack-commit && $(<"$runtime/.pi-stack-commit") == "$expected" ]] || { echo 'Managed agent runtime selection is not the target' >&2; exit 75; }
for launcher in stack-pi.mjs; do
  [[ -x $runtime/$launcher ]] || { echo "Managed launcher is missing: $runtime/$launcher" >&2; exit 75; }
done
[[ -f $runtime/managed-agent.mjs && -f $runtime/capacity/native-session.js ]] || { echo 'Native ThreadService owner is missing' >&2; exit 75; }
grep -q 'PiStack native ThreadService owner' "$runtime/node_modules/@earendil-works/pi-coding-agent/dist/main.js" || { echo 'Native CLI has no ThreadService owner' >&2; exit 75; }
node --input-type=module -e 'const owner=await import(process.argv[1]); if(typeof owner.createManagedAgentSession!=="function")process.exit(75)' "file://$runtime/managed-agent.mjs"
selected=$(readlink -f "$runtime/stack-pi.mjs")
users=$(pi_stack_users)
[[ -n $users ]] || { echo 'Managed ingress has no configured accounts' >&2; exit 75; }
while IFS= read -r user; do
  home=$(pi_stack_home "$user")
  [[ -n $home && -d $home ]] || { echo "Configured account home is unavailable: $user" >&2; exit 75; }
  [[ $(readlink -f "$home/.local/bin/pi") == "$selected" ]] || { echo "Account $user has no managed Pi launcher" >&2; exit 75; }
done <<<"$users"
core=${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}
proof=$(pi_stack_as_root "$core/host/core-runtime" proof "$core" /etc/pi-stack/core.json)
jq -e --arg expected "$expected" '.ok == true and .value.releaseCommit == $expected and .value.protocol == "pi-core-adoption-proof-v1"' <<<"$proof" >/dev/null || { echo 'Scoped core ingress does not own the selected adopted release' >&2; exit 75; }
jq -nc --arg commit "$expected" '{cli:"managed",sdk:"managed",core:"adopted",evidence:{releaseCommit:$commit}}'
