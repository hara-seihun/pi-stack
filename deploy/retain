#!/usr/bin/env bash
# Bound the commit-addressed release store and the dependency trees behind it.
#
#   deploy/retain [--dry-run] [--keep N] [--budget-seconds S]
#
# Every deployment publishes a new release per component under
# /srv/pi/.pi-stack-releases/COMPONENT/COMMIT, and a dependency change adds a
# tree under /srv/pi/dependencies. Nothing else removes them. This keeps, per
# component, the selected release and the N most recently published others
# (PI_STACK_RELEASE_KEEP, default 5) for rollback, plus every release that is
# still in use:
#
#   - named by a live process's cwd, executable, command line, environment,
#     mappings or open files;
#   - selected when a still-running Pi process started, since Node resolves
#     later imports through the releases that were selected when it began;
#   - recorded by a queued, starting or running Orchestrator run in any
#     account's ledger (fleet recovery resumes a run under its release);
#   - published within the grace period (PI_STACK_RETAIN_GRACE_SECONDS, 3600).
#
# A dependency tree stays while a kept release links into it, a process names
# it, or it is inside the grace period. Retired entries are renamed out of
# their commit-addressed names first, so a half-deleted release is never
# selectable, then removed; a --budget-seconds cutoff leaves the remaining
# renamed entries for the next run. deploy/prepare runs this before each
# release; it holds the deployment lock so no publication races it.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_acquire_deploy_lock "$root"

stable=$(dirname "${PI_STACK_RUNTIME_DEST:-/srv/pi/runtime}")
releases=${PI_STACK_RELEASES_ROOT:-$stable/.pi-stack-releases}
dependencies=${PI_STACK_DEPENDENCIES_ROOT:-/srv/pi/dependencies}
[[ -d $releases ]] || { printf 'no release store at %s\n' "$releases"; exit 0; }

pi_stack_as_root env PI_STACK_RELEASE_KEEP="${PI_STACK_RELEASE_KEEP:-5}" \
  PI_STACK_RETAIN_GRACE_SECONDS="${PI_STACK_RETAIN_GRACE_SECONDS:-3600}" \
  PI_STACK_RETAIN_LEDGERS="${PI_STACK_RETAIN_LEDGERS:-}" \
  python3 - "$stable" "$releases" "$dependencies" "$@" <<'PY'
import argparse, glob, json, os, pwd, re, shutil, sqlite3, sys, time

stable, releases, dependencies = (os.path.realpath(p) for p in sys.argv[1:4])
parser = argparse.ArgumentParser(prog="deploy/retain")
parser.add_argument("--dry-run", action="store_true")
parser.add_argument("--keep", type=int, default=int(os.environ["PI_STACK_RELEASE_KEEP"]))
parser.add_argument("--budget-seconds", type=float, default=0)
args = parser.parse_args(sys.argv[4:])
if args.keep < 1:
    sys.exit("deploy/retain: --keep must be at least 1; rollback needs a previous release")
grace = float(os.environ["PI_STACK_RETAIN_GRACE_SECONDS"])
now = time.time()
COMMIT = re.compile(r"^[0-9a-f]{40}$")
# Dependency trees are only ours to prune beside the stable root they serve;
# a rehearsal that redirects the releases elsewhere leaves the host's alone.
prune_dependencies = os.path.isdir(dependencies) and os.path.dirname(dependencies) == stable

def published(path):
    for probe in (os.path.join(path, ".pi-stack-commit"), path):
        try:
            return os.lstat(probe).st_mtime
        except OSError:
            pass
    return 0.0

components = {}
for name in sorted(os.listdir(releases)):
    directory = os.path.join(releases, name)
    if name.startswith(".") or not os.path.isdir(directory) or os.path.islink(directory):
        continue
    entries = [os.path.join(directory, e) for e in os.listdir(directory) if COMMIT.match(e)]
    entries = [e for e in entries if os.path.isdir(e) and not os.path.islink(e)]
    components[name] = sorted(entries, key=published, reverse=True)

reasons = {}
def keep(path, reason):
    reasons.setdefault(path, reason)

# The selected releases: every stable symlink beside the store.
selected = {}
for name in os.listdir(stable):
    link = os.path.join(stable, name)
    if os.path.islink(link):
        target = os.path.realpath(link)
        if os.path.dirname(os.path.dirname(target)) == releases:
            keep(target, f"selected by {link}")
            selected[link] = target

# Rollback depth and the grace period.
for name, entries in components.items():
    others = [e for e in entries if e not in reasons or not reasons[e].startswith("selected")]
    for e in others[: args.keep]:
        keep(e, "recent release kept for rollback")
    for e in entries:
        if now - published(e) < grace:
            keep(e, "published within the grace period")

# Live processes.
release_ref = re.compile(re.escape(releases) + r"/([^/\0\s]+)/([0-9a-f]{40})")
dependency_ref = re.compile(re.escape(dependencies) + r"/([0-9a-f]{64})")
stable_ref = re.compile(re.escape(stable) + r"/([^/\0\s.][^/\0\s]*)")
dependency_refs = set()
boot = None
try:
    with open("/proc/stat") as f:
        boot = next(float(l.split()[1]) for l in f if l.startswith("btime "))
    ticks = os.sysconf("SC_CLK_TCK")
except Exception:
    boot = None
def started(pid):
    if boot is None:
        return None
    try:
        with open(f"/proc/{pid}/stat") as f:
            fields = f.read().rsplit(")", 1)[1].split()
        return boot + int(fields[19]) / ticks
    except Exception:
        return None
for pid in (p for p in os.listdir("/proc") if p.isdigit()):
    texts = []
    for entry in ("cwd", "exe", "root"):
        try:
            texts.append(os.readlink(f"/proc/{pid}/{entry}"))
        except OSError:
            pass
    for entry in ("cmdline", "environ", "maps"):
        try:
            with open(f"/proc/{pid}/{entry}", "rb") as f:
                texts.append(f.read().decode("utf-8", "replace"))
        except OSError:
            pass
    try:
        for fd in os.listdir(f"/proc/{pid}/fd"):
            try:
                texts.append(os.readlink(f"/proc/{pid}/fd/{fd}"))
            except OSError:
                pass
    except OSError:
        pass
    text = "\n".join(texts)
    for component, commit in release_ref.findall(text):
        keep(os.path.join(releases, component, commit), f"used by process {pid}")
    for tree in dependency_ref.findall(text):
        dependency_refs.add(tree)
    # Node resolves later imports through the releases selected when a Pi
    # process began, which its command line need not name (a thread host
    # names only its Orchestrator release, yet loads the runtime's extensions
    # and dependencies). Pin every component's release from that moment.
    if release_ref.search(text) or dependency_ref.search(text) or any(
            os.path.join(stable, n) in selected for n in stable_ref.findall(text)):
        begun = started(pid)
        if begun is not None:
            for component, entries in components.items():
                tenure = [e for e in entries if published(e) <= begun]
                if tenure:
                    keep(tenure[0], f"selected when process {pid} started")

# Orchestrator runs that may still resume under their recorded release.
ledgers = [p for p in os.environ.get("PI_STACK_RETAIN_LEDGERS", "").split(":") if p]
if not ledgers:
    homes = {u.pw_dir for u in pwd.getpwall() if u.pw_dir and u.pw_dir != "/"}
    ledgers = [os.path.join(h, ".local/share/pi-orchestrator/ledger.sqlite3") for h in sorted(homes)]
for ledger in ledgers:
    if not os.path.isfile(ledger):
        continue
    try:
        db = sqlite3.connect(f"file:{ledger}?mode=ro", uri=True, timeout=10)
        rows = db.execute("SELECT DISTINCT release_path FROM run WHERE release_path IS NOT NULL AND state IN ('queued','starting','running')").fetchall()
        db.close()
    except sqlite3.Error as error:
        # An unreadable ledger could name any release; keep everything.
        sys.exit(f"deploy/retain: cannot read {ledger}: {error}; nothing removed")
    for (path,) in rows:
        target = os.path.realpath(path)
        keep(target, f"recorded by an unfinished run in {ledger}")

retire = [e for entries in components.values() for e in entries if e not in reasons]

# Dependency trees the kept releases link into.
retired_trees, kept_trees = [], []
if prune_dependencies:
    linked = set(dependency_refs)
    # Releases are small (links, not copies), so walk each kept one whole.
    for path in reasons:
        for directory, subdirectories, files in os.walk(path):
            for name in subdirectories + files:
                entry = os.path.join(directory, name)
                if os.path.islink(entry):
                    m = dependency_ref.search(os.readlink(entry)) or dependency_ref.search(os.path.realpath(entry))
                    if m:
                        linked.add(m.group(1))
    for name in os.listdir(dependencies):
        tree = os.path.join(dependencies, name)
        if not re.fullmatch(r"[0-9a-f]{64}", name) or not os.path.isdir(tree) or os.path.islink(tree):
            continue
        if name in linked or now - os.lstat(tree).st_mtime < grace:
            kept_trees.append(name)
            continue
        retired_trees.append(tree)

# Leftovers of interrupted publications: stages and retired entries.
def stale_leftover(path):
    name = os.path.basename(path)
    m = re.match(r"^\.(?:stage|activate|rollback)\.(\d+)", name)
    if m and os.path.exists(f"/proc/{m.group(1)}"):
        return False
    return name.startswith(".retired.") or (m is not None and now - os.lstat(path).st_mtime >= grace)
leftovers = []
for directory in [releases, *[os.path.join(releases, c) for c in components]] + ([dependencies] if prune_dependencies else []):
    for name in os.listdir(directory):
        if name.startswith((".stage.", ".activate.", ".rollback.", ".retired.")):
            path = os.path.join(directory, name)
            if stale_leftover(path):
                leftovers.append(path)

summary = {
    "keepPrevious": args.keep,
    "components": {c: {"total": len(e), "retire": sum(1 for x in e if x not in reasons)} for c, e in components.items()},
    "dependencies": {"retire": len(retired_trees)} if prune_dependencies else "left alone",
    "leftovers": len(leftovers),
    "dryRun": args.dry_run,
}
if args.dry_run:
    summary["kept"] = {p: r for p, r in sorted(reasons.items()) if not r.startswith("recent release")}
    summary["keptDependencies"] = sorted(kept_trees)
    print(json.dumps(summary, indent=1))
    sys.exit(0)

# Rename first: the commit-addressed name disappears atomically.
doomed = []
for path in retire + retired_trees:
    target = os.path.join(os.path.dirname(path), f".retired.{os.path.basename(path)}.{os.getpid()}")
    os.rename(path, target)
    doomed.append(target)
doomed += leftovers
deadline = now + args.budget_seconds if args.budget_seconds > 0 else None
removed = 0
for path in doomed:
    if deadline is not None and time.time() > deadline:
        break
    if os.path.islink(path) or not os.path.isdir(path):
        os.unlink(path)
    else:
        shutil.rmtree(path)
    removed += 1
summary["removed"] = removed
summary["deferred"] = len(doomed) - removed
print(json.dumps(summary))
PY
