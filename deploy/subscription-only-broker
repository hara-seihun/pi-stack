#!/usr/bin/env bash
set -euo pipefail
# Scoped immutable broker update. No Core/Remote/campaign activation.
[[ $# == 3 ]] || { echo 'usage: deploy/subscription-only-broker BASE DEST SERVICE|none' >&2; exit 64; }
base=$(realpath "$1"); dest=$2; service=$3
root=$(cd "$(dirname "$0")/.." && pwd)
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="$root" GIT_OPTIONAL_LOCKS=0
commit=$(git -C "$root" rev-parse HEAD)
[[ -z $(git -C "$root" status --porcelain) ]] || { echo 'uncommitted source' >&2; exit 65; }
[[ ! -e $dest ]] || { echo 'immutable destination exists' >&2; exit 65; }
[[ $EUID == 0 ]] || { echo 'root required' >&2; exit 77; }
stage=$(mktemp -d "${dest}.stage.XXXX")
trap 'rm -rf "$stage"' EXIT
cp -a "$base/." "$stage/"
for name in subscription-only shared-oauth pooled-only anthropic-files-provider; do
  /srv/pi/runtime/node_modules/esbuild/bin/esbuild "$root/packages/orchestrator/src/auth/$name.ts" --outfile="$stage/dist/auth/$name.js" --format=esm --platform=node --target=node24
  cp "$root/packages/orchestrator/src/auth/$name.ts" "$stage/src/auth/"
done
/srv/pi/runtime/node_modules/esbuild/bin/esbuild "$root/packages/orchestrator/src/model-broker.ts" --outfile="$stage/dist/model-broker.js" --format=esm --platform=node --target=node24
cp "$root/packages/orchestrator/src/model-broker.ts" "$stage/src/"
/srv/pi/runtime/node_modules/esbuild/bin/esbuild "$root/packages/orchestrator/src/experiment-custody.ts" --outfile="$stage/dist/experiment-custody.js" --format=esm --platform=node --target=node24
cp "$root/packages/orchestrator/src/experiment-custody.ts" "$stage/src/"
cp "$root/deploy/subscription-only-check.mjs" "$stage/subscription-only-check.mjs"
printf '{"source":"%s","base":"%s"}\n' "$commit" "$base" > "$stage/subscription-only-binding.json"
node "$stage/subscription-only-check.mjs" "$stage"
chmod 0755 "$stage"
chmod 0644 "$stage/dist/experiment-custody.js" "$stage/src/experiment-custody.ts"
if [[ $service != none ]]; then
  service_user=$(systemctl show "$service" --property=User --value)
  [[ -n $service_user ]] || { echo 'broker service must declare its Unix owner' >&2; exit 65; }
  runuser -u "$service_user" -- node --input-type=module - "$stage" /etc/pi-model-broker.json <<'NODE'
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
const [root,config]=process.argv.slice(2);
for(const name of ['dist/cli.js','dist/model-broker.js','dist/experiment-custody.js'])readFileSync(join(root,name));
JSON.parse(readFileSync(config,'utf8'));
console.log(JSON.stringify({ok:true,preflight:'service-user-code-and-grants-readable'}));
NODE
fi
mv "$stage" "$dest"
if [[ $service != none ]]; then
  [[ $service == pi-model-broker.service ]] || { echo 'unsupported active broker owner' >&2; exit 65; }
  mkdir -p "/etc/systemd/system/$service.d"
  printf '[Service]\nExecStart=\nExecStart=/usr/local/bin/node %s/dist/cli.js model-broker /etc/pi-model-broker.json\nTimeoutStopSec=30min\n' "$dest" > "/etc/systemd/system/$service.d/zzzzzzz-subscription-only.conf"
  systemctl daemon-reload
  # Existing requests drain under the broker's native close() before replacement.
  systemctl restart "$service"
  systemctl is-active --quiet "$service"
  proof_dir=/var/lib/pi-model-broker/source-bindings
  install -d -m755 "$proof_dir"
  node --input-type=module - "$dest" "$commit" "$proof_dir/$commit.json" <<'NODE'
import { readFileSync, writeFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { join } from 'node:path';
const [root,source,path]=process.argv.slice(2);
const names=['dist/model-broker.js','dist/experiment-custody.js',...['subscription-only','shared-oauth','pooled-only','anthropic-files-provider'].map(n=>`dist/auth/${n}.js`)];
writeFileSync(path,JSON.stringify({source,root,files:names.map(name=>({path:name,sha256:createHash('sha256').update(readFileSync(join(root,name))).digest('hex')}))}),{mode:0o644});
NODE
  node "$root/deploy/subscription-only-adopt.mjs" "$dest" "$service" "$proof_dir/$commit.json"
fi
printf 'installed %s from %s\n' "$dest" "$commit"
