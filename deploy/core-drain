#!/usr/bin/env python3
"""Exact old-owner graceful drain with durable recovery and positive detachment receipts."""
import hashlib
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import sys
from datetime import datetime, timezone
from core_namespace import absolute, enter, publish, trusted


def properties(unit):
    result = subprocess.run(['/usr/bin/systemctl', 'show', unit, '--property=MainPID,ExecMainPID,ExecMainCode,ExecMainStatus,Result,ActiveState,InvocationID'], check=True, capture_output=True, text=True, timeout=3)
    return dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)


def detached_status(current, prior, kind, retirement, fleet_exit=None):
    collected = kind == 'fleet' and fleet_exit is not None and current.get('ExecMainPID') == '0' and current.get('ExecMainCode') == '0'
    if current.get('InvocationID') not in ('', prior['InvocationID']) or current.get('ActiveState') not in ('inactive', 'failed') or current.get('MainPID') != '0' or (not collected and (current.get('ExecMainPID') != prior['MainPID'] or current.get('ExecMainCode') != '1')) or current.get('ExecMainStatus') != '0' or current.get('Result') != 'success':
        raise ValueError('exact original process has not acknowledged a normal successful exit')
    if kind == 'fleet' and (retirement is None or retirement.get('state') != 'closed' or any(edge.get('state') != 'closed' for edge in retirement.get('edges', []))):
        raise ValueError('original fleet retirement has not positively closed every controller edge')


def journal_since(value):
    timestamp = datetime.fromisoformat(value)
    if timestamp.tzinfo is None:
        raise ValueError('drain journal boundary requires an explicit timezone')
    return '@' + format(timestamp.timestamp(), '.6f')


def storage_identities(scopes):
    grouped = {}
    for scope in scopes:
        absolute(scope['databasePath'])
        key = (json.dumps(scope['namespace'], sort_keys=True), scope['uid'], scope['gid'])
        grouped.setdefault(key, []).append(scope)
    result = {}
    code = "import json,os,stat,sys;result={};\nfor p in json.loads(sys.argv[1]):\n s=os.stat(p);assert stat.S_ISREG(s.st_mode);result[p]={'dev':str(s.st_dev),'ino':str(s.st_ino)}\nprint(json.dumps(result))"
    for (_, uid, gid), group in grouped.items():
        offset = 0
        while offset < len(group):
            batch, size = [], 0
            while offset < len(group):
                row = group[offset]
                if size + len(row['databasePath'].encode()) + 4 > 32000:
                    if not batch:
                        raise ValueError('store path exceeds bounded metadata frame')
                    break
                batch.append(row); size += len(row['databasePath'].encode()) + 4; offset += 1
            payload = json.dumps([scope['databasePath'] for scope in batch])
            values = json.loads(enter(batch[0]['namespace'], ['/usr/bin/python3', '-c', code, payload], uid, gid))
            for scope in batch:
                result[scope['scopeId']] = values[scope['databasePath']]
    return result


def native_exit_custody(plan, invocation_id, after=False):
    mode = plan.get('nativeExit')
    if not isinstance(mode, dict) or mode.get('kind') not in ('direct-bun','supervised'):
        raise ValueError('explicit original native exit custody required')
    if mode['kind'] == 'direct-bun':
        if not after and Path(os.readlink(f"/proc/{plan['pid']}/exe")).resolve() != Path('/usr/local/bin/bun').resolve():
            raise ValueError('direct native exit declaration differs from MainPID executable')
        return {'kind':'direct-bun'}
    module = runpy.run_path(str(Path(__file__).with_name('core-remote-witness')))
    witness_path = absolute(mode['witnessPlanPath'])
    witness, digest = module['plan_at'](witness_path)
    if witness['unit'] != plan['unit'] or witness['invocationId'] != invocation_id or witness['wrapper'] != {'pid':plan['pid'],'startTicks':plan['startTicks']}:
        raise ValueError('native child witness belongs to another original invocation')
    proof_path = absolute(witness['proofPath'])
    if after and not proof_path.exists():return None
    result = module['status'](witness_path)
    if result['state'] != ('exited' if after else 'attached'):
        raise ValueError('native child has no affirmative kernel attachment/normal exit proof')
    if not after:return {'kind':'supervised','planPath':str(witness_path),'planSha256':digest}
    proof = trusted(proof_path)
    if proof.get('protocol') != 'pi-core-native-child-exit-v1' or proof.get('unit') != plan['unit'] or proof.get('invocationId') != invocation_id or proof.get('wrapper') != witness['wrapper'] or proof.get('nativeChild') != witness['nativeChild'] or proof.get('exit') != {'kind':'normal','code':0} or proof.get('sourceProof') != witness['sourceProof']:
        raise ValueError('native child normal exit receipt does not match the registered witness')
    return {'kind':'supervised','path':str(proof_path),'sha256':hashlib.sha256(proof_path.read_bytes()).hexdigest(),'planSha256':digest}


def image_drain_proofs(plan):
    paths = plan.get('imageProofPaths')
    if not isinstance(paths, list) or not paths:
        raise ValueError('original Remote image intake must be fenced and accepted work drained before SIGTERM')
    records = []
    for path in paths:
        proof = trusted(absolute(path))
        if proof.get('protocol') != 'pi-core-original-image-drain-v1' or proof.get('pid') != plan['pid'] or proof.get('startTicks') != plan['startTicks'] or proof.get('state') != 'drained' or proof.get('generating') != 0:
            raise ValueError('exact original image owner has not positively drained accepted provider work')
        records.append({'path':path,'sha256':hashlib.sha256(Path(path).read_bytes()).hexdigest()})
    return records


def drain(path):
    plan = trusted(path)
    if plan.get('version') != 1 or plan.get('kind') not in ('fleet', 'remote', 'root', 'memory', 'broker') or not re.fullmatch(r'pi-[a-zA-Z0-9@_.-]+\.service', plan.get('unit', '')):
        raise ValueError('declared exact old owner kind and unit required')
    if not isinstance(plan.get('scopes'), list) or not plan['scopes'] or type(plan.get('pid')) is not int or not isinstance(plan.get('startTicks'), str):
        raise ValueError('original owner identity and exact adopted stores required')
    state_path = absolute(plan['statePath'])
    digest = hashlib.sha256(json.dumps(plan, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    state = trusted(state_path) if state_path.exists() else None
    if state is not None and state.get('planSha256') != digest:
        raise ValueError('another drain purpose owns this recovery record')
    if state is not None and state.get('state') == 'detached':
        for scope in plan['scopes']:
            receipt = trusted(absolute(scope['receiptPath']))
            if receipt.get('scopeId') != scope['scopeId'] or receipt.get('detachmentEvidence', {}).get('planSha256') != digest:
                raise ValueError('completed detachment receipt changed')
        return {'protocol': 'pi-core-owner-drain-v1', 'state': 'detached', 'unit': plan['unit'], 'receiptCount': len(plan['scopes'])}
    current = properties(plan['unit'])
    if state is None:
        if current.get('MainPID') != str(plan['pid']) or current.get('ActiveState') != 'active':
            raise ValueError('original owner is not currently identified by its declared unit')
        fields = Path(f"/proc/{plan['pid']}/stat").read_text().rsplit(')', 1)[1].split()
        if fields[19] != plan['startTicks']:
            raise ValueError('original owner birth changed')
        source = absolute(plan['sourceProof']['path'])
        if hashlib.sha256(source.read_bytes()).hexdigest() != plan['sourceProof']['sha256']:
            raise ValueError('original graceful-detachment source binding changed')
        if plan['kind'] == 'broker':
            proof = trusted(absolute(plan['streamsProofPath']))
            if proof.get('protocol') != 'pi-core-original-broker-drain-v1' or proof.get('pid') != plan['pid'] or proof.get('startTicks') != plan['startTicks'] or proof.get('state') != 'drained' or proof.get('accepted') != 0:
                raise ValueError('original runtime HTTP callbacks must positively drain before broker SIGTERM')
        if plan['kind'] == 'root':
            proof = trusted(absolute(plan['rootReadyProofPath']))
            health = proof.get('health', {})
            if proof.get('pid') != plan['pid'] or proof.get('startTicks') != plan['startTicks'] or proof.get('acceptedExecutionsDrained') is not True or health.get('dispatchPaused') is not True or health.get('handoffReady') is not True or health.get('activeExecutions') != 0 or health.get('consentActive') is not False:
                raise ValueError('positive original Root dispatch/accepted-execution drain required before detach')
        native_custody = native_exit_custody(plan,current['InvocationID']) if plan['kind']=='remote' else None
        image_proofs = image_drain_proofs(plan) if plan['kind'] == 'remote' else []
        started = datetime.now(timezone.utc).isoformat()
        state = {'version': 1, 'planSha256': digest, 'previous': current, 'startedAt': started, 'state': 'prepared', 'storageIdentities': storage_identities(plan['scopes']), 'imageDrainProofs':image_proofs,'nativeExitCustody':native_custody}
        publish(state_path, state)
        # Preserve independent execution/FUSE resources even if a previous unit used
        # control-group killing. Their explicit resource owner remains separate.
        directory = Path('/run/systemd/system') / (plan['unit'] + '.d')
        directory.mkdir(mode=0o755, parents=True, exist_ok=True)
        metadata = directory.lstat()
        if not directory.is_dir() or metadata.st_uid != 0 or metadata.st_mode & 0o022:
            raise ValueError('unit drain directory is not protected root custody')
        target = directory / 'zzzz-core-drain.conf'
        target.write_text('[Unit]\nRefuseManualStart=yes\n[Service]\nKillMode=process\nTimeoutStopSec=infinity\nRestart=no\n')
        os.chmod(target, 0o644)
        subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=True, capture_output=True, timeout=5)
        fenced = subprocess.run(['/usr/bin/systemctl', 'show', plan['unit'], '--property=Restart,RefuseManualStart'], check=True, capture_output=True, text=True, timeout=3).stdout
        fence_properties = dict(line.split('=', 1) for line in fenced.splitlines() if '=' in line)
        if fence_properties != {'Restart': 'no', 'RefuseManualStart': 'yes'}:
            raise ValueError('owning unit configuration overrode the controller intake fence')
    if state['state'] == 'prepared':
        publish(state_path, {**state, 'state': 'stopping'})
        # systemd owns the stop job; a tool timeout never authorizes another owner.
        subprocess.run(['/usr/bin/systemctl', 'stop', '--no-block', plan['unit']], check=True, capture_output=True, timeout=3)
        state = {**state, 'state': 'stopping'}
    current = properties(plan['unit'])
    if current.get('MainPID') != '0' or current.get('ActiveState') not in ('inactive', 'failed'):
        return {'protocol': 'pi-core-owner-drain-v1', 'state': 'pending', 'unit': plan['unit']}
    retirement = None
    fleet_exit = None
    if plan['kind'] == 'fleet':
        journal = subprocess.run(['/usr/bin/journalctl', '--no-pager', '--all', '--output=json', f"_SYSTEMD_INVOCATION_ID={state['previous']['InvocationID']}", '--since', journal_since(state['startedAt'])], check=True, capture_output=True, text=True, timeout=3).stdout
        for line in journal.splitlines():
            row = json.loads(line)
            try:
                record = json.loads(row.get('MESSAGE', ''))
                if record.get('type') == 'fleet-controller-retired' and row.get('_PID') == str(plan['pid']) and row.get('_SYSTEMD_UNIT') == plan['unit']:
                    retirement = record
            except (ValueError, TypeError):
                continue
        if retirement is not None:
            journal = subprocess.run(['/usr/bin/journalctl', '--no-pager', '--all', '--output=json', f"UNIT={plan['unit']}", f"INVOCATION_ID={state['previous']['InvocationID']}", '--since', journal_since(state['startedAt'])], check=True, capture_output=True, text=True, timeout=3).stdout
            for line in journal.splitlines():
                row = json.loads(line)
                if row.get('_PID') == '1' and row.get('MESSAGE_ID') == '7ad2d189f7e94e70a38c781354912448':
                    fleet_exit = {'kind': 'closed-controller-systemd-success', 'invocationId': state['previous']['InvocationID'], 'journalCursor': row['__CURSOR'], 'retirementSha256': hashlib.sha256(json.dumps(retirement, sort_keys=True, separators=(',', ':')).encode()).hexdigest()}
    detached_status(current, state['previous'], plan['kind'], retirement, fleet_exit)
    native_proof = native_exit_custody(plan,state['previous']['InvocationID'],after=True) if plan['kind']=='remote' else None
    if plan['kind']=='remote' and native_proof is None:
        return {'protocol':'pi-core-owner-drain-v1','state':'pending','unit':plan['unit'],'waiting':'native-child-exit-witness'}
    timestamp = datetime.now(timezone.utc).isoformat()
    identities = storage_identities(plan['scopes'])
    if identities != state['storageIdentities']:
        raise ValueError('original database generation changed during drain')
    for scope in plan['scopes']:
        receipt = {'version': 1, **scope.get('receiptExtras', {}), 'state': 'detached', 'scopeId': scope['scopeId'],
                   'databasePath': scope['databasePath'], 'sessionsDir': scope['sessionsDir'], 'databaseIdentity': identities[scope['scopeId']],
                   'previousOwner': {'identity': f"{plan['unit']}:{plan['pid']}:{plan['startTicks']}:{state['previous']['InvocationID']}", 'detachedAt': timestamp},
                   'detachmentEvidence': {'protocol': 'pi-core-owner-drain-v1', 'planSha256': digest, 'exitCode': 0 if current.get('ExecMainCode') == '1' else None, 'fleetExitEvidence': fleet_exit, 'sourceProof': plan['sourceProof'], 'imageDrainProofs':state.get('imageDrainProofs',[]),'nativeExitCustody':native_proof}}
        publish(absolute(scope['receiptPath']), receipt)
    publish(state_path, {**state, 'state': 'detached', 'detachedAt': timestamp})
    return {'protocol': 'pi-core-owner-drain-v1', 'state': 'detached', 'unit': plan['unit'], 'receiptCount': len(plan['scopes'])}


def extend_fleet(path):
    plan = trusted(path)
    if plan.get('version') != 1:
        raise ValueError('explicit closed fleet census extension required')
    original_path = absolute(plan['ownerPlanPath'])
    original = trusted(original_path)
    if original.get('kind') != 'fleet':
        raise ValueError('only positively closed fleet owners admit census extension')
    acknowledged = drain(original_path)
    if acknowledged['state'] != 'detached':
        raise ValueError('original fleet controller has not positively detached')
    source = trusted(absolute(original['scopes'][0]['receiptPath']))
    census_path, baseline_path = absolute(plan['censusPath']), absolute(plan['baselinePath'])
    for key, value in [('censusSha256', census_path), ('baselineSha256', baseline_path)]:
        if hashlib.sha256(value.read_bytes()).hexdigest() != plan[key]:
            raise ValueError('pre-detachment owner census binding changed')
    census, baseline = trusted(census_path), trusted(baseline_path)
    if baseline.get('phase') != 'baseline':
        raise ValueError('positive original pre-detachment baseline required')
    rows = {row['id']: row for row in baseline['evidence']}
    scopes = [row for row in census['scopes'] if row.get('ownerUnit') == original['unit']]
    stores = []
    for row in scopes:
        old = rows.get(row['scopeId'], {}).get('threads')
        if old is None or old['path'] != row['databasePath']:
            raise ValueError('census store lacks an exact original baseline identity')
        stores.append({'scopeId': row['scopeId'], 'databasePath': row['databasePath'], 'sessionsDir': row['sessionsDir'], 'namespace': row['source'], 'uid': row['uid'], 'gid': row['gid'], 'receiptPath': row['adoptionReceiptPath']})
    identities = storage_identities(stores)
    for row in stores:
        old = rows[row['scopeId']]['threads']
        if identities[row['scopeId']] != {'dev': old['dev'], 'ino': old['ino']}:
            raise ValueError('closed original fleet store differs from pre-detachment physical identity')
    evidence = {'protocol': 'pi-core-closed-fleet-census-v1', 'ownerPlanPath': str(original_path), 'ownerReceiptSha256': hashlib.sha256(absolute(original['scopes'][0]['receiptPath']).read_bytes()).hexdigest(), 'censusSha256': plan['censusSha256'], 'baselineSha256': plan['baselineSha256']}
    for row in stores:
        target = absolute(row['receiptPath'])
        if target.exists():
            existing = trusted(target)
            if existing.get('previousOwner') != source['previousOwner'] or existing.get('databaseIdentity') != identities[row['scopeId']]:
                raise ValueError('another original owner or generation already owns census receipt')
            continue
        receipt = {**source, 'scopeId': row['scopeId'], 'databasePath': row['databasePath'], 'sessionsDir': row['sessionsDir'], 'databaseIdentity': identities[row['scopeId']], 'censusExtension': evidence}
        publish(target, receipt)
    return {'protocol': 'pi-core-closed-fleet-census-v1', 'state': 'detached', 'unit': original['unit'], 'receiptCount': len(stores)}


if __name__ == '__main__':
    try:
        if os.geteuid() != 0 or len(sys.argv) not in (2, 3) or len(sys.argv) == 3 and sys.argv[1] != 'extend-fleet':
            raise ValueError('usage: root core-drain [extend-fleet] ABSOLUTE_ROOT_PLAN')
        print(json.dumps({'ok': True, 'value': extend_fleet(absolute(sys.argv[2])) if len(sys.argv) == 3 else drain(absolute(sys.argv[1]))}))
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(json.dumps({'ok': False, 'error': {'code': 'core-owner-drain-unconfirmed', 'message': str(error)}}))
        sys.exit(75)
