#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
base=${PI_STACK_WRITE_URL:-ws://127.0.0.1:8797/}

case ${1:---activate} in
  --check)
    [[ $(systemctl show pi-stack-write.service -p LoadState --value) == loaded ]] || {
      echo 'Install the host pi-stack-write.service declaration before deploying Pi Stack Write.' >&2
      exit 66
    }
    ;;
  --activate)
    port=$(printf '%s' "$base" | cut -d: -f3 | cut -d/ -f1)
    [[ $port =~ ^[0-9]+$ ]] || { echo "Invalid Write endpoint: $base" >&2; exit 64; }
    fail() {
      echo "$1" >&2
      pi_stack_as_root systemctl status pi-stack-write.service --no-pager --full >&2 || true
      exit 1
    }
    pi_stack_as_root systemctl enable pi-stack-write.service
    pi_stack_as_root systemctl reset-failed pi-stack-write.service
    pi_stack_as_root systemctl restart pi-stack-write.service || fail 'Write engine restart failed'
    # Type=simple reports active before model loading and GPU warmup finish.
    # GPU startup took 10.8 seconds in PUB-819a4d53104745bfb703640c. This
    # readiness budget leaves room within the enclosing 50-second deploy bound.
    readiness_seconds=30
    deadline=$((SECONDS + readiness_seconds))
    while :; do
      systemctl is-active --quiet pi-stack-write.service || fail 'Write engine stopped before its listener was ready'
      # No ASR slot or dictation is started by this loopback TCP probe.
      if pi_stack_as_root bash -c "echo >/dev/tcp/127.0.0.1/$port" 2>/dev/null; then break; fi
      (( SECONDS < deadline )) || fail "Write engine did not bind its listener within $readiness_seconds seconds"
      sleep 0.1
    done
    ;;
  *) echo 'usage: deploy/write-service [--check|--activate]' >&2; exit 64 ;;
esac
