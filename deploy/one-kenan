def rollback():
    if record['phase'] in ('new','prepared','rolled-back'): return
    failures=[]
    def attempt(fn):
        try: fn()
        except Exception as error: failures.append(str(error))
    # Fence only root/room feature requests; the original front door never stops.
    previous=record['files'].get(str(host))
    if previous:
        attempt(lambda: host.write_bytes(base64.b64decode(previous['data'])))
    else:
        payload=json.loads(host.read_text()); payload['oneKenan']=False
        attempt(lambda: host.write_text(json.dumps(payload,indent=2)+'\n'))
    for unit in reversed(record['newUnits']):
        if unit!='pi-kenan-access.service': attempt(lambda unit=unit: ctl('disable','--now',unit))
    if not failures and record.get('brokerStarted'):
        attempt(lambda: run([config.get('node','/usr/local/bin/node'),'--input-type=module','-e',
          'import { Store } from '+json.dumps(config.get('orchestratorRoot','/srv/pi/pi-orchestrator')+'/dist/store.js')+'; const store=Store.open(process.argv[1]); try { store.publishBrokerGrants([], "one-kenan"); } finally { store.close(); }',broker['ledgerPath']],capture_output=True))
    if failures:
        record['phase']='rollback-failed'; record['failures']=failures; save()
        raise RuntimeError('Rollback incomplete; UID gates/config preserved: '+'; '.join(failures))
    if 'pi-kenan-access.service' in record['newUnits']: attempt(lambda: ctl('disable','--now','pi-kenan-access.service'))
    for backup in reversed(record['aclFiles']):
        retained=[block for block in pathlib.Path(backup).read_text().strip().split('\n\n') if block and pathlib.Path(acl_path(block)).exists()]
        if retained: attempt(lambda retained=retained: run(['setfacl','--restore=-'],input='\n\n'.join(retained)+'\n',capture_output=True))
    for name,previous in reversed(list(record['files'].items())):
        path=pathlib.Path(name)
        # Credentials and encrypted custody stay under root custody for reactivation/recovery.
        if path.is_relative_to(shared): continue
        def restore(path=path,previous=previous):
            if previous is None: path.unlink(missing_ok=True)
            elif 'link' in previous:
                path.unlink(missing_ok=True); path.symlink_to(previous['link'])
                if not fixture: os.lchown(path,previous['uid'],previous['gid'])
            else:
                if path.is_symlink(): path.unlink()
                path.write_bytes(base64.b64decode(previous['data'])); path.chmod(previous['mode'])
                if not fixture: os.chown(path,previous['uid'],previous['gid'])
        attempt(restore)
    if str(target('/etc/apparmor.d/local/fusermount3')) in record['files']:
        attempt(lambda: run(['apparmor_parser','-r',str(target('/etc/apparmor.d/fusermount3'))],capture_output=True))
    attempt(lambda: ctl('daemon-reload'))
    record['phase']='rollback-failed' if failures else 'rolled-back'; record['failures']=failures; save()
    if failures: raise RuntimeError('Rollback incomplete: '+'; '.join(failures))

if args.action=='prepare':
    if record['phase'] not in ('new','prepared'): raise SystemExit('Existing transaction cannot be prepared again')
    if json.loads(host.read_text()).get('oneKenan') is True: raise SystemExit('Prepare requires the existing feature to be off')
    for name,contents in rendered_units().items(): (state/name).write_text(contents)
    record['phase']='prepared'; save()
    print(json.dumps({'phase':'prepared','liveChanged':False,'units':active_units,'required':['Hara cutover authorization','committed root/rooms runtimes','first post-reboot login opens encrypted custody']}))
elif args.action=='cutover':
    if record['phase']!='prepared': raise SystemExit('Run prepare first; interrupted transactions require rollback')
    record['phase']='applying'; save()
    try:
        snapshot(host)
        install()
        payload=json.loads(host.read_text()); payload['oneKenan']=True; replace(host,json.dumps(payload,indent=2)+'\n')
        record['newUnits']=active_units; save()
        for unit in active_units:
            if unit=='pi-kenan-broker.service': record['brokerStarted']=True; save()
            ctl('enable','--now',unit)
        record['phase']='active'; save()
        print(json.dumps({'phase':'active','originalServicesUntouched':True,'pending':['Existing supervisors gain credentials at their next ordinary start; UID identity works meanwhile','First enrolled login opens custody; absent folder keys are collected on successful logins']}))
    except Exception:
        rollback(); raise
elif args.action=='rollback':
    rollback(); print(json.dumps({'phase':record['phase'],'encryptedCustodyPreserved':True,'originalServicesUntouched':True}))
else: print(json.dumps({'phase':record['phase'],'newUnits':record['newUnits'],'failures':record.get('failures',[])}))
