#!/usr/bin/python3
"""Additive root Kenan preparation, authorized activation and data-preserving rollback."""
import argparse
import base64
import fcntl
import json
import os
import pathlib
import pwd
import re
import secrets
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('action', choices=['prepare', 'cutover', 'rollback', 'status'])
parser.add_argument('--config', required=True)
parser.add_argument('--state', required=True)
parser.add_argument('--root')
parser.add_argument('--fixture', action='store_true')
parser.add_argument('--authorize-cutover', action='store_true')
args = parser.parse_args()
if not args.fixture and os.readlink('/proc/self/ns/mnt') != os.readlink('/proc/1/ns/mnt'):
    raise SystemExit('One Kenan deployment requires PID 1\'s mount namespace; rerun via sudo nsenter -t 1 -m -- deploy/one-kenan with the same absolute --config and --state paths. No host changes made.')
repo = pathlib.Path(__file__).resolve().parent.parent
config_path = pathlib.Path(args.config).resolve()
config = json.loads(config_path.read_text())
state = pathlib.Path(args.state).resolve()
fixture = pathlib.Path(args.root).resolve() if args.fixture and args.root else None
if args.fixture != bool(fixture): parser.error('--fixture requires --root; --root is fixture-only')
if not fixture and args.action in ('cutover', 'rollback') and (os.geteuid() != 0 or not args.authorize_cutover):
    raise SystemExit('Host mutation requires root and --authorize-cutover after Hara says go')
def target(path): return fixture / path.lstrip('/') if fixture else pathlib.Path(path)
host = pathlib.Path(config.get('hostFile', '/etc/pi-stack/host.json')).resolve()
persons_dir = pathlib.Path(config.get('personsDir', '/var/lib/pi-remote/persons')).resolve()
shared = target('/var/lib/pi-kenan')
consent_capability=pathlib.Path(config.get('rootConsentCapabilityFile',str(shared/'root-consent-capability'))).resolve()
if not consent_capability.is_relative_to(shared): raise SystemExit('rootConsentCapabilityFile must stay in root-owned /var/lib/pi-kenan custody')
router_port=config.get('routerPort',8788)
if not isinstance(router_port,int) or isinstance(router_port,bool) or not 1023<router_port<=65535: raise SystemExit('Invalid routerPort')
root_runtime=config.get('rootRuntime',config.get('remoteRoot','/srv/pi/pi-remote')+'/kenan-root')
memory_runtime=config.get('memoryRuntime','/srv/pi/runtime/node_modules/kenan-memory')
rooms_home = target('/var/lib/pi-rooms')
if fixture:
    for path in (state, config_path, host, persons_dir):
        if not path.is_relative_to(fixture): raise SystemExit(f'Fixture path escaped staging root: {path}')
if config.get('version') != 1: raise SystemExit('Expected version 1 root-Kenan configuration')
if any(name in config for name in ('ports', 'orchestratorPorts', 'oldOrchestratorPorts', 'extraUnits', 'unitTemplates')):
    raise SystemExit('Per-person side supervisors and execution-identity switching are not part of root Kenan')
people = [json.loads(path.read_text()) for path in sorted(persons_dir.glob('*.json'))]
if not people: raise SystemExit('No registered people')
execution, room_user = config.get('executionUser', 'pi-kenan'), config.get('roomsUser', 'pi-rooms')
operator = config.get('brokerUser', json.loads(host.read_text()).get('fleetUser'))
for user in (execution, room_user, operator, *[person['user'] for person in people]):
    if not isinstance(user, str) or not re.fullmatch('[a-z_][a-z0-9_-]*', user): raise SystemExit('Invalid service/person user')
if len({execution, room_user, operator}) != 3 or execution in [p['user'] for p in people] or room_user in [p['user'] for p in people]:
    raise SystemExit('Root and room service accounts must be distinct from each other and from people')
ports = {name: config.get(name, default) for name, default in [('memoryPort',18820),('rootPort',18821),('roomsPort',18822),('rootBrokerPort',2480),('roomsBrokerPort',2481)]}
if any(not isinstance(port,int) or isinstance(port,bool) or not 1023 < port <= 65535 for port in ports.values()) or len(set(ports.values())) != len(ports):
    raise SystemExit('New ports must be distinct unprivileged TCP ports')
if set(ports.values()) & {p['port'] for p in people}: raise SystemExit('New listener collides with a person supervisor')
if router_port in ports.values(): raise SystemExit('New listener collides with existing router')
if fixture and set(ports.values()) & (set(range(18790,18800)) | set(range(2461,2475))): raise SystemExit('Fixture ports overlap live listeners')
root_config = config.get('root', {})
if any(not root_config.get(name) for name in ('provider','model','thinkingLevel','promptFile')): raise SystemExit('root requires fixed provider/model/thinkingLevel/promptFile')
if not pathlib.Path(root_config['promptFile']).is_absolute(): raise SystemExit('Root promptFile must be absolute')
broker_source = pathlib.Path(config.get('brokerSource', '/etc/pi-model-broker.json')).resolve()
if fixture and not broker_source.is_relative_to(fixture): raise SystemExit('Fixture brokerSource escaped root')
broker = json.loads(broker_source.read_text())
if not broker.get('listeners') or not all(pathlib.Path(broker[name]).is_absolute() for name in ('ledgerPath','authPath')): raise SystemExit('Invalid source broker config')
if fixture and any(not pathlib.Path(broker[name]).resolve().is_relative_to(fixture) for name in ('ledgerPath','authPath')): raise SystemExit('Fixture broker paths escaped root')
if fixture and not pathlib.Path(root_config['promptFile']).resolve().is_relative_to(fixture): raise SystemExit('Fixture root prompt escaped root')
existing_ports = {entry['port'] for entry in broker['listeners']}
if existing_ports & set(ports.values()): raise SystemExit('New listener collides with existing model broker')
accounts = config.get('brokerAccounts', sorted({account for entry in broker['listeners'] for account in entry['accounts']}))
models = config.get('brokerModels', sorted({model for entry in broker['listeners'] for model in entry['models']}))
if not accounts or not models or any(not isinstance(item,str) or not item for item in [*accounts,*models]): raise SystemExit('Explicit model/account grants are required')
if f'{root_config["provider"]}/{root_config["model"]}' not in models: raise SystemExit('Fixed root model is absent from broker grants')
if not fixture:
    protected=[config_path,broker_source]
    if pathlib.Path(root_config['promptFile']).exists(): protected.append(pathlib.Path(root_config['promptFile']))
    for path in protected:
        if path.stat().st_uid != 0 or path.stat().st_mode & 0o022: raise SystemExit(f'Privileged configuration must be root-owned and not group/world writable: {path}')
state.mkdir(parents=True, exist_ok=True, mode=0o700)
os.chmod(state,0o700)
lock = open(state/'lock','a'); fcntl.flock(lock,fcntl.LOCK_EX)
record_file = state/'transaction.json'
record = json.loads(record_file.read_text()) if record_file.exists() else {'phase':'new','files':{},'newUnits':[],'createdUsers':[],'aclFiles':[]}
def save():
    temporary = state/'transaction.tmp'; temporary.write_text(json.dumps(record,indent=2)+'\n'); temporary.chmod(0o600)
    with temporary.open('rb') as stream: os.fsync(stream.fileno())
    os.replace(temporary,record_file)
    fd = os.open(state,os.O_RDONLY)
    try: os.fsync(fd)
    finally: os.close(fd)
def run(command,**kwargs): return subprocess.run(command,check=True,text=True,timeout=30,**kwargs)
def ctl(*arguments): return run(['systemctl',*arguments],capture_output=True).stdout.strip()
def snapshot(path,allow_symlink=False):
    path = pathlib.Path(path); key = str(path)
    if key in record['files']: return
    if path.is_symlink():
        if not allow_symlink: raise RuntimeError(f'Refusing to replace symlink: {path}')
        info=path.lstat(); record['files'][key]={'link':os.readlink(path),'uid':info.st_uid,'gid':info.st_gid}; save(); return
    if path.exists():
        info=path.stat(); record['files'][key]={'data':base64.b64encode(path.read_bytes()).decode(),'mode':info.st_mode&0o7777,'uid':info.st_uid,'gid':info.st_gid}
    else: record['files'][key]=None
    save()
def replace(path,contents,mode=0o644):
    path=pathlib.Path(path); snapshot(path); path.parent.mkdir(parents=True,exist_ok=True)
    temporary=path.with_name(path.name+'.one-kenan-tmp'); temporary.write_bytes(contents if isinstance(contents,bytes) else contents.encode()); temporary.chmod(mode); os.replace(temporary,path)
def fresh(path,contents,mode=0o644):
    if pathlib.Path(path).exists(): raise RuntimeError(f'Additive path already exists: {path}')
    replace(path,contents,mode)
def user_identity(name,home):
    if fixture: return (config.get('fixtureUids',{}).get(name,os.getuid()),os.getgid())
    try: pwd.getpwnam(name)
    except KeyError: pass
    else: raise RuntimeError(f'{name} already exists; use its owning transaction')
    record['createdUsers'].append(name); save()
    run(['useradd','--system','--user-group','--home-dir',str(home),'--no-create-home','--shell','/usr/sbin/nologin',name])
    entry=pwd.getpwnam(name); return (entry.pw_uid,entry.pw_gid)
def person_uid(person):
    return person.get('fixtureUid',os.getuid()) if fixture else pwd.getpwnam(person['user']).pw_uid

def acl_path(block):
    name=next(line[8:] for line in block.splitlines() if line.startswith('# file: '))
    return re.sub(r'\\([0-7]{3})',lambda match: chr(int(match[1],8)),name)
def grant_spaces(uid):
    spaces=[*config.get('spaces',[]),
        {'path':str(target('/var/lib/pi-remote/one-kenan')),'owner':'root','recursive':True,'access':'r-X','defaultAccess':'r-x'},
        {'path':str(rooms_home),'owner':room_user,'recursive':True,'access':'r-X','defaultAccess':'r-x'}]
    for person in people:
        if person.get('unlock'):
            spaces += [{'path':person['unlock'][key],'owner':person['user'],'ownerUid':person_uid(person),'recursive':key=='cipherDir','access':'rwX','ownerAccess':key=='cipherDir'} for key in ('cipherDir','mountpoint')]
    blocks,access={},{}
    for space in spaces:
        path=pathlib.Path(space['path']).resolve()
        if fixture and not path.is_relative_to(fixture): raise RuntimeError('Fixture ACL path escaped root')
        if not path.exists(): raise RuntimeError(f'Required space does not exist: {path}')
        source=run(['getfacl','-p','-n',*(['-R'] if space.get('recursive') else []),'--',str(path)],capture_output=True).stdout
        for block in source.strip().split('\n\n'):
            name=acl_path(block)
            if pathlib.Path(name).is_symlink(): continue
            owner_uid=space.get('ownerUid',os.getuid() if fixture else pwd.getpwnam(space['owner']).pw_uid)
            blocks.setdefault(name,block); access[name]=(space.get('access','rwX'),owner_uid,space.get('recursive',False),space.get('defaultAccess','rwx'),space.get('ownerAccess',False) and pathlib.Path(name)==path)
        for parent in path.parents:
            if parent == pathlib.Path('/') or (fixture and not parent.is_relative_to(fixture)): break
            name=str(parent)
            if name not in blocks: blocks[name]=run(['getfacl','-p','-n','--',name],capture_output=True).stdout.strip()
            access.setdefault(name,('--x',None,False,'rwx',False))
    backup=state/'acls.txt'; backup.write_text('\n\n'.join(blocks.values())+'\n'); backup.chmod(0o600)
    record['aclFiles'].append(str(backup)); save()
    modified=[]
    for name,block in blocks.items():
        rights,owner_uid,defaults,default_rights,owner_access=access[name]; isdir=pathlib.Path(name).is_dir()
        rights=rights.replace('X','x' if isdir or pathlib.Path(name).stat().st_mode&0o111 else '-')
        lines=block.splitlines()
        # Widening a mask must not reactivate another person's masked-out grants.
        for prefix in ('','default:'):
            mask=next((line.split(':')[-1].split()[0] for line in lines if line.startswith(prefix+'mask:')),'rwx')
            adjusted=[]
            for line in lines:
                clean=line.split('\t')[0].split(' #')[0]; parts=clean.removeprefix(prefix).split(':') if clean.startswith(prefix) else []
                if len(parts)==3 and (parts[0]=='group' or (parts[0]=='user' and parts[1])):
                    clean=prefix+':'.join([parts[0],parts[1],''.join(char if char in mask else '-' for char in parts[2])])
                adjusted.append(clean)
            lines=adjusted
        lines=[line for line in lines if not line.startswith((f'user:{uid}:','mask::'))]+[f'user:{uid}:{rights}','mask::rwx']
        if owner_access:
            lines=[line for line in lines if not line.startswith(f'user:{owner_uid}:')]+[f'user:{owner_uid}:rwx']
        if isdir and defaults:
            if not any(line.startswith('default:') for line in lines): lines+=['default:user::rwx','default:group::---','default:other::---']
            lines=[line for line in lines if not line.startswith((f'default:user:{uid}:',f'default:user:{owner_uid}:','default:mask::'))]
            lines += [f'default:user:{uid}:{default_rights}',f'default:user:{owner_uid}:rwx','default:mask::rwx']
        modified.append('\n'.join(lines))
    if modified: run(['setfacl','--restore=-'],input='\n\n'.join(modified)+'\n',capture_output=True)

unit_names=['pi-kenan-access.service','pi-kenan-broker.service','pi-kenan-custody.service','pi-kenan-memory.service','pi-kenan-root.service','pi-rooms.service','pi-kenan-journal.service','pi-kenan-journal.timer']
active_units=[name for name in unit_names if name!='pi-kenan-journal.service']
def rendered_units():
    substitutions={'@EXECUTION_USER@':execution,'@ROOMS_USER@':room_user,'@BROKER_USER@':operator,'@KENAN_ENV_FILE@':str(target('/etc/pi-stack/one-kenan.env')),
      '@HOST_FILE@':str(host),'@BUN@':config.get('bun','/usr/local/bin/bun'),'@NODE@':config.get('node','/usr/local/bin/node'),
      '@REMOTE_ROOT@':config.get('remoteRoot','/srv/pi/pi-remote'),'@ROOT_RUNTIME@':root_runtime,
      '@ORCHESTRATOR_ROOT@':config.get('orchestratorRoot','/srv/pi/pi-orchestrator'),'@STACK_ROOT@':config.get('stackRoot',str(repo)),
      '@PUBLISHER_TOKEN_FILE@':str(shared/'publisher-token'),'@KENAN_PRIVATE_DIR@':str(shared/'private'),
      '@KENAN_MEMORY_SOURCE@':memory_runtime,
      '@ROOT_CONSENT_CAPABILITY_FILE@':str(consent_capability),'@ROOT_ROUTER_URL@':f'http://127.0.0.1:{router_port}',
      '@STATE_DIR@':str(shared),'@ROOMS_HOME@':str(rooms_home),
      '@PERSONS_DIR@':str(persons_dir),'@BROKER_CONFIG@':str(target('/etc/pi-stack/one-kenan-broker.json')),
      '@ROOMS_ENV_FILE@':str(target('/etc/pi-stack/rooms.env')),'@ROOMS_CONFIG@':str(target('/etc/pi-stack/rooms.json')),
      '@ORCHESTRATOR_CONFIG@':config.get('orchestratorConfig','/var/lib/pi-orchestrator/config.json'),
      '@RUNTIME_LAUNCHER@':str(target('/usr/local/libexec/pi-kenan-runtime')),
      '@ACCESS_CONFIG@':str(target('/etc/pi-stack/one-kenan-access.json')),'@ACCESS_COMMAND@':str(target('/usr/local/sbin/pi-kenan-access'))}
    units={}
    for name in unit_names:
        source=(repo/'deploy/systemd'/name).read_text()
        if name=='pi-kenan-memory.service':
            source=source.replace('[Service]','[Service]\nEnvironmentFile=@KENAN_ENV_FILE@').replace('Requires=pi-kenan-custody.service','Requires=pi-kenan-custody.service pi-kenan-access.service').replace('User=pi-kenan',f'User={execution}').replace('Group=pi-kenan',f'Group={execution}')
        if name=='pi-kenan-memory.service': source=source.replace('/var/lib/pi-kenan',str(shared)).replace('/srv/pi/kenan-memory',memory_runtime)
        for before,after in substitutions.items(): source=source.replace(before,after)
        source=source.replace('/etc/pi-stack/host.json',str(host)).replace('/etc/pi-stack/kenan-memory-auth.json',str(target('/etc/pi-stack/kenan-memory-auth.json'))) 
        if re.search(r'@[A-Z_]+@',source): raise RuntimeError(f'Unrendered unit: {name}')
        units[name]=source
    return units

def install_mail_routes():
    tool=pathlib.Path(config.get('toolsRoot','/srv/pi/tools'))/'mail-send/main'
    if not tool.is_absolute(): raise RuntimeError('toolsRoot must be absolute')
    routes={target('/home/kenan/tools/mail-send/main')}
    for user in {operator,*[person['user'] for person in people]}:
        home=target('/home/'+user) if fixture else pathlib.Path(pwd.getpwnam(user).pw_dir)
        routes.add(home/'.local/bin/mail-send')
        main=home/'tools/mail-send/main'
        if main.exists() or main.is_symlink(): routes.add(main)
    for route in config.get('mailSendRoutes',[]):
        if not pathlib.Path(route).is_absolute(): raise RuntimeError('mailSendRoutes must be absolute')
        routes.add(target(route))
    for path in sorted(routes):
        snapshot(path,allow_symlink=True); path.parent.mkdir(parents=True,exist_ok=True)
        temporary=path.with_name(path.name+'.one-kenan-tmp'); temporary.symlink_to(tool); os.replace(temporary,path)
        previous=record['files'][str(path)]
        if not fixture and previous: os.lchown(path,previous['uid'],previous['gid'])

def install_fuse_apparmor():
    profile=target('/etc/apparmor.d/fusermount3')
    if not profile.exists(): return
    local=target('/etc/apparmor.d/local/fusermount3')
    previous=local.read_bytes() if local.exists() else b''
    mountpoint=str(shared/'private')+'/'
    rules=f'\n# One Kenan shared custody mount\nmount fstype=@{{fuse_types}} options=(nosuid,nodev) options in (ro,rw,noatime,dirsync,nodiratime,noexec,sync) -> "{mountpoint}",\numount "{mountpoint}",\n'
    replace(local,previous+rules.encode())
    run(['apparmor_parser','-r',str(profile)],capture_output=True)

def install():
    root_uid,root_gid=user_identity(execution,shared); room_uid,room_gid=user_identity(room_user,rooms_home)
    record['rootUid']=root_uid; record['roomUid']=room_uid; save()
    for directory,uid,gid,mode in [(shared,0,0,0o711),(shared/'custody',0,0,0o700),(shared/'supervisor-capabilities',0,0,0o700),
      (shared/'.private.crypt',root_uid,root_gid,0o700),(shared/'private',root_uid,root_gid,0o700),(shared/'home',root_uid,root_gid,0o700),
      (shared/'bun',root_uid,root_gid,0o700),(shared/'bun/install',root_uid,root_gid,0o700),(shared/'bun/install/cache',root_uid,root_gid,0o700),
      (shared/'bin',0,0,0o755),(rooms_home,room_uid,room_gid,0o700)]:
        directory.mkdir(parents=True,exist_ok=True,mode=mode); directory.chmod(mode)
        if not fixture: os.chown(directory,uid,gid)
    if not fixture:
        run(['python3', str(repo/'apps/remote/server/pi-timezone-provision'), *[argument for user in [*[p['user'] for p in people], room_user] for argument in ('--user', user)]], capture_output=True)
    memory={'supervisors':[],'uidPersons':{}}
    for person in people:
        token=secrets.token_urlsafe(32); cap=shared/'supervisor-capabilities'/person['user']; fresh(cap,token+'\n',0o600)
        memory['supervisors'].append({'person':person['user'],'displayName':person['displayName'],'token':token,'timezoneFile':str(target('/var/lib/pi-timezones')/person['user']/'timezone.json')}); memory['uidPersons'][str(person_uid(person))]=person['user']
        fresh(target(f'/etc/systemd/system/pi-remote@{person["user"]}.service.d/one-kenan.conf'),
          f'[Service]\nLoadCredential=kenan-memory-supervisor:{cap}\nEnvironment=PI_KENAN_MEMORY_URL=http://127.0.0.1:{ports["memoryPort"]}\nEnvironment=PI_KENAN_ROOT_URL=http://127.0.0.1:{ports["rootPort"]}\n')
    room_token=secrets.token_urlsafe(32); fresh(shared/'supervisor-capabilities/pi-rooms',room_token+'\n',0o600)
    memory['supervisors'].append({'person':'pi-rooms','token':room_token,'timezoneFile':str(target('/var/lib/pi-timezones')/room_user/'timezone.json')}); memory['uidPersons'][str(room_uid)]='pi-rooms'
    for field,name in [('publisherToken','publisher-token'),('rootToken','root-memory-token')]:
        memory[field]=secrets.token_urlsafe(32); fresh(shared/name,memory[field]+'\n',0o600)
    fresh(shared/'root-admin-capability',secrets.token_hex(32)+'\n',0o600)
    fresh(consent_capability,secrets.token_hex(32)+'\n',0o600)
    fresh(target('/etc/pi-stack/kenan-memory-auth.json'),json.dumps(memory)+'\n',0o600)
    one={**config,**ports,'executionUser':execution,'roomsUser':room_user,'custodySocket':str(target('/run/pi-kenan/custody.sock')),
         'rootAdminCapabilityFile':str(shared/'root-admin-capability'),'rootConsentCapabilityFile':str(consent_capability),
         'routerPort':router_port,'brokerUser':operator,'memoryTimezoneGroup':'pi-timezones-readers'}
    fresh(target('/etc/pi-stack/one-kenan.json'),json.dumps(one,indent=2)+'\n')
    root={**root_config,'version':1,'cwd':str(shared/'private'),'agentDir':str(shared/'private/.pi/agent'),
          'sessionsDir':str(shared/'private/root-sessions'),'brokerUrl':f'http://127.0.0.1:{ports["rootBrokerPort"]}',
          'people':[{'person':person['user'],'displayName':person['displayName']} for person in people]}
    fresh(target('/etc/pi-stack/kenan-root.json'),json.dumps(root,indent=2)+'\n')
    prompt=pathlib.Path(root['promptFile'])
    if not prompt.exists():
        source=pathlib.Path(config.get('rootPromptSource',root_runtime+'/instructions.md'))
        if fixture and not source.resolve().is_relative_to(fixture): raise RuntimeError('Fixture root prompt source escaped root')
        fresh(prompt,source.read_bytes())
    additive_broker={**broker,'grantOwner':'one-kenan','listeners':[{'principal':user,'port':port,'accounts':accounts,'models':models,'maxInFlight':config.get('brokerMaxInFlight',20)}
        for user,port in [(execution,ports['rootBrokerPort']),(room_user,ports['roomsBrokerPort'])]]}
    fresh(target('/etc/pi-stack/one-kenan-broker.json'),json.dumps(additive_broker,indent=2)+'\n')
    env=f'PI_STACK_HOST_FILE={host}\nPI_STACK_HOST_CONFIG={host}\nPI_KENAN_CONFIG={target("/etc/pi-stack/one-kenan.json")}\nPI_REMOTE_PERSONS_DIR={persons_dir}\nPI_KENAN_KEY_STORE={shared}/custody/keys.json\nPI_KENAN_PRIVATE_DIR={shared}/private\nPI_KENAN_SHARED_CIPHER={shared}/.private.crypt\nPI_KENAN_MEMORY_STORE={shared}/private/memory/memory.sqlite3\nPI_KENAN_MEMORY_PORT={ports["memoryPort"]}\nPI_KENAN_MEMORY_URL=http://127.0.0.1:{ports["memoryPort"]}\nPI_KENAN_ROOT_PORT={ports["rootPort"]}\nPI_KENAN_ROOT_URL=http://127.0.0.1:{ports["rootPort"]}\nPI_KENAN_ROOT_CONFIG={target("/etc/pi-stack/kenan-root.json")}\nPI_KENAN_ACTION_JOURNAL_DIR={shared}/private/action-journal\nPI_KENAN_ROOM_AUDIENCE_MODULE={config.get("remoteRoot","/srv/pi/pi-remote")}/server/room-audience.mjs\nPI_REMOTE_ROOMS_DB={target("/var/lib/pi-remote/one-kenan/rooms.sqlite3")}\n'
    fresh(target('/etc/pi-stack/one-kenan.env'),env)
    room_environment={'PI_REMOTE_HOST':'127.0.0.1','PI_REMOTE_PORT':ports['roomsPort'],'PI_REMOTE_DATA':str(rooms_home),
      'PI_PERSON_TIMEZONE_FILE':str(target('/var/lib/pi-timezones')/room_user/'timezone.json'),
      'PI_AGENT_DIR':str(rooms_home/'agent'),'PI_MODEL_BROKER_URL':f'http://127.0.0.1:{ports["roomsBrokerPort"]}',
      'PI_KENAN_ROOT_URL':f'http://127.0.0.1:{ports["rootPort"]}','PI_KENAN_MEMORY_URL':f'http://127.0.0.1:{ports["memoryPort"]}',
      'PI_STACK_HOST_CONFIG':str(host),**config.get('roomsEnvironment',{})}
    fresh(target('/etc/pi-stack/rooms.json'),json.dumps({'version':1,'user':room_user,'displayName':'Kenan rooms','environment':room_environment},indent=2)+'\n')
    fresh(target('/etc/pi-stack/rooms.env'),'\n'.join(f'{key}={value}' for key,value in room_environment.items())+'\n')
    (rooms_home/'agent').mkdir(exist_ok=True,mode=0o700)
    if not fixture: os.chown(rooms_home/'agent',room_uid,room_gid)
