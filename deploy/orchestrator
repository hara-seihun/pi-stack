#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
dest=${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}
runtime=${PI_STACK_RUNTIME_DEST:-/srv/pi/runtime}
commit=$(git -C "$root" rev-parse HEAD)

# Every account that runs orchestrator commands reaches the CLI through
# ~/.local/bin/pi-orchestrator, so the links are reconciled on every run,
# including the already-deployed fast path.
reconcile_cli_links() {
  local user home owner group link
  while IFS= read -r user; do
    home=$(pi_stack_home "$user")
    [[ -n $home && -d $home ]] || continue
    owner=$(stat -c %U "$home"); group=$(stat -c %G "$home")
    link=$home/.local/bin/pi-orchestrator
    pi_stack_as_root install -d -m 755 -o "$owner" -g "$group" "$home/.local" "$home/.local/bin"
    pi_stack_as_root ln -sfn "$dest/dist/cli.js" "$link"
    pi_stack_as_root chown -h "$owner:$group" "$link"
  done < <(pi_stack_users)
}

# The fleet user's operator config names the lane manifest. A release whose
# daemon cannot parse the live manifest must not be selected.
validate_manifest() {
  local fleet home config manifest
  fleet=$(pi_stack_fleet_user)
  [[ -n $fleet ]] || return 0
  home=$(pi_stack_home "$fleet")
  config=${PI_ORCHESTRATOR_CONFIG:-$home/.config/pi-orchestrator/config.json}
  [[ -f $config ]] || return 0
  manifest=$(pi_stack_as_root jq -r '.taskManifest // empty' "$config")
  [[ -n $manifest ]] || return 0
  pi_stack_as_root test -f "$manifest" || { echo "orchestrator lane manifest does not exist: $manifest" >&2; return 1; }
  pi_stack_as_root cat "$manifest" | node - <<'NODE'
const chunks=[];process.stdin.on("data",(c)=>chunks.push(c)).on("end",()=>{
const manifest = JSON.parse(Buffer.concat(chunks).toString("utf8"));
if (manifest.version !== 2 || !Array.isArray(manifest.lanes)) throw new Error("lane manifest version 2 required");
for (const lane of manifest.lanes) {
  for (const key of ["id", "cwd", "profile"]) if (typeof lane[key] !== "string" || !lane[key]) throw new Error(`lane ${key} is required`);
  if ((typeof lane.prompt !== "string" || !lane.prompt) && (typeof lane.promptFile !== "string" || !lane.promptFile)) throw new Error(`lane ${lane.id} needs prompt or promptFile`);
  if (!(Number(lane.weight) > 0)) throw new Error(`lane ${lane.id} needs a positive weight`);
}});
NODE
}

if [[ -f $dest/.pi-stack-commit && $(<"$dest/.pi-stack-commit") == "$commit" && -x $dest/dist/cli.js ]]; then
  validate_manifest
  "$dest/dist/cli.js" help | grep -q '^usage: pi-orchestrator'
  reconcile_cli_links
  printf 'Pi Orchestrator from %s is already deployed\n' "$commit"
  exit 0
fi
stage=$(mktemp -d "${TMPDIR:-/tmp}/pi-orchestrator.XXXXXXXX")
trap 'rm -rf "$stage"' EXIT

cd "$root"
pi_stack_prepare_dependencies "$root"
[[ -f $runtime/.pi-stack-commit && $(<"$runtime/.pi-stack-commit") == "$commit" ]] || {
  echo "deploy Pi Runtime $commit before Pi Orchestrator" >&2
  exit 66
}
dependencies=$(readlink -f "$runtime/node_modules")
[[ -d $dependencies ]] || { echo "Pi Runtime dependencies are missing at $dependencies" >&2; exit 66; }
rm -rf packages/orchestrator/dist
npm run build --workspace=pi-orchestrator

mkdir -p "$stage/release"
rsync -a --chmod=D755,Fu=rwX,Fgo=rX packages/orchestrator/dist packages/orchestrator/src \
  packages/orchestrator/package.json "$stage/release/"
chmod 755 "$stage/release/dist/cli.js"
ln -s "$dependencies" "$stage/release/node_modules"
printf '%s\n' "$commit" > "$stage/release/.pi-stack-commit"
validate_manifest
pi_stack_publish_release "$root" "$stage/release" "$dest" orchestrator

"$dest/dist/cli.js" help | grep -q '^usage: pi-orchestrator'
reconcile_cli_links
printf 'deployed Pi Orchestrator from %s to %s\n' "$commit" "$dest"
