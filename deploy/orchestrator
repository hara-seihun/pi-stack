#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
source "$root/deploy/lib"
pi_stack_enter_deployment "$0" "$root" "$@"
dest=${PI_STACK_ORCHESTRATOR_DEST:-/srv/pi/pi-orchestrator}
runtime=${PI_STACK_RUNTIME_DEST:-/srv/pi/runtime}
commit=$(git -C "$root" rev-parse HEAD)
action=${1:---build}
case $action in
  --build|--links-only|--install-core) [[ $# -le 1 ]] || exit 64;;
  *) echo 'usage: deploy/orchestrator [--links-only|--install-core]' >&2; exit 64;;
esac

reconcile_cli_links() {
  local user home owner group
  while IFS= read -r user; do
    home=$(pi_stack_home "$user")
    [[ -n $home && -d $home ]] || continue
    owner=$(stat -c %U "$home"); group=$(stat -c %G "$home")
    pi_stack_as_root install -d -m 755 -o "$owner" -g "$group" "$home/.local" "$home/.local/bin"
    for pair in 'pi-orchestrator:cli.js' 'pi-agent-capacity:agent-capacity-cli.js'; do
      pi_stack_as_root ln -sfn "$dest/dist/${pair#*:}" "$home/.local/bin/${pair%%:*}"
      pi_stack_as_root chown -h "$owner:$group" "$home/.local/bin/${pair%%:*}"
    done
  done < <(pi_stack_users)
}
check_artifact() {
  test -f "$dest/dist/core/main.js" && test -f "$dest/dist/core/config.js" &&
    test -f "$dest/host/core-host.mjs" && test -x "$dest/host/core-runtime" && test -f "$dest/dist/cli.js" &&
    test -f "$dest/dist/agent-capacity-cli.js" || {
      echo "Shared core artifact is incomplete: $dest" >&2; return 66;
    }
}
if [[ $action != --build ]]; then
  pi_stack_require_release "$dest" "$commit"
  check_artifact
  if [[ $action == --install-core ]]; then
    pi_stack_as_root bun "$dest/host/core-host.mjs" install "$dest" "${PI_STACK_CORE_CONFIG:-/etc/pi-stack/core.json}"
  else
    reconcile_cli_links
  fi
  exit 0
fi
if [[ -f $dest/.pi-stack-commit && $(<"$dest/.pi-stack-commit") == "$commit" ]]; then
  check_artifact
  [[ ${PI_STACK_PREPARE_ONLY:-0} == 1 ]] || reconcile_cli_links
  printf 'Pi Stack core from %s is already deployed\n' "$commit"
  exit 0
fi
stage=$(mktemp -d "${TMPDIR:-/tmp}/pi-stack-core.XXXXXXXX")
trap 'rm -rf "$stage"' EXIT
cd "$root"
pi_stack_prepare_dependencies "$root"
pi_stack_require_release "$runtime" "$commit"
dependencies=$(readlink -f "$runtime/node_modules")
[[ -d $dependencies ]] || { echo "Pi Runtime dependencies are missing: $dependencies" >&2; exit 66; }
node "$root/scripts/build-workspace.mjs" orchestrator
mkdir -p "$stage/release/host"
rsync -a --chmod=D755,Fu=rwX,Fgo=rX packages/orchestrator/dist packages/orchestrator/src packages/orchestrator/package.json "$stage/release/"
install -m644 deploy/core-host.mjs deploy/core-broker-handoff.mjs deploy/core_namespace.py deploy/core-capability-epoch.py deploy/systemd/pi-stack-core.service deploy/systemd/pi-stack-core-custody.service "$stage/release/host/"
install -m755 deploy/core-runtime deploy/core-custody deploy/core-adopt deploy/core-person-activate deploy/core-plan deploy/core-native-census deploy/core-native-retire deploy/core-drain deploy/core-root-census deploy/core-remote-witness deploy/core-meet-drain deploy/core-provider-adopt deploy/core-adopt-batch deploy/core-bindings deploy/core-assemble deploy/core-aux-plan deploy/core-aux-run deploy/core-auxiliary-receipts deploy/core-image-handoff "$stage/release/host/"
bun build deploy/core-auxiliary.ts --target=bun --outfile="$stage/release/host/core-auxiliary.js"
chmod 755 "$stage/release/dist/cli.js" "$stage/release/dist/agent-capacity-cli.js"
ln -s "$dependencies" "$stage/release/node_modules"
printf '%s\n' "$commit" > "$stage/release/.pi-stack-commit"
pi_stack_publish_release "$root" "$stage/release" "$dest" orchestrator
check_artifact
[[ ${PI_STACK_PREPARE_ONLY:-0} == 1 ]] || reconcile_cli_links
printf 'deployed Pi Stack core from %s to %s\n' "$commit" "$dest"
