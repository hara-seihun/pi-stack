#!/usr/bin/python3 -B
"""Enter the one prepared core namespace once; never create or unlock storage."""
import json
import os
from pathlib import Path
import sys
sys.dont_write_bytecode = True
from core_namespace import namespace_path, trusted

PLAN = Path('/etc/pi-stack/core-runtime.json')


def prepared_namespace():
    if os.geteuid() != 0:
        raise PermissionError('root core resource owner required')
    plan = trusted(PLAN)
    if plan.get('version') != 1 or plan.get('uid') != 0 or plan.get('gid') != 0:
        raise ValueError('explicit shared core UID/GID required')
    namespace = plan['namespace']
    descriptor = os.open(namespace_path(namespace), os.O_RDONLY)
    if namespace['kind'] != 'host' and str(os.fstat(descriptor).st_ino) != namespace['mountNamespaceInode']:
        os.close(descriptor)
        raise ValueError('namespace changed during acquisition')
    os.set_inheritable(descriptor, True)
    return descriptor


def main():
    if len(sys.argv) != 4 or sys.argv[1] not in ('launch', 'preflight', 'proof'):
        raise ValueError('usage: core-runtime launch|preflight|proof ABSOLUTE_ARTIFACT ABSOLUTE_CONFIG')
    operation, artifact, configuration = sys.argv[1:]
    if not Path(artifact).is_absolute() or not Path(configuration).is_absolute():
        raise ValueError('absolute source and configuration required')
    descriptor = prepared_namespace()
    if operation == 'launch':
        command = ['/usr/local/bin/bun', str(Path(artifact) / 'dist/core/main.js'), 'serve', configuration]
    else:
        command = ['/usr/local/bin/bun', str(Path(artifact) / 'host/core-host.mjs'), operation, artifact, configuration]
    os.execv('/usr/bin/nsenter', ['/usr/bin/nsenter', f'--mount=/proc/self/fd/{descriptor}', '--',
                                '/usr/bin/setpriv', '--reuid=0', '--regid=0', '--clear-groups', '--', *command])


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(json.dumps({'ok': False, 'error': {'code': 'core-namespace-unavailable', 'message': str(error)}}), file=sys.stderr)
        sys.exit(75)
