[Unit]
Description=Deliver immutable Pi Stack source to one host %i
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=@PUBLICATION_COMMAND@ host-run %i
RuntimeMaxSec=10min
TimeoutStopSec=10s
KillMode=control-group
UMask=0077
Environment=PATH=@PUBLICATION_PATH@
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
