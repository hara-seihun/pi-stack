[Unit]
Description=Deliver a pending Pi Stack publication or repair report

[Service]
Type=oneshot
ExecStart=/home/kenan/machine/pi-stack-publication notices
TimeoutStartSec=50s
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
Environment=PATH=/home/kenan/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
