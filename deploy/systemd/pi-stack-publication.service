[Unit]
Description=Integrate and release durable Pi Stack publications
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/home/kenan/machine/pi-stack-publication drain
TimeoutStopSec=10s
KillMode=control-group
UMask=0077
Environment=PATH=/home/kenan/.local/bin:/run/wrappers/bin:/run/current-system/sw/bin:/usr/bin:/bin
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
