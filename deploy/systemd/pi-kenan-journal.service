[Unit]
Description=Publish Kenan's durable outbound action journal into shared memory
Requires=pi-kenan-custody.service
BindsTo=pi-kenan-custody.service
After=pi-kenan-custody.service pi-kenan-memory.service

[Service]
Type=oneshot
User=@EXECUTION_USER@
EnvironmentFile=@KENAN_ENV_FILE@
Environment=PI_KENAN_MEMORY_PUBLISHER_TOKEN_FILE=%d/kenan-memory-publisher
LoadCredential=kenan-memory-publisher:@PUBLISHER_TOKEN_FILE@
ExecCondition=/usr/bin/jq -e .oneKenan==true @HOST_FILE@
ExecStart=+@RUNTIME_LAUNCHER@ journal
TimeoutStartSec=30
UMask=0077
MemorySwapMax=0
LimitCORE=0
