[Unit]
Description=Additive scoped model broker for root Kenan and rooms
Requires=pi-kenan-access.service
After=network-online.target pi-kenan-access.service

[Service]
Type=simple
User=@BROKER_USER@
EnvironmentFile=@KENAN_ENV_FILE@
Environment=PI_ORCHESTRATOR_CONFIG=@ORCHESTRATOR_CONFIG@
ExecCondition=/usr/bin/jq -e .oneKenan==true @HOST_FILE@
ExecStart=@NODE@ @ORCHESTRATOR_ROOT@/dist/cli.js model-broker @BROKER_CONFIG@
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
