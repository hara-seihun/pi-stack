[Unit]
Description=Supervise publication progress and dispatch dedicated local repairs

[Service]
Type=oneshot
ExecStart=/home/kenan/machine/pi-stack-publication watchdog
TimeoutStartSec=45s
TimeoutStopSec=5s
KillMode=control-group
UMask=0077
Environment=PATH=/home/kenan/.local/bin:/run/wrappers/bin:/run/current-system/sw/bin:/usr/bin:/bin
