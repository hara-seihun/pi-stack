[Unit]
Description=Kenan's shared memory and disclosure log
Requires=pi-kenan-custody.service
BindsTo=pi-kenan-custody.service
After=pi-kenan-custody.service
JoinsNamespaceOf=pi-kenan-custody.service

[Service]
Type=simple
User=pi-kenan
Group=pi-kenan
PrivateMounts=yes
UMask=0077
WorkingDirectory=/srv/pi/kenan-memory
Environment=PI_STACK_HOST_CONFIG=/etc/pi-stack/host.json
Environment=PI_KENAN_MEMORY_AUTH_FILE=%d/kenan-memory-auth
Environment=PI_KENAN_PRIVATE_DIR=/var/lib/pi-kenan/private
LoadCredential=kenan-memory-auth:/etc/pi-stack/kenan-memory-auth.json
ExecCondition=/usr/local/bin/bun -e "import { oneKenanEnabled } from '/srv/pi/kenan-memory/src/config.ts'; process.exit(oneKenanEnabled() ? 0 : 1)"
ExecStart=/usr/local/bin/bun /srv/pi/kenan-memory/src/main.ts
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
