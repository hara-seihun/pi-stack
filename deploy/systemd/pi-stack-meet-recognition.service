[Unit]
Description=Pi Stack external meeting CPU speech recognition
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/pi/meet-recognition/server.py

[Service]
Type=simple
User=kenan
Group=users
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/pi/meet-recognition/venv/bin/python /srv/pi/meet-recognition/server.py --model /srv/pi/meet-recognition/model --host 127.0.0.1 --port 8797 --threads 4 --streams 4
Restart=on-failure
RestartSec=1
TimeoutStartSec=30
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
