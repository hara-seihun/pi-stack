[Unit]
Description=Dedicated local Pi repair for publication %i
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/home/kenan/machine/pi-stack-publication repair-run %i
RuntimeMaxSec=22min
TimeoutStopSec=10s
KillMode=control-group
Restart=no
UMask=0077
Environment=PATH=/home/kenan/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
Environment=PI_SKIP_VERSION_CHECK=1
