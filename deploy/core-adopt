def reconcile_capability(plan):
    if plan.get('version') != 1 or plan.get('priorCapability') != 'absent-after-drain':
        raise ValueError('exact missing-key reservation required')
    path = absolute(plan['receiptPath']); prior = trusted(path)
    digest = hashlib.sha256(json.dumps(plan, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    if prior.get('protocol') != 'pi-core-initialized-capability-v1' or prior.get('state') != 'preparing' or prior.get('planSha256') != digest or prior.get('keyPath') != plan['keyPath']:
        raise ValueError('only this exact preparing key reservation may be reconciled')
    source = absolute(plan['sourceProof']['path'])
    if hashlib.sha256(source.read_bytes()).hexdigest() != plan['sourceProof']['sha256']:
        raise ValueError('original capability retirement proof changed')
    import runpy
    runpy.run_path(str(Path(__file__).with_name('core-capability-epoch.py')))['validate'](trusted(source), plan)
    rejection = json.loads(enter(plan['namespace'], ['python3','-c',KEY_ANCESTOR_REJECTION,json.dumps(plan)],plan['uid'],plan['gid']))
    receipt = {**prior,'state':'failed-before-effect','reconciliation':{'kind':'affirmative-ancestor-rejection','priorReservation':prior,'rejection':rejection}}
    publish(path,receipt)
    return {'ok':True,'state':'failed-before-effect','receiptPath':str(path)}


def initialize_capability(plan):
    prior_kind = plan.get('priorCapability')
    if plan.get('version') != 1 or prior_kind not in ('none', 'absent-after-drain') or not isinstance(plan.get('scopeId'), str) or not plan['scopeId']:
        raise ValueError('explicit proved capability initialization epoch required')
    expected = 'owner-source-no-capability' if prior_kind == 'none' else 'detached-capability-epoch'
    if plan.get('sourceProof', {}).get('kind') != expected:
        raise ValueError('capability epoch requires its exact owning proof variant')
    source = absolute(plan['sourceProof']['path'])
    if hashlib.sha256(source.read_bytes()).hexdigest() != plan['sourceProof']['sha256']:
        raise ValueError('capability source proof changed')
    if type(plan.get('uid')) is not int or type(plan.get('gid')) is not int or min(plan['uid'], plan['gid']) < 0:
        raise ValueError('exact original scope UID/GID required')
    namespace_path(plan['namespace'])
    key, database = (absolute(plan[field]) for field in ('keyPath', 'databasePath'))
    receipt_path = absolute(plan['receiptPath'])
    extra = []
    if prior_kind == 'none':
        mount = absolute(plan['encryptedMountpoint'])
        if plan['namespace'].get('kind') != 'pinned' or key.parent != database.parent or not key.is_relative_to(mount) or receipt_path.is_relative_to(mount):
            raise ValueError('new root key must live beside its existing encrypted scope DB; receipt belongs to host custody')
        mount_identity(plan['namespace'], str(mount))
    else:
        base = absolute(plan['keyBasePath'])
        if not key.parent.is_relative_to(base) or receipt_path.is_relative_to(base):
            raise ValueError('new epoch key belongs to its registered owner base; receipt belongs to host custody')
        extra = [str(base)]
    digest = hashlib.sha256(json.dumps(plan, sort_keys=True, separators=(',', ':')).encode()).hexdigest()
    prior = trusted(receipt_path) if receipt_path.exists() else None
    if prior is not None and (prior.get('protocol') != 'pi-core-initialized-capability-v1' or prior.get('planSha256') != digest):
        raise ValueError('another capability initialization owns this receipt')
    recovered = prior_kind == 'absent-after-drain' and prior is not None and prior.get('state') == 'failed-before-effect'
    if recovered:
        reconciliation = prior.get('reconciliation', {})
        if reconciliation.get('kind') != 'affirmative-ancestor-rejection' or reconciliation.get('priorReservation', {}).get('state') != 'preparing':
            raise ValueError('affirmative same-reservation rejection evidence required')
        rejection = json.loads(enter(plan['namespace'], ['python3','-c',KEY_ANCESTOR_REJECTION,json.dumps(plan)],plan['uid'],plan['gid']))
        if rejection != reconciliation.get('rejection'):
            raise ValueError('original rejected ancestor identity changed')
    if prior_kind == 'absent-after-drain' and prior is not None and prior.get('state') != 'initialized' and not recovered:
        raise ValueError('capability initialization effect is uncertain; inspect and reconcile its exact receipt before continuing')
    if prior_kind == 'absent-after-drain' and (prior is None or recovered):
        import runpy
        runpy.run_path(str(Path(__file__).with_name('core-capability-epoch.py')))['validate'](trusted(source), plan)
        publish(receipt_path, {'version': 1, 'protocol': 'pi-core-initialized-capability-v1', 'state': 'preparing', 'scopeId': plan['scopeId'], 'priorCapability': prior_kind, 'keyPath': str(key), 'planSha256': digest, 'sourceProof': plan['sourceProof'], **({'reconciliation':prior['reconciliation']} if recovered else {})})
    identity = json.loads(enter(plan['namespace'], ['/usr/bin/python3', '-c', KEY_INITIALIZATION, str(key), 'inspect' if prior is not None and not recovered else 'create', str(database), *extra], plan['uid'], plan['gid']))
    if prior is not None and not recovered:
        if prior.get('keyIdentity') != identity:
            raise ValueError('initialized capability identity changed')
        return {'ok': True, 'value': prior}
    receipt = {'version': 1, 'protocol': 'pi-core-initialized-capability-v1', 'state': 'initialized', 'scopeId': plan['scopeId'], 'priorCapability': prior_kind,
               'keyPath': str(key), 'planSha256': digest, 'keyIdentity': identity, 'sourceProof': plan['sourceProof'], **({'reconciliation':prior['reconciliation']} if recovered else {})}
    publish(receipt_path, receipt)
    return {'ok': True, 'value': receipt}


def main():
    actions = {'pin': pin, 'transfer': transfer, 'rebind': rebind, 'rebind-group': rebind_group, 'retain-fuse': retain_fuse, 'initialize-capability': initialize_capability, 'reconcile-capability': reconcile_capability}
    if os.geteuid() != 0 or len(sys.argv) != 3 or sys.argv[1] not in actions:
        raise ValueError('usage: root core-adopt pin|retain-fuse|transfer|rebind|rebind-group|initialize-capability|reconcile-capability ABSOLUTE_ROOT_PLAN')
    plan = trusted(absolute(sys.argv[2]))
    print(json.dumps(actions[sys.argv[1]](plan)))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(json.dumps({'ok': False, 'error': {'code': 'core-adoption-refused', 'message': str(error)}}), file=sys.stderr)
        sys.exit(75)
