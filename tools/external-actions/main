#!/usr/bin/env bash
set -euo pipefail
if [[ $# == 1 && $1 == --help ]]; then
  printf '%s\n' 'pi-actions OPERATION: JSON stdin, typed JSON receipt from canonical owner authority' 'submit inspect list claim dispatch finish reconcile recover retry followup hold-recipient release-recipient link-recipients' 'Submit reserves only; inflight/uncertain effects never replay' 'Reconcile requires id, exact inspected expectedRevision, decision, actor and evidence {kind,reference,detail}; actor text grants no authority. Inflight cannot be reconciled.' 'Decisions: effect-confirmed | no-effect-confirmed | resolve-purpose | hold' 'effect-confirmed: uncertain + provider-receipt -> succeeded; purpose remains unresolved.' 'no-effect-confirmed: uncertain/held/accepted/failed-before-effect + provider-rejection -> failed-before-effect; purpose resolved.' 'resolve-purpose: succeeded/failed-before-effect + supporting evidence -> purpose resolved.' 'hold: explicit recipient-hold evidence retains the recipient hold; accepted -> held.' 'Use the returned revision for subsequent resolve-purpose. Reconciliation never lifts recipient holds or resends the request.' 'Example JSON for effect-confirmed after inspecting a synthetic uncertain action:' '{"id":"SYNTHETIC_ACTION_ID","expectedRevision":3,"decision":"effect-confirmed","evidence":{"kind":"provider-receipt","reference":"SYNTHETIC_ORIGINAL_RECEIPT","detail":"SYNTHETIC_CONFIRMED_EFFECT"},"actor":"authorized-owning-operator"}' 'Pass that JSON to: env -u PI_THREAD_TOKEN pi-actions reconcile (registered owning Unix account, explicitly authorized operator action). Replace placeholders and revision with inspected evidence.'
  exit 0
fi
exec bun /srv/pi/runtime/node_modules/kenan-memory/src/actions-cli.ts "$@"
