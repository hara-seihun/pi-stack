#!/usr/bin/env python3
"""Send mail through the local Proton Bridge SMTP endpoint.

Composes UTF-8 mail, threads replies correctly, and refuses to send unless
--send is given so a composed draft can be reviewed first. Credentials come
from Proton Pass at runtime and are never printed. Bridge files the outgoing
copy in Sent itself; this tool does not append.
"""
import argparse, base64, email.utils, imaplib, json, mimetypes, os, re, smtplib, ssl, subprocess, sys, unicodedata, uuid
from email.header import decode_header, make_header
from email.message import EmailMessage

BRIDGE_HOST = "127.0.0.1"
IMAP_PORT = 1143
SMTP_PORT = 1025


def journal_enabled():
    path = os.environ.get("PI_STACK_HOST_CONFIG") or os.environ.get("PI_STACK_HOST_FILE") or "/etc/pi-stack/host.json"
    if not os.path.exists(path):
        return False
    with open(path, encoding="utf-8") as f:
        return json.load(f).get("oneKenan") is True


def journal(command, payload):
    cli = os.environ.get("PI_KENAN_ACTION_JOURNAL_CLI", "/srv/pi/runtime/node_modules/kenan-memory/src/journal-cli.ts")
    result = subprocess.run(["bun", cli, command], input=json.dumps(payload),
                            capture_output=True, text=True, timeout=15)
    if result.returncode:
        raise RuntimeError("Action journal: " + (result.stderr or result.stdout).strip())
    return json.loads(result.stdout)


def journal_finish(ticket, outcome, detail):
    if ticket is None:
        return
    try:
        journal("finish", {"ticket": ticket, "outcome": outcome, "detail": detail})
    except Exception as error:
        # A mail accepted by SMTP must not look like a failed send: repeating it duplicates mail.
        print(f"# mail outcome {outcome}; journal outcome pending; do not resend: {error}", file=sys.stderr)


def action(command, payload):
    cli = os.environ.get("PI_KENAN_ACTION_CLI", "/srv/pi/runtime/node_modules/kenan-memory/src/actions-cli.ts")
    try:
        result = subprocess.run(["bun", cli, command], input=json.dumps(payload),
                                capture_output=True, text=True, timeout=15)
        value = json.loads(result.stdout)
        if not isinstance(value, dict) or not isinstance(value.get("ok"), bool) or result.returncode and value.get("ok"):
            raise ValueError("invalid or interrupted ActionResult")
        return value
    except (OSError, subprocess.TimeoutExpired, ValueError) as error:
        return {"ok": False, "error": "unavailable", "message": f"Action authority unavailable; no replay permitted: {error}"}


def report(value):
    print(json.dumps(value, ensure_ascii=False))
    return 0 if value.get("ok") else 2


def finish_action(ticket, outcome, result, detail):
    kind = {"succeeded": "provider-receipt", "failed-before-effect": "provider-rejection", "uncertain": "operator-observation"}[outcome]
    receipt = action("finish", {"ticket": ticket, "outcome": outcome, "result": result,
                                "evidence": {"kind": kind, "reference": f"smtp:{ticket['id']}", "detail": detail}})
    if not receipt["ok"]:
        return {"ok": False, "error": "receipt-pending", "message": "Dispatch outcome could not commit; inspect action, never resend automatically.",
                "actionId": ticket["id"], "observedOutcome": outcome, "result": result, "authority": receipt}
    return receipt


def purpose(subject, parent_id):
    if parent_id:
        return "email.reply:" + parent_id
    normalized = unicodedata.normalize("NFKC", subject).strip().casefold()
    normalized = re.sub(r"^(?:(?:re|fw|fwd)\s*:\s*)+", "", normalized)
    return "email.subject:" + " ".join(normalized.split())


def recipients(values):
    addresses = [address for _, address in email.utils.getaddresses(values)]
    if not addresses or any(not re.fullmatch(r"[^<>\s@]+@[^<>\s@]+", address) for address in addresses):
        raise ValueError("All recipients must have explicit email addresses")
    return sorted(set(address.lower() for address in addresses))


def creds():
    # Delegated access: a JSON file {"email":..., "password":...} named by
    # MAIL_BRIDGE_CREDENTIAL_FILE bypasses Proton Pass. Used to grant another
    # local account the mailbox without giving it the whole Agent vault.
    import os
    f = os.environ.get("MAIL_BRIDGE_CREDENTIAL_FILE")
    if f:
        with open(f, encoding="utf-8") as credential_file:
            c = json.load(credential_file)
        return c["email"], c["password"]
    env = dict(os.environ)
    env.setdefault("PROTON_PASS_AGENT_REASON", "Read Proton Bridge local mail-client credentials")
    out = subprocess.run(["pass-cli", "item", "view", "--vault-name", "Agent",
                          "--item-title", "Proton Mail Bridge", "--output", "json"],
                         capture_output=True, text=True, check=True, env=env, timeout=15).stdout
    c = json.loads(out)["item"]["content"]["content"]["Login"]
    return c["email"], c["password"]


def loopback_ctx():
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    return ctx


def dec(s):
    try:
        return str(make_header(decode_header(s or "")))
    except Exception:
        return s or ""


def parent_headers(folder, num, user, password):
    """Message-ID, References, Subject and From of the message being replied to."""
    m = imaplib.IMAP4(BRIDGE_HOST, IMAP_PORT)
    m.starttls(loopback_ctx())
    m.login(user, password)
    quoted = '"' + folder.replace('\\', '\\\\').replace('"', '\\"') + '"'
    typ, _ = m.select(quoted, readonly=True)
    if typ != "OK":
        raise SystemExit(f"cannot select {folder}")
    typ, d = m.fetch(num, "(BODY.PEEK[HEADER.FIELDS (MESSAGE-ID REFERENCES SUBJECT FROM)])")
    if typ != "OK" or not d or not isinstance(d[0], tuple):
        raise SystemExit(f"cannot fetch {folder}/{num}")
    h = email.message_from_bytes(d[0][1])
    m.logout()
    return {
        "message_id": (h.get("Message-ID") or "").strip(),
        "references": (h.get("References") or "").split(),
        "subject": dec(h.get("Subject")),
        "from": h.get("From", ""),
    }


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--to", action="append", default=[], help="recipient; repeatable")
    p.add_argument("--cc", action="append", default=[], help="cc; repeatable")
    p.add_argument("--subject")
    p.add_argument("--body-file", help="UTF-8 plain-text body; required except for inspection")
    p.add_argument("--from-name", default="Kenan")
    p.add_argument("--from-addr", help="send as this address of the Proton account "
                   "(default: the Bridge login address). Project threads use their own "
                   "identity — keep replying from the address the thread already uses.")
    p.add_argument("--reply-to", metavar="FOLDER/NUM",
                   help="thread this as a reply to an existing message, e.g. INBOX/4493")
    p.add_argument("--attach", action="append", default=[], metavar="FILE",
                   help="attach a file; repeatable")
    p.add_argument("--send", action="store_true",
                   help="actually send; without it the composed message is printed only")
    p.add_argument("--canonical-intent", "--intent-key", dest="intent_key", help="stable purpose key; otherwise reply parent Message-ID or normalized subject")
    p.add_argument("--request-id", help="request identity; changing it never bypasses intent/contact fencing")
    p.add_argument("--prior-action", help="resolved successful contact being explicitly followed up")
    p.add_argument("--prior-revision", type=int, help="exact inspected revision of prior action")
    p.add_argument("--prior-resolution", help="accountable observation that prior purpose is resolved and this is a new contact")
    p.add_argument("--inspect-action", help="inspect an action without sending")
    a = p.parse_args()
    if a.inspect_action:
        return report(action("inspect", {"id": a.inspect_action}))
    if a.body_file is None:
        p.error("--body-file is required unless --inspect-action is used")
    prior = [a.prior_action is not None, a.prior_revision is not None, a.prior_resolution is not None]
    if any(prior) and (not all(prior) or not a.intent_key or not a.send):
        p.error("followup requires --send, --canonical-intent and all --prior-action/--prior-revision/--prior-resolution flags")

    user, password = creds()
    with open(a.body_file, encoding="utf-8") as body_file:
        body = body_file.read()

    msg = EmailMessage()
    sender = a.from_addr or user
    msg["From"] = email.utils.formataddr((a.from_name, sender))
    msg["Date"] = email.utils.formatdate(localtime=True)
    parent_id = None

    if a.reply_to:
        folder, _, num = a.reply_to.rpartition("/")
        parent = parent_headers(folder, num, user, password)
        if parent["message_id"]:
            parent_id = parent["message_id"]
            msg["In-Reply-To"] = parent_id
            msg["References"] = " ".join(parent["references"] + [parent["message_id"]])
        subject = a.subject or parent["subject"]
        if not subject.lower().startswith("re:"):
            subject = "Re: " + subject
        msg["Subject"] = subject
        if not a.to:
            a.to = [parent["from"]]
    else:
        if not a.subject:
            raise SystemExit("--subject is required unless --reply-to is used")
        msg["Subject"] = a.subject

    if not a.to:
        raise SystemExit("no recipient: pass --to")
    msg["To"] = ", ".join(a.to)
    if a.cc:
        msg["Cc"] = ", ".join(a.cc)
    msg.set_content(body)

    for path in a.attach:
        ctype, _ = mimetypes.guess_type(path)
        maintype, _, subtype = (ctype or "application/octet-stream").partition("/")
        with open(path, "rb") as f:
            msg.add_attachment(f.read(), maintype=maintype, subtype=subtype,
                               filename=os.path.basename(path))

    if not a.send and a.attach:
        # full MIME would dump base64; show headers, body, and attachment summary
        print(f"To: {msg['To']}\nCc: {msg.get('Cc','')}\nSubject: {msg['Subject']}\n")
        print(body)
        for part in msg.iter_attachments():
            print(f"# attachment: {part.get_filename()} "
                  f"({part.get_content_type()}, {len(part.get_payload(decode=True))} bytes)")
    else:
        print(msg.as_string() if not a.send else
              f"To: {msg['To']}\nCc: {msg.get('Cc','')}\nSubject: {msg['Subject']}")

    if not a.send:
        print("\n# not sent (pass --send)", file=sys.stderr)
        return

    envelope = recipients(a.to + a.cc)
    payload = {"from": str(msg["From"]), "to": recipients(a.to), "cc": recipients(a.cc) if a.cc else [],
               "subject": str(msg["Subject"]), "body": body, "inReplyTo": parent_id,
               "references": str(msg.get("References", "")),
               "attachments": [{"filename": part.get_filename(), "contentType": part.get_content_type(),
                                "base64": base64.b64encode(part.get_payload(decode=True)).decode("ascii")}
                               for part in msg.iter_attachments()]}
    actor = os.environ.get("PI_THREAD_ID") or os.environ.get("PI_REMOTE_SESSION_ID") or "mail-send"
    intent = {"intentKey": a.intent_key if a.intent_key is not None else purpose(str(msg["Subject"]), parent_id),
              "recipients": envelope, "transport": "email.send", "payload": payload,
              "requestId": a.request_id if a.request_id is not None else str(uuid.uuid4()), "threadId": actor}
    if a.prior_action:
        submitted = action("followup", {"priorId": a.prior_action, "expectedRevision": a.prior_revision,
                                       "input": intent, "evidence": {"kind": "operator-observation", "reference": actor,
                                                                    "detail": a.prior_resolution}})
    else:
        submitted = action("submit", intent)
    if not submitted["ok"]:
        return report(submitted)
    reservation = submitted["value"]
    if reservation["action"]["state"] != "accepted":
        return report(submitted)
    claimed = action("claim", {"id": reservation["action"]["id"], "actor": actor})
    if not claimed["ok"]:
        return report(claimed)
    ticket = claimed["value"]
    msg["Message-ID"] = f"<kenan-action-{ticket['id']}@{sender.split('@')[-1]}>"
    projection = None
    s = None
    dispatch_entered = False
    try:
        if journal_enabled():
            projection = journal("begin", {"action": "email.send", "recipients": envelope,
                                           "summary": f"{msg['Subject']}: {body}",
                                           "externalId": str(msg["Message-ID"]), "threadId": actor})
        s = smtplib.SMTP(BRIDGE_HOST, SMTP_PORT, timeout=20)
        s.starttls(context=loopback_ctx())
        s.login(user, password)
        permitted = action("dispatch", {"ticket": ticket})
        if not permitted["ok"]:
            journal_finish(projection, "unconfirmed", "Dispatch authority withheld permission; no SMTP send entered; inspect action")
            return report(permitted)
        dispatch_entered = True
        refused = s.send_message(msg, from_addr=sender, to_addrs=envelope)
        result = {"messageId": str(msg["Message-ID"]), "refusedRecipients": sorted(refused),
                  "acceptedRecipients": [address for address in envelope if address not in refused]}
        detail = "SMTP accepted " + str(msg["Message-ID"]) + ("; partial recipient rejection" if refused else "")
        receipt = finish_action(ticket, "succeeded", result, detail)
        journal_finish(projection, "confirmed", detail)
    except Exception as error:
        rejected = (isinstance(error, smtplib.SMTPRecipientsRefused)
                    or isinstance(error, (smtplib.SMTPSenderRefused, smtplib.SMTPDataError))
                    and 400 <= error.smtp_code <= 599)
        outcome = "failed-before-effect" if not dispatch_entered or rejected else "uncertain"
        detail = ("No SMTP DATA accepted: " if outcome == "failed-before-effect" else "SMTP acceptance unknown; do not resend: ") + type(error).__name__
        receipt = finish_action(ticket, outcome, {"error": type(error).__name__, "messageId": str(msg["Message-ID"])}, detail)
        journal_finish(projection, "failed" if outcome == "failed-before-effect" else "unconfirmed", detail)
    finally:
        if s is not None:
            try:
                s.close()
            except Exception:
                print("# SMTP connection cleanup failed; action receipt remains authoritative", file=sys.stderr)
    return report(receipt)


if __name__ == "__main__":
    sys.exit(main())
