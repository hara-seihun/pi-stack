#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
npm test
[[ -x ../mcp/main ]] || { echo "deploy ../mcp first" >&2; exit 1; }

install -d -m 755 "$HOME/.local/bin"
ln -sfn "$PWD/main" "$HOME/.local/bin/mcp-script"

dest=/srv/pi/tools/mcp-script
sudo -n install -d -m 755 "$dest"
sudo -n rsync -a --delete --chmod=D755,F644 --exclude=.git \
  package.json lib.mjs worker.mjs main "$dest/"
sudo -n chmod 755 "$dest/main"
sudo -n install -d -m 755 -o orchestrator -g users /home/orchestrator/.local/bin
sudo -n ln -sfn "$dest/main" /home/orchestrator/.local/bin/mcp-script

printf 'return 2 + 2;\n' | mcp-script | jq -e '.result == 4' >/dev/null
sudo -n -u orchestrator bash -lc "printf 'return 2 + 2;\\n' | mcp-script | jq -e '.result == 4' >/dev/null"
echo "deployed mcp-script for interactive and fleet agents"
