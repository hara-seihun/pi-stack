#!/usr/bin/env bash
# tlab — temporary model threads, driven from the shell.
#
# Each thread is a directory under ~/data/thread-lab/<name>/ holding a pi
# session file, per-turn prompts and outputs, and the thread's model config.
# A turn runs `pi -p` detached inside a tmux session (tlab-<name>) so the
# caller polls with short bounded commands instead of blocking on the model.
set -euo pipefail

ROOT="${TLAB_ROOT:-$HOME/data/thread-lab}"

usage() {
  local status=${1:-1}
  cat <<'EOF'
tlab — temporary model threads

  tlab new <name> --model <provider/model> [--thinking LVL] [--append-system FILE] [--tools] [--allow-tools LIST]
  tlab send <name> (-f FILE | TEXT...)    start a turn (detached, tmux session tlab-<name>)
  tlab fork <src> <new>                   new thread continuing from <src>'s state
  tlab status [name]                      turn state; with no name, all threads
  tlab wait <name> [SECONDS]              poll until the running turn ends (default 240s)
  tlab out <name> [N]                     assistant output of turn N (default: latest)
  tlab trace <name> [N]                   thinking blocks of turn N (default: latest)
  tlab transcript <name>                  full thread: prompts, thinking, outputs
  tlab ls                                 list threads
  tlab rm <name>                          delete a thread (kills a running turn)

Threads default to --no-skills --no-context-files --no-tools and a fresh cwd,
so the only context the model sees is what you send. Pass --tools at `new` to
keep pi's builtin tools.
EOF
  exit "$status"
}

die() { echo "tlab: $*" >&2; exit 1; }

dir_of() { echo "$ROOT/$1"; }
require_thread() { [[ -d "$(dir_of "$1")" ]] || die "no thread '$1' (tlab ls)"; }
tmux_name() { echo "tlab-$1"; }
running() { tmux has-session -t "$(tmux_name "$1")" 2>/dev/null; }

latest_turn() { # -> highest turn number present, or 0
  local d; d="$(dir_of "$1")/turns"
  ls "$d" 2>/dev/null | grep -oE '^[0-9]+' | sort -n | tail -1 || true
}

cmd_new() {
  local name="" model="" thinking="" tools=0 allow_tools=""
  local -a append_system=()
  name="${1:-}"; [[ -n "$name" ]] || usage; shift
  [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || die "thread names are [A-Za-z0-9._-]+"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model) model="$2"; shift 2 ;;
      --thinking) thinking="$2"; shift 2 ;;
      --append-system) append_system+=("$(realpath "$2")"); shift 2 ;;
      --tools) tools=1; shift ;;
      --allow-tools) allow_tools="$2"; shift 2 ;;
      *) die "unknown option $1" ;;
    esac
  done
  [[ -n "$model" ]] || die "--model provider/model is required"
  local d; d="$(dir_of "$name")"
  [[ ! -e "$d" ]] || die "thread '$name' already exists"
  mkdir -p "$d/turns"
  jq -n --arg model "$model" --arg thinking "$thinking" --argjson tools "$tools" \
    --arg allow_tools "$allow_tools" \
    --args '{model: $model, thinking: $thinking, tools: ($tools == 1), allow_tools: $allow_tools, append_system: $ARGS.positional}' \
    "${append_system[@]}" > "$d/config.json"
  echo "$d"
}

cmd_send() {
  local name="${1:-}"; [[ -n "$name" ]] || usage; shift
  require_thread "$name"
  local d; d="$(dir_of "$name")"
  ! running "$name" || die "thread '$name' already has a turn running (tlab status $name)"

  local n; n=$(( $(latest_turn "$name" | grep . || echo 0) + 1 ))
  local turn; turn="$(printf '%03d' "$n")"
  local prompt="$d/turns/$turn.prompt.md"
  if [[ "${1:-}" == "-f" ]]; then
    [[ -n "${2:-}" ]] || usage
    cp "$2" "$prompt"
  else
    [[ $# -gt 0 ]] || usage
    printf '%s' "$*" > "$prompt"
  fi

  local model thinking tools allow_tools
  model="$(jq -r .model "$d/config.json")"
  thinking="$(jq -r .thinking "$d/config.json")"
  tools="$(jq -r .tools "$d/config.json")"
  allow_tools="$(jq -r '.allow_tools // ""' "$d/config.json")"

  local -a args=(-p --no-skills --no-context-files --session "$d/session.jsonl" --model "$model")
  if [[ -n "$allow_tools" ]]; then args+=(--tools "$allow_tools")
  elif [[ "$tools" != "true" ]]; then args+=(--no-tools); fi
  [[ -z "$thinking" ]] || args+=(--thinking "$thinking")
  while IFS= read -r f; do args+=(--append-system-prompt "$f"); done \
    < <(jq -r '.append_system[]' "$d/config.json")

  local run="$d/turns/$turn.run.sh"
  {
    echo '#!/usr/bin/env bash'
    echo "cd $(printf '%q' "$d")"
    printf 'pi'
    printf ' %q' "${args[@]}" "$(cat "$prompt")"
    printf ' > %q 2> %q\n' "$d/turns/$turn.out" "$d/turns/$turn.err"
    printf 'echo $? > %q\n' "$d/turns/$turn.exit"
  } > "$run"
  chmod +x "$run"
  tmux new-session -d -s "$(tmux_name "$name")" "$run"
  echo "turn $turn started (tlab status $name)"
}

status_line() {
  local name="$1" d turn state=""
  d="$(dir_of "$name")"
  turn="$(latest_turn "$name")"
  if [[ -z "$turn" ]]; then state="empty"
  elif running "$name"; then state="turn $turn running ($(du -b "$d/turns/$(printf '%03d' "$turn")".out 2>/dev/null | cut -f1 || echo 0) bytes out)"
  else
    local code; code="$(cat "$d/turns/$(printf '%03d' "$turn").exit" 2>/dev/null || echo '?')"
    state="turn $turn done (exit $code)"
  fi
  printf '%-24s %s  [%s]\n' "$name" "$state" "$(jq -r '.model + (if .thinking != "" then ":" + .thinking else "" end)' "$d/config.json")"
}

cmd_status() {
  if [[ -n "${1:-}" ]]; then require_thread "$1"; status_line "$1"; return; fi
  local t
  for t in $(cmd_ls); do status_line "$t"; done
}

cmd_wait() {
  local name="${1:-}"; [[ -n "$name" ]] || usage
  require_thread "$name"
  local limit="${2:-240}" waited=0
  while running "$name"; do
    (( waited < limit )) || { echo "still running after ${limit}s"; return 1; }
    sleep 5; waited=$(( waited + 5 ))
  done
  status_line "$name"
}

turn_arg() { # <name> [N] -> zero-padded turn or die
  local turn="${2:-$(latest_turn "$1")}"
  [[ -n "$turn" ]] || die "thread '$1' has no turns"
  printf '%03d' "$((10#$turn))"
}

cmd_out() {
  local name="${1:-}"; [[ -n "$name" ]] || usage
  require_thread "$name"
  local turn; turn="$(turn_arg "$name" "${2:-}")"
  cat "$(dir_of "$name")/turns/$turn.out"
}

# Thinking blocks live only in the session file; pair them with turns by
# assistant-message order (turn N = Nth assistant message).
cmd_trace() {
  local name="${1:-}"; [[ -n "$name" ]] || usage
  require_thread "$name"
  local turn; turn="$(turn_arg "$name" "${2:-}")"
  jq -r --argjson n "$((10#$turn))" '
    [inputs | select(.type=="message" and .message.role=="assistant")][$n-1]
    | .message.content[]? | select(.type=="thinking") | .thinking
  ' < "$(dir_of "$name")/session.jsonl"
}

cmd_transcript() {
  local name="${1:-}"; [[ -n "$name" ]] || usage
  require_thread "$name"
  local d turn n
  d="$(dir_of "$name")"
  n="$(latest_turn "$name")"
  [[ -n "$n" ]] || die "thread '$name' has no turns"
  for i in $(seq 1 "$n"); do
    turn="$(printf '%03d' "$i")"
    echo "===== turn $turn: user ====="
    cat "$d/turns/$turn.prompt.md"; echo
    echo "===== turn $turn: thinking ====="
    cmd_trace "$name" "$i" || true
    echo "===== turn $turn: assistant ====="
    cat "$d/turns/$turn.out" 2>/dev/null || echo "(no output yet)"
    echo
  done
}

cmd_fork() {
  local src="${1:-}" dst="${2:-}"
  [[ -n "$src" && -n "$dst" ]] || usage
  require_thread "$src"
  [[ "$dst" =~ ^[A-Za-z0-9._-]+$ ]] || die "thread names are [A-Za-z0-9._-]+"
  [[ ! -e "$(dir_of "$dst")" ]] || die "thread '$dst' already exists"
  ! running "$src" || die "'$src' has a turn running; wait for it first"
  cp -r "$(dir_of "$src")" "$(dir_of "$dst")"
  echo "$(dir_of "$dst") (forked from $src)"
}

cmd_ls() {
  local d
  for d in "$ROOT"/*/; do
    [[ -f "$d/config.json" ]] && basename "$d"
  done
  return 0
}

cmd_rm() {
  local name="${1:-}"; [[ -n "$name" ]] || usage
  require_thread "$name"
  ! running "$name" || tmux kill-session -t "$(tmux_name "$name")"
  rm -rf "$(dir_of "$name")"
}

cmd="${1:-}"; [[ -n "$cmd" ]] || usage; shift || true
case "$cmd" in
  -h|--help) usage 0 ;;
  new) cmd_new "$@" ;;
  send) cmd_send "$@" ;;
  fork) cmd_fork "$@" ;;
  status) cmd_status "$@" ;;
  wait) cmd_wait "$@" ;;
  out) cmd_out "$@" ;;
  trace) cmd_trace "$@" ;;
  transcript) cmd_transcript "$@" ;;
  ls) cmd_ls ;;
  rm) cmd_rm "$@" ;;
  *) usage ;;
esac
