#!/usr/bin/env python3
"""Pull every message Hara has sent to agents in a pi profile and count tokens.

Reads pi session JSONL files, keeps sessions whose cwd matches the requested
profile root, extracts user-role text messages, and reports message/char/token
totals. Optionally writes the full transcript to a file.
"""

import argparse
import json
import re
import sqlite3
import sys
from pathlib import Path

SESSION_DIRS = [
    Path("/home/kenan/data/pi-remote/sessions"),
    Path("/home/kenan/.pi/agent/sessions/--home-kenan--"),
]

PROFILE_ROOTS = {
    "home": "/home/kenan",
    "personal": "/home/kenan/hara",
    "work": "/home/kenan/data/pi-remote/work-shadow",
}

SUPERVISOR_DB = Path("/home/kenan/data/pi-remote/supervisor.sqlite3")

def thread_names() -> dict:
    if not SUPERVISOR_DB.exists():
        return {}
    db = sqlite3.connect(f"file:{SUPERVISOR_DB}?mode=ro", uri=True)
    try:
        rows = db.execute("SELECT session_path, name FROM sessions").fetchall()
    finally:
        db.close()
    return {Path(p).stem: name for p, name in rows if p}


def user_texts(path: Path):
    """Return (header, hara_texts) where hara_texts are the user-role text
    messages. Tool results and the system prompt never enter here."""
    texts = []
    with path.open(encoding="utf-8", errors="replace") as f:
        header = None
        for line in f:
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            if header is None:
                header = entry
                if entry.get("type") != "session":
                    return None, []
                continue
            if entry.get("type") != "message":
                continue
            msg = entry.get("message", {})
            if msg.get("role") != "user":
                continue
            content = msg.get("content")
            if isinstance(content, str):
                parts = [content]
            else:
                parts = [
                    c.get("text", "")
                    for c in content
                    if isinstance(c, dict) and c.get("type") == "text"
                ]
            text = "\n".join(p for p in parts if p).strip()
            if text:
                texts.append((entry.get("timestamp", ""), text))
    return header, texts



def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--profile",
        choices=sorted(PROFILE_ROOTS),
        default="home",
        help="which pi remote profile's sessions to read (default: home)",
    )
    parser.add_argument(
        "--out",
        type=Path,
        help="write the full transcript to this file",
    )
    parser.add_argument(
        "--match",
        metavar="REGEX",
        help="keep only threads whose name or user messages match this regex (case-insensitive)",
    )
    parser.add_argument(
        "--min-msgs",
        type=int,
        default=0,
        metavar="N",
        help="keep only threads with at least N user messages",
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="list kept sessions with their thread names",
    )
    args = parser.parse_args()
    matcher = re.compile(args.match, re.IGNORECASE) if args.match else None
    names = thread_names()
    root = PROFILE_ROOTS[args.profile]

    sessions = []
    seen_ids = set()
    for directory in SESSION_DIRS:
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*.jsonl")):
            header, texts = user_texts(path)
            if not header or header.get("cwd") != root or not texts:
                continue
            sid = header.get("id")
            if sid in seen_ids:
                continue
            if len(texts) < args.min_msgs:
                continue
            if matcher:
                haystack = names.get(path.stem, "") + "\n" + "\n".join(
                    t for _, t in texts
                )
                if not matcher.search(haystack):
                    continue
            seen_ids.add(sid)
            sessions.append((header.get("timestamp", ""), path, texts))

    sessions.sort()

    if args.list:
        for started, path, texts in sessions:
            name = names.get(path.stem, "?")
            print(f"{started[:10]}  {len(texts):3d} msgs  {name}")
        print()
    all_messages = [t for _, _, texts in sessions for _, t in texts]
    corpus = "\n\n".join(all_messages)

    import tiktoken

    tokens = len(tiktoken.get_encoding("o200k_base").encode(corpus))

    if args.out:
        with args.out.open("w", encoding="utf-8") as f:
            for started, path, texts in sessions:
                f.write(f"=== session {path.stem} (started {started}) ===\n\n")
                for ts, text in texts:
                    f.write(f"[{ts}]\n{text}\n\n")
        print(f"transcript written to {args.out}")

    print(f"profile:   {args.profile} ({root})")
    print(f"sessions:  {len(sessions)}")
    print(f"messages:  {len(all_messages)}")
    print(f"chars:     {len(corpus):,}")
    print(f"words:     {len(corpus.split()):,}")
    print(f"tokens:    {tokens:,} (o200k_base)")


if __name__ == "__main__":
    sys.exit(main())
