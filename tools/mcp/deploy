#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
npm ci --ignore-scripts
npm test

install -d -m 755 "$HOME/.local/bin"
ln -sfn "$PWD/main" "$HOME/.local/bin/mcp"

dest=/srv/pi/tools/mcp
sudo -n install -d -m 755 "$dest"
sudo -n rsync -a --delete --chmod=D755,F644 \
  --exclude=.git package.json package-lock.json lib.mjs main node_modules "$dest/"
sudo -n chmod 755 "$dest/main"
sudo -n install -d -m 755 -o orchestrator -g users /home/orchestrator/.local/bin
sudo -n ln -sfn "$dest/main" /home/orchestrator/.local/bin/mcp

mcp status >/dev/null
sudo -n -u orchestrator bash -lc 'mcp status >/dev/null'
echo "deployed mcp for interactive and fleet agents"
