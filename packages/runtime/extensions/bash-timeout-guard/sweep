#!/usr/bin/env bash
# Kill fleet agent commands that outlived the autonomous bash cap. Every fleet
# run is a transient `pi-orchestrator-run-*` unit, so its cgroup is what marks a
# process as fleet work; the account running the fleet may also be a person
# whose interactive commands are allowed much longer and are left alone.
set -uo pipefail

kill_tree() {
  local pid=$1 child
  for child in $(ps -o pid= --ppid "$pid" 2>/dev/null); do
    kill_tree "$child"
  done
  kill -KILL "$pid" 2>/dev/null
}

while read -r pid age command; do
  ((age > 50)) || continue
  grep -q 'pi-orchestrator-run-' "/proc/$pid/cgroup" 2>/dev/null || continue
  case "$command" in
    *"dist/cli.js worker"*) continue ;;
  esac
  grep -qz '^PI_SESSION_ID=' "/proc/$pid/environ" 2>/dev/null || continue
  printf 'killing %s after %ss: %s\n' "$pid" "$age" "$command"
  kill_tree "$pid"
done < <(ps -eo pid=,etimes=,args= 2>/dev/null)
