#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
npm ci --ignore-scripts
install -d -m 700 "$HOME/.local/bin" "$HOME/.pi/agent/extensions"
export PATH="$HOME/.local/bin:$PATH"
ln -sfn "$PWD/node_modules/.bin/pi" "$HOME/.local/bin/pi"
ln -sfn "$PWD/prompt-eval/prompt-eval.mjs" "$HOME/.local/bin/prompt-eval"
ln -sfn "$PWD/extensions/chatgpt-pro/pro" "$HOME/.local/bin/pro"
rm -f "$HOME/.pi/agent/extensions/chatgpt-pro.ts" "$HOME/.pi/agent/extensions/chatgpt-pro.md"
rm -rf "$HOME/.pi/agent/extensions/chatgpt-pro-support" "$HOME/.pi/agent/extensions/chatgpt-pro"
ln -s "$PWD/extensions/chatgpt-pro" "$HOME/.pi/agent/extensions/chatgpt-pro"
npm test
claude_extension="$PWD/extensions/pi-claude-code-use/extensions/index.ts"
settings="$HOME/.pi/agent/settings.json"
claude_extension_configured=$(jq -r '.packages | any(. == "../../tools/pi-runtime/extensions/pi-claude-code-use" or . == "/home/kenan/tools/pi-runtime/extensions/pi-claude-code-use")' "$settings")
for shared_extension in context-guard bash-timeout-guard; do
  jq -e --arg e "$shared_extension" \
    '.packages | any(endswith("/tools/pi-runtime/extensions/" + $e))' "$settings" >/dev/null ||
    { echo "$shared_extension extension package is not configured" >&2; exit 1; }
done
orchestrator_configured=$(jq -r '.packages | any(. == "/srv/pi/pi-orchestrator")' "$settings")
[[ "$orchestrator_configured" == true ]] || { echo "pi-orchestrator extension package is not configured" >&2; exit 1; }
cursor_provider="$HOME/tools/pi-cursor"
cursor_configured=$(jq -r --arg p "$cursor_provider" '.packages | any(. == $p)' "$settings")
[[ "$cursor_configured" == true ]] || { echo "locally owned Cursor provider is not configured" >&2; exit 1; }
if jq -e '.packages | any(type == "string" and startswith("npm:@rahularya01/pi-cursor"))' "$settings" >/dev/null; then
  echo "npm pi-cursor must not replace the locally owned provider" >&2
  exit 1
fi
# The bundle is what pi loads, so a source edge left unbuilt would deploy the
# superseded provider without anything reporting it.
[[ -f "$cursor_provider/dist/index.js" ]] || { echo "Cursor provider bundle is missing; run npm run build in $cursor_provider" >&2; exit 1; }
if [[ -n $(find "$cursor_provider/src" "$cursor_provider/package.json" -newer "$cursor_provider/dist/index.js" -print -quit) ]]; then
  echo "Cursor provider bundle is older than its source; run npm run build in $cursor_provider" >&2
  exit 1
fi
if jq -e '.packages | any(type == "string" and startswith("npm:@benvargas/pi-claude-code-use"))' "$settings" >/dev/null; then
  echo "npm pi-claude-code-use must not replace the locally owned extension" >&2
  exit 1
fi
if [[ "$claude_extension_configured" == true ]]; then
  claude_extension_hash=$(sha256sum "$claude_extension" | cut -d' ' -f1)
fi
"$HOME/.local/bin/pi" update --extensions
if [[ "$claude_extension_configured" == true && $(sha256sum "$claude_extension" | cut -d' ' -f1) != "$claude_extension_hash" ]]; then
  echo "package update modified the locally owned Claude extension" >&2
  exit 1
fi
"$HOME/.local/bin/pi" --list-models chatgpt-pro | grep -q 'gpt-5-6-pro-literal'
version=$("$HOME/.local/bin/pi" --version)
[[ "$version" == "0.84.1" ]] || { echo "unexpected Pi version: $version" >&2; exit 1; }
[[ $("$HOME/.local/bin/pro" --version) == "$version" ]] || { echo "Pro launcher does not resolve to deployed Pi" >&2; exit 1; }
"$HOME/.local/bin/prompt-eval" --help | grep -q '^prompt-eval'

# Orchestrator-hosted sessions run as the orchestrator user, which cannot
# read this repository inside a 0700 home. /srv/pi carries world-readable
# deploy artifacts of the shared pi packages; the orchestrator user's pi
# settings load them from there.
shared=/srv/pi
install -d -m 755 "$shared/extensions" "$shared/pi-cursor/node_modules"
rsync -a --delete --chmod=D755,F644 \
  "$PWD/extensions/pi-claude-code-use" "$PWD/extensions/context-guard" \
  "$PWD/extensions/bash-timeout-guard" "$shared/extensions/"
rsync -a --delete --chmod=D755,F644 "$cursor_provider/dist" "$cursor_provider/package.json" "$shared/pi-cursor/"
rsync -a --delete --chmod=D755,F644 "$cursor_provider/node_modules/@bufbuild" "$shared/pi-cursor/node_modules/"

# This deploy owns which shared packages the fleet user loads, so an extension
# can never reach interactive sessions while silently missing from the fleet.
# Everything else in that file (model defaults) stays orchestrator-owned.
# Sessions build their settings at launch, so this needs no runner drain.
fleet_settings=/home/orchestrator/.pi/agent/settings.json
fleet_packages=$(jq -n '[
  "/srv/pi/pi-orchestrator",
  "/srv/pi/extensions/pi-claude-code-use",
  "/srv/pi/extensions/context-guard",
  "/srv/pi/extensions/bash-timeout-guard",
  "/srv/pi/pi-cursor",
  "npm:pi-mcp-adapter"
]')
sudo -n install -d -m 700 -o orchestrator -g users /home/orchestrator/.pi /home/orchestrator/.pi/agent
fleet_current=$(sudo -n cat "$fleet_settings" 2>/dev/null || echo '{}')
printf '%s' "$fleet_current" | jq --argjson p "$fleet_packages" '.packages = $p' |
  sudo -n -u orchestrator tee "$fleet_settings" >/dev/null
sudo -n chmod 600 "$fleet_settings"
sudo -n cat "$fleet_settings" | jq -e --argjson p "$fleet_packages" '.packages == $p' >/dev/null ||
  { echo "fleet pi settings did not take the shared package list" >&2; exit 1; }

# Models pi's own catalog does not carry yet — stealth previews above all,
# which appear on a provider weeks before a pinned release knows their name.
# Both users run the same catalog: a model the fleet is configured to launch
# but the interactive user cannot select (or the reverse) is a split brain
# that only shows up as an unknown-model run failure.
for user_home in "$HOME" /home/orchestrator; do
  user=$([[ "$user_home" == "$HOME" ]] && echo "$USER" || echo orchestrator)
  sudo -n -u "$user" tee "$user_home/.pi/agent/models.json" >/dev/null < "$PWD/models.json"
  sudo -n -u "$user" chmod 600 "$user_home/.pi/agent/models.json"
  sudo -n cat "$user_home/.pi/agent/models.json" | cmp -s - "$PWD/models.json" ||
    { echo "$user did not take the shared model catalog" >&2; exit 1; }
done
"$HOME/.local/bin/pi" --list-models openrouter | grep -q 'stealth/ox-alpha'

# The MCP adapter is an npm package, and the fleet user has no pi CLI to
# install one for itself, so this deploy installs it at the version the
# interactive user runs. Without it the fleet has no MCP client at all, which
# is how the math ledger ended up behind a bespoke CLI bridge until 2026-08-21.
adapter_version=$(jq -r '.version' "$HOME/.pi/agent/npm/node_modules/pi-mcp-adapter/package.json")
sudo -n -u orchestrator bash -lc "
  set -e
  mkdir -p ~/.pi/agent/npm
  cd ~/.pi/agent/npm
  [ -f package.json ] || echo '{\"name\":\"pi-extensions\",\"private\":true}' > package.json
  installed=\$(jq -r '.version' node_modules/pi-mcp-adapter/package.json 2>/dev/null || echo none)
  [ \"\$installed\" = \"$adapter_version\" ] ||
    npm install --no-audit --no-fund --silent pi-mcp-adapter@$adapter_version
"
sudo -n -u orchestrator jq -e --arg v "$adapter_version" \
  '.version == $v' /home/orchestrator/.pi/agent/npm/node_modules/pi-mcp-adapter/package.json >/dev/null ||
  { echo "fleet MCP adapter is not at $adapter_version" >&2; exit 1; }

# Both users reach the math ledger as the registered `math` MCP server, each
# with its own single key. A missing registration would leave the fleet with a
# client and no ledger, so it is written and verified here rather than trusted.
for user_home in "$HOME" /home/orchestrator; do
  user=$([[ "$user_home" == "$HOME" ]] && echo "$USER" || echo orchestrator)
  sudo -n -u "$user" install -d -m 700 "$user_home/.config/mcp"
  sudo -n -u "$user" tee "$user_home/.config/mcp/mcp.json" >/dev/null <<JSON
{
  "mcpServers": {
    "math": {
      "url": "https://lemma.ing/mcp",
      "auth": "bearer",
      "bearerToken": "!cat $user_home/data/math-research/contributor.key"
    }
  }
}
JSON
  sudo -n -u "$user" chmod 600 "$user_home/.config/mcp/mcp.json"
  # Captured, not piped into grep: a `grep -q` that matches early SIGPIPEs
  # curl, and pipefail would read that as an unreachable ledger.
  hello=$(sudo -n -u "$user" bash -lc "curl -fsS https://lemma.ing/mcp \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' \
    -H \"Authorization: Bearer \$(cat $user_home/data/math-research/contributor.key)\" \
    -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/call\",\"params\":{\"name\":\"hello\",\"arguments\":{}}}'")
  # The welcome text arrives escaped inside the tool-result JSON, so match the
  # bare word rather than a quoted key.
  [[ "$hello" == *welcome* ]] ||
    { echo "$user cannot reach the math ledger with its key" >&2; exit 1; }
done

# One GitHub identity, shared the same way: /var/lib/github is both users'
# gh config directory (tmpfiles owns the symlinks), so the fleet reviews and
# merges pull requests as hara-seihun. gh rewrites hosts.yml 0600 whenever auth
# changes, which silently locks the fleet out, so the mode is reconciled here
# and both users are proved rather than assumed.
chmod 660 /var/lib/github/hosts.yml /var/lib/github/config.yml
sudo -n -u orchestrator tee /home/orchestrator/.gitconfig >/dev/null <<'GITCONFIG'
[user]
	name = fleet
	email = fleet@works.local
[credential "https://github.com"]
	helper = !gh auth git-credential
[init]
	defaultBranch = main
GITCONFIG
for user in "$USER" orchestrator; do
  login=$(sudo -n -u "$user" --login gh api user --jq .login)
  [[ "$login" == hara-seihun ]] ||
    { echo "$user does not authenticate to GitHub as hara-seihun" >&2; exit 1; }
done

echo "Pi $version, prompt evaluator, extensions, and /srv/pi shared packages deployed"
echo "fleet packages reconciled in $fleet_settings"
echo "MCP adapter $adapter_version and the math server registration verified for both users"
