#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
npm ci --ignore-scripts
install -d -m 700 "$HOME/.local/bin" "$HOME/.pi/agent/extensions"
export PATH="$HOME/.local/bin:$PATH"
ln -sfn "$PWD/node_modules/.bin/pi" "$HOME/.local/bin/pi"
ln -sfn "$PWD/orchestrator/orchestrator.mjs" "$HOME/.local/bin/orchestrator"
ln -sfn "$PWD/prompt-eval/prompt-eval.mjs" "$HOME/.local/bin/prompt-eval"
ln -sfn "$PWD/usage/pi-usage.mjs" "$HOME/.local/bin/pi-usage"
ln -sfn "$PWD/plan-meter/plan-meter.mjs" "$HOME/.local/bin/plan-meter"
ln -sfn "$PWD/extensions/chatgpt-pro/pro" "$HOME/.local/bin/pro"
rm -f "$HOME/.pi/agent/extensions/chatgpt-pro.ts" "$HOME/.pi/agent/extensions/chatgpt-pro.md"
rm -rf "$HOME/.pi/agent/extensions/chatgpt-pro-support" "$HOME/.pi/agent/extensions/chatgpt-pro"
ln -s "$PWD/extensions/chatgpt-pro" "$HOME/.pi/agent/extensions/chatgpt-pro"
npm test
claude_extension="$PWD/extensions/pi-claude-code-use/extensions/index.ts"
settings="$HOME/.pi/agent/settings.json"
claude_extension_configured=$(jq -r '.packages | any(. == "../../tools/pi-runtime/extensions/pi-claude-code-use" or . == "/home/kenan/tools/pi-runtime/extensions/pi-claude-code-use")' "$settings")
usage_logger_configured=$(jq -r '.packages | any(. == "../../tools/pi-runtime/extensions/pi-usage-logger" or . == "/home/kenan/tools/pi-runtime/extensions/pi-usage-logger")' "$settings")
[[ "$usage_logger_configured" == true ]] || { echo "locally owned Pi usage logger is not configured" >&2; exit 1; }
cursor_provider="$HOME/tools/pi-cursor"
cursor_configured=$(jq -r --arg p "$cursor_provider" '.packages | any(. == $p)' "$settings")
[[ "$cursor_configured" == true ]] || { echo "locally owned Cursor provider is not configured" >&2; exit 1; }
if jq -e '.packages | any(type == "string" and startswith("npm:@rahularya01/pi-cursor"))' "$settings" >/dev/null; then
  echo "npm pi-cursor must not replace the locally owned provider" >&2
  exit 1
fi
# The bundle is what pi loads and what the host code fingerprint hashes, so a source edge left
# unbuilt would deploy the superseded provider without anything reporting a stale generation.
[[ -f "$cursor_provider/dist/index.js" ]] || { echo "Cursor provider bundle is missing; run npm run build in $cursor_provider" >&2; exit 1; }
if [[ -n $(find "$cursor_provider/src" "$cursor_provider/package.json" -newer "$cursor_provider/dist/index.js" -print -quit) ]]; then
  echo "Cursor provider bundle is older than its source; run npm run build in $cursor_provider" >&2
  exit 1
fi
if jq -e '.packages | any(type == "string" and startswith("npm:@benvargas/pi-claude-code-use"))' "$settings" >/dev/null; then
  echo "npm pi-claude-code-use must not replace the locally owned extension" >&2
  exit 1
fi
if [[ "$claude_extension_configured" == true ]]; then
  claude_extension_hash=$(sha256sum "$claude_extension" | cut -d' ' -f1)
fi
"$HOME/.local/bin/pi" update --extensions
if [[ "$claude_extension_configured" == true && $(sha256sum "$claude_extension" | cut -d' ' -f1) != "$claude_extension_hash" ]]; then
  echo "package update modified the locally owned Claude extension" >&2
  exit 1
fi
"$HOME/.local/bin/pi" --list-models chatgpt-pro | grep -q 'gpt-5-6-pro-literal'
version=$("$HOME/.local/bin/pi" --version)
[[ "$version" == "0.84.1" ]] || { echo "unexpected Pi version: $version" >&2; exit 1; }
[[ $("$HOME/.local/bin/pro" --version) == "$version" ]] || { echo "Pro launcher does not resolve to deployed Pi" >&2; exit 1; }
"$HOME/.local/bin/prompt-eval" --help | grep -q '^prompt-eval'
"$HOME/.local/bin/pi-usage" --help | grep -q '^Usage:'
"$HOME/.local/bin/plan-meter" --help | grep -q '^Usage:'
"$HOME/.local/bin/orchestrator" check
# The superseded npm Cursor provider stays installed until no host can still spawn its bridge:
# h2-bridge.mjs is exec'd from the bundle directory on every stream, so removing it under a
# draining host would break that host's live Cursor sessions. Draining hosts exit once empty, so
# this prunes itself on a later deploy.
npm_state="$HOME/.pi/agent/npm/package.json"
if [[ -f "$npm_state" ]] && jq -e '.dependencies["@rahularya01/pi-cursor"] // empty' "$npm_state" >/dev/null 2>&1; then
  current_fingerprint=$("$HOME/.local/bin/orchestrator" check | sed -n 's/.*(code \([0-9a-f]*\)).*/\1/p')
  stale_hosts=0
  while read -r host_fingerprint; do
    [[ -n "$host_fingerprint" && "$host_fingerprint" != "$current_fingerprint" ]] && stale_hosts=$((stale_hosts + 1))
  done < <(pgrep -af 'orchestrator\.mjs agent-host' | sed -n 's/.*--fingerprint \([0-9a-f]*\).*/\1/p')
  if [[ -n "$current_fingerprint" && "$stale_hosts" -eq 0 ]]; then
    "$HOME/.local/bin/pi" remove npm:@rahularya01/pi-cursor
    echo "pruned superseded npm Cursor provider"
  else
    echo "superseded npm Cursor provider retained: $stale_hosts draining host(s) can still spawn its bridge"
  fi
fi
if [[ "${PI_RUNTIME_SKIP_RESTART:-0}" != 1 ]] && systemctl is-enabled --quiet agent-orchestrator.service 2>/dev/null; then
  sudo systemctl restart agent-orchestrator.service
  systemctl is-active --quiet agent-orchestrator.service
fi
echo "Pi $version, prompt evaluator, and agent orchestrator deployed"
