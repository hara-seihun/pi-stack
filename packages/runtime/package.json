{
  "name": "@hara-seihun/pi-runtime",
  "version": "1.0.0",
  "description": "Reusable Pi extensions and prompt evaluation tools",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./extensions/bash-timeout-guard/index.mjs",
      "./extensions/chatgpt-pro/index.ts",
      "./extensions/state-compactor/index.mjs",
      "./extensions/mcp-size-guard/index.mjs",
      "./extensions/session-condenser/index.mjs",
      "./extensions/pi-claude-code-use/extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test prompt-eval/prompt-eval.test.mjs extensions/chatgpt-pro/browser.test.mjs extensions/chatgpt-pro/launcher.test.mjs extensions/pi-claude-code-use/index.test.mjs extensions/state-compactor/extension.test.mjs extensions/bash-timeout-guard/guard.test.mjs extensions/mcp-size-guard/guard.test.mjs extensions/session-condenser/condense.test.mjs"
  },
  "dependencies": {
    "playwright-core": "1.59.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <0.85.0",
    "typebox": ">=1.3.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.7"
  }
}
