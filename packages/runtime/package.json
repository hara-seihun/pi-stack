{
  "name": "@hara-seihun/pi-runtime",
  "version": "1.0.0",
  "description": "Reusable Pi extensions and prompt evaluation tools",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./extensions/bash-timeout-guard/index.mjs",
      "./extensions/publication-custody/index.mjs",
      "./extensions/state-compactor/index.mjs",
      "./extensions/pi-claude-code-use/extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test prompt-eval/prompt-eval.test.mjs extensions/pi-claude-code-use/index.test.mjs extensions/state-compactor/extension.test.mjs extensions/bash-timeout-guard/guard.test.mjs extensions/publication-custody/custody.test.mjs"
  },
  "dependencies": {
    "agent-browser": "0.34.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <0.85.0",
    "typebox": ">=1.3.0 <2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "1.3.16"
  }
}
