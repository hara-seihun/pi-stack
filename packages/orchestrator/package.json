{
  "name": "pi-orchestrator",
  "version": "0.2.1",
  "description": "Fleet orchestration for pi agents: multi-account calibration, quota governance, task scheduling",
  "type": "module",
  "license": "MIT",
  "repository": "github:hara-seihun/pi-stack",
  "bin": {
    "pi-orchestrator": "dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./api": {
      "types": "./src/api.ts",
      "bun": "./src/api.ts",
      "default": "./dist/api.js"
    },
    "./boost": {
      "types": "./src/boost.ts",
      "bun": "./src/boost.ts",
      "default": "./dist/boost.js"
    },
    "./voice": {
      "types": "./src/voice/index.ts",
      "bun": "./src/voice/index.ts",
      "default": "./dist/voice/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/extension/usage-logger.ts",
      "./src/extension/routing.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "1.3.16"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
