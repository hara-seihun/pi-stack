{
  "name": "pi-orchestrator",
  "version": "0.2.1",
  "description": "Quota-aware Pi session orchestration",
  "type": "module",
  "license": "MIT",
  "repository": "github:hara-seihun/pi-stack",
  "bin": {
    "pi-orchestrator": "dist/cli.js",
    "pi-agent-capacity": "dist/agent-capacity-cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./api": {
      "types": "./src/api.ts",
      "bun": "./src/api.ts",
      "default": "./dist/api.js"
    },
    "./person-settings-contract": {
      "types": "./src/person-settings-contract.ts",
      "browser": "./src/person-settings-contract.ts",
      "bun": "./src/person-settings-contract.ts",
      "default": "./dist/person-settings-contract.js"
    },
    "./question-policy": {
      "types": "./src/threads/question-policy.ts",
      "bun": "./src/threads/question-policy.ts",
      "default": "./dist/threads/question-policy.js"
    },
    "./message-format": {
      "types": "./src/threads/message-format.ts",
      "browser": "./src/threads/message-format.ts",
      "bun": "./src/threads/message-format.ts",
      "default": "./dist/threads/message-format.js"
    },
    "./history": {
      "types": "./src/threads/history.d.mts",
      "default": "./src/threads/history.mjs"
    },
    "./image-service": {
      "types": "./src/image-service.ts",
      "bun": "./src/image-service.ts",
      "default": "./dist/image-service.js"
    },
    "./agent-capacity": {
      "types": "./src/agent-capacity.ts",
      "bun": "./src/agent-capacity.ts",
      "default": "./dist/agent-capacity.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/extension/usage-logger.ts",
      "./src/extension/routing.ts",
      "./src/extension/output-limit-continuation.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/check.mjs build",
    "docs": "npm run build && node scripts/generate-docs.mjs && node scripts/generate-completion-openapi.mjs",
    "test": "node scripts/check.mjs test",
    "typecheck": "node scripts/check.mjs typecheck"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@pi-plugins/claude-oauth": "0.3.7",
    "eventsource-parser": "3.1.1",
    "kenan-memory": "0.1.0",
    "openai": "6.40.0",
    "typebox": "1.3.16",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@types/node": "26.2.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
