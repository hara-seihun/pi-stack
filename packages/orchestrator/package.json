{
  "name": "pi-orchestrator",
  "version": "0.2.1",
  "description": "Quota-aware Pi session orchestration",
  "type": "module",
  "license": "MIT",
  "repository": "github:hara-seihun/pi-stack",
  "bin": {
    "pi-orchestrator": "dist/cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    "./api": {
      "types": "./src/api.ts",
      "bun": "./src/api.ts",
      "default": "./dist/api.js"
    },
    "./history": {
      "types": "./src/threads/history.d.mts",
      "default": "./src/threads/history.mjs"
    },
    "./image-service": {
      "types": "./src/image-service.ts",
      "bun": "./src/image-service.ts",
      "default": "./dist/image-service.js"
    },
    "./boost": {
      "types": "./src/boost.ts",
      "bun": "./src/boost.ts",
      "default": "./dist/boost.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/extension/usage-logger.ts",
      "./src/extension/routing.ts",
      "./src/extension/output-limit-continuation.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs": "npm run build && node scripts/generate-docs.mjs && node scripts/generate-completion-openapi.mjs",
    "pretest": "node ../runtime/patch-shared-rpc.mjs ../../node_modules",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ../../node_modules/.cache/orchestrator.tsbuildinfo"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@pi-plugins/claude-oauth": "0.3.7",
    "eventsource-parser": "3.1.1",
    "typebox": "1.3.16"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.87.1",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
