{
  "name": "pi-orchestrator",
  "version": "0.0.1",
  "description": "Fleet orchestration for pi agents: multi-account calibration, quota governance, task scheduling",
  "type": "module",
  "license": "MIT",
  "repository": "github:hara-seihun/pi-orchestrator",
  "bin": {
    "pi-orchestrator": "dist/cli.js"
  },
  "exports": {
    "./voice": {
      "types": "./src/voice/index.ts",
      "bun": "./src/voice/index.ts",
      "default": "./dist/voice/index.js"
    }
  },
  "pi": {
    "extensions": [
      "./src/extension/usage-logger.ts",
      "./src/extension/routing.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^26.2.0",
    "typebox": "^1.3.16",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
