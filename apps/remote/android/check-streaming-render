#!/usr/bin/env python3
"""Checks what the transcript does while an answer is being written into it.

A message arriving token by token is edited into place rather than rendered again, which is
worth two questions that "it looks fine" cannot answer.

Is it still? A long answer is asked for, the transcript is scrolled up so a reader is sitting
on settled text, and the screen is recorded while the rest arrives. Scrolled up the transcript
holds what is on screen still by construction, so every row that moves is text being re-made
that nobody changed. Editing only the tail moves a row or two on one frame; rendering the whole
message each poll moved about 79% of rows on half of them, which is what an answer dissolving
into raw TeX and reassembling looks like from outside.

Is it right? What thirty edits built has to be what one render would have built. The finished
thread is photographed page by page, the app is restarted so the same thread is rendered once
from nothing, and the two are compared. They should be identical. Bullets that walk to the
right as their list grows, numbering that loses its width, a heading left bold to the end of
the document: all of it shows up here as pages that stop matching, and none of it shows up in
the stillness number, because damage that arrives and stays put is perfectly still.

    android/check-streaming-render                     # emulator, makes its own thread
    android/check-streaming-render --serial <device>   # somewhere else

Needs a running emulator with the app installed; see the Android validation section of
AGENTS.md. Leaves nothing behind on the device.
"""
import argparse
import json
import pathlib
import subprocess
import sys
import tempfile
import time
import urllib.request
import uuid

PROPERTIES = pathlib.Path(__file__).with_name("local.properties")
LOCAL = dict(
    line.split("=", 1) for line in PROPERTIES.read_text().splitlines()
    if line and not line.lstrip().startswith("#") and "=" in line
)
HOST = LOCAL.get("piRemoteUrl", "http://127.0.0.1:8788")
PACKAGE = LOCAL.get("piRemoteApplicationId", "dev.piremote")
ACTIVITY = f"{PACKAGE}/dev.piremote.MainActivity"
PROMPT = (
    "Do not use any tools at all. Write a long answer about the heat equation that is mostly "
    "lists: six top-level bullet points, each with two or three nested sub-bullets, then a "
    "numbered list of twelve steps, then a few more bullets. Use inline math such as "
    "$f(x)=\\sum_n c_n e^{inx}$ in most of them, and put four display equations on their own "
    "lines. Write steadily and at length."
)
# The app bar above and the composer below are not the transcript, and both carry their own
# animation; the scrollbar down the right edge fades on its own schedule. Given as fractions so
# that the shrunken video frames and the full-sized screenshots are cropped to the same thing.
TOP, BOTTOM = 0.125, 0.85
LEFT, RIGHT = 0.015, 0.925


def load(paths, width=None):
    """The transcript out of each image, in grey, ready to be compared row by row."""
    import numpy as np
    from PIL import Image
    images = []
    for path in paths:
        image = Image.open(path).convert("L")
        if width:
            image = image.resize((width, round(image.height * width / image.width)))
        pixels = np.asarray(image, np.float32)
        height, columns = pixels.shape
        images.append(pixels[int(height * TOP):int(height * BOTTOM),
                             int(columns * LEFT):int(columns * RIGHT)])
    return images


def differing_rows(a, b):
    import numpy as np
    return int(((np.abs(a - b) > 12).sum(axis=1) > 3).sum())


def aligned_difference(a, b, limit=200):
    """The rows that differ once the two are lined up, and how far apart they were.

    Two runs are dragged through the thread by hand, so they stop a few pixels apart, and a
    page compared where it lies would differ everywhere for a reason nobody cares about. What
    the same rendering cannot survive is differing after it has been lined up. Lining up is
    done on how bright each row is, which is enough to find the offset of the same text and
    cannot invent an offset that makes different text look alike.
    """
    import numpy as np
    a_rows, b_rows = a.mean(axis=1), b.mean(axis=1)
    shift = min((float(np.abs(a_rows[max(0, s):len(a_rows) + min(0, s)]
                              - b_rows[max(0, -s):len(b_rows) - max(0, s)]).mean()), s)
                for s in range(-limit, limit + 1))[1]
    # The band the app bar shades, and the one the composer shades, sit at fixed heights on the
    # screen rather than on the text, so they land on different words once the two are lined up.
    # Trimming what the offset itself brought in leaves only the text being compared.
    edge = abs(shift)
    top, bottom = max(0, shift) + edge, a.shape[0] + min(0, shift) - edge
    return differing_rows(a[top:bottom], b[top - shift:bottom - shift]), shift


def post(path, body):
    request = urllib.request.Request(
        f"{HOST}{path}", data=json.dumps(body).encode(), headers={"content-type": "application/json"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)


def get(path):
    with urllib.request.urlopen(f"{HOST}{path}", timeout=30) as response:
        return json.load(response)


class Device:
    def __init__(self, serial):
        self.adb = ["adb", "-s", serial]

    def shell(self, *args):
        subprocess.run([*self.adb, "shell", *args], check=True, stdout=subprocess.DEVNULL)

    def open_thread(self, session):
        self.shell("am", "start", "-n", ACTIVITY, "-f", "0x24000000",
                   "--es", "dev.piremote.SESSION_ID", session)

    def restart_at(self, session):
        self.shell("am", "force-stop", PACKAGE)
        time.sleep(1)
        self.open_thread(session)

    def screenshot(self, path):
        with open(path, "wb") as file:
            subprocess.run([*self.adb, "exec-out", "screencap", "-p"], check=True, stdout=file)

    def settled_screenshot(self, path, tries=20):
        """Photographs the screen once it stops changing, so nothing is caught mid-draw."""
        previous = None
        for _ in range(tries):
            self.screenshot(path)
            current = path.read_bytes()
            if current == previous:
                return
            previous = current
            time.sleep(1)
        print(f"  {path.name} never stopped changing", file=sys.stderr)

    def to_end(self, path, tries=40):
        """Drags down until the thread has no more to show."""
        previous = None
        for _ in range(tries):
            self.settled_screenshot(path)
            current = path.read_bytes()
            if current == previous:
                return
            previous = current
            self.drag(1900, 700)
        print("  never reached the end of the thread", file=sys.stderr)

    def drag(self, from_y, to_y, ms=1200):
        # A slow drag rather than a flick: a fling is still moving a second later, and a moving
        # page differs from itself on every row.
        self.shell("input", "swipe", "540", str(from_y), "540", str(to_y), str(ms))
        time.sleep(1.5)

    def pull(self, remote, local):
        subprocess.run([*self.adb, "pull", remote, str(local)], check=True, stdout=subprocess.DEVNULL)
        self.shell("rm", remote)


def stillness(device, workspace, seconds):
    """Records the screen while the answer keeps arriving under a reader who is not moving."""
    device.drag(700, 1900)
    device.shell("screenrecord", "--bit-rate", "12000000", "--time-limit", str(seconds),
                 "/sdcard/streaming-render.mp4")
    video = workspace / "stream.mp4"
    device.pull("/sdcard/streaming-render.mp4", video)
    # screenrecord writes a frame only when the screen changed, so passing them through
    # untouched gives exactly what was displayed, with nothing padded or dropped.
    extract = subprocess.run(
        ["ffmpeg", "-loglevel", "error", "-i", str(video), "-vf", "scale=270:-1", "-vsync", "0",
         str(workspace / "frame-%04d.png")],
        capture_output=True, text=True)
    if extract.returncode != 0:
        sys.exit(extract.stderr)

    frames = load(sorted(workspace.glob("frame-*.png")))
    moved = [(index, differing_rows(frames[index], frames[index - 1])) for index in range(1, len(frames))]
    moved = [(index, rows) for index, rows in moved if rows]
    height = frames[0].shape[0]
    print(f"\nstillness: {len(frames)} distinct frames, {len(moved)} of them moved")
    for index, rows in moved[:20]:
        print(f"  frame {index}: {rows}/{height} rows ({100 * rows / height:.1f}%)")
    if moved:
        print(f"  worst frame disturbed {100 * max(r for _, r in moved) / height:.1f}% of the settled text")


def pages(device, workspace, name, count):
    """Photographs the thread from its end upwards, one screen at a time."""
    taken = []
    for index in range(count):
        path = workspace / f"{name}-{index}.png"
        device.settled_screenshot(path)
        taken.append(path)
        device.drag(700, 1900)
    return taken


def fidelity(device, session, workspace, count):
    """Compares the thread as it was written with the same thread rendered once from nothing."""
    # What the edits built is on screen now and nowhere else, so it is photographed before the
    # app is restarted, which is what throws it away and renders the thread from its source.
    device.to_end(workspace / "end.png")
    written = pages(device, workspace, "written", count)
    device.restart_at(session)
    time.sleep(6)
    device.to_end(workspace / "end.png")
    fresh = pages(device, workspace, "fresh", count)

    written_frames, fresh_frames = load(written), load(fresh)
    height = written_frames[0].shape[0]
    worst = 0
    print(f"\nfidelity: {count} pages of the finished thread, streamed against rendered once")
    for index, (a, b) in enumerate(zip(written_frames, fresh_frames)):
        rows, shift = aligned_difference(a, b)
        worst = max(worst, rows)
        print(f"  page {index}: {rows}/{height} rows differ ({100 * rows / height:.1f}%)"
              f"{'' if shift == 0 else f', lined up {abs(shift)} rows apart'}")
    print("  every page identical" if worst == 0 else
          f"  worst page differs on {100 * worst / height:.1f}% of rows, so the edits built "
          "something a single render would not have")


def wait_for_idle(session, limit=420):
    deadline = time.time() + limit
    while time.time() < deadline:
        thread = get(f"/v1/sessions/{session}")["session"]
        if thread.get("state") == "IDLE" and thread.get("activity") == "IDLE" and not thread.get("liveText"):
            time.sleep(3)
            return
        time.sleep(5)
    print("the answer never finished; comparing what there is", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--serial", default="emulator-5556")
    parser.add_argument("--seconds", type=int, default=30, help="how long to record")
    parser.add_argument("--lead", type=int, default=18, help="how long to let the answer run first")
    parser.add_argument("--pages", type=int, default=6, help="how much of the finished thread to compare")
    parser.add_argument("--prompt", default=PROMPT, help="ask the thread for something else")
    parser.add_argument("--keep", metavar="DIR", help="keep the recording and the screenshots here")
    options = parser.parse_args()

    try:
        import numpy, PIL  # noqa: F401
    except ImportError:
        sys.exit("needs numpy and pillow")

    device = Device(options.serial)
    session = post("/v1/sessions", {"requestId": str(uuid.uuid4()), "destination": "home"})["session"]["id"]
    print(f"thread {session}")
    device.open_thread(session)
    time.sleep(4)
    post(f"/v1/sessions/{session}/prompt",
         {"requestId": str(uuid.uuid4()), "text": options.prompt, "delivery": "followUp"})

    print(f"letting it write for {options.lead}s, then reading while it keeps writing")
    time.sleep(options.lead)
    workspace = pathlib.Path(options.keep) if options.keep else pathlib.Path(tempfile.mkdtemp())
    workspace.mkdir(parents=True, exist_ok=True)
    stillness(device, workspace, options.seconds)

    print("waiting for the answer to finish, then comparing it against a fresh render")
    wait_for_idle(session)
    fidelity(device, session, workspace, options.pages)
    if options.keep:
        print(f"\nframes kept in {workspace}")


if __name__ == "__main__":
    main()
