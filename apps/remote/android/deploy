#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

# The adb client auto-starts a background server daemon; stop it on exit so
# the flow leaves no detached process behind (tool-shell rejects those).
trap 'adb kill-server >/dev/null 2>&1 || true' EXIT

./gradlew testDebugUnitTest assembleDebug --no-daemon
endpoint=$(./connect-adb)
apk=app/build/outputs/apk/debug/app-debug.apk
adb -s "$endpoint" install -r "$apk"
expected=$(awk '$1 == "versionName" { gsub(/"/, "", $2); print $2; exit }' app/build.gradle)
application_id=$(awk -F= '$1 == "piRemoteApplicationId" { print $2; exit }' local.properties)
[[ -n $application_id ]] || application_id=dev.piremote
installed=$(adb -s "$endpoint" shell dumpsys package "$application_id" \
  | awk -F= '/versionName=/ { gsub(/\r/, "", $2); print $2; exit }')
[[ -n $expected && $installed == "$expected" ]] || {
  echo "installed Android version $installed; expected $expected" >&2
  exit 1
}
printf 'Pi Remote Android %s deployed to %s\n' "$installed" "$endpoint"
