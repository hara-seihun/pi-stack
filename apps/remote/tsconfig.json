{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["bun", "node"],
    "typeRoots": ["../../node_modules/@types"]
  },
  "include": ["server/**/*.ts"]
}
