# Install as /etc/pi-stack/dev-remote-USER.env for a temporary live checkout.
# All paths and domains here belong to the host, not the published app.
PI_STACK_SOURCE=/path/to/pi-stack-checkout
PI_STACK_REMOTE_SOURCE=/path/to/deployed/pi-remote
PATH=/usr/local/bin:/usr/bin:/bin
PI_REMOTE_DEV_ALLOWED_HOSTS=dev.example.test
