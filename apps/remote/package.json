{
  "name": "pi-remote",
  "version": "0.47.0",
  "description": "Self-hosted web and Android controller for persistent Pi sessions",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "pi": {
    "extensions": [
      "./server/context-mirror.ts"
    ]
  },
  "scripts": {
    "start": "bun server/main.ts",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.json",
    "test": "npm run build && node check.mjs"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "pi-orchestrator": "0.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  }
}
