#!/usr/bin/env bun
import { readFileSync } from "node:fs";
const args = process.argv.slice(2);
if (!args.length || args[0] === "--help") {
  console.log("Usage: pi-call status | list | preflight | start --brief FILE | show ID | end ID\nBrief JSON: {requestId:UUID,to:E164,contactName?,purpose,shareableFacts:[],opening,maxSeconds:60..1800,followUpOf?:CALL_ID_UUID}. Keep the approved requestId unchanged when inspecting an uncertain submission; an identity is never redialled. followUpOf acknowledges the latest accepted dial to that destination within two hours; it does not alone override the cooldown. The service additionally requires explicit manager/operator reconciliation approval. It never bypasses a recipient hold or the unfinished-call guard. Only approved recipient-facing facts enter Voice and managed telephone reasoning.");
  process.exit(0);
}
try {
  const config = JSON.parse(readFileSync(process.env.PI_STACK_PHONE_CONFIG ?? "/etc/pi-stack/phone.json", "utf8"));
  const token = readFileSync(config.adminTokenFile, "utf8").trim();
  let path: string, method = "GET", body: unknown;
  if (args[0] === "status" && args.length === 1) path = "/status";
  else if (args[0] === "list" && args.length === 1) path = "/calls";
  else if (args[0] === "preflight" && args.length === 1) { path = "/preflight"; method = "POST"; }
  else if (args[0] === "start" && args.length === 3 && args[1] === "--brief") { path = "/calls"; method = "POST"; body = JSON.parse(readFileSync(args[2]!, "utf8")); }
  else if (["show", "end"].includes(args[0]!) && args.length === 2 && args[1]) { path = `/calls/${encodeURIComponent(args[1])}`; if (args[0] === "end") method = "DELETE"; }
  else throw new Error("Invalid command. Use pi-call --help");
  if (!Number.isInteger(config.localPort)) throw new Error("An explicit telephone listener port is required");
  const response = await fetch(`http://127.0.0.1:${config.localPort}${path}`, { method, headers: { authorization: `Bearer ${token}`, "content-type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body), signal: AbortSignal.timeout(45_000) });
  console.log(JSON.stringify(await response.json(), null, 2)); process.exit(response.ok ? 0 : 1);
} catch (cause) { console.error(cause instanceof Error ? cause.message : "Phone command failed"); process.exit(1); }
