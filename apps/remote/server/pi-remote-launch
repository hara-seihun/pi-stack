#!/usr/bin/env bash
# Mount this person's folder, then become her supervisor.
#
# The unit runs with PrivateMounts=yes, so this whole script is already inside a
# mount namespace of its own with private propagation. The mount below is
# therefore visible to this process and to everything it spawns, which is every
# pi thread she runs, and to nothing else on the machine. There is no unmount
# path and no lock timer: stopping the unit destroys the namespace, and the
# plaintext view goes with it.
set -euo pipefail

: "${PI_REMOTE_CIPHER_DIR:?ciphertext directory required}"
: "${PI_REMOTE_PRIVATE_DIR:?mountpoint required}"
: "${CREDENTIALS_DIRECTORY:?systemd credentials required}"

key="$CREDENTIALS_DIRECTORY/key"
[[ -r $key ]] || { echo "no key credential" >&2; exit 78; }

mkdir -p -- "$PI_REMOTE_PRIVATE_DIR"

if ! mountpoint -q -- "$PI_REMOTE_PRIVATE_DIR"; then
  # gocryptfs forks a daemon that stays in this namespace and this cgroup, so
  # the unit owns it and KillMode=control-group takes it down with everything
  # else. A wrong key fails here and the unit never starts, which is what tells
  # the router to report the key as wrong rather than serving an empty folder.
  gocryptfs -q -passfile "$key" -- "$PI_REMOTE_CIPHER_DIR" "$PI_REMOTE_PRIVATE_DIR"
fi

exec "$@"
