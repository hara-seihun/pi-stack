#!/usr/bin/python3
"""Provision narrow per-person timezone projections; never initialize a setting value."""
import argparse
from datetime import datetime
import grp
import json
import os
from pathlib import Path
import pwd
import re
import stat
import subprocess
import tempfile
from zoneinfo import ZoneInfo

BASE = Path('/var/lib/pi-timezones')
GROUP = 'pi-timezones-readers'


def atomic(path, value):
    previous = path.stat()
    descriptor, temporary = tempfile.mkstemp(prefix='.timezone-config-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            os.fchown(stream.fileno(), previous.st_uid, previous.st_gid)
            os.fchmod(stream.fileno(), stat.S_IMODE(previous.st_mode))
            json.dump(value, stream, indent=2)
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def provision(directory, uid, gid):
    if directory.is_symlink():
        raise RuntimeError('timezone_directory_symlink')
    directory.mkdir(mode=0o2750, exist_ok=True)
    if directory.stat().st_uid not in (0, uid):
        raise RuntimeError('timezone_directory_owner_mismatch')
    os.chown(directory, uid, gid)
    directory.chmod(0o2750)


def verify(user, directory, uid, gid):
    path = directory / 'timezone.json'
    s = path.lstat()
    if not stat.S_ISREG(s.st_mode) or s.st_uid != uid or s.st_gid != gid or stat.S_IMODE(s.st_mode) != 0o640:
        raise RuntimeError('timezone_projection_file_ownership_invalid')
    payload = json.loads(path.read_text())
    if set(payload) != {'version', 'state', 'timezone'} or payload['version'] != 1 or payload['state'] != 'ready':
        raise RuntimeError('timezone_projection_not_ready')
    value = payload['timezone']
    if value is not None:
        if not isinstance(value, dict) or set(value) != {'zone', 'source', 'observedAt'} or value['source'] not in ('configured', 'client-observed') or not isinstance(value['observedAt'], str):
            raise RuntimeError('timezone_projection_invalid_metadata')
        if not isinstance(value['zone'], str) or value['zone'].startswith(('+', '-')):
            raise RuntimeError('timezone_projection_invalid_zone')
        datetime.fromisoformat(value['observedAt'].replace('Z', '+00:00'))
        ZoneInfo(value['zone'])
    return {'user': user, 'timezoneProjection': str(path), 'ready': True}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--user', action='append', required=True)
    parser.add_argument('--configure', action='store_true')
    parser.add_argument('--verify', action='store_true')
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise RuntimeError('timezone_provision_requires_root')
    if args.configure and args.verify:
        raise RuntimeError('timezone_operation_ambiguous')
    try:
        reader = grp.getgrnam(GROUP)
    except KeyError:
        if args.verify:
            raise RuntimeError('timezone_reader_group_unavailable')
        subprocess.run(['groupadd', '--system', GROUP], check=True, timeout=8)
        reader = grp.getgrnam(GROUP)
    BASE.mkdir(mode=0o755, exist_ok=True)
    if BASE.is_symlink() or BASE.stat().st_uid != 0:
        raise RuntimeError('timezone_root_untrusted')
    BASE.chmod(0o755)
    for user in args.user:
        if not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', user):
            raise RuntimeError('timezone_user_invalid')
        account = pwd.getpwnam(user)
        directory = BASE / user
        if args.verify:
            print(json.dumps(verify(user, directory, account.pw_uid, reader.gr_gid)))
            continue
        provision(directory, account.pw_uid, reader.gr_gid)
        if args.configure:
            registry = Path('/var/lib/pi-remote/persons') / (user + '.json')
            if registry.exists():
                person = json.loads(registry.read_text())
                if person['user'] != user:
                    raise RuntimeError('timezone_registry_identity_mismatch')
                person['environment']['PI_PERSON_TIMEZONE_FILE'] = str(directory / 'timezone.json')
                atomic(registry, person)
            dropin = Path('/etc/systemd/system') / ('pi-orchestrator@' + user + '.service.d')
            dropin.mkdir(mode=0o755, parents=True, exist_ok=True)
            (dropin / 'timezone.conf').write_text('[Service]\nEnvironment=PI_PERSON_TIMEZONE_FILE=' + str(directory / 'timezone.json') + '\n')
        print(json.dumps({'user': user, 'timezoneProjection': str(directory / 'timezone.json'), 'settingValueWritten': False}))
    if args.configure:
        auth = Path('/etc/pi-stack/kenan-memory-auth.json')
        config = Path('/etc/pi-stack/one-kenan.json')
        if auth.exists() and config.exists():
            memory = json.loads(auth.read_text())
            for supervisor in memory['supervisors']:
                account = pwd.getpwnam(supervisor['person'])
                provision(BASE / account.pw_name, account.pw_uid, reader.gr_gid)
                supervisor['timezoneFile'] = str(BASE / account.pw_name / 'timezone.json')
            atomic(auth, memory)
            value = json.loads(config.read_text())
            value['memoryTimezoneGroup'] = GROUP
            atomic(config, value)
            room = Path('/etc/pi-stack/rooms.json')
            if room.exists():
                document = json.loads(room.read_text())
                document['environment']['PI_PERSON_TIMEZONE_FILE'] = str(BASE / document['user'] / 'timezone.json')
                atomic(room, document)
                directory = Path('/etc/systemd/system/pi-rooms.service.d')
                directory.mkdir(mode=0o755, parents=True, exist_ok=True)
                (directory / 'timezone.conf').write_text('[Service]\nEnvironment=PI_PERSON_TIMEZONE_FILE=' + document['environment']['PI_PERSON_TIMEZONE_FILE'] + '\nReadWritePaths=' + str(BASE / document['user']) + '\n')
        subprocess.run(['systemctl', 'daemon-reload'], check=True, timeout=8)


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        raise SystemExit(str(error))
