[Unit]
Description=Pi Remote live frontend
After=network.target pi-remote-router.service

[Service]
Type=simple
User=kenan
WorkingDirectory=/home/kenan/projects/pi-stack/apps/remote
Environment=PATH=/run/current-system/sw/bin
ExecStart=/run/current-system/sw/bin/npm exec --workspace=pi-remote -- vite
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
