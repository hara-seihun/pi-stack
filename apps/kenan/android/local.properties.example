# Copy to local.properties, which Git ignores. Set sdk.dir if Gradle cannot find your SDK.
# This URL is embedded in the APK and must be reachable from the phone.
piRemoteRouterUrl=https://router.example.test/pi-stack
# Optional Access-protected entrance when the private router is unreachable:
# piRemotePublicRouterUrl=https://public-router.example.test/pi-stack
# sdk.dir=/path/to/android-sdk
